---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import MainHeaderNav from '../components/nav/MainHeaderNav.astro';
import EyeAccordionMenu from '../components/nav/EyeAccordionMenu.astro';
import SiteFooterNav from '../components/nav/SiteFooterNav.astro';
import { organizationSchema, websiteSchema, founderSchema, bookSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schemas?: Record<string, any> | Record<string, any>[];
  lang?: 'tr' | 'en';
  alternates?: { lang: string; href: string }[];
  hideFooter?: boolean;
  noindex?: boolean;
  noarchive?: boolean;
  transparentHeader?: boolean;  // Hero image üzerinden geçen şeffaf nav (yetenekler kategori sayfaları)
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  schemas,
  lang = 'tr',
  alternates,
  hideFooter = false,
  noindex = false,
  noarchive = false,
  transparentHeader = false,
} = Astro.props;

// Cloudflare Web Analytics site jetonu (derleme ortamından; panelde: Web Analytics → site → Manage site). Boşsa servis kutuda listelenir ama yükleme yapılmaz.
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '';

const SITE_URL = 'https://gonet.com.tr';

function normalizeCanonicalUrl(rawUrl: string): string {
  const parsed = new URL(rawUrl, SITE_URL);
  parsed.protocol = 'https:';
  if (parsed.hostname === 'www.gonet.com.tr') {
    parsed.hostname = 'gonet.com.tr';
  }
  let cleanPath = parsed.pathname.replace(/\/{2,}/g, '/');
  if (cleanPath === '/home' || cleanPath === '/home/' || cleanPath === '/index.html' || cleanPath === '/index.php') {
    cleanPath = '/';
  } else if (cleanPath.length > 1) {
    cleanPath = cleanPath.replace(/\/+$/, '');
  }
  parsed.pathname = cleanPath;
  parsed.search = '';
  parsed.hash = '';
  return parsed.href;
}

const canonicalUrl = normalizeCanonicalUrl(canonical || Astro.url.pathname);
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// Schema'ları @graph içine topla — entity authority için kritik
const globalSchemas = [organizationSchema, websiteSchema, founderSchema, bookSchema];
const pageSchemas = schemas
  ? Array.isArray(schemas)
    ? schemas
    : [schemas]
  : [];
const allSchemas = [...globalSchemas, ...pageSchemas];

// Kulüp sayfaları (/merhaba): üst şerit + alt bilgi her temada koyu; menüdeki
// «Görüşme isteyin» çerçeveli (kırmızı kulübün birincil eylemine ait — ARTDR §2).
const kulupSayfasi = Astro.url.pathname === '/merhaba' || Astro.url.pathname.startsWith('/merhaba/');
const alternateEnHref = alternates?.find((alt) => alt.lang.toLowerCase() === 'en')?.href;
const alternateTrHref = alternates?.find((alt) => alt.lang.toLowerCase() === 'tr')?.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Tema (no-flash) — paint öncesi data-theme'i ayarla; sistem tercihi + localStorage -->
    <meta name="theme-color" content="#ffffff" id="theme-color-meta" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('gonet-theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          var m = document.getElementById('theme-color-meta');
          if (m) m.setAttribute('content', theme === 'dark' ? '#0a0a0a' : '#ffffff');
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Inter (Adobe Clean'e en yakın açık alternatif) — kendi alan adımızdan (rıza öncesi üçüncü taraf isteği yok); @font-face: global.css -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:site_name" content="GONET" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- AEO + SEO hints -->
    {noindex ? (
      <meta name="robots" content={noarchive ? 'noindex, nofollow, noarchive' : 'noindex, nofollow'} />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}
    {alternates && alternates.length > 0 ? (
      alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)
    ) : (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="GONET Blog" href="/rss.xml" />

    <!-- Sitemap (Astro auto-generated) -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/brand/gonet-logo-dark.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Schema.org JSON-LD — AEO kalbı -->
    <JsonLd schema={allSchemas} />

    <!-- ───────────────────────────────────────────────────────────
         Analytics + Consent Management (KVKK + GDPR uyumlu)
         Klaro: kullanıcı kabul edene dek GTM YÜKLENMEZ (data-name pattern).
         GTM Container: GTM-PLNFNL — tüm tag'ler buradan yönetilir.
         ─────────────────────────────────────────────────────────── -->
    <script is:inline define:vars={{ cfBeaconToken: CF_BEACON_TOKEN }}>
      window.gonetCfToken = cfBeaconToken;
    </script>
    <script is:inline>
      // Kutu henüz karara bağlanmadıysa onun yüksekliğini baştan ayır: ilk ekran bağlantıları kutunun altında kalmaz, kutu görününce yerleşim kaymaz.
      if (!/(^|; )klaro=/.test(document.cookie)) { document.documentElement.style.setProperty('--cerez-h', window.innerWidth < 768 ? '140px' : '164px'); document.documentElement.setAttribute('data-cerez', ''); }
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      // Google Consent Mode v2 — varsayılan: her şey reddedilmiş. GTM, kutuda en az bir servise izin verilene kadar YÜKLENMEZ.
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      (function () {
        var GTM_ID = 'GTM-PLNFNL';
        // Kapsayıcıdaki Yandex etiketi GTM yüklenir yüklenmez çalışıyor (kapsayıcı tarafı henüz izne bağlı değil): bu yüzden GTM yalnız Analitik izniyle yüklenir.
        // «Yalnız Pazarlama» izninde GTM'i yüklemek için kapsayıcıda Yandex etiketi `gonet_riza_yandex` değişkenine bağlanınca bunu true yapın.
        var GTM_ADS_TEK_BASINA = false;
        var durum = { ga4: false, yandex: false, ads: false, cloudflare: false };
        var gtmYuklendi = false;
        var cfYuklendi = false;
        // Cloudflare Web Analytics GTM'den bağımsız, yalnız Analitik izniyle yüklenir (kenarda otomatik enjeksiyon panelden kapalı olmalı).
        function cfYukle() {
          if (cfYuklendi || !window.gonetCfToken) return;
          cfYuklendi = true;
          var s = document.createElement('script');
          s.defer = true;
          s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          s.setAttribute('data-cf-beacon', JSON.stringify({ token: window.gonetCfToken }));
          document.head.appendChild(s);
        }
        function gtmYukle() {
          if (gtmYuklendi) return;
          gtmYuklendi = true;
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
          document.head.appendChild(s);
        }
        // Klaro her servis için kararı bu işleve iletir (açılışta kayıtlı karar, sonra her değişiklik).
        window.gonetRiza = function (servis, onay) {
          durum[servis] = !!onay;
          gtag('consent', 'update', {
            analytics_storage: durum.ga4 ? 'granted' : 'denied',
            ad_storage: durum.ads ? 'granted' : 'denied',
            ad_user_data: durum.ads ? 'granted' : 'denied',
            ad_personalization: durum.ads ? 'granted' : 'denied'
          });
          // GTM kapsayıcısındaki etiketler bu olayı/değişkenleri tetikleyici olarak kullanır (servis başına ayrı).
          window.dataLayer.push({ event: 'gonet_riza', gonet_riza_ga4: durum.ga4, gonet_riza_yandex: durum.yandex, gonet_riza_ads: durum.ads });
          if (durum.ga4 || durum.yandex || (GTM_ADS_TEK_BASINA && durum.ads)) gtmYukle();
          if (durum.cloudflare) cfYukle();
        };
      })();
      window.klaroConfig = {
        version: 1,
        elementID: 'klaro',
        styling: { theme: ['light', 'bottom', 'wide'] },
        noAutoLoad: false,
        htmlTexts: true,
        embedded: false,
        groupByPurpose: true,
        storageMethod: 'cookie',
        cookieName: 'klaro',
        cookieExpiresAfterDays: 365,
        default: false,
        mustConsent: false,
        acceptAll: true,
        hideDeclineAll: false,
        hideLearnMore: false,
        noticeAsModal: false,
        disablePoweredBy: true,
        lang: 'tr',
        translations: {
          tr: {
            consentModal: {
              title: 'Çerez ve Gizlilik Tercihleri',
              description: 'gonet.com.tr aşağıdaki servisleri yalnız izninizle yükler; her servis adıyla, amacıyla ve tarafıyla listelenir. Kararınızı istediğiniz zaman sayfa altındaki «Çerez ayarları» bağlantısından değiştirebilir ya da geri çekebilirsiniz. <a href="/kvkk">Aydınlatma metni</a>',
            },
            consentNotice: {
              description: 'Analitik çerezlerini yalnız izninizle kullanırız; karar verene kadar bu servisler yüklenmez. <a href="/kvkk">Aydınlatma metni</a>',
              learnMore: 'Tercihler',
            },
            acceptAll: 'Hepsini kabul et',
            acceptSelected: 'Seçimi kaydet',
            decline: 'Hepsini reddet',
            ok: 'Hepsini kabul et',
            purposes: {
              analytics: { title: 'Analitik', description: 'Site kullanım istatistikleri.' },
              marketing: { title: 'Pazarlama', description: 'Reklam performansı ölçümü ve yeniden hedefleme.' },
            },
            service: {
              disableAll: { title: 'Tümünü devre dışı bırak', description: 'Tüm üçüncü taraf servisleri kapatır.' },
            },
            purposeItem: {
              service: 'servis',
              services: 'servis',
            },
            poweredBy: 'Gizlilik tercihleri',
          },
        },
        // Anahtar → servis: «Analitik» = ga4 + yandex (Google Tag Manager üzerinden) + cloudflare (doğrudan). Kapsayıcıda Ads etiketi yok → «Google Ads / DoubleClick» servisi kutuda listelenmez; «Pazarlama» grubu boş kalır.
        services: [
          {
            name: 'ga4',
            title: 'Google Analytics 4',
            purposes: ['analytics'],
            description: 'Google (üçüncü taraf, ABD). Site kullanım istatistikleri. Google Tag Manager üzerinden yüklenir.',
            cookies: [/^_ga/, /^_gid/, /^_fbp/, [/^_fbp/, '/', '.gonet.com.tr'], /^_fbc/, [/^_fbc/, '/', '.gonet.com.tr']], // _fbp/_fbc: eski ziyaretten kalmış kalıntı çerezler «Hepsini reddet»te silinir (QA ead49de)
            required: false,
            default: false,
            callback: function (consent) { window.gonetRiza('ga4', consent); },
          },
          {
            name: 'yandex',
            title: 'Yandex Metrica',
            purposes: ['analytics'],
            description: 'Yandex (üçüncü taraf, Rusya). Oturum kaydı, tıklama haritası ve Yandex\'in reklam ölçümü. Google Tag Manager üzerinden yüklenir.',
            cookies: [/^_ym/, /^yandexuid/, /^yabs-sid/],
            required: false,
            default: false,
            callback: function (consent) { window.gonetRiza('yandex', consent); },
          },
          {
            name: 'cloudflare',
            title: 'Cloudflare Web Analytics',
            purposes: ['analytics'],
            description: 'Cloudflare (üçüncü taraf, ABD). Site kullanım istatistikleri. Google Tag Manager kullanmadan doğrudan yüklenir.',
            cookies: [],
            required: false,
            default: false,
            callback: function (consent) { window.gonetRiza('cloudflare', consent); },
          },
        ],
      };
    </script>
    <!-- Klaro consent manager 0.7.22 (BSD-3) — kendi alan adımızdan (public/vendor/klaro; dosyalar eski CDN SRI özetleriyle doğrulandı) -->
    <link rel="stylesheet" href="/vendor/klaro/klaro.min.css" />
    <script defer src="/vendor/klaro/klaro-no-css.js"></script>
  </head>

  <body class="min-h-screen flex flex-col bg-white text-black">
    <!-- Header — Swiss Editöryel Üst Ana Navigasyon ve Mega Menü -->
    <MainHeaderNav
      lang={lang}
      transparentHeader={transparentHeader}
      kulupSayfasi={kulupSayfasi}
      currentPath={Astro.url.pathname}
      alternateEnHref={alternateEnHref}
      alternateTrHref={alternateTrHref}
    />

    <!-- Tema toggle handler -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        function uygula(next) {
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('gonet-theme', next); } catch (e) {}
          const m = document.getElementById('theme-color-meta');
          if (m) m.setAttribute('content', next === 'dark' ? '#0a0a0a' : '#ffffff');
          document.querySelectorAll('[data-tema-sec]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-tema-sec') === next ? 'true' : 'false');
          });
        }
        const btn = document.getElementById('theme-toggle');
        if (btn) btn.addEventListener('click', function () {
          uygula(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });
        // Telefon menüsündeki Açık/Koyu seçimi (eye-menu, DOM'da sonra gelir)
        document.addEventListener('click', function (e) {
          const b = e.target.closest && e.target.closest('[data-tema-sec]');
          if (b) { e.stopPropagation(); uygula(b.getAttribute('data-tema-sec')); }
        }, true);
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-tema-sec]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-tema-sec') === root.getAttribute('data-theme') ? 'true' : 'false');
          });
        });
      })();
    </script>

    <!-- Dış link otomasyonu (site geneli kural) — alan-dışı linkler yeni sekme +
         rel güvenlik + ↗ + SR etiketi. Tüm sayfalara/içeriğe otomatik uygulanır. -->
    <script is:inline>
      (function () {
        function isExternal(host) {
          return host && host !== 'gonet.com.tr' && !host.endsWith('.gonet.com.tr');
        }
        function process(root) {
          var links = (root || document).querySelectorAll('a[href]');
          for (var i = 0; i < links.length; i++) {
            var a = links[i];
            if (a.dataset.extDone) continue;
            var href = a.getAttribute('href') || '';
            if (!/^https?:\/\//i.test(href)) continue;       // relative/mailto/tel/# → iç
            var host;
            try { host = new URL(href, location.href).hostname; } catch (e) { continue; }
            if (!isExternal(host)) continue;                  // *.gonet.com.tr → iç, dokunma
            a.setAttribute('target', '_blank');
            var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
            if (rel.indexOf('noopener') === -1) rel.push('noopener');
            if (rel.indexOf('noreferrer') === -1) rel.push('noreferrer');
            a.setAttribute('rel', rel.join(' '));
            a.classList.add('ext-link');
            if (!a.querySelector('.sr-ext')) {
              var s = document.createElement('span');
              s.className = 'sr-only sr-ext';
              s.textContent = ' (yeni sekmede açılır)';
              a.appendChild(s);
            }
            a.dataset.extDone = '1';
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () { process(document); });
        } else {
          process(document);
        }
        // Dinamik eklenen içerik (feedback widget, vb.) için hafif gözlem
        try {
          new MutationObserver(function (muts) {
            for (var j = 0; j < muts.length; j++) {
              if (muts[j].addedNodes && muts[j].addedNodes.length) { process(document); break; }
            }
          }).observe(document.body, { childList: true, subtree: true });
        } catch (e) {}
      })();
    </script>

    <!-- Floating göz akordiyon menüsü -->
    <EyeAccordionMenu
      lang={lang}
      kulupSayfasi={kulupSayfasi}
      currentPath={Astro.url.pathname}
      alternateEnHref={alternateEnHref}
      alternateTrHref={alternateTrHref}
    />

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer — devasa tipografik mark + 5 sütunlu dizin -->
    <SiteFooterNav
      lang={lang}
      kulupSayfasi={kulupSayfasi}
      hideFooter={hideFooter}
      kimMetni={lang === 'tr' ? "İzmir ve Ege'nin ilk dijital ve ilk AI ajansı. 2005–2017 arasında Google'ın ajans programlarında sertifikalı iş ortağıydık (bugünkü adıyla Google Partner). IRD üyesi. DEPARK mukimi." : undefined}
      currentPath={Astro.url.pathname}
      alternateEnHref={alternateEnHref}
      alternateTrHref={alternateTrHref}
    />
    <script is:inline>
      (function () {
        function bagla() {
          var b = document.getElementById('cerez-ayarlari');
          if (b && !b.dataset.bagli) { b.dataset.bagli = '1'; b.addEventListener('click', function () { if (window.klaro && window.klaro.show) window.klaro.show(window.klaroConfig); }); }
          var n = document.getElementById('klaro-cookie-notice');
          if (n) { n.removeAttribute('aria-labelledby'); n.setAttribute('aria-label', 'Çerez tercihleri'); }
          var m = document.querySelector('#cookieScreen .cm-modal');
          if (m && !m.getAttribute('aria-label')) { m.setAttribute('role', 'dialog'); m.setAttribute('aria-label', 'Çerez ve gizlilik tercihleri'); }
          var l = document.querySelector('.klaro .cn-learn-more');
          if (l && l.getAttribute('role') !== 'button') l.setAttribute('role', 'button');
          var kh = n ? Math.round(n.getBoundingClientRect().height) : 0;
          if (n && kh) { document.documentElement.style.setProperty('--cerez-h', kh + 'px'); document.documentElement.setAttribute('data-cerez', ''); }
          else if (!n && window.klaro) { document.documentElement.style.removeProperty('--cerez-h'); document.documentElement.removeAttribute('data-cerez'); }
          // Karar verildikten sonra Klaro tercih ekranında «Hepsini reddet» göstermiyor: geri çekme tek tıkla olsun.
          var ft = document.querySelector('#cookieScreen .cm-footer-buttons') || document.querySelector('#cookieScreen .cm-footer');
          if (ft && !ft.querySelector('.cn-decline') && window.klaro && window.klaro.getManager) {
            var r = document.createElement('button');
            r.type = 'button';
            r.className = 'cm-btn cm-btn-danger cn-decline';
            r.textContent = 'Hepsini reddet';
            r.addEventListener('click', function () {
              var mg = window.klaro.getManager(window.klaroConfig);
              mg.changeAll(false);
              mg.saveAndApplyConsents('decline');
              var k = document.querySelector('#cookieScreen .cm-modal .hide');
              if (k) k.click();
            });
            ft.insertBefore(r, ft.firstChild);
          }
        }
        document.addEventListener('DOMContentLoaded', bagla);
        new MutationObserver(bagla).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
    <!-- Editöryel "hizasız" başlık efekti — her kelimeye random margin-left, satır wrap'larında başlangıç noktası değişir -->
    <script is:inline>
      (function () {
        function apply() {
          const palette = [0, 8, 16, 24, 32, 12, 20, 40, 4];
          const targets = document.querySelectorAll(
            'h1.editorial-display, h2.editorial-display, h3.editorial-display'
          );
          targets.forEach(function (el) {
            // Sadece sade text içeriği — child element'i varsa atla
            const hasEl = Array.from(el.childNodes).some(function (n) {
              return n.nodeType === 1;
            });
            if (hasEl) return;
            // Zaten işlendiyse skip
            if (el.dataset.irregular === '1') return;
            const text = (el.textContent || '').trim();
            if (!text || text.split(/\s+/).length < 2) return;
            const words = text.split(/(\s+)/);
            let wIdx = 0;
            let html = '';
            for (let i = 0; i < words.length; i++) {
              const part = words[i];
              if (/^\s+$/.test(part)) {
                html += ' ';
              } else if (part.length > 0) {
                const m = palette[(wIdx * 7 + part.length * 3) % palette.length];
                html +=
                  '<span style="margin-left:' +
                  m +
                  'px;display:inline-block">' +
                  part +
                  '</span>';
                wIdx++;
              }
            }
            el.innerHTML = html;
            el.dataset.irregular = '1';
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', apply);
        } else {
          apply();
        }
      })();
    </script>

    <!-- (Ölü tilt-card 3D hover JS kaldırıldı 2026-06-11: hiçbir markup .tilt-card
         kullanmıyordu; MutationObserver her DOM değişiminde boşa querySelectorAll
         çalıştırıyordu — perf temizliği.) -->

    <!-- Mobil otomatik perspektif-to-fit: sığmayan editorial-display başlıkları rotateY ile sığacak kadar eğer -->
    <script is:inline>
      (function () {
        function fitDisplayText() {
          if (window.innerWidth > 1023) {
            // Desktop'a geçildiyse önceki perspective'leri sıfırla
            document.querySelectorAll('.editorial-display[data-shrunk]').forEach(function (el) {
              el.style.transform = '';
              el.style.transformOrigin = '';
              el.style.fontSize = '';
              el.removeAttribute('data-shrunk');
            });
            return;
          }
          document.querySelectorAll('.editorial-display').forEach(function (el) {
            // Kendi inline 3D perspektifi olan kartlara dokunma
            if (el.closest('[style*="perspective"]')) return;
            // Önceki state'i sıfırla — taze ölçüm için
            if (el.dataset.shrunk) {
              el.style.transform = '';
              el.style.transformOrigin = '';
              el.style.fontSize = '';
            }
            var overflow = el.scrollWidth - el.clientWidth;
            if (overflow > 2 && el.clientWidth > 0) {
              // cos(angle) = ratio → bu açıda 3D rotateY uygulanan kutunun görünür projeksiyonu container'a tam sığar
              var ratio = el.clientWidth / el.scrollWidth;
              var safeRatio = Math.max(0.55, ratio * 0.97);  // floor 55% → max ~56° rotation (aşırı distortion engelle)
              var angleDeg = Math.acos(safeRatio) * 180 / Math.PI;
              el.style.transform = 'perspective(1100px) rotateY(' + angleDeg.toFixed(2) + 'deg)';
              el.style.transformOrigin = 'left center';
              el.dataset.shrunk = '1';
            } else if (el.dataset.shrunk) {
              el.removeAttribute('data-shrunk');
            }
          });
        }
        var rTimer;
        function schedule() {
          clearTimeout(rTimer);
          rTimer = setTimeout(fitDisplayText, 120);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fitDisplayText);
        } else {
          fitDisplayText();
        }
        window.addEventListener('resize', schedule);
        window.addEventListener('orientationchange', schedule);
      })();
    </script>

    <style is:global>
      /* AI mesajına eklenebilen "reaction" badge — kalp/sparkle/thumbs */
      .gonet-reaction {
