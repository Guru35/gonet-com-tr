        function extractReaction(content) {
          const m = content && content.match(/^\[REACTION:(heart|sparkle|thumbs)\]\s*/);
          if (!m) return { content: content, reaction: null };
          return { content: content.slice(m[0].length), reaction: m[1] };
        }

        function renderMessage(m) {
          const wrap = document.createElement('div');
          wrap.className = m.role === 'user' ? 'flex flex-col items-end' : 'flex flex-col items-start';
          const label = document.createElement('p');
          label.className = 'text-[9px] font-semibold uppercase tracking-[0.3em] text-black/40 mb-1.5 px-1';
          label.textContent = m.role === 'user' ? 'SİZ' : 'GONET ASİSTAN';
          wrap.appendChild(label);

          // AI mesajı için reaction tag varsa: animasyonlu badge önce render
          let bubbleContent = m.content;
          if (m.role === 'assistant') {
            const ext = extractReaction(m.content);
            bubbleContent = ext.content;
            if (ext.reaction) {
              const react = document.createElement('div');
              react.className = 'gonet-reaction gonet-reaction-' + ext.reaction;
              if (ext.reaction === 'heart') {
                react.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 21s-7-4.5-9.5-9.5C1 8 3 5 6 5c2 0 3 1 4 2.5C11 6 12 5 14 5c3 0 5 3 3.5 6.5C19 16.5 12 21 12 21z"/></svg>';
              } else if (ext.reaction === 'sparkle') {
                react.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2l2.4 7.4L22 12l-7.6 2.6L12 22l-2.4-7.4L2 12l7.6-2.6z"/></svg>';
              } else {
                react.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M7 11l3-7c2 0 3 1 3 3v3h5c1 0 2 1 2 2v5c0 2-1 3-3 3H9c-2 0-3-1-3-3v-6z"/></svg>';
              }
              wrap.appendChild(react);
            }
          }

          const bubble = document.createElement('div');
          bubble.className = m.role === 'user'
            ? 'max-w-[88%] bg-black text-white px-4 py-3 text-[15px] leading-relaxed whitespace-pre-wrap border border-black'
            : 'max-w-[88%] bg-white text-black px-4 py-3 text-[15px] leading-relaxed whitespace-pre-wrap border-l-2 border-brand-600 border-y border-r border-y-black/10 border-r-black/10';
          bubble.textContent = sanitize(bubbleContent);
          wrap.appendChild(bubble);
          msgsEl.appendChild(wrap);
          msgsEl.scrollTop = msgsEl.scrollHeight;
        }

        function renderSystemMessage(text) {
          var wrap = document.createElement('div');
          wrap.className = 'flex flex-col items-start';
          var label = document.createElement('p');
          label.className = 'text-[9px] font-semibold uppercase tracking-[0.3em] text-black/40 mb-1.5 px-1';
          label.textContent = 'GONET';
          wrap.appendChild(label);
          var bubble = document.createElement('div');
          bubble.className = 'max-w-[88%] bg-stone-50 text-black/80 px-4 py-3 text-[14px] leading-relaxed whitespace-pre-wrap border-l-2 border-black/20 border-y border-r border-y-black/5 border-r-black/5 italic';
          bubble.textContent = text;
          wrap.appendChild(bubble);
          msgsEl.appendChild(wrap);
          msgsEl.scrollTop = msgsEl.scrollHeight;
        }

        function open(trigger) {
          sessionId = uid();
          sourceUrl = trigger.getAttribute('data-source-url') || window.location.href;
          sourceTitle = trigger.getAttribute('data-source-title') || document.title;
          intent = trigger.getAttribute('data-feedback-intent') || 'error_report';
          // Opsiyonel override'lar — sosyal medya galerisi gibi özel bağlamlar için.
          // Sağlanmazsa default metinler kullanılır (yetenekler vb. değişmez).
          var overrideTitle = trigger.getAttribute('data-feedback-title');
          var overrideEyebrow = trigger.getAttribute('data-feedback-eyebrow');
          var overridePlaceholder = trigger.getAttribute('data-feedback-placeholder');
          var overrideWelcome = trigger.getAttribute('data-feedback-welcome');
          messages = []; images = []; ended = false;
          msgsEl.innerHTML = ''; imgsEl.innerHTML = ''; txtEl.value = ''; emailEl.value = '';
          if (kvkkEl) kvkkEl.checked = false;
          if (kvkkWrap) { kvkkWrap.classList.add('hidden'); kvkkWrap.classList.remove('flex'); }
          if (piiWrap) piiWrap.classList.add('hidden');
          if (piiYes) piiYes.checked = false;
          if (piiNo) piiNo.checked = false;
          if (finalBtn) finalBtn.disabled = false;
          inputRow.classList.remove('hidden'); endBlock.classList.add('hidden');
          showStatus('');
          if (intent === 'discussion') {
            if (eyebrowEl) eyebrowEl.textContent = overrideEyebrow || '— AI ile tartış · Sadece bu yazı';
            if (titleEl) titleEl.textContent = overrideTitle || 'Bu yazı hakkında ne düşünüyorsunuz?';
            if (txtEl) txtEl.placeholder = overridePlaceholder || 'Yazıyla ilgili görüşünüzü yazın…';
            if (consentWrap) {
              consentWrap.classList.remove('hidden');
              consentWrap.classList.add('flex');
            }
            if (consentEl) consentEl.checked = true;
          } else {
            if (eyebrowEl) eyebrowEl.textContent = overrideEyebrow || '— Geri bildirim';
            if (titleEl) titleEl.textContent = overrideTitle || 'Bu sayfada hata mı gördünüz?';
            if (txtEl) txtEl.placeholder = overridePlaceholder || 'Mesajınız…';
            if (consentWrap) {
              consentWrap.classList.add('hidden');
              consentWrap.classList.remove('flex');
            }
          }
          lb.classList.remove('hidden');
          lb.classList.add('flex');
          document.body.style.overflow = 'hidden';
          // Yavaş yavaş başlat: welcome (varsa) → AI cevabı
          if (overrideWelcome) {
            setTimeout(function () { renderSystemMessage(overrideWelcome); }, 280);
            setTimeout(function () { requestAi(); }, 1150);
          } else {
            requestAi();
          }
        }

        function close() {
          lb.classList.add('hidden');
          lb.classList.remove('flex');
          document.body.style.overflow = '';
        }

        async function requestAi() {
          showStatus('Yazıyor…');
          sendBtn.disabled = true;
          try {
            const r = await fetch(ENGINE + '/api/feedback/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                session_id: sessionId,
                source_url: sourceUrl,
                source_title: sourceTitle,
                intent: intent,
                messages: messages,
                images: images,
              }),
            });
            const data = await r.json();
            if (data.ok && data.message) {
              const m = { role: 'assistant', content: data.message };
              messages.push(m);
              renderMessage(m);
              // Sohbet bitiş işareti yakala (her iki intent için)
              if (/e-posta adresinizi vermek ister/i.test(data.message) ||
                  /sohbetin kopyas[ıi]n[ıi]/i.test(data.message) ||
                  /mail kopyas[ıi]\s*ister/i.test(data.message) ||
                  /kaydedip ekibe ilett/i.test(data.message) ||
                  /kaydediyorum[\.,]\s*sohbet kopyas/i.test(data.message) ||
                  /talebinizi.*ekibimiz/i.test(data.message) ||
                  /ekibimiz.*size geri d[oö]n/i.test(data.message)) {
                ended = true;
                inputRow.classList.add('hidden');
                endBlock.classList.remove('hidden');
                // PII tespit edildiyse KVKK consent radio bloğu göster
                if (detectPiiInMessages(messages)) {
                  piiWrap.classList.remove('hidden');
                  if (finalBtn) finalBtn.disabled = true;
                }
              }
              showStatus('');
            } else {
              showStatus('Asistan şu an yanıt veremiyor.', true);
            }
          } catch (e) {
            showStatus('Bağlantı hatası', true);
          } finally {
            sendBtn.disabled = false;
          }
        }

        async function sendUser() {
          const txt = txtEl.value.trim();
          if (!txt || ended) return;
          if (messages.length > 18) {
            showStatus('Maksimum mesaj sayısına ulaşıldı. Lütfen tamamlayın.', true);
            ended = true;
            inputRow.classList.add('hidden');
            endBlock.classList.remove('hidden');
            return;
          }
          const m = { role: 'user', content: txt };
          messages.push(m); renderMessage(m);
          txtEl.value = '';
          await requestAi();
        }

        async function uploadFile(file) {
          if (images.length >= 2) { showStatus('En fazla 2 görsel ekleyebilirsiniz.', true); return; }
          if (file.size > 4 * 1024 * 1024) { showStatus('Dosya 4 MB üzeri.', true); return; }
          showStatus('Yükleniyor…');
          const fd = new FormData();
          fd.append('session_id', sessionId);
          fd.append('file', file);
          try {
            const r = await fetch(ENGINE + '/api/feedback/upload', { method: 'POST', body: fd });
            const data = await r.json();
            if (data.ok) {
              images.push({ path: data.path, mime: data.mime, size: data.size });
              const chip = document.createElement('div');
              chip.className = 'inline-flex items-center gap-2 text-xs bg-white border border-black/10 px-2.5 py-1';
              chip.innerHTML = `<span>📎 Görsel ${images.length}</span>`;
              imgsEl.appendChild(chip);
              showStatus('');
              // AI'ya da bildir
              const m = { role: 'user', content: '[Ekran görüntüsü ekledim]' };
              messages.push(m); renderMessage(m);
              await requestAi();
            } else {
              showStatus('Yükleme başarısız', true);
            }
          } catch (e) {
            showStatus('Yükleme hatası', true);
          }
        }

        async function finalize(email) {
          showStatus('Kaydediliyor…');
          finalBtn.disabled = true;
          try {
            const r = await fetch(ENGINE + '/api/feedback/finalize', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                session_id: sessionId, source_url: sourceUrl, source_title: sourceTitle,
                intent: intent,
                content_improvement_consent: intent === 'discussion'
                  ? !!(consentEl && consentEl.checked)
                  : null,
                pii_consent: piiConsentValue(),
                messages: messages, images: images, user_email: email || null,
              }),
            });
            const data = await r.json();
            if (data.ok) {
              msgsEl.innerHTML = '';
              const ok = document.createElement('div');
              ok.className = 'text-center py-12';
              ok.innerHTML = `
                <p class="text-3xl mb-3">✓</p>
                <p class="text-base font-semibold mb-2">Teşekkürler!</p>
                <p class="text-sm text-slate-600 max-w-sm mx-auto leading-relaxed">
                  Geri bildiriminiz kaydedildi (referans #${data.id}). Ekibimiz inceleyip gerekli düzenlemeleri yapacaktır.
                </p>
              `;
              msgsEl.appendChild(ok);
              endBlock.classList.add('hidden');
              inputRow.classList.add('hidden');
              setTimeout(close, 3500);
            } else {
              showStatus('Kayıt başarısız', true);
              finalBtn.disabled = false;
            }
          } catch (e) {
            showStatus('Bağlantı hatası', true);
            finalBtn.disabled = false;
          }
        }

        async function copyTranscript() {
          const txt = messages.map(m => (m.role === 'user' ? 'SİZ' : 'ASİSTAN') + ':\n' + m.content).join('\n\n');
          try { await navigator.clipboard.writeText(txt); showStatus('Panoya kopyalandı'); }
          catch (e) { window.prompt('Sohbeti kopyalayın:', txt); }
        }

        document.querySelectorAll('[data-feedback-open]').forEach((b) => {
          b.addEventListener('click', () => open(b));
        });

        // Global expose — başka script'ler programatik açabilsin
        // Örn. paragraf yanındaki AI ikonu, blog'da inline tartış butonu vs.
        window.gonetOpenFeedback = function (opts) {
          opts = opts || {};
          const fakeTrigger = {
            getAttribute(attr) {
              if (attr === 'data-source-url') return opts.url || window.location.href;
              if (attr === 'data-source-title') return opts.title || document.title;
              if (attr === 'data-feedback-intent') return opts.intent || 'discussion';
              return null;
            }
          };
          open(fakeTrigger);
        };
        closeBtn.addEventListener('click', close);
        lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.classList.contains('hidden')) close(); });
        sendBtn.addEventListener('click', sendUser);
        txtEl.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendUser(); }
        });
        txtEl.addEventListener('input', () => {
          txtEl.style.height = 'auto';
          txtEl.style.height = Math.min(240, txtEl.scrollHeight) + 'px';
          txtEl.style.overflowY = txtEl.scrollHeight > 240 ? 'auto' : 'hidden';
        });
        fileEl.addEventListener('change', () => {
          const f = fileEl.files && fileEl.files[0];
          if (f) uploadFile(f);
          fileEl.value = '';
        });
        emailEl.addEventListener('input', updateKvkkGate);
        if (kvkkEl) kvkkEl.addEventListener('change', updateKvkkGate);

        // PII consent — radio değişince finalize butonunu aç
        function piiConsentValue() {
          if (piiYes && piiYes.checked) return true;
          if (piiNo && piiNo.checked) return false;
          return null;
        }
        function updatePiiGate() {
          if (!piiWrap || piiWrap.classList.contains('hidden')) return;
          const v = piiConsentValue();
          if (finalBtn) finalBtn.disabled = v === null;
        }
        if (piiYes) piiYes.addEventListener('change', updatePiiGate);
        if (piiNo) piiNo.addEventListener('change', updatePiiGate);

        finalBtn.addEventListener('click', () => {
          const email = emailEl.value.trim();
          if (email && (!kvkkEl || !kvkkEl.checked)) {
            showStatus('E-posta gönderilmesi için KVKK onayı gerekli.', true);
            return;
          }
          // PII consent zorunlu kontrol
          if (piiWrap && !piiWrap.classList.contains('hidden')) {
            const v = piiConsentValue();
            if (v === null) {
              showStatus('Lütfen KVKK onayı seçeneklerinden birini işaretleyin.', true);
              return;
            }
          }
          finalize(email);
        });
        skipBtn.addEventListener('click', () => {
          emailEl.value = '';
          updateKvkkGate();
          finalize('');
        });
        copyBtn.addEventListener('click', copyTranscript);
      })();
    </script>
  </body>
</html>
