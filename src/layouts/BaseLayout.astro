    <script is:inline>
      (function () {
        function apply() {
          const palette = [0, 8, 16, 24, 32, 12, 20, 40, 4];
          const targets = document.querySelectorAll(
            'h1.editorial-display, h2.editorial-display, h3.editorial-display'
          );
          targets.forEach(function (el) {
            // Sadece sade text içeriği — child element'i varsa atla
            const hasEl = Array.from(el.childNodes).some(function (n) {
              return n.nodeType === 1;
            });
            if (hasEl) return;
            // Zaten işlendiyse skip
            if (el.dataset.irregular === '1') return;
            const text = (el.textContent || '').trim();
            if (!text || text.split(/\s+/).length < 2) return;
            const words = text.split(/(\s+)/);
            let wIdx = 0;
            let html = '';
            for (let i = 0; i < words.length; i++) {
              const part = words[i];
              if (/^\s+$/.test(part)) {
                html += ' ';
              } else if (part.length > 0) {
                const m = palette[(wIdx * 7 + part.length * 3) % palette.length];
                html +=
                  '<span style="margin-left:' +
                  m +
                  'px;display:inline-block">' +
                  part +
                  '</span>';
                wIdx++;
              }
            }
            el.innerHTML = html;
            el.dataset.irregular = '1';
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', apply);
        } else {
          apply();
        }
      })();
    </script>

    <!-- Tilt-card 3D hover — .tilt-card class'lı element fareye göre rotateX/Y alır -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(pointer: coarse)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        function init() {
          var cards = document.querySelectorAll('.tilt-card');
          if (!cards.length) return;
          var MAX_TILT = 8;
          var SCALE = 1.02;
          cards.forEach(function (card) {
            if (card.dataset.tiltBound === '1') return;
            card.dataset.tiltBound = '1';
            var rect = null;
            var rafId = null;
            card.addEventListener('mouseenter', function () {
              rect = card.getBoundingClientRect();
              card.style.transition = 'transform 100ms ease-out';
            });
            card.addEventListener('mousemove', function (e) {
              if (!rect) return;
              if (rafId) cancelAnimationFrame(rafId);
              rafId = requestAnimationFrame(function () {
                var x = (e.clientX - rect.left) / rect.width;
                var y = (e.clientY - rect.top) / rect.height;
                var rotateX = (y - 0.5) * -MAX_TILT * 2;
                var rotateY = (x - 0.5) * MAX_TILT * 2;
                card.style.transform = 'rotateX(' + rotateX.toFixed(2) + 'deg) rotateY(' + rotateY.toFixed(2) + 'deg) scale(' + SCALE + ')';
              });
            });
            card.addEventListener('mouseleave', function () {
              card.style.transition = 'transform 400ms cubic-bezier(0.4, 0, 0.2, 1)';
              card.style.transform = 'rotateX(0) rotateY(0) scale(1)';
            });
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else { init(); }
        // Yeni eklenen tilt-card'lar için (blog infinite-scroll vs.)
        new MutationObserver(init).observe(document.body, { childList: true, subtree: true });
      })();
    </script>

    <!-- Mobil otomatik perspektif-to-fit: sığmayan editorial-display başlıkları rotateY ile sığacak kadar eğer -->
    <script is:inline>
      (function () {
        function fitDisplayText() {
          if (window.innerWidth > 1023) {
            // Desktop'a geçildiyse önceki perspective'leri sıfırla
            document.querySelectorAll('.editorial-display[data-shrunk]').forEach(function (el) {
              el.style.transform = '';
              el.style.transformOrigin = '';
              el.style.fontSize = '';
              el.removeAttribute('data-shrunk');
            });
            return;
          }
          document.querySelectorAll('.editorial-display').forEach(function (el) {
            // Kendi inline 3D perspektifi olan kartlara dokunma
            if (el.closest('[style*="perspective"]')) return;
            // Önceki state'i sıfırla — taze ölçüm için
            if (el.dataset.shrunk) {
              el.style.transform = '';
              el.style.transformOrigin = '';
              el.style.fontSize = '';
            }
            var overflow = el.scrollWidth - el.clientWidth;
            if (overflow > 2 && el.clientWidth > 0) {
              // cos(angle) = ratio → bu açıda 3D rotateY uygulanan kutunun görünür projeksiyonu container'a tam sığar
              var ratio = el.clientWidth / el.scrollWidth;
              var safeRatio = Math.max(0.55, ratio * 0.97);  // floor 55% → max ~56° rotation (aşırı distortion engelle)
              var angleDeg = Math.acos(safeRatio) * 180 / Math.PI;
              el.style.transform = 'perspective(1100px) rotateY(' + angleDeg.toFixed(2) + 'deg)';
              el.style.transformOrigin = 'left center';
              el.dataset.shrunk = '1';
            } else if (el.dataset.shrunk) {
              el.removeAttribute('data-shrunk');
            }
          });
        }
        var rTimer;
        function schedule() {
          clearTimeout(rTimer);
          rTimer = setTimeout(fitDisplayText, 120);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fitDisplayText);
        } else {
          fitDisplayText();
        }
        window.addEventListener('resize', schedule);
        window.addEventListener('orientationchange', schedule);
      })();
    </script>

