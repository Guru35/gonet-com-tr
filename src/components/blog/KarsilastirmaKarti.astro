---
interface Satir {
  sol: string;
  sag: string;
}

interface Props {
  baslik: string;
  solBaslik: string;
  sagBaslik: string;
  satirlar: Satir[];
}

const { baslik, solBaslik, sagBaslik, satirlar } = Astro.props;
const headingId = `karsilastirma-karti-${baslik.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 24)}`;
---

{satirlar && satirlar.length > 0 && (
  <figure
    class="blog-viz my-12 lg:my-14 border border-[var(--border)] bg-[var(--surface)] text-[var(--text)]"
    aria-labelledby={headingId}
  >
    <figcaption
      id={headingId}
      class="px-6 py-4 lg:px-8 border-b border-[var(--border)] flex flex-wrap items-baseline justify-between gap-3"
    >
      <span class="editorial-display text-xl lg:text-2xl leading-tight text-[var(--text-heading)]">
        {baslik}
      </span>
      <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-[var(--text-secondary)]">
        Karşılaştırma
      </span>
    </figcaption>

    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[var(--border)]">
      <div class="p-6 lg:p-8 bg-[var(--surface-2)]">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-[var(--text-secondary)] pb-3 mb-4 border-b border-[var(--border)]">
          {solBaslik}
        </p>
        <ul class="space-y-4">
          {satirlar.map((satir) => (
            <li class="flex items-start gap-3 text-sm lg:text-base leading-relaxed text-[var(--text-secondary)]">
              <span class="font-bold shrink-0 mt-0.5" aria-hidden="true">—</span>
              <span>{satir.sol}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="p-6 lg:p-8 border-t-4 md:border-t-0 md:border-l-0" style="border-top-color: #ff0000;">
        <p
          class="text-xs font-bold uppercase tracking-[0.22em] pb-3 mb-4 border-b border-[var(--border)]"
          style="color: var(--accent-strong);"
        >
          {sagBaslik}
        </p>
        <ul class="space-y-4">
          {satirlar.map((satir) => (
            <li class="flex items-start gap-3 text-sm lg:text-base leading-relaxed font-medium text-[var(--text-heading)]">
              <span class="font-bold shrink-0 mt-0.5" style="color: var(--accent-strong);" aria-hidden="true">→</span>
              <span>{satir.sag}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </figure>
)}
