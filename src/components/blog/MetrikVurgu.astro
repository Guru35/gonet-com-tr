---
interface Metrik {
  deger: string;
  etiket: string;
  kaynak?: string;
}

interface Props {
  baslik?: string;
  metrikler: Metrik[];
}

const { baslik, metrikler } = Astro.props;
const colsClass =
  metrikler.length === 1
    ? 'grid-cols-1'
    : metrikler.length === 2
      ? 'grid-cols-1 md:grid-cols-2'
      : 'grid-cols-1 md:grid-cols-3';
---

{metrikler && metrikler.length > 0 && (
  <figure class="blog-viz my-12 lg:my-14 border border-[var(--border)] bg-[var(--surface)] text-[var(--text)]">
    {baslik && (
      <figcaption class="px-6 py-4 lg:px-8 border-b border-[var(--border)] flex flex-wrap items-baseline justify-between gap-3">
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-[var(--text-heading)]">
          {baslik}
        </span>
        <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-secondary)]">
          Ölçülen Kanıt
        </span>
      </figcaption>
    )}
    <dl class={`grid ${colsClass} divide-y md:divide-y-0 md:divide-x divide-[var(--border)]`}>
      {metrikler.map((m) => (
        <div class="p-6 lg:p-8 flex flex-col justify-between gap-3">
          <dd
            class="editorial-display text-4xl lg:text-5xl leading-none"
            style="color: var(--accent-strong);"
          >
            {m.deger}
          </dd>
          <dt class="text-sm lg:text-base font-medium leading-snug text-[var(--text-heading)]">
            {m.etiket}
          </dt>
          {m.kaynak && (
            <p class="text-[11px] uppercase tracking-[0.16em] text-[var(--text-secondary)] pt-2 border-t border-[var(--border)]">
              {m.kaynak}
            </p>
          )}
        </div>
      ))}
    </dl>
  </figure>
)}
