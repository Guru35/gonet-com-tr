---
import {
  navigasyonGetir,
  yolDiliniBul,
  yolAktifMi,
  kokAktifMi,
  karsitDilBilgisi,
  type Dil,
  type NavKok,
} from '../../data/navigasyon';

interface Props {
  lang?: 'tr' | 'en';
  transparentHeader?: boolean;
  kulupSayfasi?: boolean;
  currentPath: string;
  alternateEnHref?: string;
  alternateTrHref?: string;
}

const {
  lang,
  transparentHeader = false,
  kulupSayfasi = false,
  currentPath,
  alternateEnHref,
  alternateTrHref,
} = Astro.props;

const aktifDil: Dil = lang ?? yolDiliniBul(currentPath);
const paket = navigasyonGetir(aktifDil);
const karsitDil = karsitDilBilgisi(currentPath, aktifDil, alternateEnHref, alternateTrHref);

const logoHref = aktifDil === 'en' ? '/en' : '/';
const ctaCerceveli =
  'items-center justify-center min-h-[44px] box-border border border-current bg-transparent text-black hover:bg-black hover:text-white transition-colors font-semibold uppercase text-[11px]';
const ctaDolu =
  'items-center justify-center min-h-[44px] box-border bg-accent-600 text-[#000000] hover:bg-black hover:text-white transition-colors font-semibold uppercase text-[11px]';

function altGrupSutunSinifi(kok: NavKok): string {
  if (kok.gruplar.length >= 2) {
    return 'grid grid-cols-1 xl:grid-cols-2 gap-8';
  }
  return 'grid grid-cols-1 gap-6';
}

function ogeListeSinifi(kok: NavKok): string {
  if (kok.gruplar.length === 1 && (kok.gruplar[0]?.ogeler.length ?? 0) > 3) {
    return 'grid grid-cols-1 xl:grid-cols-2 gap-x-6 gap-y-1';
  }
  return 'space-y-1';
}
---

<header
  id="site-header"
  data-transparent={transparentHeader ? 'true' : undefined}
  class={`site-header-root z-50 ${
    transparentHeader
      ? 'absolute top-0 left-0 right-0 bg-transparent text-black transition-colors'
      : 'relative bg-white text-black'
  }`}
  {...(kulupSayfasi ? { 'data-theme': 'dark' } : {})}
>
  <nav
    class="max-w-7xl mx-auto px-3 sm:px-4 md:px-6 lg:px-8 xl:px-10 py-2.5 md:py-3.5 flex items-center justify-between gap-2 lg:gap-3"
    aria-label={paket.etiketler.anaNavAria}
  >
    <a
      href={logoHref}
      id="site-logo"
      class="editorial-display inline-flex items-center min-h-[44px] text-[26px] sm:text-[28px] md:text-3xl xl:text-4xl text-black leading-none shrink-0"
      aria-label={paket.etiketler.logoAria}
    >
      Gonet
    </a>

    <!-- Masaüstü (lg:) 5 Ebeveyn + Swiss Editöryel Mega Panel -->
    <ul class="hidden lg:flex items-center gap-1 xl:gap-3 text-[11px] font-medium uppercase tracking-[0.14em] xl:tracking-[0.2em]">
      {paket.kokler.map((kok) => {
        const kokAktif = kokAktifMi(currentPath, kok);
        const dogrudanAktif = yolAktifMi(currentPath, kok.href);
        const panelId = `mega-panel-${kok.id}`;

        if (!kok.megaMenuVar) {
          return (
            <li class="static">
              <a
                href={kok.href}
                class={`inline-flex items-center min-h-[44px] px-2.5 xl:px-3 transition-colors whitespace-nowrap ${
                  kokAktif
                    ? 'bg-black text-white border-b-2 border-b-accent-600'
                    : 'text-black hover:bg-black hover:text-white'
                }`}
                {...(dogrudanAktif ? { 'aria-current': 'page' } : {})}
              >
                {kok.label}
              </a>
            </li>
          );
        }

        return (
          <li class="static" data-mega-item={kok.id}>
            <button
              type="button"
              id={`mega-trigger-${kok.id}`}
              data-mega-trigger={kok.id}
              aria-expanded="false"
              aria-controls={panelId}
              class={`mega-trigger inline-flex items-center gap-1.5 min-h-[44px] px-2.5 xl:px-3 text-[11px] font-medium uppercase tracking-[0.14em] xl:tracking-[0.2em] transition-colors whitespace-nowrap cursor-pointer ${
                kokAktif
                  ? 'bg-black text-white border-b-2 border-b-accent-600'
                  : 'text-black hover:bg-black hover:text-white'
              }`}
            >
              <span>{kok.label}</span>
              <svg
                class="mega-chevron shrink-0 transition-transform duration-150"
                width="10"
                height="10"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M2.5 4.5L6 8l3.5-3.5" />
              </svg>
            </button>

            <div
              id={panelId}
              data-mega-panel={kok.id}
              aria-labelledby={`mega-trigger-${kok.id}`}
              hidden
              class="mega-panel absolute left-0 right-0 top-full z-50 border-y border-black bg-white text-black shadow-none max-h-[calc(100dvh-5rem)] overflow-y-auto"
            >
              <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-10 py-8">
                <div class="grid grid-cols-12 gap-0 border border-black">
                  <!-- Sol Kolon: Numara, Başlık, Editöryel Özet ve Ana Sayfa Linki -->
                  <div class="col-span-3 p-6 border-r border-black flex flex-col justify-between gap-6">
                    <div>
                      <p
                        class="text-4xl xl:text-5xl font-light leading-none tracking-tight mb-4"
                        style="font-variant-numeric: tabular-nums; color: var(--accent-text);"
                      >
                        {kok.numara}
                      </p>
                      <p class="text-lg font-semibold tracking-tight text-black mb-2 normal-case">
                        {kok.label}
                      </p>
                      <p class="text-xs leading-relaxed text-slate-600 normal-case tracking-normal">
                        {kok.ozet}
                      </p>
                    </div>
                    <div>
                      <a
                        href={kok.href}
                        class="inline-flex items-center min-h-[44px] px-3 -mx-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors"
                        {...(dogrudanAktif ? { 'aria-current': 'page' } : {})}
                      >
                        {kok.tumunuGorEtiket}
                      </a>
                    </div>
                  </div>

                  <!-- Orta Kolonlar: Alt Gruplar ve Sayfa Bağlantıları -->
                  <div class="col-span-6 p-6 border-r border-black">
                    <div class={altGrupSutunSinifi(kok)}>
                      {kok.gruplar.map((grup) => (
                        <div>
                          <p class="text-[10px] font-semibold uppercase tracking-[0.25em] pb-2 mb-3 border-b border-black text-slate-600">
                            {grup.baslik}
                          </p>
                          <ul class={ogeListeSinifi(kok)}>
                            {grup.ogeler.map((oge) => {
                              const ogeAktif = yolAktifMi(currentPath, oge.href, oge.aktifEkYollar);
                              return (
                                <li>
                                  <a
                                    href={oge.href}
                                    class={`group flex flex-col justify-center min-h-[44px] px-3 py-2 border-l-2 transition-colors normal-case tracking-normal ${
                                      ogeAktif
                                        ? 'border-l-accent-600 bg-brand-50 text-black'
                                        : 'border-l-transparent hover:border-l-black hover:bg-brand-50 text-black'
                                    }`}
                                    {...(ogeAktif ? { 'aria-current': 'page' } : {})}
                                  >
                                    <span class="flex items-center justify-between gap-2 text-sm font-semibold leading-snug">
                                      <span>{oge.label}</span>
                                      {oge.rozet && (
                                        <span
                                          class={`shrink-0 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.15em] ${
                                            oge.oneCikan
                                              ? 'bg-accent-600 text-[#000000]'
                                              : 'border border-black text-black'
                                          }`}
                                        >
                                          {oge.rozet}
                                        </span>
                                      )}
                                    </span>
                                    <span class="text-xs text-slate-600 leading-snug mt-0.5">
                                      {oge.aciklama}
                                    </span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- Sağ Kolon: Editöryel Vurgu Kutusu (SEO & AEO Analizi + Teklif Al) -->
                  <div class="col-span-3 p-6 bg-brand-50 flex flex-col justify-between gap-5 normal-case tracking-normal">
                    <div>
                      <p
                        class="text-[10px] font-semibold uppercase tracking-[0.25em] mb-3"
                        style="color: var(--accent-text);"
                      >
                        {paket.etiketler.megaMenuVurguBaslik}
                      </p>
                      <a
                        href={paket.aksiyonlar.seoAnaliz.href}
                        class="flex flex-col justify-center min-h-[44px] p-3 border border-black bg-white text-black hover:bg-black hover:text-white transition-colors group"
                        {...(yolAktifMi(currentPath, paket.aksiyonlar.seoAnaliz.href)
                          ? { 'aria-current': 'page' }
                          : {})}
                      >
                        <span class="flex items-center justify-between gap-2 text-sm font-semibold leading-snug">
                          <span>{paket.aksiyonlar.seoAnaliz.label}</span>
                          {paket.aksiyonlar.seoAnaliz.rozet && (
                            <span class="shrink-0 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.15em] bg-accent-600 text-[#000000]">
                              {paket.aksiyonlar.seoAnaliz.rozet}
                            </span>
                          )}
                        </span>
                        <span class="text-xs text-slate-600 group-hover:text-white/80 leading-snug mt-1">
                          {paket.aksiyonlar.seoAnaliz.aciklama}
                        </span>
                      </a>
                    </div>

                    <div class="pt-3 border-t border-black">
                      <a
                        href={paket.aksiyonlar.teklif.href}
                        class="inline-flex items-center justify-between w-full min-h-[44px] px-4 bg-accent-600 text-[#000000] hover:bg-black hover:text-white transition-colors text-[11px] font-semibold uppercase tracking-[0.2em]"
                        {...(yolAktifMi(currentPath, paket.aksiyonlar.teklif.href)
                          ? { 'aria-current': 'page' }
                          : {})}
                      >
                        <span>{paket.aksiyonlar.teklif.label}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>

    <!-- Sağ Aksiyonlar: TR/EN Geçiş + Tema + Merhaba + Görüşme İsteyin + Mobil Menü -->
    <div class="flex items-center gap-1.5 sm:gap-2 md:gap-2.5 shrink-0">
      <a
        href={karsitDil.href}
        lang={karsitDil.hedefDil}
        hreflang={karsitDil.hedefDil}
        aria-label={karsitDil.ariaLabel}
        class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-2 border border-black bg-transparent text-black hover:bg-black hover:text-white transition-colors text-[11px] font-semibold uppercase tracking-[0.18em] shrink-0"
      >
        {karsitDil.kisaEtiket}
      </a>

      {!kulupSayfasi && (
        <button
          type="button"
          id="theme-toggle"
          aria-label={paket.etiketler.temaDegistirAria}
          class="hidden md:inline-flex items-center justify-center w-11 h-11 min-h-[44px] border border-black hover:bg-black hover:text-white transition-colors shrink-0 cursor-pointer"
        >
          <svg
            class="theme-icon-moon"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg
            class="theme-icon-sun"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      )}

      <a
        href={paket.aksiyonlar.merhaba.href}
        class={`hidden md:inline-flex ${ctaCerceveli} px-3.5 xl:px-5 tracking-[0.18em] xl:tracking-[0.25em] whitespace-nowrap shrink-0 ${
          kulupSayfasi ? 'border-b-2 border-b-accent-600' : ''
        }`}
        {...(kulupSayfasi ? { 'aria-current': 'page' } : {})}
      >
        {paket.aksiyonlar.merhaba.label} <span aria-hidden="true">&nbsp;→</span>
      </a>

      <a
        href={paket.aksiyonlar.gorusme.href}
        class={`inline-flex ${
          kulupSayfasi ? `${ctaCerceveli} px-2` : `${ctaDolu} px-2`
        } md:px-3.5 xl:px-5 tracking-[0.14em] md:tracking-[0.18em] xl:tracking-[0.25em] whitespace-nowrap shrink-0`}
      >
        {aktifDil === 'tr' ? (
          <span>
            Görüşme<span class="max-[360px]:sr-only"> isteyin</span>
          </span>
        ) : (
          <span>
            Book<span class="max-[360px]:sr-only"> a Call</span>
          </span>
        )}
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label={paket.etiketler.hizliGezAria}
        aria-controls="eye-menu"
        aria-expanded="false"
        class="lg:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] text-[11px] font-semibold uppercase tracking-[0.16em] px-2.5 sm:px-3 py-2 border border-current text-black hover:bg-black hover:text-white transition-colors shrink-0 cursor-pointer"
      >
        {paket.etiketler.mobilMenuDugmesi}
      </button>
    </div>
  </nav>

  <!-- Alt çizgi — sol kenardan başlar, logo "Gonet" sağ kenarında biter -->
  <div id="header-line" class="absolute bottom-0 left-0 h-px bg-black pointer-events-none" style="width:0"></div>
</header>

<style>
  .mega-panel[hidden] {
    display: none !important;
  }

  /* Fare geçiş köprüsü: üst tetikleyici buton ile panel arası boşluğu kapatır */
  .mega-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 28px;
  }

  .mega-trigger[aria-expanded='true'] .mega-chevron {
    transform: rotate(180deg);
  }

  /* Şeffaf header aktifken mega menü açılınca tam opak yüzey */
  #site-header[data-mega-open='true'],
  #site-header:has(.mega-panel:not([hidden])) {
    background-color: var(--bg);
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 1023px) {
    .mega-panel {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-chevron,
    .site-header-root,
    .mega-panel {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    // 1. Logo alt çizgisi (#header-line) konumlama
    function updateHeaderLine() {
      var logo = document.getElementById('site-logo');
      var line = document.getElementById('header-line');
      if (!logo || !line) return;
      var r = logo.getBoundingClientRect();
      line.style.width = r.right + 'px';
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateHeaderLine);
    } else {
      updateHeaderLine();
    }
    window.addEventListener('resize', updateHeaderLine);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(updateHeaderLine);
    }

    // 2. Swiss Editöryel Mega Menü — hover-intent (120ms), klavye, Escape ve dışarı tıklama
    var header = document.getElementById('site-header');
    if (!header || header.dataset.megaBound) return;
    header.dataset.megaBound = '1';

    var items = Array.prototype.slice.call(header.querySelectorAll('[data-mega-item]'));
    if (!items.length) return;

    var openId = null;
    var openMode = null; // 'hover' | 'click'
    var openedAt = 0;
    var openTimer = null;
    var closeTimer = null;
    var canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
    var desktopMq = window.matchMedia ? window.matchMedia('(min-width: 1024px)') : null;

    function clearTimers() {
      if (openTimer) {
        clearTimeout(openTimer);
        openTimer = null;
      }
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    function getParts(id) {
      var item = header.querySelector('[data-mega-item="' + id + '"]');
      if (!item) return null;
      return {
        item: item,
        trigger: item.querySelector('[data-mega-trigger="' + id + '"]'),
        panel: item.querySelector('[data-mega-panel="' + id + '"]'),
      };
    }

    function closeAll(restoreFocus) {
      clearTimers();
      var prevId = openId;
      for (var i = 0; i < items.length; i++) {
        var id = items[i].getAttribute('data-mega-item');
        var parts = getParts(id);
        if (!parts) continue;
        if (parts.panel) parts.panel.hidden = true;
        if (parts.trigger) parts.trigger.setAttribute('aria-expanded', 'false');
      }
      openId = null;
      openMode = null;
      header.removeAttribute('data-mega-open');

      if (restoreFocus && prevId) {
        var prevParts = getParts(prevId);
        if (prevParts && prevParts.trigger) {
          prevParts.trigger.focus();
        }
      }
    }

    function openPanel(id, mode) {
      if (desktopMq && !desktopMq.matches) return;
      clearTimers();
      if (openId && openId !== id) {
        var prev = getParts(openId);
        if (prev) {
          if (prev.panel) prev.panel.hidden = true;
          if (prev.trigger) prev.trigger.setAttribute('aria-expanded', 'false');
        }
      }
      var parts = getParts(id);
      if (!parts || !parts.panel || !parts.trigger) return;
      parts.panel.hidden = false;
      parts.trigger.setAttribute('aria-expanded', 'true');
      openId = id;
      openMode = mode;
      openedAt = Date.now();
      header.setAttribute('data-mega-open', 'true');
    }

    items.forEach(function (item) {
      var id = item.getAttribute('data-mega-item');
      var trigger = item.querySelector('[data-mega-trigger]');
      var panel = item.querySelector('[data-mega-panel]');
      if (!id || !trigger || !panel) return;

      trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        var isAlreadyOpen = openId === id && !panel.hidden;
        if (isAlreadyOpen) {
          // Hover-intent ile yeni açılmışsa tıklama paneli sabitler; aksi halde kapatır
          if (openMode === 'hover' && e.detail > 0 && Date.now() - openedAt < 350) {
            openMode = 'click';
            return;
          }
          closeAll(false);
        } else {
          openPanel(id, 'click');
        }
      });

      item.addEventListener('pointerenter', function (e) {
        if (!canHover || e.pointerType === 'touch') return;
        if (desktopMq && !desktopMq.matches) return;
        clearTimers();
        if (openId === id && !panel.hidden) return;
        openTimer = setTimeout(function () {
          openPanel(id, 'hover');
        }, 120);
      });

      item.addEventListener('pointerleave', function (e) {
        if (!canHover || e.pointerType === 'touch') return;
        if (openTimer) {
          clearTimeout(openTimer);
          openTimer = null;
        }
        if (openId !== id) return;
        closeTimer = setTimeout(function () {
          if (openId === id) {
            closeAll(false);
          }
        }, 120);
      });

      item.addEventListener('focusout', function (e) {
        if (openId !== id) return;
        var next = e.relatedTarget;
        if (next && item.contains(next)) return;
        closeAll(false);
      });
    });

    document.addEventListener('click', function (e) {
      if (!openId) return;
      var parts = getParts(openId);
      if (parts && parts.item.contains(e.target)) return;
      closeAll(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && openId) {
        e.preventDefault();
        closeAll(true);
      }
    });

    if (desktopMq && desktopMq.addEventListener) {
      desktopMq.addEventListener('change', function (e) {
        if (!e.matches && openId) {
          closeAll(false);
        }
      });
    }
  })();
</script>
