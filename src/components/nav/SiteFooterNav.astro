---
import {
  dilDegistirHref,
  navigasyonGetir,
  yolAktifMi,
  yolDiliniBul,
  type Dil,
} from '../../data/navigasyon';

interface Props {
  lang?: Dil;
  currentPath?: string;
  kulupSayfasi?: boolean;
  hideFooter?: boolean;
  kimMetni?: string;
  alternateEnHref?: string;
  alternateTrHref?: string;
}

const {
  lang,
  currentPath = Astro.url.pathname,
  kulupSayfasi = false,
  hideFooter = false,
  kimMetni: kimMetniProp,
  alternateEnHref,
  alternateTrHref,
} = Astro.props;

const aktifDil: Dil = lang ?? yolDiliniBul(currentPath);
const paket = navigasyonGetir(aktifDil);
const { etiketler, kokler, rastgeleSayfalar } = paket;

const trHref = dilDegistirHref(currentPath, 'tr', alternateTrHref);
const enHref = dilDegistirHref(currentPath, 'en', alternateEnHref);
const rastgeleSayfalarJson = JSON.stringify(rastgeleSayfalar);

const varsayilanKimMetni =
  aktifDil === 'en'
    ? "Izmir-based hybrid Creative AI agency (1 human founder + 27 specialized AI agents), active in digital since 2000. Certified Google partner between 2005–2017 (now Google Partner). IRD member. DEPARK resident."
    : "2000'den beri dijitalde, İzmir merkezli hibrit Creative AI ajansı (1 kurucu insan + 27 uzman AI ajanı). 2005–2017 arasında Google'ın ajans programlarında sertifikalı iş ortağıydık (bugünkü adıyla Google Partner). IRD üyesi. DEPARK mukimi.";

const kimMetni = kimMetniProp ?? varsayilanKimMetni;

const adresSatirlari =
  aktifDil === 'en'
    ? ['Adatepe Mah.', 'DEU Tinaztepe Campus', 'Buca / Izmir, Turkey']
    : ['Adatepe Mah.', 'DEÜ Tınaztepe Kampüsü', 'Buca / İzmir'];

const telifMetni =
  aktifDil === 'en'
    ? `© ${new Date().getFullYear()} Gonet — Gonet is in every work.`
    : `© ${new Date().getFullYear()} Gonet — Her iş'te Gonet var.`;

const donemMetni =
  aktifDil === 'en' ? '2000 → 2026 / 26 years / 190+ brands' : '2000 → 2026 / 26 yıl / 190+ marka';
---

{!hideFooter && (
<footer id="site-footer" class="bg-white text-black border-t border-black" {...(kulupSayfasi ? { 'data-theme': 'dark' } : {})}>
  <!-- Massive wordmark band -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-20 pb-6">
    <a
      href={aktifDil === 'en' ? '/en' : '/'}
      id="footer-wordmark"
      data-random-pages={rastgeleSayfalarJson}
      class="footer-wordmark editorial-display block text-[22vw] lg:text-[22vw] xl:text-[320px] leading-[0.85] text-black cursor-pointer whitespace-nowrap -mx-6 lg:-mx-10 px-6 lg:px-10"
      aria-label={etiketler.altBilgiWordmarkAria}
    >
      Gonet
    </a>
    <script is:inline>
      (function () {
        const wm = document.getElementById('footer-wordmark');
        if (!wm) return;
        let pages = ['/', '/uzmanlik', '/case-studies', '/hakkimizda', '/ekibimiz', '/ik', '/iletisim'];
        try {
          const parsed = JSON.parse(wm.getAttribute('data-random-pages') || '[]');
          if (Array.isArray(parsed) && parsed.length > 0) pages = parsed;
        } catch (e) {}
        wm.addEventListener('click', (e) => {
          e.preventDefault();
          const here = window.location.pathname;
          const candidates = pages.filter((p) => p !== here);
          const target = candidates[Math.floor(Math.random() * candidates.length)] || pages[0];
          window.location.href = target;
        });
      })();
    </script>
  </div>

  <!-- Üst meta şerit: Kim · İletişim · Sosyal -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 grid md:grid-cols-12 gap-8 border-t border-black">
    <div class="md:col-span-4">
      <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3">{etiketler.altBilgiKimBaslik}</p>
      <p class="text-sm leading-snug">
        {kimMetni}
      </p>
      <p class="text-[11px] text-slate-600 mt-3 leading-relaxed">
        Pigme Proje ve İş Geliştirme Merkezi Yazılım A.Ş.
      </p>
    </div>

    <div class="md:col-span-4">
      <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3">{etiketler.altBilgiIletisimBaslik}</p>
      <ul class="space-y-2 text-sm">
        <li>
          <a href="mailto:gonet@gonet.com.tr" class="underline decoration-2 underline-offset-4 hover:bg-black hover:text-white transition-colors">
            gonet@gonet.com.tr
          </a>
        </li>
        <li class="flex flex-wrap gap-x-4 md:flex-col md:items-start md:gap-y-2">
          <a href="tel:+902324650015" class="inline-flex items-center min-h-[44px] md:min-h-0 text-black hover:underline">
            +90 232 465 00 15
          </a>
          <a href="tel:+902324634649" class="inline-flex items-center min-h-[44px] md:min-h-0 text-black hover:underline">
            +90 232 463 46 49
          </a>
        </li>
        {adresSatirlari.map((satir) => (
          <li class="text-slate-600">{satir}</li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-4">
      <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3">{etiketler.altBilgiSosyalBaslik}</p>
      <ul class="space-y-2 text-sm">
        <li><a href="https://www.linkedin.com/in/gokhankazanci/" target="_blank" rel="noopener noreferrer" class="hover:bg-black hover:text-white transition-colors">LinkedIn / Kazancı (16K)</a></li>
        <li><a href="https://www.behance.net/GonetCompany" target="_blank" rel="noopener noreferrer" class="hover:bg-black hover:text-white transition-colors">Behance / GonetCompany</a></li>
        <li><a href="https://www.instagram.com/gonetinteractive/" target="_blank" rel="noopener noreferrer" class="hover:bg-black hover:text-white transition-colors">Instagram / gonetinteractive</a></li>
        <li><a href="https://www.facebook.com/GonetCompany/" target="_blank" rel="noopener noreferrer" class="hover:bg-black hover:text-white transition-colors">Facebook / GonetCompany</a></li>
        <li><a href="https://www.slideshare.net/gonetpigme" target="_blank" rel="noopener noreferrer" class="hover:bg-black hover:text-white transition-colors">SlideShare / gonetpigme</a></li>
      </ul>
    </div>
  </div>

  <!-- Gez: navigasyon.ts ebeveyn gruplarıyla tam uyumlu 5 sütunlu dizin -->
  <nav aria-label={etiketler.altBilgiGezBaslik} class="max-w-7xl mx-auto px-6 lg:px-10 py-10 border-t border-slate-200">
    <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-6">{etiketler.altBilgiGezBaslik}</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
      {kokler.map((kok) => {
        const ogeler = kok.gruplar.flatMap((grup) => grup.ogeler);
        return (
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] pb-2 mb-3 border-b border-slate-200 flex items-baseline gap-2">
              <span class="text-accent-aa tabular-nums">{kok.numara}</span>
              <span>{kok.label}</span>
            </p>
            <ul class="space-y-1.5 text-sm">
              {ogeler.map((oge) => {
                const aktif = yolAktifMi(currentPath, oge.href, oge.aktifEkYollar);
                return (
                  <li>
                    <a
                      href={oge.href}
                      class={`inline-block px-1 py-0.5 transition-colors ${
                        aktif
                          ? 'bg-black text-white font-semibold'
                          : 'hover:bg-black hover:text-white'
                      }`}
                      {...(aktif ? { 'aria-current': 'page' } : {})}
                    >
                      {oge.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
  </nav>

  <!-- Copyright + slogan + dil + çerez satırı -->
  <div class="border-t border-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 sm:pr-28 lg:pr-28 py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-[10px] uppercase tracking-[0.25em] font-medium">
      <span>{telifMetni}</span>
      <span class="text-slate-600">{donemMetni}</span>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5">
          <a
            href={trHref}
            lang="tr"
            class={`inline-flex items-center min-h-[44px] sm:min-h-0 px-2 sm:px-1 py-0.5 ${aktifDil === 'tr' ? 'underline decoration-2 underline-offset-4 font-bold' : 'hover:bg-black hover:text-white transition-colors'}`}
            {...(aktifDil === 'tr' ? { 'aria-current': 'page' } : {})}
          >
            TR
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={enHref}
            lang="en"
            class={`inline-flex items-center min-h-[44px] sm:min-h-0 px-2 sm:px-1 py-0.5 ${aktifDil === 'en' ? 'underline decoration-2 underline-offset-4 font-bold' : 'hover:bg-black hover:text-white transition-colors'}`}
            {...(aktifDil === 'en' ? { 'aria-current': 'page' } : {})}
          >
            EN
          </a>
        </span>
        <button
          type="button"
          id="cerez-ayarlari"
          class="underline self-start sm:self-auto min-h-[44px] sm:min-h-0 text-left uppercase tracking-[0.25em] font-medium hover:text-[#ff0000]"
        >
          {etiketler.altBilgiCerezDugmesi}
        </button>
      </div>
    </div>
  </div>
</footer>
)}
