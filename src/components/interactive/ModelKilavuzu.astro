</section>

<style is:global>
/* Model Kılavuzu — self-contained token'lar (koyu tema flip). Global çünkü
   bileşen içeriği prose dışında; site token sistemine paralel ama bağımsız. */
.mk{
  --mk-white:#ffffff; --mk-ink:#000000; --mk-near:#171717;
  --mk-g1:#262626; --mk-g2:#525252; --mk-g3:#8a8a8a; --mk-g4:#d4d4d4;
  --mk-g5:#e5e5e5; --mk-g6:#f5f5f5; --mk-red:#ff0000;
  font-family:var(--font-sans,'Inter',sans-serif); line-height:1.5; color:var(--mk-ink);
}
[data-theme="dark"] .mk{
  --mk-white:#161616; --mk-ink:#e6e6e6; --mk-near:#000000;
  --mk-g1:#d0d0d0; --mk-g2:#b3b3b3; --mk-g3:#8a8a8a; --mk-g4:#3a3a3a;
  --mk-g5:#2a2a2a; --mk-g6:#1d1d1d;
}
.mk *{box-sizing:border-box}
.mk code{font-size:11px;color:var(--mk-g2);font-family:'Courier New',monospace}

/* sektör barı */
.mk-sectorbar{position:sticky;top:52px;z-index:30;background:var(--mk-white);border-bottom:1px solid var(--mk-g5);padding:12px 0;margin-bottom:4px}
.mk-sectorbar-inner{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.mk-sectorbar-label{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mk-g3);flex-shrink:0}
.mk-chips{display:flex;flex-wrap:wrap;gap:6px}
.mk-chip{font-family:inherit;font-size:12px;font-weight:600;padding:6px 13px;border:1px solid var(--mk-g4);background:var(--mk-white);color:var(--mk-g2);cursor:pointer;transition:all .15s;white-space:nowrap}
.mk-chip:hover{border-color:var(--mk-ink);color:var(--mk-ink)}
.mk-chip.on{background:var(--mk-ink);color:var(--mk-white);border-color:var(--mk-ink)}
.mk-chip-diger{border-style:dashed;border-color:var(--mk-red);color:var(--mk-red)}
.mk-chip-diger.on{background:var(--mk-red);color:#fff;border-color:var(--mk-red)}

/* top head */
.mk-tophead{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:28px 0 0}
.mk-verify{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mk-g2)}
.mk-vtick{color:var(--mk-red);font-size:12px}
.mk-seg-group{display:inline-flex;border:1px solid var(--mk-g4)}
.mk-seg{font-family:inherit;padding:0 14px;height:32px;font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mk-g3);background:var(--mk-white);border:none;cursor:pointer;transition:all .15s;white-space:nowrap}
.mk-seg+.mk-seg{border-left:1px solid var(--mk-g4)}
.mk-seg.on{background:var(--mk-ink);color:var(--mk-white)}
.mk-seg:hover:not(.on){color:var(--mk-ink)}

/* diğer form */
.mk-diger-panel{margin-top:24px;border:1px solid var(--mk-g4);background:var(--mk-g6)}
.mk-diger-inner{padding:28px 24px}
.mk-diger-title{font-size:18px;font-weight:700;margin-bottom:8px}
.mk-diger-desc{font-size:13px;color:var(--mk-g2);line-height:1.6;margin-bottom:20px;max-width:620px}
.mk-diger-form{display:flex;flex-direction:column;gap:16px;max-width:520px}
.mk-field{display:flex;flex-direction:column;gap:5px}
.mk-field-l{font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--mk-g3)}
.mk-field input{font-family:inherit;font-size:14px;padding:11px 13px;border:1px solid var(--mk-g4);background:var(--mk-white);color:var(--mk-ink)}
.mk-field input:focus{outline:2px solid var(--mk-red);outline-offset:-1px}
.mk-consent{display:flex;gap:9px;align-items:flex-start;font-size:12px;color:var(--mk-g2);line-height:1.5}
.mk-consent input{margin-top:2px;flex-shrink:0}
.mk-consent a{color:var(--mk-red);text-decoration:underline}
.mk-diger-submit{font-family:inherit;font-size:13px;font-weight:600;padding:12px 20px;background:var(--mk-red);color:#fff;border:none;cursor:pointer;align-self:flex-start;transition:background .15s}
.mk-diger-submit:hover{background:var(--mk-ink)}
.mk-diger-status{font-size:13px;line-height:1.5;padding:12px 14px;background:var(--mk-white);border-left:3px solid var(--mk-red);color:var(--mk-ink)}

/* view */
.mk-view{display:none}
.mk-view.active{display:block}
.mk-view-label{padding:36px 0 0;font-size:11px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--mk-g3)}

/* model section */
.mk-model-section{padding:56px 0;border-bottom:1px solid var(--mk-g5)}
.mk-model-header{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;padding-bottom:24px;border-bottom:1px solid var(--mk-g5)}
.mk-model-num{font-size:11px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--mk-g3);margin-bottom:6px}
.mk-model-name{font-size:40px;font-weight:900;letter-spacing:-.03em;line-height:1;margin-bottom:8px}
.mk-model-desc{font-size:14px;color:var(--mk-g2)}
.mk-model-id{font-size:11px;color:var(--mk-g3);font-family:'Courier New',monospace;text-align:right;flex-shrink:0}
.mk-eff{font-size:10px;color:var(--mk-g3)}
.mk-alert{background:var(--mk-g6);border-left:3px solid var(--mk-g4);padding:12px 16px;margin-top:1px;font-size:12px;color:var(--mk-g2);line-height:1.5}
.mk-alert strong{color:var(--mk-ink);font-weight:600}

/* card grid */
.mk-card-grid{display:grid;gap:1px;background:var(--mk-g5);margin-top:1px}
.mk-card-grid.g1{grid-template-columns:1fr}
.mk-card-grid.g2{grid-template-columns:repeat(2,1fr)}
.mk-card{background:var(--mk-white);padding:26px 22px 30px;border-top:3px solid transparent;position:relative}
.mk-card.ideal{border-top-color:var(--mk-ink)}
.mk-card.ok{border-top-color:var(--mk-g4)}
.mk-card.avoid{border-top-color:var(--mk-g6);background:var(--mk-g6)}
.mk-card.cc-card{border-top-color:var(--mk-ink);background:var(--mk-near)}
.mk-card.cc-card .mk-effort-name,.mk-card.cc-card .mk-tok-v{color:#e8e8e8}
.mk-card.cc-card .mk-effort-lv,.mk-card.cc-card .mk-effort-en,.mk-card.cc-card .mk-note,.mk-card.cc-card .task-list li{color:#a3a3a3}
.mk-card.cc-card .task-list li::before{color:#666}

.mk-card-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
.mk-effort{flex:1}
.mk-effort-lv{font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--mk-g3);margin-bottom:3px}
.mk-effort-name{font-size:18px;font-weight:700;line-height:1.1}
.mk-effort-en{font-size:13px;font-weight:400;color:var(--mk-g3)}
.mk-card.avoid .mk-effort-name{color:var(--mk-g2)}
.mk-badge{font-size:9px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:4px 8px;flex-shrink:0;margin-left:12px;white-space:nowrap}
.b-ideal{background:var(--mk-red);color:#fff}
.b-ok{border:1px solid var(--mk-ink);color:var(--mk-ink)}
.b-lim{border:1px solid var(--mk-g3);color:var(--mk-g3)}
.b-avoid{border:1px solid var(--mk-g4);color:var(--mk-g3)}
.b-cc{background:var(--mk-g1);color:var(--mk-g6);font-size:9px}

.mk-compat{height:2px;background:var(--mk-g6);margin-bottom:18px}
.mk-compat-fill{height:2px}
.ideal .mk-compat-fill{background:var(--mk-ink)}
.ok .mk-compat-fill{background:var(--mk-g3)}
.avoid .mk-compat-fill{background:var(--mk-g5)}
.cc-card .mk-compat{background:var(--mk-g1)} .cc-card .mk-compat-fill{background:var(--mk-g3)}

.mk-tasks{margin-bottom:0}
.task-list{list-style:none;margin-bottom:18px;padding:0}
.task-list li{font-size:13px;color:var(--mk-g2);line-height:1.6;display:flex;align-items:baseline;gap:9px}
.task-list li::before{content:'—';color:var(--mk-g4);flex-shrink:0;font-size:10px}
.task-list li.ex-label{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mk-red);margin-bottom:4px}
.task-list li.ex-label::before{content:'';width:0;margin:0}
.mk-card.avoid .task-list li{color:var(--mk-g3)}
.mk-note{font-size:12px;color:var(--mk-g3);font-style:italic;margin-bottom:16px;line-height:1.5}
.mk-ccnote{display:inline-flex;font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#a3a3a3;padding:3px 7px;border:1px solid var(--mk-g2);margin-bottom:14px}

.mk-thinking{border-top:1px solid var(--mk-g5);padding:14px 0 0}
.cc-card .mk-thinking{border-top-color:var(--mk-g2)}
.mk-thinking-hd{font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--mk-g4);margin-bottom:8px}
.mk-thinking-always{font-size:12px;color:var(--mk-g2);line-height:1.5}
.mk-thinking-no{font-size:12px;color:var(--mk-g4);font-style:italic;line-height:1.5}
.mk-thinking-row{display:flex;gap:10px;margin-bottom:5px;align-items:flex-start}
.mk-tk{font-size:9px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;flex-shrink:0;width:46px;display:flex;align-items:center;gap:3px}
.mk-tk.ton{color:var(--mk-ink)} .mk-tk.toff{color:var(--mk-g3)}
.mk-tcheck{color:var(--mk-red);font-size:10px}
.mk-tv{font-size:12px;color:var(--mk-g2);line-height:1.5}

/* token economy */
.mk-cost-ladder{padding:30px 0 6px;display:flex;flex-direction:column;gap:13px}
.mk-cl-row{display:flex;align-items:center;gap:16px}
.mk-cl-name{width:72px;font-size:14px;font-weight:700;flex-shrink:0}
.mk-cl-track{flex:1;height:8px;background:var(--mk-g6)}
.mk-cl-bar{height:8px;background:var(--mk-ink)}
.mk-cl-tag{width:auto;font-size:11px;color:var(--mk-g3);text-align:right;flex-shrink:0}
.mk-cost-row{display:flex;align-items:center;gap:12px;margin-bottom:18px}
.mk-cr-label{font-size:9px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--mk-g3);flex-shrink:0}
.mk-cr-track{flex:1;height:4px;background:var(--mk-g6)} .mk-cr-fill{height:4px;background:var(--mk-ink)}
.mk-tok{margin-bottom:14px}
.mk-tok-k{font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-bottom:4px;color:var(--mk-ink)}
.mk-tok-v{font-size:13px;color:var(--mk-g2);line-height:1.55}

/* diğer sektörler */
.mk-extra-sectors{padding-top:8px}
.mk-extra-list{list-style:none;padding:0;margin-top:18px;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}

/* footer */
.mk-footer{padding:48px 0 8px}
.mk-rules{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;padding-bottom:36px;border-bottom:1px solid var(--mk-g5);margin-bottom:28px}
.mk-rule strong{display:block;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:5px;color:var(--mk-ink)}
.mk-rule p{font-size:12px;color:var(--mk-g2);line-height:1.6}
.mk-sources-title{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mk-g3);margin-bottom:16px;display:flex;align-items:center;gap:8px}
.mk-sources-list{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:14px 32px;counter-reset:fs}
.mk-sources-list li{font-size:12px;line-height:1.5;padding-left:24px;position:relative;counter-increment:fs}
.mk-sources-list li::before{content:counter(fs,decimal-leading-zero);position:absolute;left:0;top:1px;font-size:10px;font-weight:700;color:var(--mk-g4)}
.mk-sources-list a{color:var(--mk-ink);text-decoration:none;font-weight:600;border-bottom:1px solid var(--mk-g4)}
.mk-sources-list a:hover{border-bottom-color:var(--mk-ink)}
.mk-sources-list span{display:block;color:var(--mk-g3);font-weight:400;margin-top:3px;font-size:11px}

@media (max-width:820px){
  .mk-card-grid.g2{grid-template-columns:1fr}
  .mk-model-name{font-size:32px}
  .mk-rules{grid-template-columns:repeat(2,1fr)}
  .mk-sources-list,.mk-extra-list{grid-template-columns:1fr}
  .mk-sectorbar{top:0}
}
@media (max-width:520px){
  .mk-model-header{flex-direction:column;align-items:flex-start}
  .mk-model-id{text-align:left}
  .mk-tophead{align-items:flex-start;flex-direction:column}
}
</style>

<script is:inline>
(function(){
  var root=document.querySelector('[data-mk-root]'); if(!root) return;
  var KNOWN=Array.prototype.map.call(root.querySelectorAll('.mk-chip[data-sektor]'),function(c){return c.getAttribute('data-sektor');});

  // view toggle
  var segs=root.querySelectorAll('.mk-seg');
  var panels=root.querySelectorAll('[data-view-panel]');
  function setView(v){
    segs.forEach(function(s){s.classList.toggle('on',s.getAttribute('data-view')===v);});
    panels.forEach(function(p){var on=p.getAttribute('data-view-panel')===v;p.classList.toggle('active',on);p.hidden=!on;});
  }
  segs.forEach(function(s){s.addEventListener('click',function(){setView(this.getAttribute('data-view'));});});

  // sektör seçici (JS varsa göster)
  var bar=root.querySelector('[data-mk-sectorbar]'); if(bar) bar.hidden=false;
  var diger=root.querySelector('[data-mk-diger]');
  var chips=root.querySelectorAll('.mk-chip');
  function applySector(sec){
    root.querySelectorAll('.mk-tasks').forEach(function(box){
      var lists=box.querySelectorAll('.task-list');
      var hasVariant=box.querySelector('.task-list[data-sektor="'+sec+'"]');
      lists.forEach(function(ul){
        var s=ul.getAttribute('data-sektor');
        ul.hidden = hasVariant ? (s!==sec) : (s!=='genel');
      });
    });
    chips.forEach(function(c){var on=c.getAttribute('data-sektor')===sec;c.classList.toggle('on',on);c.setAttribute('aria-selected',on?'true':'false');});
    if(diger) diger.hidden = (sec!=='diger');
    if(sec!=='diger'){ try{localStorage.setItem('gonet-mk-sektor',sec);}catch(e){}
      try{var u=new URL(window.location);u.searchParams.set('sektor',sec);history.replaceState({},'',u);}catch(e){} }
  }
  chips.forEach(function(c){c.addEventListener('click',function(){applySector(this.getAttribute('data-sektor'));});});

  // başlangıç: ?sektor= veya localStorage
  var init='genel';
  try{var q=new URL(window.location).searchParams.get('sektor'); if(q&&KNOWN.indexOf(q)>=0) init=q;
      else{var ls=localStorage.getItem('gonet-mk-sektor'); if(ls&&KNOWN.indexOf(ls)>=0) init=ls;}}catch(e){}
  if(init!=='genel') applySector(init);

  // diğer form → engine API (capture; üretim+yayın panelden onaylanır)
  var form=root.querySelector('[data-mk-diger-form]');
  if(form){form.addEventListener('submit',function(e){
    e.preventDefault();
    var st=root.querySelector('[data-mk-diger-status]');
    var btn=form.querySelector('.mk-diger-submit');
    function show(msg){ if(st){st.hidden=false;st.textContent=msg;} }
    var payload={
      sektor:(form.sektor.value||'').trim(),
      email:(form.email.value||'').trim(),
      phone:form.phone?(form.phone.value||'').trim():'',
      wants_sms:form.wants_sms?form.wants_sms.checked:false,
      kvkk:form.kvkk.checked
    };
    btn.disabled=true;btn.textContent='Gönderiliyor…';
    fetch('https://engine.gonet.com.tr/api/sector-request',{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)
    }).then(function(r){return r.json().then(function(d){return{ok:r.ok,d:d};});})
    .then(function(res){
      if(res.ok&&res.d&&res.d.ok){
        show(res.d.message||'Talebiniz alındı. Sektörünüze özel örnekleri e-posta ile göndereceğiz.');
        var ins=form.querySelectorAll('input');for(var i=0;i<ins.length;i++)ins[i].disabled=true;
        btn.textContent='Talebiniz alındı ✓';
      }else{
        show((res.d&&res.d.message)||'Bir sorun oluştu, lütfen tekrar deneyin.');
        btn.disabled=false;btn.textContent='Örneklerimi hazırlayın →';
      }
    }).catch(function(){
      show('Bağlantı hatası. Lütfen birazdan tekrar deneyin.');
      btn.disabled=false;btn.textContent='Örneklerimi hazırlayın →';
    });
  });}
})();
</script>
