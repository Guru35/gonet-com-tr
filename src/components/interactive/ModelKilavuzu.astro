---
/**
 * Model Kılavuzu — interaktif blog bileşeni.
 * v2 HTML taslağından port edildi; renkler --mk-* self-contained token'lara
 * çevrildi (koyu tema otomatik flip). Sektöre uyarlanan görev listeleri
 * MKTaskList ile data-driven; geri kalan içerik sabit.
 *
 * AEO: tüm sektör varyantları sunucuda HTML'de. JS yalnızca görünürlük + view.
 */
import { SECTORS, EXAMPLES } from '../../data/model-kilavuzu';
import ekData from '../../data/model-kilavuzu-ek-sektorler.json';
import MKTaskList from './MKTaskList.astro';
import JsonLd from '../JsonLd.astro';
import { faqSchema } from '../../lib/schema';

// "Diğer" ile gelip onaylanan ek sektörler (engine ekler). Base sektörlerle merge.
const extraSectors = (ekData?.sektorler ?? []).filter((s: any) => s?.id && s?.examples);
const allSectors = [
  ...SECTORS,
  ...extraSectors.map((s: any) => ({ id: s.id, label: s.label, short: s.short || s.label })),
];
// Her kart için base örnekler + ek sektörlerin örneklerini birleştir.
const mergedExamples: Record<string, Record<string, string[]>> = {};
for (const cardId of Object.keys(EXAMPLES)) {
  mergedExamples[cardId] = { ...EXAMPLES[cardId] };
  for (const es of extraSectors) {
    if (es.examples?.[cardId]) mergedExamples[cardId][es.id] = es.examples[cardId];
  }
}

const faqItems = [
  {
    question: 'Hangi Claude modelini seçmeliyim?',
    answer:
      'Emin değilseniz Sonnet · Medium ile başlayın. İş basitse Haiku’ya inin, kritik ve geri alınamaz bir kararsa Opus’a çıkın, kullanıcıya gidecek bir metinse Fable kullanın. Hem yetenek hem maliyet açısından varsayılan başlangıç Sonnet’tir.',
  },
  {
    question: 'Thinking (düşünme) modu nedir?',
    answer:
      'Claude’un adım adım muhakeme sürecini görünür kıldığı moddur. Web arayüzünde effort dropdown’ı, Claude Code’da /effort komutu, API’de output_config.effort ile kontrol edilir. Fable 5’te Thinking her zaman aktiftir ve kapatılamaz.',
  },
  {
    question: 'Effort seviyesi (Low, Medium, High, Max) ne işe yarar?',
    answer:
      'Effort, modelin bir göreve ne kadar derin düşüneceğini ve ne kadar token harcayacağını belirler. Düşük effort hızlı ve ucuzdur; yüksek effort daha derin muhakeme ve daha fazla token demektir. Önce düşük effort’la deneyip gerekiyorsa kademeli yükseltmek en ekonomik yaklaşımdır.',
  },
  {
    question: 'Ultracode nedir?',
    answer:
      'Ultracode, Claude Code’a özgü bir oturum modudur: en yüksek effort (xHigh) seviyesini açar ve paralel çok-ajanlı orkestrasyona (Dynamic Workflows) izin verir. Web arayüzünde bulunmaz. Büyük, bölünebilir görevlerde işi hızlandırır ama token tüketimini ajan sayısıyla çarpar.',
  },
  {
    question: 'Bu kılavuzdaki bilgiler güvenilir mi?',
    answer:
      'Evet. Tüm model ve effort bilgileri Anthropic’in dört ayrı resmî kaynağından (Claude Code dokümantasyonu, Effort parametresi, Extended Thinking dokümanı ve resmî duyuru) doğrulanmıştır. Kaynaklar yazının sonundaki Kaynakça bölümünde listelenmiştir.',
  },
];
---

<section class="mk" data-mk-root>
  <!-- ── SEKTÖR SEÇİCİ (JS açar; no-JS = genel içerik) ── -->
  <div class="mk-sectorbar" hidden data-mk-sectorbar>
    <div class="mk-sectorbar-inner">
      <span class="mk-sectorbar-label">Sektörünüz:</span>
      <div class="mk-chips" role="tablist" aria-label="Sektör seçimi">
        {allSectors.map((s) => (
          <button
            class:list={['mk-chip', { on: s.id === 'genel' }]}
            data-sektor={s.id}
            role="tab"
            aria-selected={s.id === 'genel' ? 'true' : 'false'}
          >{s.short}</button>
        ))}
        <button class="mk-chip mk-chip-diger" data-sektor="diger" aria-selected="false">+ Diğer</button>
      </div>
    </div>
  </div>

  <!-- ── HERO doğrulama rozeti + view toggle ── -->
  <div class="mk-tophead">
    <div class="mk-verify"><span class="mk-vtick">✓</span>Veriler dört ayrı resmî kaynaktan doğrulanmıştır</div>
    <div class="mk-seg-group" role="tablist" aria-label="Görünüm">
      <button class="mk-seg on" data-view="capability">Yetenek</button>
      <button class="mk-seg" data-view="token">Token Ekonomisi</button>
    </div>
  </div>

  <!-- ── "Diğer" sektör formu (chip ile açılır) ── -->
  <div class="mk-diger-panel" hidden data-mk-diger>
    <div class="mk-diger-inner">
      <p class="mk-diger-title">Sektörünüz listede yok mu?</p>
      <p class="mk-diger-desc">Sektörünüzü bir cümleyle anlatın; örnekleri yapay zekâ ile sizin işinize göre hazırlayıp <b>e-posta ile gönderelim</b>. Onaylandığında bu kılavuzun altındaki <b>“Diğer sektörler”</b> bölümüne de eklenir.</p>
      <form class="mk-diger-form" data-mk-diger-form>
        <label class="mk-field">
          <span class="mk-field-l">Sektörünüz / işiniz</span>
          <input type="text" name="sektor" maxlength="120" required placeholder="Örn. Veteriner kliniği işletiyorum" />
        </label>
        <label class="mk-field">
          <span class="mk-field-l">E-posta adresiniz</span>
          <input type="email" name="email" required placeholder="ornek@firma.com" />
        </label>
        <label class="mk-field">
          <span class="mk-field-l">Telefon <span style="text-transform:none;font-weight:400;color:var(--mk-g3)">(isteğe bağlı — SMS bildirimi çok yakında)</span></span>
          <input type="tel" name="phone" maxlength="20" placeholder="05xx xxx xx xx" />
        </label>
        <label class="mk-consent">
          <input type="checkbox" name="wants_sms" />
          <span>Hazır olduğunda SMS olarak da almak isterim. <em style="color:var(--mk-g3)">(SMS hattı çok yakında aktifleşecek; şimdilik e-posta ile gönderiyoruz.)</em></span>
        </label>
        <label class="mk-consent">
          <input type="checkbox" name="kvkk" required />
          <span>Örnek listemin hazırlanıp e-posta/SMS ile gönderilmesi için iletişim bilgimin işlenmesine onay veriyorum. <a href="/kvkk" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a></span>
        </label>
        <button type="submit" class="mk-diger-submit">Örneklerimi hazırlayın →</button>
        <p class="mk-diger-status" data-mk-diger-status hidden></p>
      </form>
    </div>
  </div>

  <!-- ════════ VIEW A — YETENEK ════════ -->
  <div class="mk-view active" data-view-panel="capability">
    <div class="mk-view-label">Yetenek Kılavuzu — hangi model neyi iyi yapar</div>

    <!-- 01 FABLE -->
    <section class="mk-model-section" id="mk-cap-fable">
      <div class="mk-model-header">
        <div>
          <div class="mk-model-num">01 — Model</div>
          <div class="mk-model-name">Fable</div>
          <div class="mk-model-desc">Metin ustası — etkilemek, iz bırakmak için yazar</div>
        </div>
        <div class="mk-model-id">claude-fable-5<br /><span class="mk-eff">effort: Low · Medium · High · Extra · Max · Ultracode</span></div>
      </div>
      <div class="mk-alert"><strong>Fable 5’te Thinking her zaman aktiftir.</strong> Devre dışı bırakılamaz; effort yükseldikçe Thinking derinliği de artar.</div>

      <div class="mk-card-grid g2">
        <!-- F1 Hızlı/Low -->
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Hızlı <span class="mk-effort-en">· Low</span></div></div><span class="mk-badge b-lim">Taslak</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:48%"></div></div>
          <ul class="task-list"><li>Küçük kopya revizyonu</li><li>Buton veya etiket metni değişikliği</li><li>Hızlı başlık alternatifi üret</li></ul>
          <div class="mk-note">Hız odaklı; ton tutarlılığı ikincil planda kalır. İşlevsel taslaklar için yeterli.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">Aktif, minimum düzey. Fable hafif düşünür ama ton değerlendirmesi kısadır.</div></div>
        </div>
        <!-- F2 Standart/Medium -->
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Standart <span class="mk-effort-en">· Medium</span></div></div><span class="mk-badge b-ok">Yapabilir</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:62%"></div></div>
          <ul class="task-list"><li>Ürün açıklamaları, özellik tanımları</li><li>Push bildirimi ve in-app mesaj</li><li>Kullanıcı hikayesi (user story) yazımı</li></ul>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">Orta düzey aktif. Tonun bağlamla uyumunu kontrol eder; standart görevler için yeterli.</div></div>
        </div>
        <!-- F3 Özgün/High İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Özgün <span class="mk-effort-en">· High</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:95%"></div></div>
          <MKTaskList cardId="f-high" cardExamples={mergedExamples["f-high"]} sectors={allSectors} />
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">Ton, bağlam ve marka sesini bilinçli dengeler; en uygun alternatifleri üretir. Bu seviye Fable’ın tatlı noktasıdır.</div></div>
        </div>
        <!-- F4 Derin Anlatı/Extra İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Derin Anlatı <span class="mk-effort-en">· Extra</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:95%"></div></div>
          <MKTaskList cardId="f-extra" cardExamples={mergedExamples["f-extra"]} sectors={allSectors} />
          <div class="mk-note">API parametresi: <code>effort: "xhigh"</code></div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">Uzun formlarda yapı ve mesaj hiyerarşisini önceden planlar. Ton tutarlılığı metin boyunca korunur.</div></div>
        </div>
        <!-- F5 Max İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Maksimum <span class="mk-effort-en">· Max</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:93%"></div></div>
          <MKTaskList cardId="f-max" cardExamples={mergedExamples["f-max"]} sectors={allSectors} />
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">En derin yaratıcı değerlendirme. Token kısıtı yok; tüm ton ve ses alternatifleri değerlendirilir.</div></div>
        </div>
        <!-- F6 Ultracode -->
        <div class="mk-card cc-card">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Mod</div><div class="mk-effort-name">Ultracode <span class="mk-effort-en">· xHigh + Çok Ajanlı</span></div></div><span class="mk-badge b-cc">Claude Code</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:100%"></div></div>
          <div class="mk-ccnote">Yalnızca Claude Code · Web arayüzünde yok</div>
          <ul class="task-list"><li>Paralel ajanlarda toplu içerik üretimi</li><li>Büyük içerik kütüphanesi — iş yükü bölüştürülür</li><li>Çok kanallı kampanya materyali — eş zamanlı</li></ul>
          <div class="mk-note">Ultracode effort seviyesi değildir; xHigh’ı ayarlar + Dynamic Workflow iznini açar. Prompt’a "ultracode" yazarak etkinleştirilir.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">Fable 5’te Thinking zaten her zaman aktiftir. Ultracode xHigh’ı tetiklediğinden derinlik otomatik maksimuma çıkar.</div></div>
        </div>
      </div>
    </section>

    <!-- 02 OPUS -->
    <section class="mk-model-section" id="mk-cap-opus">
      <div class="mk-model-header">
        <div>
          <div class="mk-model-num">02 — Model</div>
          <div class="mk-model-name">Opus</div>
          <div class="mk-model-desc">Ağır kaldırıcı — hata affedilmez olduğunda</div>
        </div>
        <div class="mk-model-id">claude-opus-4-8<br /><span class="mk-eff">effort: Low · Medium · High · Extra · Max · Ultracode</span></div>
      </div>

      <div class="mk-card-grid g2">
        <!-- O1 Low avoid -->
        <div class="mk-card avoid">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Hızlı <span class="mk-effort-en">· Low</span></div></div><span class="mk-badge b-avoid">Pahalıya Gelir</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:20%"></div></div>
          <ul class="task-list"><li>Git işlemleri → Haiku</li><li>Kısa notlar, şablon → Sonnet</li><li>Sonnet takılırsa buraya taşı</li></ul>
          <div class="mk-note">Low’da Opus, Sonnet’ten pahalı ama daha iyi değil. Kaçış yolu olarak kullan, kural değil.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk toff"><span class="mk-tcheck">✓</span>Kapalı</span><span class="mk-tv">Low’da Thinking otomatik atlanır; maliyeti artırma.</span></div></div>
        </div>
        <!-- O2 Medium ok -->
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Standart <span class="mk-effort-en">· Medium</span></div></div><span class="mk-badge b-ok">Yapabilir</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:52%"></div></div>
          <ul class="task-list"><li>Büyük refactor (Sonnet yetmezse)</li><li>Karmaşık state yönetimi</li><li>Çok dosyalı bağımlılık düzenleme</li></ul>
          <div class="mk-note">Sonnet Medium ile başla; yetmezse buraya taşı.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">Büyük refactorda sistematik plan çıkarır; dosyalar arası tutarlılığı sağlar.</span></div></div>
        </div>
        <!-- O3 High İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Derin <span class="mk-effort-en">· High</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:95%"></div></div>
          <MKTaskList cardId="o-high" cardExamples={mergedExamples["o-high"]} sectors={allSectors} />
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">Derin analizin standart kullanımı — alternatifleri ve ödünleşimleri adım adım değerlendirir.</span></div></div>
        </div>
        <!-- O4 Extra İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Uzun Görev <span class="mk-effort-en">· Extra</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:97%"></div></div>
          <MKTaskList cardId="o-extra" cardExamples={mergedExamples["o-extra"]} sectors={allSectors} />
          <div class="mk-note">API parametresi: <code>effort: "xhigh"</code></div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">xHigh bu seviye için tasarlandı — Thinking’siz çalıştırmak kapasitesini kısıtlar.</span></div></div>
        </div>
        <!-- O5 Max İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Maksimum <span class="mk-effort-en">· Max</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:97%"></div></div>
          <MKTaskList cardId="o-max" cardExamples={mergedExamples["o-max"]} sectors={allSectors} />
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">Max + Thinking: en güçlü kombinasyon. Token kısıtı yok — en derin muhakeme bu noktada gerçekleşir.</span></div></div>
        </div>
        <!-- O6 Ultracode -->
        <div class="mk-card cc-card">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Mod</div><div class="mk-effort-name">Ultracode <span class="mk-effort-en">· xHigh + Çok Ajanlı</span></div></div><span class="mk-badge b-cc">Claude Code</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:100%"></div></div>
          <div class="mk-ccnote">Yalnızca Claude Code · Web arayüzünde yok</div>
          <ul class="task-list"><li>Paralel alt-ajan orkestrasyonu (Dynamic Workflows)</li><li>Büyük ölçek codebase taraması — bölüşülmüş iş yükü</li><li>Kapsamlı kod/güvenlik denetimi — çok ajanlı</li></ul>
          <div class="mk-note">Ultracode effort seviyesi değildir; xHigh’ı ayarlar + Dynamic Workflow iznini açar.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-always">Ultracode xHigh effort’unu içerdiğinden Thinking otomatik aktiftir.</div></div>
        </div>
      </div>
    </section>

    <!-- 03 SONNET -->
    <section class="mk-model-section" id="mk-cap-sonnet">
      <div class="mk-model-header">
        <div>
          <div class="mk-model-num">03 — Model</div>
          <div class="mk-model-name">Sonnet</div>
          <div class="mk-model-desc">Günlük iş atı — işlerin %80’i burada çözülür</div>
        </div>
        <div class="mk-model-id">claude-sonnet-4-6<br /><span class="mk-eff">effort: Low · Medium · High · Max</span></div>
      </div>

      <div class="mk-card-grid g2">
        <!-- S1 Low İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Hızlı <span class="mk-effort-en">· Low</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:90%"></div></div>
          <MKTaskList cardId="s-low" cardExamples={mergedExamples["s-low"]} sectors={allSectors} />
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk toff"><span class="mk-tcheck">✓</span>Kapalı</span><span class="mk-tv">Low’da Thinking zaten atlanır; basit işlere değer katmaz.</span></div></div>
        </div>
        <!-- S2 Medium İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Standart <span class="mk-effort-en">· Medium</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:97%"></div></div>
          <MKTaskList cardId="s-medium" cardExamples={mergedExamples["s-medium"]} sectors={allSectors} />
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">Yaklaşım belirsizse veya edge case’ler kritikse açık; alternatifleri karşılaştırır.</span></div></div>
        </div>
        <!-- S3 High İDEAL -->
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Derin <span class="mk-effort-en">· High</span></div></div><span class="mk-badge b-ideal">İdeal</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:93%"></div></div>
          <MKTaskList cardId="s-high" cardExamples={mergedExamples["s-high"]} sectors={allSectors} />
          <div class="mk-note">Geri dönülemez ve kritik kararlarda Opus tercih et — Sonnet High güçlüdür ama Opus kadar derin değildir.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">Karmaşık hata ayıklama ve yol ayrımında işe yarar; adım adım alternatifleri listeler.</span></div></div>
        </div>
        <!-- S4 Max ok -->
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Maksimum <span class="mk-effort-en">· Max</span></div></div><span class="mk-badge b-ok">Yapabilir</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:70%"></div></div>
          <ul class="task-list"><li>En zorlu çok-dosyalı hata ayıklama</li><li>Mimari taslak — Opus incelemesi öncesi</li><li>Kapsamlı test stratejisi tasarımı</li></ul>
          <div class="mk-note">Sonnet’in tavanı. Buraya sık geliyorsan görev muhtemelen Opus işidir.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-row"><span class="mk-tk ton"><span class="mk-tcheck">✓</span>Açık</span><span class="mk-tv">Max’ta Thinking’in tam kapasitesi açılır; en derin Sonnet muhakemesi burada gerçekleşir.</span></div></div>
        </div>
      </div>
    </section>

    <!-- 04 HAIKU -->
    <section class="mk-model-section" id="mk-cap-haiku">
      <div class="mk-model-header">
        <div>
          <div class="mk-model-num">04 — Model</div>
          <div class="mk-model-name">Haiku</div>
          <div class="mk-model-desc">Cevabı belli işler için — karar yok, eylem var</div>
        </div>
        <div class="mk-model-id">claude-haiku-4-5<br /><span class="mk-eff">effort seçeneği yok · Thinking desteklenmez</span></div>
      </div>
      <div class="mk-alert"><strong>Effort seçeneği bu modelde yok.</strong> Haiku tek modda çalışır; claude.ai veya Claude Code’da effort dropdown görünmez.</div>

      <div class="mk-card-grid g1">
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Effort</div><div class="mk-effort-name">Tek Mod <span class="mk-effort-en">· sabit</span></div></div><span class="mk-badge b-ideal">İdeal: Basit İşler</span></div>
          <div class="mk-compat"><div class="mk-compat-fill" style="width:95%"></div></div>
          <MKTaskList cardId="h-tek" cardExamples={mergedExamples["h-tek"]} sectors={allSectors} />
          <div class="mk-note">Sınırları bil: derin analiz → Opus · yaratıcı metin → Fable. Haiku bu işlerde yanlış yanıt verir, fark etmez, devam eder.</div>
          <div class="mk-thinking"><div class="mk-thinking-hd">Thinking</div><div class="mk-thinking-no">Bu modelde Thinking desteklenmez.</div></div>
        </div>
      </div>
    </section>
  </div>

  <!-- ════════ VIEW B — TOKEN EKONOMİSİ ════════ -->
  <div class="mk-view" data-view-panel="token" hidden>
    <div class="mk-view-label">Token Ekonomisi — hangi token nerede feda edilir</div>
    <div class="mk-cost-ladder">
      <div class="mk-cl-row"><span class="mk-cl-name">Haiku</span><div class="mk-cl-track"><div class="mk-cl-bar" style="width:12%"></div></div><span class="mk-cl-tag">en düşük maliyet</span></div>
      <div class="mk-cl-row"><span class="mk-cl-name">Sonnet</span><div class="mk-cl-track"><div class="mk-cl-bar" style="width:35%"></div></div><span class="mk-cl-tag">orta — en iyi değer/oran</span></div>
      <div class="mk-cl-row"><span class="mk-cl-name">Fable</span><div class="mk-cl-track"><div class="mk-cl-bar" style="width:68%"></div></div><span class="mk-cl-tag">premium · yaratıcı taban</span></div>
      <div class="mk-cl-row"><span class="mk-cl-name">Opus</span><div class="mk-cl-track"><div class="mk-cl-bar" style="width:95%"></div></div><span class="mk-cl-tag">en yüksek maliyet</span></div>
    </div>

    <section class="mk-model-section" id="mk-tok-fable">
      <div class="mk-model-header"><div><div class="mk-model-num">01 — Token Profili</div><div class="mk-model-name">Fable</div><div class="mk-model-desc">Yaratıcı taban — Thinking sürekli açık, her çağrı bir taban öder</div></div><div class="mk-model-id">claude-fable-5</div></div>
      <div class="mk-card-grid g2">
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Token profili</div><div class="mk-effort-name">Fable <span class="mk-effort-en">· premium</span></div></div><span class="mk-badge b-lim">Premium</span></div>
          <div class="mk-cost-row"><span class="mk-cr-label">Görece maliyet</span><div class="mk-cr-track"><div class="mk-cr-fill" style="width:68%"></div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">↓ Tasarruf et</div><div class="mk-tok-v">Taslağı Low’da ürettir, sonra elle cilala. İskeleti al, üstüne sen koy.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Harcamaya değer</div><div class="mk-tok-v">Lansman kopyası, mağaza açıklaması — bir kez yazılır, binlerce kişi okur. Token feda etmek en ucuz yatırımdır.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">× Token tuzağı</div><div class="mk-tok-v">Kod veya teknik analizi Fable’a yaptırmak: hem yanlış çıkar hem sürekli açık Thinking tabanı boşa yanar.</div></div>
        </div>
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Anahtar kural</div><div class="mk-effort-name">Taban maliyet</div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">≡ Thinking kapatılamaz</div><div class="mk-tok-v">Fable 5’te kısa işlerde bile düşünme-token tabanı ödersin; mikro işleri Haiku/Sonnet’e bırak.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Effort = uzunluk</div><div class="mk-tok-v">Low → Max yükseldikçe alternatif ve derinlik (token) artar. Maliyeti effort ile yönet.</div></div>
        </div>
      </div>
    </section>

    <section class="mk-model-section" id="mk-tok-opus">
      <div class="mk-model-header"><div><div class="mk-model-num">02 — Token Profili</div><div class="mk-model-name">Opus</div><div class="mk-model-desc">En pahalı model — her token Sonnet’in katı, doğru yerde harca</div></div><div class="mk-model-id">claude-opus-4-8</div></div>
      <div class="mk-card-grid g2">
        <div class="mk-card avoid">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Token profili</div><div class="mk-effort-name">Opus <span class="mk-effort-en">· en yüksek</span></div></div><span class="mk-badge b-lim">En Pahalı</span></div>
          <div class="mk-cost-row"><span class="mk-cr-label">Görece maliyet</span><div class="mk-cr-track"><div class="mk-cr-fill" style="width:95%"></div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">↓ Tasarruf et</div><div class="mk-tok-v">Low/Medium işleri Opus’a verme — Sonnet aynısını maliyetin kesirine yapar.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Harcamaya değer</div><div class="mk-tok-v">Geri alınamaz mimari / güvenlik kararı. Yanlış kararın maliyeti, en yüksek token faturasından kat kat büyüktür.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">× Token tuzağı</div><div class="mk-tok-v">Ultracode’da paralel ajanlar token tüketimini çarpar (N ajan ≈ N kat). Küçük işte açma.</div></div>
        </div>
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Anahtar kural</div><div class="mk-effort-name">Pahalı ama haklı</div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Yüksek effort = yatırım</div><div class="mk-tok-v">Opus’un değeri High/Extra/Max’ta ortaya çıkar. Düşük effort’ta ya yüksek aç ya Sonnet’e in.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">≡ İnsan saati > token</div><div class="mk-tok-v">Kritik kararda doğru cevabı bir kerede almak, ucuz modelde defalarca yanılmaktan toplamda daha ucuzdur.</div></div>
        </div>
      </div>
    </section>

    <section class="mk-model-section" id="mk-tok-sonnet">
      <div class="mk-model-header"><div><div class="mk-model-num">03 — Token Profili</div><div class="mk-model-name">Sonnet</div><div class="mk-model-desc">Ekonominin merkezi — en iyi token/değer oranı</div></div><div class="mk-model-id">claude-sonnet-4-6</div></div>
      <div class="mk-card-grid g2">
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Token profili</div><div class="mk-effort-name">Sonnet <span class="mk-effort-en">· en iyi oran</span></div></div><span class="mk-badge b-ideal">En İyi Değer</span></div>
          <div class="mk-cost-row"><span class="mk-cr-label">Görece maliyet</span><div class="mk-cr-track"><div class="mk-cr-fill" style="width:35%"></div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">↓ Tasarruf et</div><div class="mk-tok-v">High thinking’i her işte açma; Low/Medium işlerin çoğunu çözer. Varsayılanı düşük tut.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Harcamaya değer</div><div class="mk-tok-v">Karmaşık debug’da High + Thinking. Fazladan token, saatlerce elle hata ayıklamadan çok ucuza patlar.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">× Token tuzağı</div><div class="mk-tok-v">Sonnet’te tıkanıp aynı işi tekrar denemek. Üç-dört turdan sonra tek Opus çağrısı toplamda ucuzdur.</div></div>
        </div>
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Anahtar kural</div><div class="mk-effort-name">Varsayılan başlangıç</div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">≡ Önce buradan başla</div><div class="mk-tok-v">İşlerin %80’i Sonnet’te en düşük toplam maliyetle biter. Sapmayı ancak görev zorlarsa yap.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Effort’u kademeli aç</div><div class="mk-tok-v">Low → Medium → High. Doğrudan Max açmak çoğu işte gereksiz token harcar.</div></div>
        </div>
      </div>
    </section>

    <section class="mk-model-section" id="mk-tok-haiku">
      <div class="mk-model-header"><div><div class="mk-model-num">04 — Token Profili</div><div class="mk-model-name">Haiku</div><div class="mk-model-desc">En ucuz — Thinking yok, düşünme-token maliyeti sıfır</div></div><div class="mk-model-id">claude-haiku-4-5</div></div>
      <div class="mk-card-grid g2">
        <div class="mk-card ideal">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Token profili</div><div class="mk-effort-name">Haiku <span class="mk-effort-en">· en düşük</span></div></div><span class="mk-badge b-ok">En Ucuz</span></div>
          <div class="mk-cost-row"><span class="mk-cr-label">Görece maliyet</span><div class="mk-cr-track"><div class="mk-cr-fill" style="width:12%"></div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">↓ Tasarruf et</div><div class="mk-tok-v">Yüksek hacimli basit işler: toplu commit, etiketleme, dosya işlemleri. Birim maliyet dipte.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">↑ Harcamaya değer</div><div class="mk-tok-v">Hacim. Bin küçük işi Haiku’ya dağıt — aynı işi Opus’a vermek yüzlerce kat fazlaya mal olur.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">× Token tuzağı</div><div class="mk-tok-v">Derin işi Haiku’ya vermek: yanlış çıkar → düzeltme turu → toplam iki kat token.</div></div>
        </div>
        <div class="mk-card ok">
          <div class="mk-card-head"><div class="mk-effort"><div class="mk-effort-lv">Anahtar kural</div><div class="mk-effort-name">Hacim modeli</div></div></div>
          <div class="mk-tok"><div class="mk-tok-k">≡ Thinking yok = ek maliyet yok</div><div class="mk-tok-v">Haiku düşünme-token üretmez. Maliyet yalnızca girdi + çıktıdır; tekrarlı basit işlerde rakipsizdir.</div></div>
          <div class="mk-tok"><div class="mk-tok-k">× Sınırı zorlama</div><div class="mk-tok-v">Karar, analiz, yaratıcı metin Haiku’nun işi değil. Zorlarsan düzeltme maliyeti tasarrufu siler.</div></div>
        </div>
      </div>
    </section>
  </div>

  <!-- ── DİĞER SEKTÖRLER (engine onayladıkça büyür) ── -->
  {extraSectors.length > 0 && (
    <div class="mk-extra-sectors">
      <div class="mk-view-label">Diğer sektörler — okuyucularımızın talebiyle eklendi</div>
      <ul class="mk-extra-list">
        {extraSectors.map((s: any) => (
          <li><button class="mk-chip" data-sektor={s.id}>{s.label}</button></li>
        ))}
      </ul>
    </div>
  )}

  <!-- ── FOOTER kuralları + KAYNAKÇA ── -->
  <div class="mk-footer">
    <div class="mk-rules">
      <div class="mk-rule"><strong>Emin değilsen</strong><p>Sonnet · Medium ile başla. Basit işse Haiku’ya in, kritikse Opus’a çık. Varsayılan başlangıç Sonnet’tir.</p></div>
      <div class="mk-rule"><strong>Thinking nedir?</strong><p>Claude’un adım adım muhakemesini görünür kıldığı mod. Web’de effort dropdown, Claude Code’da /effort. API: output_config.effort</p></div>
      <div class="mk-rule"><strong>Token altın kuralı</strong><p>Hata maliyeti yüksekse token feda et (Opus). İş tekrar ediyor ve basitse token kıs (Haiku).</p></div>
      <div class="mk-rule"><strong>Ultracode nedir?</strong><p>Claude Code’a özgü oturum modu: xHigh effort + paralel çok-ajanlı orkestrasyon. Web arayüzünde yoktur.</p></div>
    </div>
    <div class="mk-sources">
      <div class="mk-sources-title"><span class="mk-vtick">✓</span>Kaynakça — dört ayrı resmî kaynaktan doğrulanmıştır</div>
      <ol class="mk-sources-list">
        <li><a href="https://code.claude.com/docs/en/model-config" target="_blank" rel="noopener">Claude Code — Model Yapılandırması & Effort</a><span>code.claude.com · resmî dokümantasyon</span></li>
