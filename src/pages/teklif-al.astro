---
import BaseLayout from '../layouts/BaseLayout.astro';
import KvkkTeklifFormu from '../components/form/KvkkTeklifFormu.astro';
import { webpageSchema, SITE_URL } from '../lib/schema';

const title = 'Teklif Al — Gonet İzmir';
const description =
  'Projeniz için KVKK onaylı teklif talebi oluşturun. Web, SEO, AEO/GEO ve kurumsal strateji çalışmaları için hızlı ön değerlendirme.';
const url = `${SITE_URL}/teklif-al`;

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'ContactPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: `${SITE_URL}/` },
    { name: 'Teklif Al', url },
  ],
});
---

<BaseLayout title={title} description={description} canonical={url} schemas={[pageSchema]}>
  <section class="bg-white border-b border-black">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700" aria-current="page">Teklif Al</li>
        </ol>
      </nav>
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-6">
        KVKK Onaylı Teklif Köprüsü
      </p>
      <h1 class="editorial-display text-[12vw] lg:text-[7vw] xl:text-[104px] leading-[0.95] mb-8">
        Projeniz için teklif alın.
      </h1>
      <p class="text-lg text-slate-700 leading-relaxed max-w-2xl">
        Kapsamınızı kısaca paylaşın; ekibimiz talebinizi KVKK güvencesiyle kayıt altına alıp
        size özel yol haritası ve teklif çalışmasıyla dönüş yapsın.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-6 grid lg:grid-cols-3 gap-16">
      <div class="lg:col-span-2">
        <KvkkTeklifFormu />
      </div>

      <aside class="space-y-8 border-t lg:border-t-0 lg:border-l border-black/15 pt-8 lg:pt-0 lg:pl-10">
        <div>
          <p class="text-[10px] font-medium uppercase tracking-[0.3em] text-slate-500 mb-3">
            Nasıl İlerliyoruz?
          </p>
          <ol class="space-y-3 text-sm text-slate-700 leading-relaxed list-decimal pl-4">
            <li>Talebiniz KVKK onay zaman damgasıyla güvenli biçimde kayıt edilir.</li>
            <li>Ekibimiz mevcut dijital varlığınızı ve hedeflerinizi inceler.</li>
            <li>1 iş günü içinde ön değerlendirme ve görüşme daveti paylaşılır.</li>
          </ol>
        </div>

        <div>
          <p class="text-[10px] font-medium uppercase tracking-[0.3em] text-slate-500 mb-3">
            Doğrudan İletişim
          </p>
          <p class="text-sm text-slate-700 leading-relaxed">
            E-posta: <a href="mailto:gonet@gonet.com.tr" class="underline text-black">gonet@gonet.com.tr</a><br />
            Telefon: <a href="tel:+902324650015" class="underline text-black">+90 232 465 00 15</a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section id="calisma-ilkeleri" class="border-t border-black bg-slate-50 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-slate-600 mb-3">
        Şeffaf Çalışma İlkeleri
      </p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-10">
        Sürpriz fatura ve sözleşme kilidi olmadan çalışıyoruz.
      </h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <article id="kota-seffafligi" class="border border-black/15 bg-white p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            Aylık Üretim Sınırı ve Yüzde 75 / 90 Kota Bildirimi
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Çalışmaya başlamadan önce aylık üretim sınırınızı açıkça görürsünüz. Kotanız yüzde 75 ve yüzde 90 seviyesine geldiğinde bilgilendirilirsiniz; kapsam dışı tek bir kalem bile siz dijital onay vermeden faturanıza eklenmez.
          </p>
        </article>

        <article class="border border-black/15 bg-white p-6 md:p-8">
          <h3 id="adil-cikis" tabindex="-1" class="text-lg font-bold text-slate-900 mb-3">
            Adil Çıkış İlkesi ve Veri Mülkiyeti
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Sizi ağır cayma cezalarıyla değil, her ay kanıtlanan sonuçlarla tutuyoruz. İhtiyacınız değiştiğinde 30 gün önceden bildirerek ceza ödemeden ayrılabilirsiniz; üretilen tüm içeriklerin, web varlıklarının ve Delil Kasası kayıtlarının kontrolü sizde kalır.
          </p>
        </article>

        <article id="kredi-devri" class="border border-black/15 bg-white p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            Ön-İşaretsiz Teklif ve 90 Gün Kredi Devri
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Teklif ekranlarımızda önceden işaretlenmiş gizli ek hizmetler bulunmaz. Yoğun aylarda kullanamadığınız üretim kredileriniz yanmaz; 90 güne kadar sonraki dönemlere devreder.
          </p>
        </article>

        <article id="medya-kalkani-kapsam" class="border border-black/15 bg-white p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            Net Kapsam ve Dijital Köken Doğrulaması
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Yapay korku senaryoları veya tutulamayacak sınırsızlık vaatleri sunmuyoruz. Çalışma kapsamını baştan net biçimde tanımlıyor; ürettiğimiz görsel ve videoları C2PA dijital köken künyesi ve TÜBİTAK Nitelikli Elektronik Zaman Damgası ile doğrulama kasasında saklıyoruz.
          </p>
        </article>

        <article id="sabit-tl-kalkani" class="border border-black/15 bg-white p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            15 Gün Öncesi Yenileme Özeti ve Sabit TL Fiyat Kalkanı
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Yenileme döneminizden 15 gün önce yeni dönem özetinizi paylaşıyor, altı ve on iki aylık anlaşmalarda Sabit TL Fiyat Kalkanı uyguluyoruz. Tüm hizmet faturalarınızı ve değer özetlerinizi muhasebenize hazır düzende sunuyoruz.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="acik-paket-kapsamlari" class="border-t border-black bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-slate-600 mb-3">
        Açık Paket Çerçevesi
      </p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-10">
        Satış görüşmesi şartı olmadan açık paket kapsamları.
      </h2>

      <div class="grid md:grid-cols-3 gap-6 mb-8">
        <article class="border border-black/15 bg-slate-50 p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            1. Keşif ve Görünürlük Denetimi (1–2 Hafta)
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Teknik altyapı, arama ve yapay zekâ görünürlüğü (SEO / AEO / GEO) ile veri akışı risklerinin ölçülüp önceliklendirilmiş yol haritasının teslim edilmesi. Kurulum katmanına geçişte keşif kapsamı çalışma planına mahsup edilir.
          </p>
        </article>

        <article class="border border-black/15 bg-slate-50 p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            2. Kurulum ve Dijital Dönüşüm (2–6 Hafta)
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Kurumsal web mimarisi, yapısal veri şemaları, içerik altyapısı ve onaylı iş akışı otomasyonlarının devreye alınması. Teslim sınırları ve takvim çalışmaya başlamadan önce yazılı olarak netleştirilir.
          </p>
        </article>

        <article class="border border-black/15 bg-slate-50 p-6 md:p-8">
          <h3 class="text-lg font-bold text-slate-900 mb-3">
            3. Aylık Değer ve Görünürlük Yönetimi (6 / 12 Ay)
          </h3>
          <p class="text-sm text-slate-700 leading-relaxed">
            Sürekli görünürlük takibi, içerik üretimi, teknik bakım ve değer kanıtlı dönem özeti. Altı ve on iki aylık anlaşmalarda Sabit TL Fiyat Kalkanı ve 90 gün kredi devri uygulanır.
          </p>
        </article>
      </div>

      <p class="text-sm text-slate-700 leading-relaxed mb-6">
        Paket kapsamlarımız görüşme ön koşulu olmadan açıkça paylaşılır; projenizin ölçeğine uygun dönem bedeli ve açık KDV kırılımı yazılı teklif özetinde sunulur. Paket kapsamı, kullanım kotası ve fiyat politikasını güncelleme hakkı Gonet yönetiminde saklıdır.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="/aeo-geo-denetimi"
          class="min-h-[44px] inline-flex items-center justify-center px-5 py-3 border border-black text-slate-900 hover:bg-black hover:text-white transition-colors text-xs font-semibold uppercase tracking-[0.14em]"
        >
          AEO / GEO Denetim Paket Detaylarını İnceleyin →
        </a>
        <a
          href="#kvkk-teklif-formu"
          class="min-h-[44px] inline-flex items-center justify-center px-5 py-3 bg-black text-white hover:bg-slate-800 transition-colors text-xs font-semibold uppercase tracking-[0.14em]"
        >
          Yazılı Teklif Özeti İsteyin ↑
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
