// ItemList schema — AEO için citation-worthy entity list
const itemListSchema = {
  '@type': 'ItemList',
  name: 'Gonet portföyündeki markalar',
  numberOfItems: sectors.reduce((sum, s) => sum + s.brands.length, 0),
  itemListElement: sectors.flatMap((sector, sIdx) =>
    sector.brands.map((brand, bIdx) => ({
      '@type': 'ListItem',
      position: sIdx * 100 + bIdx + 1,
      item: {
        '@type': 'Organization',
        name: brand.split(' — ')[0],
        description: brand.includes(' — ') ? brand.split(' — ')[1] : undefined,
      },
    })),
  ),
};
---

<BaseLayout title={title} description={description} canonical={url} schemas={[pageSchema, itemListSchema]}>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-50 via-white to-brand-100 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700" aria-current="page">Markalar</li>
        </ol>
      </nav>
      <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
        Çalıştığımız Markalar
      </p>
      <h1 class="text-5xl font-bold text-brand-950 leading-tight mb-6">
        26 yılda 20+ sektörde 200+ marka.
      </h1>
      <p class="text-xl text-slate-700 leading-relaxed">
        Sağlık turizminden inşaata, siyasi kampanyalardan büyük markaların mobil API'lerine —
        2000'den bu yana çalıştığımız markaların bir kısmı. Listemiz <strong>çok daha uzun</strong>;
        burada en bilinenler veya hikayesi public olanlardır.
      </p>
      <p class="text-lg text-accent-700 leading-relaxed mt-4 font-semibold">
        Bu markaların büyük çoğunluğunun <strong>ilk websitesinde, ilk internet reklamında,
        ilk SEO\'sunda, ilk sosyal medyasında ya da ilk mobil uygulamasında biz vardık.</strong>
        Bir markanın dijitalle ilk teması bizi geçti — bu da bizim Türkiye dijital
        ekosisteminin kurulmasındaki rolümüzün kanıtı.
      </p>
      <p class="text-sm text-slate-500 mt-4 italic">
        Eksik olan markalar var — geriye dönüp eklemeye devam ediyoruz. Sizinle de çalıştıysak
        ve isminizi göremiyorsanız bize haber verin, yerini bulalım.
      </p>
    </div>
  </section>

  <!-- Sektörler -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6 space-y-12">
      {sectors.map((sector) => (
        <article class="border border-slate-200 rounded-lg overflow-hidden">
          <header class="bg-brand-50 px-6 py-4 border-b border-slate-200">
            <h2 class="text-2xl font-bold text-brand-950">{sector.name}</h2>
            {sector.highlight && (
              <p class="text-sm text-brand-700 mt-1 font-medium">★ {sector.highlight}</p>
            )}
          </header>
          <ul class="divide-y divide-slate-100">
            {sector.brands.map((brand) => (
              <li class="px-6 py-3 text-slate-800">
                {brand.includes(' — ') ? (
                  <>
                    <strong>{brand.split(' — ')[0]}</strong>
                    <span class="text-slate-600"> — {brand.split(' — ').slice(1).join(' — ')}</span>
                  </>
                ) : (
                  brand
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-950 text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-4">Sizin de markanız bu listede yer alsın</h2>
      <p class="text-lg text-brand-100 mb-8 max-w-2xl mx-auto">
        Sektörünüz ne olursa olsun — 15+ sektörde, 100+ markada denenmiş stratejiyle çalışıyoruz.
      </p>
      <a
        href="/iletisim"
        class="inline-block bg-accent-500 text-white px-8 py-4 rounded-md font-semibold hover:bg-accent-600 transition"
      >
        İletişime Geç →
      </a>
    </div>
  </section>
</BaseLayout>
