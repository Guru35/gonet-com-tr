const itemListSchema = {
  '@type': 'ItemList',
  name: 'Gonet portföyündeki markalar',
  numberOfItems: sectors.reduce((sum, s) => sum + s.brands.length, 0),
  itemListElement: sectors.flatMap((sector, sIdx) =>
