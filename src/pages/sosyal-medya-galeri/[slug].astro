---
// Sosyal medya post viewer — Chrome'un ham PNG dark-theme'inden kaçınmak için
// beyaz arka planlı HTML wrapper içinde gösterir.

export async function getStaticPaths() {
  const postlar = [
    { slug: '01-mevlana-aynasi',   name: 'Mevlânâ Aynası',  kategori: 'Varyasyon A · Felsefi köprü' },
    { slug: '02-kirmizi-nokta',    name: 'Kırmızı Nokta',   kategori: 'Varyasyon B-1 · Manifesto' },
    { slug: '03-numara-bir',       name: 'Numara Bir',      kategori: 'Varyasyon B-2 · Tipografik ilk' },
    { slug: '04-ai-zeki-sen',      name: 'AI Zeki. Sen?',   kategori: 'Varyasyon C-1 · Toscani modu' },
    { slug: '05-yansima',          name: 'Yansıma',         kategori: 'Varyasyon C-2 · Felsefi ayna' },
    { slug: '06-at-sahibine-gore', name: 'At Sahibine Göre',kategori: 'Varyasyon D · Atasözü köprüsü' },
  ];
  return postlar.map((p) => ({
    params: { slug: p.slug },
    props: { name: p.name, kategori: p.kategori },
  }));
}

const { slug } = Astro.params;
const { name, kategori } = Astro.props;
const imageSrc = `/sosyal-medya/${slug}.png`;
const title = `${name} — Gonet Sosyal Medya Galerisi`;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/brand/gonet-logo-dark.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      background: #fff;
      color: #000;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      min-height: 100vh;
    }
    body { color-scheme: light; }
    .frame {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px;
      box-sizing: border-box;
    }
    .meta {
      width: 100%;
      max-width: 1280px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 24px;
      margin-bottom: 16px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 600;
      color: #000;
    }
    .meta a {
      color: #000;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }
    .meta .hint { opacity: 0.5; font-weight: 400; }
    .meta .kategori { color: #ff0000; font-weight: 600; }
    img.full {
      display: block;
      max-height: calc(100vh - 80px);
      max-width: 100%;
      width: auto;
      height: auto;
      background: #fff;
      cursor: zoom-in;
      transition: max-height 0.4s ease, max-width 0.4s ease;
    }
    img.full.is-zoomed {
      max-height: none;
      max-width: 100%;
      width: 100%;
      cursor: zoom-out;
    }
  </style>
</head>
<body>
  <div class="frame">
    <div class="meta">
      <span>Gonet · Sosyal Medya · <span class="kategori">{kategori}</span> · {name}</span>
      <span class="hint">Resme tıkla → zoom in / out</span>
      <a href="/sosyal-medya-galeri">← Galeri</a>
    </div>
    <img id="full-img" class="full" src={imageSrc} alt={`Gonet ${name} sosyal medya post varyasyonu`} />
  </div>
  <script is:inline>
    (function () {
      var img = document.getElementById('full-img');
      if (!img) return;
      img.addEventListener('click', function () {
        img.classList.toggle('is-zoomed');
        if (img.classList.contains('is-zoomed')) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    })();
  </script>
</body>
</html>
