---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema, faqSchema } from '../lib/schema';

const title = 'Kurumsal Kimlik ve Marka Kılavuzu — Gonet';
const description =
  "Gonet (Pigme Proje ve İş Geliştirme Merkezi Yazılım A.Ş.) resmî İsviçre Editoryal kurumsal kimlik kılavuzu, 6 kanonik SVG logo matrisi, renk/tipografi jetonları ve 3D stüdyo vitrini.";
const url = 'https://gonet.com.tr/kurumsal-kimlik';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'CollectionPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Kurumsal Kimlik', url },
  ],
});

const faqItems = [
  {
    question: 'Gonet logosunun resmi boyut ve kullanım kuralları nelerdir?',
    answer:
      "Gonet tam yatay logosu 460×152 px, yalnız GO amblemi ise 262×152 px oranındadır. Minimum kullanım yüksekliği dijital arayüzlerde 56 px, basılı materyallerde 15 mm olarak uygulanır; beyaz, siyah ve temaya duyarlı currentColor sürümleri mevcuttur.",
  },
  {
    question: 'Gonet kurumsal renklerinin HEX, CMYK ve Pantone karşılıkları nelerdir?',
    answer:
      "İsviçre Editoryal (Yüzey A) sisteminde Gonet Kırmızısı #FF0000 (CMYK 0/99/100/0, Pantone 485 C), Metin Siyahı #000000 (CMYK 0/0/0/100, Pantone Black 6 C), Zengin Siyah #0A0A0A (CMYK 40/30/30/100) ve Saf Beyaz #FFFFFF kullanılır. Dolu #FF0000 butonlarda WCAG 2.2 AA uyumu için yalnızca #000000 yazı rengi kullanılır.",
  },
  {
    question: 'İsviçre Editoryal ve Obsidian Engine tasarım yüzeyleri nerelerde kullanılır?',
    answer:
      "İsviçre Editoryal (Yüzey A) gonet.com.tr ana vitrini, kurumsal dokümanlar, baskı işleri ve /merhaba kulüp yüzeyinde 0 px köşe geometrisiyle uygulanır. Obsidian Engine (Yüzey B) ise panel.gonet.com.tr SaaS müşteri panelinde tonal ayrım, 12 px kart yuvarlaması ve #F03E47 panel vurgusuyla kullanılır.",
  },
];

const faq = faqSchema(faqItems);
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  ogImage="/brand/og-default-2400x1260.png"
  schemas={[pageSchema, faq]}
>
  <div class="kk-root">
    <!-- BREADCRUMB & HERO -->
    <section class="kk-hero-sec">
      <div class="kk-wrap">
        <nav class="kk-breadcrumb" aria-label="Gezinti yolu">
          <a href="/">Ana sayfa</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Kurumsal Kimlik</span>
        </nav>

        <p class="kk-eyebrow">KANONİK MARKA KILAVUZU · V2.1 · /KURUMSAL-KIMLIK</p>

        <div class="kk-hero-grid">
          <h1 class="kk-hero-title">KURUMSAL KİMLİK<span class="kk-red-dot">.</span></h1>
          <div class="kk-hero-copy">
            <p>
              &laquo;Doğru anlatılmak&raquo; yalnızca söylemle değil, her temas noktasında tutarlı bir görsel disiplinle başlar. Bu sayfa; Gonet'in müşterileri, iş ortakları ve basın için hazırladığı resmî İsviçre Editoryal kimlik sistemini ve 3D stüdyo uygulamasını tek merkezde sunar.
            </p>
            <div class="kk-hero-metrics">
              <div>
                <span class="kk-metric-val">2000 → 2026</span>
                <span class="kk-metric-lbl">26 Yıllık Birikim</span>
              </div>
              <div>
                <span class="kk-metric-val">190+ Marka</span>
                <span class="kk-metric-lbl">24 Farklı Sektör</span>
              </div>
              <div>
                <span class="kk-metric-val">0 px Köşe</span>
                <span class="kk-metric-lbl">İsviçre Editoryal</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 1. 3D STÜDYO MOCKUP VİTRİNİ -->
    <section class="kk-sec" id="vitrin">
      <div class="kk-wrap">
        <div class="kk-sec-head">
          <div>
            <p class="kk-eyebrow">01 · GERÇEK DÜNYA UYGULAMALARI</p>
            <h2 class="kk-sec-title">3D Stüdyo Mockup Vitrini<span class="kk-red-dot">.</span></h2>
            <p class="kk-sec-sub">Beş farklı temas noktasının Açık (Light) ve Koyu (Dark) stüdyo varyasyonları. Sahneyi canlandırmak için fareyi görselin üzerine getirin, tam boy incelemek için tıklayın.</p>
          </div>
          <div class="kk-mode-bar" role="group" aria-label="Vitrin görünüm modu">
            <button type="button" class="kk-mode-btn" data-view-mode="auto" aria-pressed="true">Tema ile Uyumlu (Otomatik)</button>
            <button type="button" class="kk-mode-btn" data-view-mode="light" aria-pressed="false">Açık (Light)</button>
            <button type="button" class="kk-mode-btn" data-view-mode="dark" aria-pressed="false">Koyu (Dark)</button>
            <button type="button" class="kk-mode-btn" data-view-mode="compare" aria-pressed="false">Yan Yana Karşılaştır</button>
            <button type="button" class="kk-mode-btn" id="kk-motion-toggle" aria-pressed="false">Hareketi Durdur</button>
          </div>
        </div>

        <div class="kk-mockup-grid" id="kk-mockup-grid">
          <!-- Sahne 1 -->
          <article class="kk-mockup-card is-featured" data-active-shot="light">
            <div class="kk-mockup-media">
              <div class="kk-mockup-pair">
                <figure class="kk-mockup-shot shot-light" role="button" tabindex="0" aria-label="01 · Kartvizit, Antetli Kağıt ve Zarf — Açık (Light) tam boy incele" data-lightbox="/brand/mockups/light/01-kartvizit-kirtasiye-light.webp" data-video="/brand/mockups/light/01-kartvizit-kirtasiye-light.mp4" data-caption="01 · Kartvizit, Antetli Kağıt ve Zarf — Açık (Light)">
                  <img src="/brand/mockups/light/01-kartvizit-kirtasiye-light.webp" alt="Gonet Açık Tema Kartvizit, Antetli Kağıt ve Zarf 3D Mockup" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/light/01-kartvizit-kirtasiye-light.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Light</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
                <figure class="kk-mockup-shot shot-dark" role="button" tabindex="0" aria-label="01 · Kartvizit, Antetli Kağıt ve Zarf — Koyu (Dark) tam boy incele" data-lightbox="/brand/mockups/dark/01-kartvizit-kirtasiye-dark.webp" data-video="/brand/mockups/dark/01-kartvizit-kirtasiye-dark.mp4" data-caption="01 · Kartvizit, Antetli Kağıt ve Zarf — Koyu (Dark)">
                  <img src="/brand/mockups/dark/01-kartvizit-kirtasiye-dark.webp" alt="Gonet Koyu Tema Kartvizit, Antetli Kağıt ve Zarf 3D Mockup" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/dark/01-kartvizit-kirtasiye-dark.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Dark</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
              </div>
            </div>
            <div class="kk-mockup-body">
              <span class="kk-mockup-num">SAHNE 01 · BASKI &amp; KIRTASİYE</span>
              <h3>Kartvizit, Antetli Kağıt ve Zarf</h3>
              <p>3–5 mm taşma paylı, kırmızı kenar boyalı kartvizit ve C:0 M:0 Y:0 K:100 tipografik antetli kağıt seti.</p>
            </div>
          </article>

          <!-- Sahne 2 -->
          <article class="kk-mockup-card" data-active-shot="light">
            <div class="kk-mockup-media">
              <div class="kk-mockup-pair">
                <figure class="kk-mockup-shot shot-light" role="button" tabindex="0" aria-label="02 · Web Vitrin & Obsidian Panel — Açık (Light) tam boy incele" data-lightbox="/brand/mockups/light/02-web-macbook-light.webp" data-video="/brand/mockups/light/02-web-macbook-light.mp4" data-caption="02 · Web Vitrin &amp; Obsidian Panel — Açık (Light)">
                  <img src="/brand/mockups/light/02-web-macbook-light.webp" alt="Gonet Açık Tema MacBook Pro Web Ekranı 3D Mockup" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/light/02-web-macbook-light.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Light</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
                <figure class="kk-mockup-shot shot-dark" role="button" tabindex="0" aria-label="02 · Web Vitrin & Obsidian Panel — Koyu (Dark) tam boy incele" data-lightbox="/brand/mockups/dark/02-web-macbook-dark.webp" data-video="/brand/mockups/dark/02-web-macbook-dark.mp4" data-caption="02 · Web Vitrin &amp; Obsidian Panel — Koyu (Dark)">
                  <img src="/brand/mockups/dark/02-web-macbook-dark.webp" alt="Gonet Koyu Tema MacBook Pro Web ve Obsidian Panel 3D Mockup" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/dark/02-web-macbook-dark.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Dark</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
              </div>
            </div>
            <div class="kk-mockup-body">
              <span class="kk-mockup-num">SAHNE 02 · DİJİTAL ARAYÜZ</span>
              <h3>Web Vitrin &amp; Obsidian Panel</h3>
              <p>gonet.com.tr ana vitrini ve panel.gonet.com.tr SaaS arayüzünün MacBook Pro stüdyo sunumu.</p>
            </div>
          </article>

          <!-- Sahne 3 -->
          <article class="kk-mockup-card" data-active-shot="light">
            <div class="kk-mockup-media">
              <div class="kk-mockup-pair">
                <figure class="kk-mockup-shot shot-light" role="button" tabindex="0" aria-label="03 · Sert Kapak Marka Kılavuzu & AEO/GEO Raporu — Açık (Light) tam boy incele" data-lightbox="/brand/mockups/light/03-marka-kilavuzu-rapor-light.webp" data-video="/brand/mockups/light/03-marka-kilavuzu-rapor-light.mp4" data-caption="03 · Sert Kapak Marka Kılavuzu &amp; AEO/GEO Raporu — Açık (Light)">
                  <img src="/brand/mockups/light/03-marka-kilavuzu-rapor-light.webp" alt="Gonet Açık Tema Sert Kapak Marka Kılavuzu ve AEO/GEO Raporu" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/light/03-marka-kilavuzu-rapor-light.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Light</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
                <figure class="kk-mockup-shot shot-dark" role="button" tabindex="0" aria-label="03 · Sert Kapak Marka Kılavuzu & AEO/GEO Raporu — Koyu (Dark) tam boy incele" data-lightbox="/brand/mockups/dark/03-marka-kilavuzu-rapor-dark.webp" data-video="/brand/mockups/dark/03-marka-kilavuzu-rapor-dark.mp4" data-caption="03 · Sert Kapak Marka Kılavuzu &amp; AEO/GEO Raporu — Koyu (Dark)">
                  <img src="/brand/mockups/dark/03-marka-kilavuzu-rapor-dark.webp" alt="Gonet Koyu Tema Sert Kapak Marka Kılavuzu ve AEO/GEO Raporu" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/dark/03-marka-kilavuzu-rapor-dark.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Dark</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
              </div>
            </div>
            <div class="kk-mockup-body">
              <span class="kk-mockup-num">SAHNE 03 · YAYIN &amp; DENETİM</span>
              <h3>Marka Kılavuzu &amp; AEO/GEO Raporu</h3>
              <p>Sert kapak marka kitabı ve yönetici özeti formatındaki AEO/GEO denetim raporu.</p>
            </div>
          </article>

          <!-- Sahne 4 -->
          <article class="kk-mockup-card" data-active-shot="light">
            <div class="kk-mockup-media">
              <div class="kk-mockup-pair">
                <figure class="kk-mockup-shot shot-light" role="button" tabindex="0" aria-label="04 · Mobil Deneyim & Winner Club Kartı — Açık (Light) tam boy incele" data-lightbox="/brand/mockups/light/04-mobil-winner-kart-light.webp" data-video="/brand/mockups/light/04-mobil-winner-kart-light.mp4" data-caption="04 · Mobil Deneyim &amp; Winner Club Kartı — Açık (Light)">
                  <img src="/brand/mockups/light/04-mobil-winner-kart-light.webp" alt="Gonet Açık Tema Mobil Ekran ve Winner Club Kartı" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/light/04-mobil-winner-kart-light.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Light</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
                <figure class="kk-mockup-shot shot-dark" role="button" tabindex="0" aria-label="04 · Mobil Deneyim & Winner Club Kartı — Koyu (Dark) tam boy incele" data-lightbox="/brand/mockups/dark/04-mobil-winner-kart-dark.webp" data-video="/brand/mockups/dark/04-mobil-winner-kart-dark.mp4" data-caption="04 · Mobil Deneyim &amp; Winner Club Kartı — Koyu (Dark)">
                  <img src="/brand/mockups/dark/04-mobil-winner-kart-dark.webp" alt="Gonet Koyu Tema Mobil Ekran ve Metal Winner Club Kartı" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/dark/04-mobil-winner-kart-dark.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Dark</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
              </div>
            </div>
            <div class="kk-mockup-body">
              <span class="kk-mockup-num">SAHNE 04 · KAPALI SALON</span>
              <h3>Mobil &amp; Winner Club Kartı</h3>
              <p>/merhaba davetiyeli kulüp deneyimi ve GONET | WINNER CLUB metal üyelik kartı.</p>
            </div>
          </article>

          <!-- Sahne 5 -->
          <article class="kk-mockup-card" data-active-shot="light">
            <div class="kk-mockup-media">
              <div class="kk-mockup-pair">
                <figure class="kk-mockup-shot shot-light" role="button" tabindex="0" aria-label="05 · Ofis Kırtasiye, Tabela ve Tote Çanta — Açık (Light) tam boy incele" data-lightbox="/brand/mockups/light/05-ofis-defter-tote-light.webp" data-video="/brand/mockups/light/05-ofis-defter-tote-light.mp4" data-caption="05 · Ofis Kırtasiye, Tabela ve Tote Çanta — Açık (Light)">
                  <img src="/brand/mockups/light/05-ofis-defter-tote-light.webp" alt="Gonet Açık Tema Defter, Kalem, Tabela ve Tote Çanta" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/light/05-ofis-defter-tote-light.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Light</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
                <figure class="kk-mockup-shot shot-dark" role="button" tabindex="0" aria-label="05 · Ofis Kırtasiye, Duvar Tabelası ve Kalem — Koyu (Dark) tam boy incele" data-lightbox="/brand/mockups/dark/05-ofis-defter-tote-dark.webp" data-video="/brand/mockups/dark/05-ofis-defter-tote-dark.mp4" data-caption="05 · Ofis Kırtasiye, Duvar Tabelası ve Kalem — Koyu (Dark)">
                  <img src="/brand/mockups/dark/05-ofis-defter-tote-dark.webp" alt="Gonet Koyu Tema Defter, Kalem ve Mimari Duvar Tabelası" width="1376" height="768" loading="lazy" decoding="async" />
                  <video class="kk-mockup-video" data-video-src="/brand/mockups/dark/05-ofis-defter-tote-dark.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
                  <span class="kk-mockup-shot-badge">Dark</span>
                  <span class="kk-mockup-motion-hint"><span class="kk-mockup-motion-dot" aria-hidden="true"></span><span class="kk-mockup-motion-label">Üzerine Gel · Canlandır</span></span>
                </figure>
              </div>
            </div>
            <div class="kk-mockup-body">
              <span class="kk-mockup-num">SAHNE 05 · MEKAN &amp; OFİS</span>
              <h3>Ofis Defter, Tabela ve Çanta</h3>
              <p>DEPARK ofis yönlendirmesi, mat siyah kalem, sert kapak defter ve bez çanta uygulamaları.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 2. 6 KANONİK LOGO MATRİSİ -->
    <section class="kk-sec" id="logolar">
      <div class="kk-wrap">
        <div class="kk-sec-head">
          <div>
            <p class="kk-eyebrow">02 · VEKTÖR KİMLİK VARLIKLARI</p>
            <h2 class="kk-sec-title">Logo Matrisi ve GO Amblemi<span class="kk-red-dot">.</span></h2>
            <p class="kk-sec-sub">Minimum kullanım yüksekliği dijitalde 56 px, baskıda 15 mm'dir. currentColor sürümleri tema değişiminde otomatik renk alır.</p>
          </div>
        </div>

        <div class="kk-grid-3">
          <article class="kk-card">
            <div class="kk-logo-stage is-light">
              <img src="/brand/gonet-logo-dark.svg" alt="Gonet Tam Yatay Siyah Logo" />
            </div>
            <strong class="kk-card-title">Tam Logo — Siyah (460×152)</strong>
            <p class="kk-card-desc">Saf beyaz (#FFFFFF) ve açık mimari zeminler için kanonik yatay logo.</p>
            <div class="kk-card-actions">
              <a class="kk-btn" href="/brand/gonet-logo-dark.svg" download>SVG İndir</a>
            </div>
          </article>

          <article class="kk-card">
            <div class="kk-logo-stage is-dark">
              <img src="/brand/gonet-logo-white.svg" alt="Gonet Tam Yatay Beyaz Logo" />
            </div>
            <strong class="kk-card-title">Tam Logo — Beyaz (460×152)</strong>
            <p class="kk-card-desc">Koyu zeminler (#0A0A0A) ve Winner Club yüzeyi için tam ölçekli beyaz SVG.</p>
            <div class="kk-card-actions">
              <a class="kk-btn" href="/brand/gonet-logo-white.svg" download>SVG İndir</a>
            </div>
          </article>

          <article class="kk-card">
            <div class="kk-logo-stage is-adaptive">
