    border: 1px solid #ff0000;
    font-size: 13px;
    font-weight: 600;
  }
  .kk-toast.is-hidden { display: none; }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const mockupGrid = document.getElementById('kk-mockup-grid');
    const modeBtns = document.querySelectorAll('[data-view-mode]');
    const mockupCards = document.querySelectorAll('.kk-mockup-card');
    const motionToggle = document.getElementById('kk-motion-toggle');
    const mockupShots = document.querySelectorAll('.kk-mockup-shot');
    const lightbox = document.getElementById('kk-lightbox');
    const lightboxImg = document.getElementById('kk-lightbox-img');
    const lightboxVideo = document.getElementById('kk-lightbox-video');
    const lightboxTitle = document.getElementById('kk-lightbox-title');
    const lightboxClose = document.getElementById('kk-lightbox-close');
    const toast = document.getElementById('kk-toast');

    let currentViewMode = 'auto';
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let motionDisabled = motionQuery.matches;
    if (typeof motionQuery.addEventListener === 'function') {
      motionQuery.addEventListener('change', (e) => {
        motionDisabled = e.matches;
        syncMotionToggleUI();
      });
    }

    function isDarkTheme() {
      return root.getAttribute('data-theme') === 'dark';
    }

    function ensureVideoSrc(video) {
      if (!video) return;
      const vSrc = video.getAttribute('data-video-src');
      if (vSrc && !video.getAttribute('src')) {
        video.preload = 'auto';
        video.src = vSrc;
        video.load();
      }
    }

    function stopAllVideos() {
      mockupShots.forEach((shot) => {
        const video = shot.querySelector('video.kk-mockup-video');
        const label = shot.querySelector('.kk-mockup-motion-label');
        shot.classList.remove('is-playing');
        if (label) {
          label.textContent = motionDisabled ? 'Hareket Kapalı' : 'Üzerine Gel · Canlandır';
        }
        if (video) {
          video.pause();
          try { video.currentTime = 0; } catch {}
        }
      });
    }

    function syncMotionToggleUI() {
      if (!motionToggle) return;
      motionToggle.setAttribute('aria-pressed', String(motionDisabled));
      motionToggle.textContent = motionDisabled ? 'Hareket Kapalı (Aç)' : 'Hareketi Durdur';
      if (motionDisabled) {
        stopAllVideos();
      } else {
        mockupShots.forEach((shot) => {
          const label = shot.querySelector('.kk-mockup-motion-label');
          if (label && !shot.classList.contains('is-playing')) {
            label.textContent = 'Üzerine Gel · Canlandır';
          }
        });
      }
    }

    function playShot(shot) {
      if (motionDisabled) return;
      const video = shot.querySelector('video.kk-mockup-video');
      const label = shot.querySelector('.kk-mockup-motion-label');
      if (!video) return;
      ensureVideoSrc(video);
      shot.classList.add('is-playing');
      if (label) label.textContent = 'Canlı Stüdyo';
      video.play().catch(() => {});
    }

    function stopShot(shot) {
      const video = shot.querySelector('video.kk-mockup-video');
      const label = shot.querySelector('.kk-mockup-motion-label');
      shot.classList.remove('is-playing');
      if (label) {
        label.textContent = motionDisabled ? 'Hareket Kapalı' : 'Üzerine Gel · Canlandır';
      }
      if (video) {
        video.pause();
        try { video.currentTime = 0; } catch {}
      }
    }

    function syncShowcase() {
      stopAllVideos();
      if (!mockupGrid) return;
      if (currentViewMode === 'compare') {
        mockupGrid.classList.add('is-compare');
        return;
      }
      mockupGrid.classList.remove('is-compare');
      const target = currentViewMode === 'auto' ? (isDarkTheme() ? 'dark' : 'light') : currentViewMode;
      mockupCards.forEach((card) => card.setAttribute('data-active-shot', target));
    }

    mockupShots.forEach((shot) => {
      shot.addEventListener('mouseenter', () => playShot(shot));
      shot.addEventListener('mouseleave', () => stopShot(shot));
      shot.addEventListener('focusin', () => playShot(shot));
      shot.addEventListener('focusout', () => stopShot(shot));
      shot.addEventListener('touchstart', () => {
        if (motionDisabled) return;
        if (shot.classList.contains('is-playing')) {
          stopShot(shot);
        } else {
          mockupShots.forEach((other) => { if (other !== shot) stopShot(other); });
          playShot(shot);
        }
      }, { passive: true });
      shot.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          shot.click();
        }
      });
    });

    if (motionToggle) {
      motionToggle.addEventListener('click', () => {
        motionDisabled = !motionDisabled;
        syncMotionToggleUI();
      });
    }

    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentViewMode = btn.getAttribute('data-view-mode') || 'auto';
        modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        syncShowcase();
      });
    });

    function closeLightbox() {
      if (lightboxVideo) {
        lightboxVideo.pause();
        lightboxVideo.removeAttribute('src');
        lightboxVideo.load();
        lightboxVideo.style.display = 'none';
      }
      if (lightbox && typeof lightbox.close === 'function') {
        lightbox.close();
      } else if (lightbox) {
        lightbox.removeAttribute('open');
      }
    }

    document.querySelectorAll('[data-lightbox]').forEach((fig) => {
      fig.addEventListener('click', () => {
        const src = fig.getAttribute('data-lightbox') || '';
        const videoSrc = fig.getAttribute('data-video');
        const caption = fig.getAttribute('data-caption') || '3D Stüdyo Mockup';
        if (lightboxTitle) lightboxTitle.textContent = caption;
        if (videoSrc && !motionDisabled && lightboxVideo && lightboxImg) {
          lightboxImg.style.display = 'none';
          lightboxVideo.style.display = 'block';
          lightboxVideo.poster = src;
          lightboxVideo.src = videoSrc;
          lightboxVideo.play().catch(() => {});
        } else if (lightboxImg) {
          if (lightboxVideo) lightboxVideo.style.display = 'none';
          lightboxImg.style.display = 'block';
          lightboxImg.src = src;
          lightboxImg.alt = caption;
        }
        if (lightbox && typeof lightbox.showModal === 'function') {
          lightbox.showModal();
        } else if (lightbox) {
          lightbox.setAttribute('open', '');
        }
      });
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      lightbox.addEventListener('cancel', closeLightbox);
    }

    function showToast(msg) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('is-hidden');
      clearTimeout(window.__gonetKkToastTimer);
      window.__gonetKkToastTimer = setTimeout(() => toast.classList.add('is-hidden'), 1800);
    }

    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const val = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(val);
        } catch {}
        showToast('Kopyalandı: ' + val);
      });
    });

    try {
      new MutationObserver(() => syncShowcase()).observe(root, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    } catch {}

    syncMotionToggleUI();
    syncShowcase();
  })();
</script>
