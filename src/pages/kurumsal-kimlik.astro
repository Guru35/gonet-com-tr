<style>
  .kk-root {
    --border-soft: rgba(0, 0, 0, 0.16);
    --accent-text: #d40000;
    --ink-shadow: 0 0 1px rgba(0, 0, 0, 0.14);
    background: var(--bg);
    color: var(--text);
  }

  :global([data-theme="dark"]) .kk-root {
    --border-soft: rgba(255, 255, 255, 0.14);
    --accent-text: #ff2b2b;
    --ink-shadow: none;
  }

  .kk-root *,
  .kk-root *::before,
  .kk-root *::after {
    box-sizing: border-box;
    border-radius: 0;
  }

  .kk-wrap {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  @media (min-width: 1024px) {
    .kk-wrap { padding-inline: 40px; }
  }

  .kk-red-dot {
    color: var(--accent);
    text-shadow: none;
  }

  .kk-eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    color: var(--accent-text);
  }

  .kk-btn {
    min-height: 44px;
    min-width: 44px;
    padding: 8px 18px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-heading);
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .kk-btn:hover {
    background: var(--text-heading);
    color: var(--bg);
  }

  /* ================= HERO ================= */
  .kk-hero-sec {
    border-bottom: 1px solid var(--border);
    padding-block: 56px 64px;
  }
  @media (min-width: 1024px) {
    .kk-hero-sec { padding-block: 72px 84px; }
  }

  .kk-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
  .kk-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .kk-breadcrumb a:hover { color: var(--text-heading); }

  .kk-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: end;
  }
  @media (min-width: 960px) {
    .kk-hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
      gap: 48px;
    }
  }

  .kk-hero-title {
    margin: 0;
    font-size: clamp(36px, 8vw, 96px);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--text-heading);
    text-shadow: var(--ink-shadow);
  }

  .kk-hero-copy p {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .kk-hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    padding-top: 18px;
    gap: 16px;
  }
  @media (max-width: 480px) {
    .kk-hero-metrics {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .kk-metric-val {
    display: block;
    font-size: 20px;
    font-weight: 600;
    color: var(--text-heading);
    font-variant-numeric: tabular-nums;
  }
  .kk-metric-lbl {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  /* ================= BOLUM CERCEVELERI ================= */
  .kk-sec {
    padding-block: 64px;
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 1024px) {
    .kk-sec { padding-block: 80px; }
  }

  .kk-sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 36px;
  }
  .kk-sec-title {
    margin: 0;
    font-size: clamp(28px, 4.4vw, 48px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text-heading);
    text-shadow: var(--ink-shadow);
  }
  .kk-sec-sub {
    margin: 10px 0 0;
    max-width: 66ch;
    font-size: 15px;
    color: var(--text-secondary);
  }

  /* ================= 3D MOCKUP VITRINI ================= */
  .kk-mode-bar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .kk-mode-btn {
    min-height: 44px;
    min-width: 44px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-heading);
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
  .kk-mode-btn[aria-pressed="true"] {
    background: var(--text-heading);
    color: var(--bg);
  }
  @media (max-width: 480px) {
    .kk-btn,
    .kk-mode-btn {
      white-space: normal;
      text-align: center;
    }
  }

  .kk-mockup-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  @media (min-width: 768px) {
    .kk-mockup-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1120px) {
    .kk-mockup-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .kk-mockup-grid .kk-mockup-card.is-featured {
      grid-column: span 2;
    }
    .kk-mockup-grid.is-compare {
      grid-template-columns: minmax(0, 1fr);
    }
    .kk-mockup-grid.is-compare .kk-mockup-card.is-featured {
      grid-column: span 1;
    }
  }

  .kk-mockup-card {
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .kk-mockup-media {
    position: relative;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .kk-mockup-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .kk-mockup-grid.is-compare .kk-mockup-pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 640px) {
    .kk-mockup-grid.is-compare .kk-mockup-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .kk-mockup-shot {
    position: relative;
    display: none;
    margin: 0;
    cursor: zoom-in;
    overflow: hidden;
  }
  .kk-mockup-shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
  .kk-mockup-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    opacity: 0;
    transition: opacity 240ms ease-out;
    pointer-events: none;
    z-index: 1;
