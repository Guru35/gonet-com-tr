---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema } from '../lib/schema';

const title = 'Sosyal Medya Galerisi — Lansman Postları · Gonet';
const description =
  '2026 gonet.com.tr lansmanı için 5 sosyal medya post varyasyonu. Mevlânâ köprüsü, manifesto, Toscani provokasyonu — beyaz + tek kırmızı vurgu.';
const url = 'https://gonet.com.tr/sosyal-medya-galeri';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'CollectionPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Sosyal Medya Galerisi', url },
  ],
});

const sayfalar = [
  {
    no: '01',
    name: 'Mevlânâ Aynası',
    url: '/01-mevlana-aynasi',
    image: '/sosyal-medya/01-mevlana-aynasi.png',
    aspect: 'square',
    kategori: 'Varyasyon A · Felsefi köprü',
    ton: 'Bilge · mütevazi-derin',
    versions: [
      { v: 'V1', image: '/sosyal-medya/versions/01-v1.png', not: 'Orijinal · müze posteri · halo yok · Mevlânâ + ayna kompozisyonu' },
      { v: 'V2', image: '/sosyal-medya/versions/01-v2.png', not: 'Saf #ff0000 + kırmızı/siyah dış ışıma + "Gonet." imzası — fazla yoğun' },
      { v: 'V3', image: '/sosyal-medya/versions/01-v3.png', not: 'Halo sadece ana başlıkta · saf kırmızı düz · imza çıkarıldı' },
      { v: 'V4', image: '/sosyal-medya/versions/01-v4.png', not: 'Final · halo yok · alt gri footnote eklendi', current: true },
    ],
    caption: `800 yıl önce Mevlânâ söylemişti.
Bugün yapay zekâ için de geçerli.

Sorduğun sorunun derinliği, alacağın cevabın tavanıdır.
Promptunun cesareti, ürettiğin işin sınırıdır.

Yeni gonet.com.tr yayında. İzmir'in AI ile baştan inşa edilmiş ilk ajans sitelerinden biri.
Bir sonraki "ilk"i birlikte yazalım.

— Gökhan Kazancı, Gonet.

#yapayzeka #ai #gonet #izmir`,
    anatomi: [
      { etiket: 'Çerçeve', deger: 'AIDA (Attention → Interest → Desire → Action)' },
      { etiket: 'Teknik', deger: 'Authority Borrow + Cross-Temporal Bridge — eski hakikat × yeni teknoloji' },
      { etiket: 'Neden işler', deger: 'Tanıdık otorite (Mevlânâ) + güncel kaygı (AI) → çarpışma noktasında insan durup düşünür. Bilgelik framing\'i marka iddiasını yumuşatır.' },
      { etiket: 'Risk', deger: 'Düşük — alıntılanabilir, paylaşılabilir' },
      { etiket: 'Beklenen etki', deger: 'Bilgi paylaşımı + soft brand recall, B2B karar verici dikkati' },
    ],
  },
  {
    no: '02',
    name: 'Kırmızı Nokta',
    url: '/02-kirmizi-nokta',
    image: '/sosyal-medya/02-kirmizi-nokta.png',
    aspect: 'square',
    kategori: 'Varyasyon B-1 · Manifesto',
    ton: 'İddialı manifesto · kıvrak gurur',
    versions: [
      { v: 'V1', image: '/sosyal-medya/versions/02-v1.png', not: 'Orijinal · "Yine bir ilk. Yine GoNet." + crimson nokta + dalga' },
      { v: 'V2', image: '/sosyal-medya/versions/02-v2.png', not: 'Saf kırmızı + glow halo · "GONET." kırmızıya dönüştü · siyah ink-bleed' },
      { v: 'V3', image: '/sosyal-medya/versions/02-v3.png', not: 'Halo sadece başlıkta · saf kırmızı düz nokta' },
      { v: 'V4', image: '/sosyal-medya/versions/02-v4.png', not: 'Final · halo yok · footnote eklendi', current: true },
    ],
    caption: `Markaların çoğunun ilk web sitesinde biz vardık.
İlk Google reklamlarında biz vardık.
İlk e-ticaret denemelerinde biz vardık.

Yapay zekâ herkes için yeni bir başlangıç çizgisi çekti.
Biz başlangıç çizgilerine alışığız.

gonet.com.tr yenilendi — İzmir'in AI ile baştan inşa edilmiş ilk ajans sitelerinden biri.

Önümüzdeki "ilk"i birlikte yazalım.

#yenilendik #gonet #ai #izmir`,
    anatomi: [
      { etiket: 'Çerçeve', deger: 'Sosyal Kanıt Yığını + Reframe (yeniden konumlandırma)' },
      { etiket: 'Teknik', deger: 'Repetition Hook ("ilk… ilk… ilk…") + Pattern Interrupt (devasa beyaz alan, tek kırmızı nokta)' },
      { etiket: 'Neden işler', deger: 'Tekrar otorite kurar; "başlangıç çizgisi" reframe rakipleri sıfıra eşitler, GoNet\'i deneyim avantajıyla ayrıştırır. Boş alan tipografiyi yükseltir.' },
      { etiket: 'Risk', deger: 'Orta — fazla "biz biz biz" risk taşır; son satır "alışığız" mütevazi tonla dengeler' },
      { etiket: 'Beklenen etki', deger: 'Yüksek engagement (manifesto paylaşılır), kuruluş yıldönümü duygusu' },
    ],
  },
  {
    no: '03',
    name: 'Numara Bir',
    url: '/03-numara-bir',
    image: '/sosyal-medya/03-numara-bir.png',
    aspect: 'square',
    kategori: 'Varyasyon B-2 · Tipografik ilk',
    ton: 'Minimal-sembolik',
    versions: [
      { v: 'V1', image: '/sosyal-medya/versions/03-v1.png', not: 'Orijinal · dev "1" rakamı · serif · crimson tepe noktası' },
      { v: 'V2', image: '/sosyal-medya/versions/03-v2.png', not: 'Saf #ff0000 + glow · Inter heavy "1" · "Gonet." imza eklendi' },
      { v: 'V3', image: '/sosyal-medya/versions/03-v3.png', not: 'Halo sadece "1"in kendisinde · saf kırmızı düz' },
      { v: 'V4', image: '/sosyal-medya/versions/03-v4.png', not: 'Final · halo yok · sade dev 1 + footnote', current: true },
    ],
    caption: `1.

İlki yapmak kolay değil.
Ama 26 yıldır yapıyorsak — şimdi de yaparız.

gonet.com.tr yenilendi.
İzmir'in AI ile baştan inşa edilmiş ilk ajans sitelerinden biri.

#gonet #1 #ai`,
    anatomi: [
      { etiket: 'Çerçeve', deger: 'Iconic Reduction — tek sembol = tüm mesaj (Apple-vari)' },
      { etiket: 'Teknik', deger: 'Visual Hierarchy Inversion — sembol %80, metin %20. Rakamın noktası kırmızı: "i" + nokta + "1" semantik üst üste bindirme.' },
      { etiket: 'Neden işler', deger: 'Boş alan + tek dev sembol scroll\'da gözü yakalar. "1" hem rakam hem semboldür (ilk, lider). Düşük bilişsel yük, yüksek görsel hafıza.' },
      { etiket: 'Risk', deger: 'Düşük (estetik), orta (mesaj eksikliği — caption ile tamamlanır)' },
      { etiket: 'Beklenen etki', deger: 'Estetik beğeni, kaydetme/yer imi, portfolio-quality grafik' },
    ],
  },
  {
    no: '04',
    name: 'AI Zeki. Sen?',
    url: '/04-ai-zeki-sen',
    image: '/sosyal-medya/04-ai-zeki-sen.png',
    aspect: 'square',
    kategori: 'Varyasyon C-1 · Shockvertising',
    ton: 'Provokatif · Toscani modu · agitation',
    versions: [
      { v: 'V1', image: '/sosyal-medya/versions/04-v1.png', not: 'Orijinal · "AI zeki. / Sen?" bold tipografi · sol alt crimson nokta' },
      { v: 'V2', image: '/sosyal-medya/versions/04-v2.png', not: 'Inter ultra-bold + siyah ink-bleed halo + "Gonet." imzası' },
      { v: 'V3', image: '/sosyal-medya/versions/04-v3.png', not: 'Halo sadece "SEN?" üzerinde · saf kırmızı düz' },
      { v: 'V4', image: '/sosyal-medya/versions/04-v4.png', not: 'Final · halo yok · düz tipografi + footnote', current: true },
    ],
    caption: `Yapay zekâ promptunu büyütmez. Sadece yansıtır.

Düz soru → düz cevap.
Korkak soru → ortalama cevap.
Cesur soru → cesur iş.

AI çağında en ucuz şey: ortalama.
En değerli şey: ne sorduğunu bilen insan.

Mevlânâ 800 yıl önce söylemişti:
"Ne kadar bilirsen bil, anlattıkların karşındakinin anlayabildiği kadardır."

AI da öyle.

Yeni gonet.com.tr yayında.
Kreatif zekânın elinde AI'nın ne yapabildiğini görmek isteyenler için.

— Gökhan Kazancı, Gonet kurucusu

#ai #yapayzeka #gonet`,
    anatomi: [
      { etiket: 'Çerçeve', deger: 'PAS — Problem (AI seni kurtarmaz) · Agitation (ucuz şey: ortalama) · Solution (Gonet, kreatif zekâ)' },
      { etiket: 'Teknik', deger: 'Shockvertising (Toscani/Benetton) — soru işareti yüze tokat. Antagonism Frame (rakipler isimsiz hedef). Pattern Interrupt: ultra-kısa 2 satır beyaz boşluğa karşı.' },
      { etiket: 'Neden işler', deger: 'Egoya dokunur ("Sen?"), düşünce hattını kırar. Yanlış kitlede iticidir; doğru kitlede (karar verici, yaratıcı yönetim) "ben de böyle düşünüyorum" tepkisi.' },
      { etiket: 'Risk', deger: 'Yüksek — polarize eder. İsim verilmemesi yasal güvence; ton uzun süreli marka çağrışımıyla dengelenmeli.' },
      { etiket: 'Beklenen etki', deger: 'Yüksek viralite + tartışma. Yorumlar yağar. "GoNet bunu konuşuyor" bilinci.' },
    ],
  },
  {
    no: '05',
    name: 'Yansıma',
    url: '/05-yansima',
    image: '/sosyal-medya/05-yansima.png',
    aspect: 'square',
    kategori: 'Varyasyon C-2 · Visual metaphor',
    ton: 'Felsefi-acı · soft provocation',
    versions: [
      { v: 'V1', image: '/sosyal-medya/versions/05-v1.png', not: 'Orijinal · iki silüet + dikey kırmızı hat · "AI seni yansıtır"' },
      { v: 'V2', image: '/sosyal-medya/versions/05-v2.png', not: 'Saf kırmızı + glow + "Gonet." imza · kompozisyon biraz dağıldı' },
      { v: 'V3', image: '/sosyal-medya/versions/05-v3.png', not: 'Halo sadece alt başlıkta · saf düz kırmızı hat' },
      { v: 'V4', image: '/sosyal-medya/versions/05-v4.png', not: 'Final · halo yok · clean kompozisyon + footnote', current: true },
    ],
    caption: `AI seni yansıtır.
Daha fazlasını değil.

Ne sorarsan onu görürsün.
Ne kadar derinleşirsen o kadar derinleşir.

Yeni gonet.com.tr yayında — AI'ı bir araç olarak değil, bir ayna olarak gören insanlar için.

İzmir'in AI ile baştan inşa edilmiş ilk ajans sitelerinden biri.

#ai #yapayzeka #gonet`,
    anatomi: [
      { etiket: 'Çerçeve', deger: 'Visual Metaphor + Soft PAS — saldırgan değil, düşündürür' },
      { etiket: 'Teknik', deger: 'İki silüet + kırmızı dikey hat (narrative axis / sınır metaforu). C-1\'in kardeşi ama Mevlânâ üslubuna yakın.' },
      { etiket: 'Neden işler', deger: 'Görsel kompozisyon mesajı taşır — yansıma fiziksel olarak symmetrytir, kırmızı dikey hat anlatımın eksenidir. Mesaj görsele paralel.' },
      { etiket: 'Risk', deger: 'Düşük-orta — herkes anlamayabilir ama anlayanlar derinden anlar' },
      { etiket: 'Beklenen etki', deger: 'Düşünce paylaşımı, "kayda değer içerik" yer imi, premium algı' },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical={url} schemas={pageSchema} hideFooter={true}>
  <!-- Fullscreen slider — tek seferde bir slide görünür, prev/next ile geçiş -->
  <div class="hpan" id="hpan">
    <div class="hpan-track" id="hpan-track">
      <!-- Slide 0: Hero -->
      <section class="hpan-slide hpan-intro">
        <p class="text-[10px] uppercase tracking-[0.4em] font-medium mb-6">2026 · Lansman Postları</p>
        <h1 class="editorial-display text-[12vw] xl:text-[180px] leading-[0.85] mb-8">
          Sosyal Medya<br />Galerisi.
        </h1>
        <p class="text-xl xl:text-2xl leading-snug max-w-xl mb-10">
          5 varyasyon, üç farklı strateji. <strong>Mevlânâ köprüsü</strong>, manifesto,
          <strong style="color:#ff0000">Toscani provokasyonu</strong>. Hangisi yayınlansın?
        </p>
        <p class="text-[10px] uppercase tracking-[0.3em] opacity-60">→ İleri</p>
      </section>

      <section class="hpan-pages" id="hpan-pages">
        <div class="hpan-empty-card paper-sheet" aria-hidden="true"></div>
        {sayfalar.map((s, idx) => (
          <article class="hpan-page" data-idx={idx}>
            <div class="hpan-meta">
              <p class="editorial-display text-[8vw] xl:text-[110px] leading-[0.85] mb-3">{s.no}</p>
              <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-2" style="color:#ff0000">{s.kategori}</p>
              <h2 class="editorial-display text-2xl xl:text-4xl leading-[0.9] mb-3">{s.name}</h2>
              <p class="text-[10px] font-medium uppercase tracking-[0.3em] opacity-70 mb-3">{s.ton}</p>
              <span class="text-xs font-mono uppercase tracking-[0.2em] opacity-60 inline-block mb-4">post · 1:1</span>
              <p class="text-sm leading-relaxed italic">"{s.caption.split('\n')[0]}"</p>

              <div class="hpan-meta-tabs">
                <button class="hpan-meta-tab is-active" data-tab="yayin" type="button">Yayın</button>
                <button class="hpan-meta-tab" data-tab="anatomi" type="button">Anatomi</button>
              </div>

              <div class="hpan-meta-tab-content is-active" data-tab-content="yayin">
                <div class="hpan-meta-caption">{s.caption}</div>
              </div>

              <div class="hpan-meta-tab-content" data-tab-content="anatomi">
                <dl class="hpan-meta-anatomi">
                  {s.anatomi.map((a) => (
                    <>
                      <dt>{a.etiket}</dt>
                      <dd>{a.deger}</dd>
                    </>
                  ))}
                </dl>
              </div>

              {/* Discuss butonu sağ sütuna (akordiyon üstüne) taşındı */}
            </div>
            <div class={`hpan-image ${s.aspect === 'landscape' ? 'is-landscape' : ''} ${s.aspect === 'mobile' ? 'is-mobile' : ''} ${s.aspect === 'square' ? 'is-square' : ''}`}>
              <a
                data-image-src={s.image}
                data-image-title={s.name}
                href={s.image}
                class="paper-sheet lightbox-trigger block relative overflow-hidden bg-white hpan-image-link"
                aria-label={`${s.name} — tam ekran aç`}
              >
                <img
                  src={s.image}
                  alt={`${s.name} — sosyal medya post varyasyonu`}
                  class="hpan-image-img block w-full h-full object-contain"
                  loading="lazy"
                />
              </a>
            </div>

            {/* Sağ sütun: discuss kart (üstte) + versiyon seçici (altta), flex.
                V4 (final) akordiyonda en üstte, V1 en altta. */}
            <div class="hpan-page-side">
              <aside class="hpan-page-discuss" aria-label="Tasarım hakkında konuş">
                <button
                  type="button"
                  data-feedback-open
                  data-feedback-intent="discussion"
                  data-feedback-title={`${s.name} — bu tasarım hakkında ne düşünüyorsun?`}
                  data-feedback-eyebrow={`— Tasarım sohbeti · Sadece bu post`}
                  data-feedback-placeholder="Tasarımla ilgili görüşünü yaz…"
                  data-feedback-welcome={`Hoş geldin. "${s.name}" tasarımı hakkındaki düşüncelerini dinlemek istiyorum. Söylediklerin bu tasarımın bir sonraki revizyonunda kullanılabilir — sondaki onay seninde, istediğin zaman iptal edebilirsin. (KVKK · 6 ay retention)`}
                  data-source-url={`https://gonet.com.tr/sosyal-medya-galeri${s.url}`}
                  data-source-title={`Sosyal Medya · ${s.no} ${s.name}`}
                  class="hpan-page-discuss-btn"
                >
                  <span>Ne düşünüyorsun?</span>
                  {/* Hibrit AI ikonu: konuşma balonu + büyük "AI" lettermark + 4-point sparkle */}
                  <svg class="hpan-page-discuss-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M19 11.5a7 7 0 0 1-10.3 6.18L4.5 18.5l1.2-3.6A7 7 0 1 1 19 11.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <text x="11.5" y="14.2" font-family="Inter, system-ui, sans-serif" font-size="9.5" font-weight="800" text-anchor="middle" fill="currentColor" stroke="none" style="letter-spacing:-0.3px">AI</text>
                    <path d="M21 3 L21.7 4.8 L23.5 5.5 L21.7 6.2 L21 8 L20.3 6.2 L18.5 5.5 L20.3 4.8 Z" fill="currentColor" stroke="none"/>
                  </svg>
                </button>
                <p class="hpan-page-discuss-text">
                  Tasarımla ilgili düşüncelerini AI ile konuş.<br />
                  Görüşün bir sonraki revizyona yansıyabilir.
                </p>
              </aside>

              <aside class="hpan-page-acc" aria-label={`${s.name} versiyonlar`}>
                {[...s.versions].reverse().map((v, vi) => (
                  <div
                    class={`hpan-page-acc-item ${vi === 0 ? 'is-open' : ''}`}
                    data-ver-src={v.image}
                    data-ver-label={v.v}
                  >
                    <button
                      class="hpan-page-acc-head"
                      type="button"
                      aria-expanded={vi === 0 ? 'true' : 'false'}
                    >
                      <span class="hpan-page-acc-no">{v.v}</span>
                      {v.current && <span class="hpan-page-acc-final">final</span>}
                      <span class="hpan-page-acc-arrow" aria-hidden="true"></span>
                    </button>
                    <div class="hpan-page-acc-body">
                      <p class="hpan-page-acc-note">{v.not}</p>
                    </div>
                  </div>
                ))}
              </aside>
            </div>
          </article>
        ))}
      </section>

      <!-- Last slide: CTA — public/reklam yüzü, müşteri çekme amacı.
           Görüşelim butonu /iletisim'e yönlendirir. Mouse butona yaklaşınca
           soru işareti kaçmayı bırakıp doğal yerine döner (grow-q JS davranışı). -->
      <section class="hpan-slide hpan-cta">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-8">Lansman için</p>
        <h2 class="editorial-display text-[10vw] xl:text-[140px] leading-[0.85] mb-8">
          Hangisini<br /><span style="color:#ff0000">Yayınlıyoruz<span class="grow-q">?</span></span>
        </h2>
        <p class="text-base xl:text-lg leading-snug max-w-xl mb-6 opacity-70">
          Önerim: <strong>02 Kırmızı Nokta</strong> ana lansman postu.<br />
          Bir hafta sonra <strong>01 Mevlânâ</strong>, sonrasında <strong>04 AI Zeki / Sen?</strong> — tartışma yarat.
        </p>
        <p class="text-base xl:text-lg leading-snug max-w-xl mb-10">
          Senin markan için de böyle bir kafa lazımsa — <strong>konuşalım.</strong>
        </p>
        <a
          href="/iletisim"
          class="inline-block text-xl xl:text-2xl font-bold uppercase tracking-[0.2em] underline decoration-2 underline-offset-8 hover:decoration-4 transition-all"
        >
          Görüşelim →
        </a>
      </section>
    </div>

    <button class="hpan-arrow hpan-prev" id="hpan-prev" aria-label="Önceki">
      <svg class="arrow-svg" viewBox="0 0 80 20" aria-hidden="true">
        <polyline points="10,4 2,10 10,16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <line class="arrow-shaft" x1="14" y1="10" x2="78" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="64" stroke-dashoffset="64" />
      </svg>
    </button>
    <button class="hpan-arrow hpan-next" id="hpan-next" aria-label="Sonraki">
      <svg class="arrow-svg" viewBox="0 0 80 20" aria-hidden="true">
        <line class="arrow-shaft" x1="66" y1="10" x2="2" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="64" stroke-dashoffset="64" />
        <polyline points="70,4 78,10 70,16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    {/* Eski global akordiyon kaldırıldı — yerine per-slide .hpan-page-acc geldi */}

    <div class="hpan-controls">
      <span class="hpan-count" id="hpan-count">1 / 7</span>
      <div class="hpan-dots" id="hpan-dots"></div>
    </div>
  </div>

  <!-- Fullscreen lightbox -->
  <div class="lightbox" id="lightbox" hidden aria-modal="true" role="dialog" aria-label="Görsel ön izleme">
    <div class="lightbox-meta">
      <button class="lightbox-back" id="lightbox-close" aria-label="Geri dön">
        <svg class="lightbox-back-svg" viewBox="0 0 12 16" aria-hidden="true">
          <polyline points="9,2 2,8 9,14" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="lightbox-back-label">Geri Dön</span>
      </button>
      <span class="lightbox-title" id="lightbox-title"></span>
      <span class="lightbox-hint">
        <span class="lightbox-hint-line">Resme tıkla → zoom</span>
        <span class="lightbox-hint-line">ESC → kapat</span>
      </span>
    </div>
    <div class="lightbox-stage" id="lightbox-stage">
      <img class="lightbox-img" id="lightbox-img" alt="" />
    </div>
  </div>

  <style>
    @media (min-width: 1024px) {
      :global(html), :global(body) {
        overflow: hidden !important;
        height: 100vh !important;
      }
      :global(main) {
        height: calc(100vh - 80px);
        overflow: hidden;
      }
      .hpan {
        position: relative;
        width: 100%;
        height: calc(100vh - 80px);
        overflow: hidden;
        background: #fff;
      }
      .hpan-track {
        display: flex;
        height: 100%;
        width: max-content;
        will-change: transform;
        transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .hpan-slide {
        flex: 0 0 100vw;
        height: 100%;
        padding: 4vh 8vw;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: flex-start;
      }
      .hpan-intro, .hpan-cta {
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 4vh 10vw;
      }
      .hpan-pages {
        flex: 0 0 100vw;
        height: 100%;
        position: relative;
        padding: 5vh 8vw 12vh;
        box-sizing: border-box;
      }
      /* Sosyal post 1:1 — boş kart da kare olsun */
      .hpan-empty-card {
        position: absolute;
        top: 5vh;
        bottom: 12vh;
        left: 50%;
        transform: translateX(-50%);
        aspect-ratio: 1 / 1;
        background: #fff;
        z-index: 1;
      }
      .hpan-page {
        position: absolute;
        top: 5vh;
        left: 8vw;
        right: 8vw;
        bottom: 12vh;
        opacity: 1;
        pointer-events: none;
        z-index: 2;
      }
      .hpan-page.is-active { pointer-events: auto; }
      .hpan-meta {
        position: absolute;
        top: 0;
        bottom: 0;
        right: calc(50% + 40vh);
        width: 18vw;
        max-width: 280px;
        text-align: right;
        opacity: 0;
        transition: opacity 0.7s ease-out;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(0,0,0,0.18) transparent;
        padding-right: 0.4rem;
        box-sizing: border-box;
      }
      .hpan-meta::-webkit-scrollbar { width: 4px; }
      .hpan-meta::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.18);
        border-radius: 4px;
      }
      .hpan-page.is-active .hpan-meta {
        opacity: 0.62;
        transition: opacity 0.7s ease-in 0.6s;
      }
      .hpan-page.is-active .hpan-meta:hover {
        opacity: 0.95;
        transition: opacity 0.3s ease;
      }
      .hpan-meta > div > a { text-align: right; }
      /* Sosyal post varsayılan: kare */
      .hpan-image {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        aspect-ratio: 1 / 1;
        opacity: 0;
        transition: opacity 0.7s ease-out;
      }
      .hpan-image.is-landscape { aspect-ratio: 16 / 9; }
      .hpan-image.is-mobile    { aspect-ratio: 9 / 19.5; }
      .hpan-image.is-square    { aspect-ratio: 1 / 1; }
      .hpan-page.is-active .hpan-image {
        opacity: 1;
        transition: opacity 0.7s ease-in 0.6s;
      }
      .hpan-image > a {
        display: block;
        height: 100%;
        width: 100%;
        cursor: zoom-in;
      }
      .hpan-image > a > img {
        height: 100%;
        width: 100%;
        object-fit: contain;
        object-position: center;
      }

      .hpan-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: 0;
        padding: 0.75rem 1rem;
        cursor: pointer;
        color: #000;
        z-index: 5;
        display: inline-flex;
        align-items: center;
        transition: opacity 0.2s;
      }
      .hpan-prev { left: 1.5rem; }
      .hpan-next { right: 1.5rem; }
      .hpan-arrow:disabled {
        opacity: 0.2;
        cursor: not-allowed;
      }
      .arrow-svg {
        width: 64px;
        height: 18px;
        display: block;
      }
      .arrow-shaft {
        transition: stroke-dashoffset 0.45s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .hpan-arrow:hover:not(:disabled) .arrow-shaft {
        stroke-dashoffset: 0;
      }

      .hpan-controls {
        position: absolute;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 1.5rem;
        z-index: 5;
      }
      .hpan-count {
        font-family: var(--font-sans);
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        font-weight: 600;
        font-feature-settings: 'tnum';
      }
      .hpan-dots {
        display: flex;
        gap: 6px;
      }
      .hpan-dots button {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        border: 0;
        background: rgba(0, 0, 0, 0.18);
        cursor: pointer;
        padding: 0;
        transition: all 0.25s;
      }
      .hpan-dots button:hover { background: rgba(0, 0, 0, 0.4); }
      .hpan-dots button.is-active {
        background: #ff0000;
        width: 22px;
        border-radius: 4px;
      }

      /* Sağ accordion — kare canvas yarı genişliği ≈ (100vh-17vh)/2 ≈ 41vh.
         Bunu güvenli sınır için 44vh yaptık. */
      .hpan-acc {
        position: absolute;
        top: 5vh;
        bottom: 12vh;
        left: calc(50% + 44vh);
        width: 16vw;
        max-width: 320px;
        z-index: 5;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .hpan-acc::-webkit-scrollbar { display: none; width: 0; height: 0; }

      .hpan-acc-item {
        background: transparent;
        border: 0;
        border-top: 1px solid rgba(0, 0, 0, 0.15);
      }

      .hpan-acc-head {
        width: 100%;
        background: transparent;
        border: 0;
        padding: 1rem 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-family: var(--font-display, 'Anton', sans-serif);
        font-size: 1.5rem;
        line-height: 1;
        color: #000;
        opacity: 0.35;
        transition: opacity 0.3s ease;
        text-align: left;
      }
      .hpan-acc-head:hover { opacity: 0.85; }
      .hpan-acc-item.is-open .hpan-acc-head { opacity: 1; }

      .hpan-acc-no { font-feature-settings: 'tnum'; letter-spacing: 0.02em; }

      .hpan-acc-arrow {
        width: 12px;
        height: 12px;
        position: relative;
        transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
      }
      .hpan-acc-arrow::before,
      .hpan-acc-arrow::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 7px;
        height: 1px;
        background: currentColor;
      }
      .hpan-acc-arrow::before { left: 0; transform: rotate(45deg); transform-origin: left center; }
      .hpan-acc-arrow::after  { right: 0; transform: rotate(-45deg); transform-origin: right center; }
      .hpan-acc-item.is-open .hpan-acc-arrow { transform: rotate(180deg); }

      .hpan-acc-body {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.55s cubic-bezier(0.65, 0, 0.35, 1),
                    opacity 0.4s ease 0.05s,
                    padding 0.4s ease;
        padding: 0;
      }
      .hpan-acc-item.is-open .hpan-acc-body {
        max-height: 75vh;
        opacity: 1;
        padding: 0 0.5rem 1.5rem 0;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(0,0,0,0.18) transparent;
      }
      .hpan-acc-item.is-open .hpan-acc-body::-webkit-scrollbar {
        width: 4px;
      }
      .hpan-acc-item.is-open .hpan-acc-body::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.18);
        border-radius: 4px;
      }

      .hpan-acc-cat {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: #ff0000;
        margin: 0 0 0.5rem;
      }
      .hpan-acc-name {
        font-family: var(--font-display, 'Anton', sans-serif);
        font-size: 1.75rem;
        line-height: 0.95;
        margin: 0 0 0.85rem;
        color: #000;
      }
      .hpan-acc-link {
        display: inline-block;
        font-family: var(--font-mono, monospace);
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
        color: #000;
        margin-bottom: 0.85rem;
        transition: color 0.2s;
      }
      .hpan-acc-link:hover { color: #ff0000; }
      .hpan-acc-desc {
        font-size: 13px;
        line-height: 1.55;
        color: #000;
        margin: 0;
      }
    }

    @media (max-width: 1023px) {
      .lightbox-meta {
        padding: 12px 16px;
        gap: 12px;
      }
      .lightbox-title { display: none; }
      .lightbox-hint {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: right;
        line-height: 1.4;
      }
      .lightbox-hint-line {
        display: block;
        width: 100%;
        text-align: right;
      }
      .lightbox-hint-line + .lightbox-hint-line::before {
        content: none;
        padding: 0;
      }
    }

    .grow-q {
      display: inline-block;
      will-change: transform;
    }

    /* ───────── Accordion içerik genişletmesi: Ton, Section, Caption, Anatomi ─────────
       Media-query dışı ortak tanımlar — hem desktop hem mobilde aynı görünür. */
    .hpan-acc-ton {
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      font-weight: 500;
      opacity: 0.6;
      margin: 0 0 0.85rem;
      color: #000;
    }
    .hpan-acc-section {
      font-size: 9px;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      font-weight: 700;
      color: #ff0000;
      margin: 1.4rem 0 0.7rem;
      padding-top: 0.9rem;
      border-top: 1px solid rgba(0,0,0,0.12);
    }
    .hpan-acc-caption {
      white-space: pre-wrap;
      font-family: var(--font-sans);
      font-size: 12px;
      line-height: 1.55;
      color: #000;
      opacity: 0.88;
      margin: 0;
    }
    .hpan-acc-anatomi {
      margin: 0;
      font-size: 12px;
      line-height: 1.5;
    }
    .hpan-acc-anatomi dt {
      font-size: 9px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      font-weight: 600;
      color: #ff0000;
      margin-top: 0.85rem;
      margin-bottom: 0.25rem;
    }
    .hpan-acc-anatomi dt:first-of-type {
      margin-top: 0;
    }
    .hpan-acc-anatomi dd {
      margin: 0 0 0.6rem;
      color: #000;
      opacity: 0.85;
    }

    /* "Evrim" başlığı için border-top yok (ilk section) */
    .hpan-acc-section-first {
      margin-top: 0.5rem;
      padding-top: 0;
      border-top: 0;
    }

    /* Versiyon mini-kartları */
    /* ───────── Sol meta içinde Yayın + Anatomi (tab yapısı) ─────────
       İki tap (tab) — sadece bir içerik aktif. Scroll gitti, içerik
       ekrana sığar. Tablar sağa hizalı (meta sütununun gen. hizasıyla),
       içerik sola hizalı (uzun yazı okunabilir). */
    .hpan-meta-tabs {
      display: flex;
      gap: 1.25rem;
      margin: 1.4rem 0 0.85rem;
      padding-top: 0.9rem;
      border-top: 1px solid rgba(0,0,0,0.18);
      justify-content: flex-end;
    }
    .hpan-meta-tab {
      background: transparent;
      border: 0;
      padding: 0.35rem 0;
      font-family: var(--font-sans);
      font-size: 12px;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(0,0,0,0.4);
      cursor: pointer;
      transition: color 0.2s ease;
      position: relative;
    }
    .hpan-meta-tab:hover { color: rgba(0,0,0,0.75); }
    .hpan-meta-tab.is-active { color: #ff0000; }
    .hpan-meta-tab.is-active::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0.35em;
      bottom: -3px;
      height: 1.5px;
      background: #ff0000;
    }

    .hpan-meta-tab-content {
      display: none;
      text-align: left;
    }
    .hpan-meta-tab-content.is-active {
      display: block;
    }

    .hpan-meta-caption {
      white-space: pre-wrap;
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.6;
      color: #000;
      margin: 0;
      text-align: left;
    }
    .hpan-meta-anatomi {
      margin: 0;
      font-size: 14px;
      line-height: 1.55;
      text-align: left;
    }
    .hpan-meta-anatomi dt {
      font-size: 10.5px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      font-weight: 600;
      color: #ff0000;
      margin-top: 0.95rem;
      margin-bottom: 0.3rem;
    }
    .hpan-meta-anatomi dt:first-of-type {
      margin-top: 0;
    }
    .hpan-meta-anatomi dd {
      margin: 0 0 0.7rem;
      color: #000;
      opacity: 0.9;
    }

    /* AI ile Tartış butonu — yetenekler sayfasındaki pattern'in sol meta varyantı.
       Siyah border + beyaz BG, hover'da kırmızıya dönüşür. */
    .hpan-meta-discuss {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.6rem 1rem 0.55rem;
      border: 1px solid #000;
      background: #fff;
      color: #000;
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      margin: 1.6rem 0 0.6rem;
      text-align: left;
    }
    .hpan-meta-discuss:hover {
      background: #ff0000;
      color: #fff;
      border-color: #ff0000;
    }
    .hpan-meta-discuss-icon {
      width: 14px;
      height: 14px;
      flex: 0 0 14px;
    }
    .hpan-meta-discuss-note {
      font-size: 10.5px;
      line-height: 1.4;
      color: rgba(0,0,0,0.55);
      margin: 0 0 0.4rem;
      text-align: left;
      max-width: 24em;
    }

    /* ───────── Sağ sütun (.hpan-page-side) ─────────
       Flex container: discuss kart (üstte) + versiyon seçici akordiyon (altta).
       Slayt aktifken yumuşakça fade-in. */
    .hpan-page-side {
      position: absolute;
      top: 5vh;
      bottom: 12vh;
      left: calc(50% + 44vh);
      width: 16vw;
      max-width: 320px;
      z-index: 5;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      opacity: 0;
      transition: opacity 0.7s ease-out;
    }
    .hpan-page.is-active .hpan-page-side {
      opacity: 1;
      transition: opacity 0.7s ease-in 0.6s;
    }

    /* Discuss kart — buzlu cam, başlık metni + "Ne düşünüyorsun?" butonu */
    .hpan-page-discuss {
      flex: 0 0 auto;
      background: rgba(255,255,255,0.6);
      backdrop-filter: blur(10px) saturate(125%);
      -webkit-backdrop-filter: blur(10px) saturate(125%);
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: 4px;
      padding: 0.95rem 1rem;
      box-sizing: border-box;
    }
    .hpan-page-discuss-text {
      font-size: 13px;
      line-height: 1.55;
      color: rgba(0,0,0,0.75);
      margin: 0.75rem 0 0;
      text-align: left;
    }
    .hpan-page-discuss-btn {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      width: 100%;
      padding: 0.7rem 0.95rem;
      border: 1px solid #000;
      background: #fff;
      color: #000;
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .hpan-page-discuss-btn:hover {
      background: #ff0000;
      color: #fff;
      border-color: #ff0000;
    }
    .hpan-page-discuss-icon {
      width: 26px;
      height: 26px;
      flex: 0 0 26px;
    }

    /* Akordiyon — artık flex item (eski absolute pozisyonu kaldırıldı) */
    .hpan-page-acc {
      position: relative;
      top: auto;
      left: auto;
      bottom: auto;
      width: auto;
      max-width: none;
      flex: 1 1 auto;
      min-height: 0;
      background: rgba(255,255,255,0.55);
      backdrop-filter: blur(10px) saturate(125%);
      -webkit-backdrop-filter: blur(10px) saturate(125%);
      border: 1px solid rgba(0,0,0,0.06);
      border-radius: 4px;
      padding: 0.7rem 1rem;
      box-sizing: border-box;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(0,0,0,0.15) transparent;
    }
    .hpan-page-acc::-webkit-scrollbar { width: 4px; }
    .hpan-page-acc::-webkit-scrollbar-thumb {
      background: rgba(0,0,0,0.15);
      border-radius: 4px;
    }

    .hpan-page-acc-item {
      border-top: 1px solid rgba(0,0,0,0.12);
    }
    .hpan-page-acc-item:first-child {
      border-top: 0;
    }
    .hpan-page-acc-head {
      width: 100%;
      background: transparent;
      border: 0;
      padding: 0.85rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      font-family: var(--font-display, 'Anton', sans-serif);
      font-size: 1.3rem;
      line-height: 1;
      color: #000;
      opacity: 0.4;
      transition: opacity 0.3s ease;
      text-align: left;
      font-feature-settings: 'tnum';
      letter-spacing: 0.02em;
    }
    .hpan-page-acc-head:hover { opacity: 0.85; }
    .hpan-page-acc-item.is-open .hpan-page-acc-head { opacity: 1; }
    .hpan-page-acc-no { flex: 0 0 auto; }
    .hpan-page-acc-final {
      font-family: var(--font-sans);
      font-size: 9px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      font-weight: 700;
      color: #ff0000;
      margin-left: 0.4rem;
    }
    .hpan-page-acc-arrow {
      width: 12px;
      height: 12px;
      position: relative;
      transition: transform 0.4s cubic-bezier(0.65, 0, 0.35, 1);
      margin-left: auto;
    }
    .hpan-page-acc-arrow::before,
    .hpan-page-acc-arrow::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 7px;
      height: 1px;
      background: currentColor;
    }
    .hpan-page-acc-arrow::before { left: 0; transform: rotate(45deg); transform-origin: left center; }
    .hpan-page-acc-arrow::after  { right: 0; transform: rotate(-45deg); transform-origin: right center; }
    .hpan-page-acc-item.is-open .hpan-page-acc-arrow { transform: rotate(180deg); }
    .hpan-page-acc-body {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.45s cubic-bezier(0.65, 0, 0.35, 1),
                  opacity 0.3s ease 0.05s,
                  padding 0.3s ease;
      padding: 0;
    }
    .hpan-page-acc-item.is-open .hpan-page-acc-body {
      max-height: 20vh;
      opacity: 1;
      padding: 0 0 0.85rem 0;
    }
    .hpan-page-acc-note {
      font-size: 11px;
      line-height: 1.45;
      color: #000;
      opacity: 0.8;
      margin: 0;
    }

    /* Mobil: sağ sütun (discuss + acc) normal düşey akış */
    @media (max-width: 1023px) {
      .hpan-page-side {
        position: relative;
        inset: auto;
        left: auto;
        top: auto;
        bottom: auto;
        width: 100%;
        max-width: none;
        opacity: 1 !important;
        margin-top: 1.5rem;
        gap: 1rem;
      }
      .hpan-page-discuss {
        background: rgba(255,255,255,0.85);
      }
      .hpan-page-discuss-btn {
        font-size: 12px;
      }
      .hpan-page-acc {
        position: relative;
        inset: auto;
        left: auto;
        top: auto;
        bottom: auto;
        width: 100%;
        max-width: none;
        opacity: 1 !important;
        background: rgba(255,255,255,0.85);
      }
      .hpan-meta {
        position: relative;
        inset: auto;
        right: auto;
        width: 100%;
        max-width: none;
        text-align: left;
        opacity: 1 !important;
        margin-bottom: 2rem;
        overflow: visible;
      }
      .hpan-meta-section { text-align: left; }
    }

    /* Bu class artık kullanılmıyor (eski global akordiyon) — referans için bırakıldı */
    .hpan-acc-versions {
      list-style: none;
      margin: 0 0 0.5rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .hpan-acc-versions li {
      display: flex;
      gap: 0.65rem;
      align-items: flex-start;
      padding: 0.45rem 0;
      border-bottom: 1px dashed rgba(0,0,0,0.1);
      position: relative;
    }
    .hpan-acc-versions li:last-child {
      border-bottom: 0;
    }
    .hpan-acc-versions li.is-current::before {
      content: '';
      position: absolute;
      left: -10px;
      top: 0.55rem;
      bottom: 0.85rem;
      width: 2px;
