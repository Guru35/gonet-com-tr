      .hpan-acc-arrow::after  { right: 0; transform: rotate(-45deg); transform-origin: right center; }
      .hpan-acc-item.is-open .hpan-acc-arrow { transform: rotate(180deg); }
      .hpan-acc-body {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
