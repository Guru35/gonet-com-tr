---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema } from '../lib/schema';

const title = 'İstatistikler — Ultra Minimal | Gonet';
const description = '26 yıllık Gonet verisi — saf siyah-beyaz, tek satır, sayısız fill, sayısız renk.';
const url = 'https://gonet.com.tr/istatistik1';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'WebPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'İstatistikler (Ultra Minimal)', url },
  ],
});

// — Veri seti (aynı veriler) —
const sectors = [
  { name: 'Sanayi & Elektronik', n: 25 },
  { name: 'İnşaat & Gayrimenkul', n: 22 },
  { name: 'Gıda & FMCG', n: 20 },
  { name: 'Sağlık', n: 18 },
  { name: 'Eğitim', n: 12 },
  { name: 'Turizm & Otelcilik', n: 10 },
  { name: 'E-ticaret', n: 9 },
  { name: 'Otomotiv', n: 8 },
  { name: 'Tekstil & Konfeksiyon', n: 7 },
  { name: 'Siyaset & Kamu', n: 6 },
  { name: 'Mobilya', n: 5 },
  { name: 'Mobil API', n: 6 },
  { name: 'Holding & Kurumsal', n: 5 },
  { name: 'Birlikler & Ticaret', n: 5 },
  { name: 'Diğer', n: 62 },
];
const maxN = Math.max(...sectors.map((s) => s.n));
const totalBrands = sectors.reduce((s, x) => s + x.n, 0);

const services = [
  { name: 'Web Tasarım', pct: 28 },
  { name: 'Google Ads / SEM', pct: 22 },
  { name: 'SEO', pct: 15 },
  { name: 'Sosyal Medya', pct: 14 },
  { name: 'Marka & Kreatif', pct: 9 },
  { name: 'AEO / GEO', pct: 7, accent: true },
  { name: 'Diğer', pct: 5 },
];

const yearMs = [
  { y: 2000, n: 2 }, { y: 2003, n: 1 }, { y: 2005, n: 1 }, { y: 2007, n: 3 },
  { y: 2008, n: 1 }, { y: 2009, n: 1 }, { y: 2010, n: 1 }, { y: 2011, n: 1 },
  { y: 2013, n: 1 }, { y: 2014, n: 1 }, { y: 2015, n: 1 }, { y: 2017, n: 1 },
  { y: 2019, n: 1 }, { y: 2020, n: 1 }, { y: 2022, n: 1 }, { y: 2023, n: 1 },
  { y: 2024, n: 1 }, { y: 2025, n: 1 }, { y: 2026, n: 2 },
];

const social = [
  { name: 'LinkedIn', val: 16084, lbl: '16K takipçi' },
  { name: 'Behance', val: 23000, lbl: '23K izlenme' },
  { name: 'Instagram', val: 2000, lbl: 'aktif' },
  { name: 'Facebook', val: 800, lbl: 'sayfa' },
  { name: 'SlideShare', val: 500, lbl: 'sunum' },
];
const socialTot = social.reduce((s, x) => s + x.val, 0);

// Line chart points
function linePts(pts: { y: number; n: number }[], w = 1000, h = 100) {
  const xs = pts.map((p) => p.y);
  const ns = pts.map((p) => p.n);
  const xMin = Math.min(...xs), xMax = Math.max(...xs);
  const nMax = Math.max(...ns);
  return pts.map((p) => ({
    x: ((p.y - xMin) / (xMax - xMin)) * w,
    yPos: h - (p.n / nMax) * h,
    ...p,
  }));
}
const linePoints = linePts(yearMs);
const linePathD = linePoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.yPos.toFixed(1)}`).join(' ');

// Annular ring segments (servis donut'u — sadece outline)
function annularSegments(items: { pct: number; accent?: boolean }[], r = 95) {
  let acc = 0;
  return items.map((it) => {
    const start = acc;
    const end = acc + it.pct;
    acc = end;
    const a1 = (start / 100) * 2 * Math.PI - Math.PI / 2;
    const a2 = (end / 100) * 2 * Math.PI - Math.PI / 2;
    const x1 = 100 + r * Math.cos(a1);
    const y1 = 100 + r * Math.sin(a1);
    const x2 = 100 + r * Math.cos(a2);
    const y2 = 100 + r * Math.sin(a2);
    const large = it.pct > 50 ? 1 : 0;
    return { ...it, d: `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${r} ${r} 0 ${large} 1 ${x2.toFixed(2)} ${y2.toFixed(2)}` };
  });
}
const ringSegs = annularSegments(services);
---

<BaseLayout title={title} description={description} canonical={url} schemas={pageSchema} noindex={true}>
  <!-- HERO — sadece massive sayı + tek hairline -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-20 lg:pt-28 pb-12">
      <nav class="text-[10px] uppercase tracking-[0.3em] font-medium mb-20 lg:mb-28">
        <ol class="flex items-center gap-3 flex-wrap">
          <li><a href="/" class="hover:underline">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="opacity-60">İstatistikler · Minimal</li>
        </ol>
      </nav>
      <p class="text-[10px] uppercase tracking-[0.4em] mb-10">Veri · 26 Yıl</p>
      <h1 class="editorial-display text-[20vw] lg:text-[16vw] xl:text-[240px] leading-[0.82] mb-6">Sayılarla.</h1>
      <hr class="border-0 h-px bg-black w-1/3 my-0" />
    </div>
  </section>

  <!-- 4 DEVASA SAYI — tek satır, ayraç hairline -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-y-16 gap-x-6 lg:gap-x-10">
        {[
          { n: `${totalBrands}+`, l: 'marka' },
          { n: `${sectors.length}`, l: 'sektör' },
          { n: '26', l: 'yıl' },
          { n: '12+', l: 'türkiye ilki', accent: true },
        ].map((s) => (
          <div>
            <p class="editorial-display text-[20vw] lg:text-[8vw] xl:text-[130px] leading-[0.85]" style={s.accent ? 'color:#ff0000' : ''}>{s.n}</p>
            <hr class="border-0 h-px bg-black w-12 my-3" />
            <p class="text-[10px] uppercase tracking-[0.3em]" style={s.accent ? 'color:#ff0000' : ''}>{s.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/2 mx-6 lg:mx-10 max-w-7xl" />

  <!-- BAR — sadece çizgi + sayı, dolgu yok -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">01 · Sektör</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Dağılım.</h2>
      <div class="space-y-5">
        {sectors.map((s) => {
          const pct = (s.n / maxN) * 100;
          return (
            <div class="flex items-baseline gap-4 lg:gap-8">
              <span class="text-xs lg:text-sm w-40 lg:w-60 shrink-0 truncate">{s.name}</span>
              <span class="flex-1 relative h-px bg-black/15">
                <span class="absolute left-0 top-1/2 -translate-y-1/2 h-px bg-black" style={`width: ${pct}%;`}></span>
              </span>
              <span class="editorial-display text-base lg:text-2xl w-12 text-right shrink-0">{s.n}</span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/3 mx-6 lg:mx-10 max-w-7xl ml-auto" />

  <!-- RING — donut yerine sadece outline arc + tick'ler -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-[10px] uppercase tracking-[0.4em] mb-8">02 · Hizmet</p>
        <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Karışım.</h2>
        <ul class="space-y-5">
          {services.map((s) => (
            <li class="flex items-baseline gap-4 border-b border-black/15 pb-3">
              <span class="text-sm lg:text-base" style={s.accent ? 'color:#ff0000' : ''}>{s.name}</span>
              <span class="ml-auto editorial-display text-2xl lg:text-3xl" style={s.accent ? 'color:#ff0000' : ''}>%{s.pct}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <svg viewBox="0 0 200 200" width="100%" style="max-width: 320px;" aria-hidden="true">
          {ringSegs.map((seg) => (
            <path d={seg.d} stroke={seg.accent ? '#ff0000' : '#000'} stroke-width={seg.accent ? '2.5' : '1.2'} fill="none" />
          ))}
          {/* Tick marks her segment başında */}
          {ringSegs.map((seg, i) => {
            const angle = (services.slice(0, i).reduce((a, b) => a + b.pct, 0) / 100) * 2 * Math.PI - Math.PI / 2;
            const x1 = 100 + 88 * Math.cos(angle);
            const y1 = 100 + 88 * Math.sin(angle);
            const x2 = 100 + 100 * Math.cos(angle);
            const y2 = 100 + 100 * Math.sin(angle);
            return <line x1={x1.toFixed(2)} y1={y1.toFixed(2)} x2={x2.toFixed(2)} y2={y2.toFixed(2)} stroke="#000" stroke-width="1" />;
          })}
          <text x="100" y="105" text-anchor="middle" font-family="var(--font-display)" font-size="28" fill="#000">100</text>
          <text x="100" y="118" text-anchor="middle" font-size="7" letter-spacing="2">%</text>
        </svg>
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/4 mx-6 lg:mx-10 max-w-7xl" />

  <!-- LINE — sadece tek polyline, eksen yok -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">03 · Yıl bazında</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">İlkler.</h2>
      <svg viewBox="0 -20 1000 140" width="100%" class="block">
        <path d={linePathD} stroke="#000" stroke-width="1" fill="none" />
        {linePoints.map((p) => (
          p.n > 1 ? (
            <g>
              <circle cx={p.x} cy={p.yPos} r="3" fill="#ff0000" stroke="none" />
              <text x={p.x} y={p.yPos - 8} text-anchor="middle" font-size="11" font-weight="700" fill="#ff0000">{p.n}</text>
            </g>
          ) : (
            <circle cx={p.x} cy={p.yPos} r="1.5" fill="#000" />
          )
        ))}
      </svg>
      <div class="flex justify-between text-[10px] tracking-[0.2em] opacity-60 mt-2">
        <span>2000</span>
        <span>2007</span>
        <span>2014</span>
        <span>2020</span>
        <span>2026</span>
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/2 mx-6 lg:mx-10 max-w-7xl ml-auto" />

  <!-- PIE → minimum: tally bar olarak göster -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">04 · Sosyal</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Kanallar.</h2>
      <div class="space-y-8 lg:space-y-10 max-w-4xl">
        {social.map((s) => {
          const pct = (s.val / socialTot) * 100;
          return (
            <div>
              <div class="flex items-baseline gap-6 mb-2">
                <span class="editorial-display text-3xl lg:text-5xl">{s.name}</span>
                <span class="text-[10px] uppercase tracking-[0.3em] opacity-70">{s.lbl}</span>
                <span class="editorial-display text-xl lg:text-2xl ml-auto">%{pct.toFixed(1)}</span>
              </div>
              <div class="h-px bg-black/15 relative">
                <div class="absolute left-0 top-0 h-px bg-black" style={`width: ${pct}%;`}></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/3 mx-6 lg:mx-10 max-w-7xl" />

  <!-- ÖNEMLİ SAYILAR — 5 devasa + hairline rule altta -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">05 · Vurgu</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-20">Beş kritik sayı.</h2>
      <div class="space-y-20 lg:space-y-24">
        {[
          { n: '25K', label: 'DEÜ Uzaktan Eğitim — anlık eşzamanlı kullanıcı (Avrupa\'nın en büyüğü, 2014)' },
          { n: '16K', label: 'Gökhan Kazancı LinkedIn takipçi' },
          { n: '2009', label: 'Google Dublin Agencies@Google · Türkiye temsilcisi' },
          { n: 'İlk 3', label: 'Türkiye Google Partner ajansı · 2. Google Analytics partneri (2025)' },
          { n: '24', label: 'Behance projesi · 23.000 toplam izlenme' },
        ].map((it) => (
          <div class="grid grid-cols-12 gap-4 items-baseline">
            <p class="editorial-display col-span-12 lg:col-span-4 text-[24vw] lg:text-[10vw] xl:text-[180px] leading-[0.82]">{it.n}</p>
            <div class="col-span-12 lg:col-span-8">
              <hr class="border-0 h-px bg-black w-16 mb-4" />
              <p class="text-base lg:text-2xl leading-snug">{it.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/4 mx-6 lg:mx-10 max-w-7xl ml-auto" />

  <!-- SPARKLINE — 3 mikro trend, eksen yok, sadece çizgi + endpoint -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">06 · Mikro trend</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-20">Üç çizgi.</h2>
      <div class="grid lg:grid-cols-3 gap-16 lg:gap-12">
        {[
          { lbl: 'LinkedIn · 2020 → 2026', pts: '5,55 25,52 50,48 75,40 100,32 130,22 160,12 195,5', val: '16K+', accent: true },
          { lbl: 'Marka · 2000 → 2026', pts: '5,58 20,55 40,50 60,45 90,35 120,25 150,15 180,8 195,5', val: '220+' },
          { lbl: 'Schema entity · 2026', pts: '5,55 30,52 60,48 90,42 110,28 140,18 170,8 195,3', val: '220+', accent: true },
        ].map((t) => (
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] mb-6">{t.lbl}</p>
            <svg viewBox="0 -5 200 70" width="100%" class="block mb-6">
              <polyline points={t.pts} stroke={t.accent ? '#ff0000' : '#000'} stroke-width="1" fill="none" />
              <circle cx="195" cy={t.pts.split(' ').slice(-1)[0].split(',')[1]} r="2.5" fill={t.accent ? '#ff0000' : '#000'} />
            </svg>
            <hr class="border-0 h-px bg-black w-12 mb-4" />
            <p class="editorial-display text-4xl lg:text-6xl" style={t.accent ? 'color:#ff0000' : ''}>{t.val}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/2 mx-6 lg:mx-10 max-w-7xl ml-auto" />

  <!-- 07 · VERTICAL BAR — X/Y eksenli, hover'da detay -->
  <section class="bg-white" data-section-anim>
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">07 · Dikey bar</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Yıl × ilk.</h2>

      <svg viewBox="0 0 1000 360" width="100%" class="block" role="img" aria-label="Yıl bazında Türkiye ilki yoğunluğu">
        <!-- Y axis (0 → 3) -->
        {[0, 1, 2, 3].map((n) => {
          const yPos = 320 - n * 100;
          return (
            <g>
              <line x1="60" x2="990" y1={yPos} y2={yPos} stroke={n === 0 ? '#000' : '#e5e5e5'} stroke-width="1" />
              <text x="50" y={yPos + 4} text-anchor="end" font-size="11" fill="#737373">{n}</text>
            </g>
          );
        })}
        <!-- Y axis label -->
        <text x="20" y="60" font-size="10" letter-spacing="2" font-weight="700" fill="#000">İLK</text>
        <text x="20" y="75" font-size="10" letter-spacing="2" fill="#404040">SAYISI</text>

        <!-- Bars -->
        {yearMs.map((p, i) => {
          const xMin = 2000, xMax = 2026;
          const x = 60 + ((p.y - xMin) / (xMax - xMin)) * 920;
          const barH = (p.n / 3) * 300;
          const accent = p.n > 1;
          return (
            <g class="bar-group" data-anim-draw>
              <line
                x1={x}
                x2={x}
                y1={320}
                y2={320 - barH}
                stroke={accent ? '#ff0000' : '#000'}
                stroke-width={accent ? '6' : '4'}
              >
                <title>{p.y}: {p.n} Türkiye ilki</title>
              </line>
              {accent && (
                <text x={x} y={320 - barH - 8} text-anchor="middle" font-size="13" font-weight="700" fill="#ff0000">{p.n}</text>
              )}
              {(i % 3 === 0 || i === yearMs.length - 1) && (
                <text x={x} y="345" text-anchor="middle" font-size="10" letter-spacing="1" fill="#404040">{p.y}</text>
              )}
            </g>
          );
        })}

        <!-- X axis baseline -->
        <line x1="60" x2="990" y1="320" y2="320" stroke="#000" stroke-width="1" />
      </svg>

      <p class="text-[10px] uppercase tracking-[0.3em] opacity-60 mt-6">
        her dikey çubuk = o yıldaki Türkiye ilki imzaları · zirveler #ff0000 · üzerine gel → tooltip
      </p>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/4 mx-6 lg:mx-10 max-w-7xl" />

  <!-- 08 · AREA CHART — Kümülatif marka portföyü -->
  <section class="bg-white" data-section-anim>
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">08 · Alan</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Marka büyümesi.</h2>

      {(() => {
        // Kümülatif portföy büyümesi — yıl bazında toplam marka
        const yrs = [2000, 2003, 2005, 2007, 2010, 2013, 2016, 2019, 2022, 2024, 2026];
        const cumul = [3, 9, 18, 32, 52, 78, 110, 145, 180, 205, 220];
        const w = 1000, h = 260, padL = 70, padR = 20, padT = 20, padB = 50;
        const xMin = 2000, xMax = 2026, yMax = 220;
        const pts = yrs.map((y, i) => ({
          x: padL + ((y - xMin) / (xMax - xMin)) * (w - padL - padR),
          yPos: (h - padB) - (cumul[i] / yMax) * (h - padT - padB),
          year: y,
          val: cumul[i],
        }));
        const pathD = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.yPos.toFixed(1)}`).join(' ');
        const areaD = `${pathD} L ${pts[pts.length - 1].x.toFixed(1)} ${h - padB} L ${pts[0].x.toFixed(1)} ${h - padB} Z`;
        return (
          <svg viewBox={`0 0 ${w} ${h}`} width="100%" class="block" role="img" aria-label="Kümülatif marka portföyü büyümesi">
            <!-- Hatch pattern -->
            <defs>
              <pattern id="hatch" patternUnits="userSpaceOnUse" width="4" height="4" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="4" stroke="#000" stroke-width="0.5" />
              </pattern>
            </defs>
            <!-- Y axis ticks -->
            {[0, 50, 100, 150, 200].map((n) => {
              const yPos = (h - padB) - (n / yMax) * (h - padT - padB);
              return (
                <g>
                  <line x1={padL} x2={w - padR} y1={yPos} y2={yPos} stroke={n === 0 ? '#000' : '#f5f5f5'} stroke-width="1" />
                  <text x={padL - 8} y={yPos + 4} text-anchor="end" font-size="11" fill="#737373">{n}</text>
                </g>
              );
            })}
            <!-- X axis baseline -->
            <line x1={padL} x2={w - padR} y1={h - padB} y2={h - padB} stroke="#000" stroke-width="1" />
            <!-- Area fill (hatch) -->
            <path d={areaD} fill="url(#hatch)" data-anim-fade />
            <!-- Line -->
            <path d={pathD} stroke="#000" stroke-width="1.5" fill="none" data-anim-draw />
            <!-- Points -->
            {pts.map((p, i) => (
              <g>
                <circle cx={p.x} cy={p.yPos} r="3" fill="#fff" stroke="#000" stroke-width="1.5">
                  <title>{p.year}: {p.val} marka</title>
                </circle>
                <text x={p.x} y={p.yPos - 10} text-anchor="middle" font-size="10" font-weight="600" fill="#000">{p.val}</text>
                <text x={p.x} y={h - padB + 18} text-anchor="middle" font-size="10" fill="#404040">{p.year}</text>
              </g>
            ))}
            <!-- Y axis label -->
            <text x="20" y="40" font-size="10" letter-spacing="2" font-weight="700" fill="#000">MARKA</text>
            <text x="20" y="55" font-size="10" letter-spacing="2" fill="#404040">SAYISI</text>
            <!-- Final emphasis -->
            <text x={pts[pts.length - 1].x - 4} y={pts[pts.length - 1].yPos - 18} text-anchor="end" font-family="var(--font-display)" font-size="32" fill="#ff0000">220+</text>
          </svg>
        );
      })()}

      <p class="text-[10px] uppercase tracking-[0.3em] opacity-60 mt-6">
        kümülatif portföy · diagonal taralı alan = toplam birikim · 2000'de 3'ten 2026'da 220'ye
      </p>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/3 mx-6 lg:mx-10 max-w-7xl ml-auto" />

  <!-- 09 · SCATTER / DOT PLOT — Sektör × yoğunluk -->
  <section class="bg-white" data-section-anim>
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">09 · Dağılım</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Nokta dağılımı.</h2>

      {(() => {
        const w = 1000, h = 360, padL = 60, padR = 30, padT = 30, padB = 60;
        // Her sektör için marker — sayısı kadar dot
        const cols = sectors.length;
        return (
          <svg viewBox={`0 0 ${w} ${h}`} width="100%" class="block" role="img" aria-label="Sektör başına marka yoğunluğu">
            <!-- Y axis ticks -->
            {[0, 10, 20, 30, 40, 50, 60].map((n) => {
              const yPos = (h - padB) - (n / 65) * (h - padT - padB);
              return (
                <g>
                  <line x1={padL} x2={w - padR} y1={yPos} y2={yPos} stroke={n === 0 ? '#000' : '#f5f5f5'} stroke-width="1" />
                  <text x={padL - 8} y={yPos + 4} text-anchor="end" font-size="10" fill="#737373">{n}</text>
                </g>
              );
            })}
            <!-- Bars (column dot stacks) -->
            {sectors.map((s, i) => {
              const x = padL + (i / (cols - 1)) * (w - padL - padR);
              const accent = s.n >= 20;
              const dots = [];
              for (let j = 0; j < s.n; j++) {
                const yPos = (h - padB) - (j / 65) * (h - padT - padB) - 2;
                dots.push({ y: yPos, j });
              }
              return (
                <g class="scatter-col">
                  {dots.map((d) => (
                    <circle
                      cx={x}
                      cy={d.y}
                      r="2.2"
                      fill={accent ? '#ff0000' : '#000'}
                      opacity={0.7 + (d.j / s.n) * 0.3}
                    >
                      <title>{s.name}: {s.n} marka</title>
                    </circle>
                  ))}
                  <text
                    x={x}
                    y={h - padB + 20}
                    text-anchor="end"
                    font-size="9"
                    fill="#404040"
                    transform={`rotate(-45 ${x} ${h - padB + 20})`}
                  >{s.name.slice(0, 14)}</text>
                </g>
              );
            })}
            <line x1={padL} x2={w - padR} y1={h - padB} y2={h - padB} stroke="#000" stroke-width="1" />
            <text x="20" y="40" font-size="10" letter-spacing="2" font-weight="700" fill="#000">MARKA</text>
            <text x="20" y="55" font-size="10" letter-spacing="2" fill="#404040">SAYISI</text>
          </svg>
        );
      })()}

      <p class="text-[10px] uppercase tracking-[0.3em] opacity-60 mt-6">
        her nokta = bir marka · sütun başına yığılım · ≥20 marka olan sektörler #ff0000
      </p>
    </div>
  </section>

  <hr class="border-0 h-px bg-black w-1/2 mx-6 lg:mx-10 max-w-7xl" />

  <!-- 10 · STEP CHART — Vaka çalışması yıl bazında akış -->
  <section class="bg-white" data-section-anim>
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <p class="text-[10px] uppercase tracking-[0.4em] mb-8">10 · Basamak</p>
      <h2 class="editorial-display text-[12vw] lg:text-[6vw] xl:text-[80px] leading-[0.9] mb-16">Vaka akışı.</h2>

      {(() => {
        const data = [
          { y: 2007, case: 'CHP siyasal · Temiz Mama · Tatil Vitrini' },
          { y: 2008, case: 'Adepo.com' },
          { y: 2010, case: 'MYvia inşaat' },
          { y: 2011, case: 'Ege Tüp Bebek' },
          { y: 2014, case: 'DEÜ Uzaktan Eğitim' },
          { y: 2015, case: 'İzsu' },
        ];
        const w = 1000, h = 260, padL = 70, padR = 20, padT = 30, padB = 50;
        const xMin = 2007, xMax = 2015;
        // Cumulative case count
        let cum = 0;
        const pts = data.map((d) => {
          cum += d.y === 2007 ? 3 : 1;
          return { x: padL + ((d.y - xMin) / (xMax - xMin)) * (w - padL - padR), yPos: (h - padB) - (cum / 9) * (h - padT - padB), val: cum, ...d };
        });
        // Step path: H then V
        let stepD = `M ${padL} ${h - padB}`;
        pts.forEach((p, i) => {
          if (i === 0) stepD += ` L ${p.x.toFixed(1)} ${h - padB} L ${p.x.toFixed(1)} ${p.yPos.toFixed(1)}`;
          else {
            const prev = pts[i - 1];
            stepD += ` L ${p.x.toFixed(1)} ${prev.yPos.toFixed(1)} L ${p.x.toFixed(1)} ${p.yPos.toFixed(1)}`;
          }
        });
        return (
          <svg viewBox={`0 0 ${w} ${h}`} width="100%" class="block" role="img" aria-label="Vaka çalışması kümülatif akış">
            {[0, 3, 6, 9].map((n) => {
              const yPos = (h - padB) - (n / 9) * (h - padT - padB);
              return (
                <g>
                  <line x1={padL} x2={w - padR} y1={yPos} y2={yPos} stroke={n === 0 ? '#000' : '#f5f5f5'} stroke-width="1" />
                  <text x={padL - 8} y={yPos + 4} text-anchor="end" font-size="11" fill="#737373">{n}</text>
                </g>
              );
            })}
            <path d={stepD} stroke="#000" stroke-width="1.5" fill="none" data-anim-draw />
            {pts.map((p) => (
              <g>
                <circle cx={p.x} cy={p.yPos} r="4" fill="#fff" stroke="#000" stroke-width="1.5">
                  <title>{p.y}: {p.case} (toplam {p.val})</title>
                </circle>
                <text x={p.x} y={p.yPos - 12} text-anchor="middle" font-size="11" font-weight="700" fill="#000">{p.val}</text>
                <text x={p.x} y={h - padB + 16} text-anchor="middle" font-size="10" fill="#404040">{p.y}</text>
              </g>
            ))}
            <line x1={padL} x2={w - padR} y1={h - padB} y2={h - padB} stroke="#000" stroke-width="1" />
            <text x="20" y="40" font-size="10" letter-spacing="2" font-weight="700" fill="#000">VAKA</text>
            <text x="20" y="55" font-size="10" letter-spacing="2" fill="#404040">TOPLAM</text>
          </svg>
        );
      })()}

      <p class="text-[10px] uppercase tracking-[0.3em] opacity-60 mt-6">
        basamak ↑ kümülatif vaka · 2007 → 3 vaka tek yıl · noktaların üzerine gel → tooltip
      </p>
    </div>
  </section>

  <!-- ANIMASYON + HOVER CSS + JS -->
  <style>
    [data-section-anim] [data-anim-draw],
    [data-section-anim] svg path[d^="M"]:not([fill]):not([data-anim-fade]) {
      stroke-dasharray: 2000;
      stroke-dashoffset: 2000;
      transition: stroke-dashoffset 1.6s ease-out;
    }
    [data-section-anim].is-in [data-anim-draw],
    [data-section-anim].is-in svg path[d^="M"]:not([fill]):not([data-anim-fade]) {
      stroke-dashoffset: 0;
    }
    [data-section-anim] [data-anim-fade] {
      opacity: 0;
      transition: opacity 1.2s ease-out 0.4s;
    }
    [data-section-anim].is-in [data-anim-fade] { opacity: 1; }

    [data-section-anim] svg circle,
    [data-section-anim] svg line.bar-vert,
    [data-section-anim] svg text {
      opacity: 0;
      transition: opacity 0.5s ease-out;
    }
    [data-section-anim].is-in svg circle,
    [data-section-anim].is-in svg line.bar-vert,
    [data-section-anim].is-in svg text { opacity: 1; transition-delay: 0.6s; }

    /* Hover — SVG çizgi/dot vurgu */
    svg circle:hover { r: 5; cursor: pointer; }
    svg line:hover { stroke-width: 8; cursor: pointer; }

    /* Bar row hover — sektör dağılımı */
    section [class*="flex items-baseline gap"]:has(>span.editorial-display):hover {
      background: rgba(255,0,0,0.04);
    }
  </style>

  <script is:inline>
    (function () {
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('[data-section-anim]').forEach(s => s.classList.add('is-in'));
        return;
      }
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.18, rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-section-anim]').forEach(s => obs.observe(s));
    })();
  </script>

  <hr class="border-0 h-px bg-black w-1/3 mx-6 lg:mx-10 max-w-7xl ml-auto" />

  <!-- METHODOLOGY — minimal -->
  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 py-20">
      <hr class="border-0 h-px bg-black w-12 mb-8" />
      <p class="text-[10px] uppercase tracking-[0.4em] mb-6">Not</p>
      <p class="text-sm leading-relaxed">
        Bu sayfada hiçbir dolgu, gölge, gradient veya simge yok. Tüm grafikler 1px çizgi + Anton sayı + Inter etiket.
        Renk paleti: <strong>siyah</strong> · gri %15 · <strong style="color:#ff0000">tek kırmızı vurgu</strong>.
        Bölüm 07-10 sayfada scroll edilince çizilir; nokta + çubuklara üzerine gel → tooltip.
        Şişman versiyon: <a href="/istatistik" class="underline decoration-1 underline-offset-4">/istatistik</a>.
      </p>
    </div>
  </section>
</BaseLayout>
