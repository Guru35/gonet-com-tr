---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { webpageSchema, faqSchema, ORG_ID, SITE_URL } from '../../lib/schema';

const title = 'Ücretsiz SEO ve AEO/GEO Analiz Aracı | Gonet';
const description =
  'Sitenizin klasik SEO, AI bot erişimi ve schema.org görünürlüğünü ücretsiz analiz edin. Anlık teknik skor alın ve müşteri paneline geçin.';
const url = `${SITE_URL}/araclar/seo-analiz`;
const seoAppUrl = 'https://seo.gonet.com.tr';
const panelLoginUrl = 'https://panel.gonet.com.tr/giris';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'WebPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: `${SITE_URL}/` },
    { name: 'Araçlar', url },
    { name: 'Ücretsiz SEO ve AEO/GEO Analiz Aracı', url },
  ],
});

const appSchema = {
  '@type': ['WebApplication', 'SoftwareApplication'],
  '@id': `${url}#app`,
  name: 'Gonet Ücretsiz SEO ve AEO/GEO Analiz Aracı',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: seoAppUrl,
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'TRY',
  },
  provider: { '@id': ORG_ID },
};

const faqItems = [
  {
    question: 'Bu ücretsiz SEO ve AEO/GEO analizi neleri ölçer?',
    answer:
      'Web sitenizi yapay zekâ bot erişimi (OAI-SearchBot, PerplexityBot, ClaudeBot), Schema.org yapısal veri, teknik SEO sağlığı (canonical, sitemap, llms.txt) ve alıntılanabilir içerik yapısı olmak üzere 4 ana kategoride 25 farklı noktadan denetler.',
  },
  {
    question: 'Analiz için siteye bir kod veya eklenti kurmam gerekir mi?',
    answer:
      'Hayır. Yalnızca herkese açık web adresinizi girmeniz yeterlidir; motorumuz sitenizi dışarıdan bir ziyaretçi ve yapay zekâ botu gözüyle tarar.',
  },
  {
    question: 'Klasik SEO araçlarından farkı nedir?',
    answer:
      'Klasik araçlar yalnızca Google sıralama sinyallerine bakar. Gonet analiz aracı ise yapay zekâ yanıt motorlarının (ChatGPT Search, Perplexity, Claude, Gemini) sitenizi okuyup kaynak gösterebilmesi için gereken AEO ve GEO sinyallerini de ölçer.',
  },
  {
    question: 'Sonuçlar ne kadar sürede hazırlanır?',
    answer:
      'Tek sayfa ve teknik bot kontrolleri saniyeler içinde tamamlanır; kapsamlı marka görünürlüğü takibi ise müşteri panelimiz üzerinden haftalık olarak otomatik yürütülür.',
  },
  {
    question: 'Analiz sonrasında markam için yapay zekâ görünürlüğü takibi açabilir miyim?',
    answer:
      'Evet. Müşteri panelimiz (panel.gonet.com.tr/giris) üzerinden ChatGPT, Claude, Gemini ve Perplexity yanıtlarında markanızın anılma oranını ve rakip kıyasını sürekli izleyebilirsiniz.',
  },
];

const faqs = faqSchema(faqItems);
const graph = [pageSchema, appSchema, faqs];

const kategoriler = [
  {
    no: '01',
    baslik: 'Yapay Zekâ Bot Erişimi (7 Kontrol)',
    aciklama:
      'Yapay zekâ arama motorlarının sitenize kapıdan girip giremediğini test eder. Çoğu site farkında olmadan bu botları engeller.',
    maddeler: [
      'robots.txt içinde OAI-SearchBot (ChatGPT) izni',
      'PerplexityBot ve ClaudeBot erişim kontrolü',
      'GPTBot ve Google-Extended politikası',
      'Cloudflare / WAF bot engelleme ve HTTP 403/503 sinyali',
      'Ham HTML içinde içerik (JS gerektirmeden okunabilirlik)',
      'X-Robots-Tag noindex / nofollow çakışması',
      'Sayfa yanıt süresi (TTFB) ve zaman aşımı riski',
    ],
  },
  {
    no: '02',
    baslik: 'Yapısal Veri & Kimlik (6 Kontrol)',
    aciklama:
      'Modellerin markanızı tekil bir varlık (entity) olarak tanımasını ve doğru hizmetlerle eşleştirmesini sağlar.',
    maddeler: [
      'JSON-LD Schema.org varlığı ve sözdizimi doğrulaması',
      'Organization / LocalBusiness ana marka kimliği',
      'WebSite ve BreadcrumbList sayfa hiyerarşisi',
      'Service / Product ve Offer fiyat/kapsam şeması',
      'FAQPage soru-cevap yapısal veri katmanı',
      'Open Graph ve sosyal paylaşım meta tutarlılığı',
    ],
  },
  {
    no: '03',
    baslik: 'Teknik SEO & Keşif (6 Kontrol)',
    aciklama:
      'Hem Googlebot hem de AI arama indekslerinin sitenizi eksiksiz taramasını güvence altına alır.',
    maddeler: [
      'HTTPS güvenlik ve geçerli SSL sertifikası',
      'Canonical URL tutarlılığı ve yinelenen sayfa önleme',
      'Title ve Meta Description uzunluk ve özgünlük kontrolü',
      'XML Sitemap erişilebilirliği ve güncelliği',
      '/llms.txt yapay zekâ özet dosyası varlığı',
      'Kırık iç/dış bağlantılar ve yönlendirme zincirleri',
    ],
  },
  {
    no: '04',
    baslik: 'İçerik & Alıntılanabilirlik (6 Kontrol)',
    aciklama:
      'Yapay zekânın cevabında markanızı doğrudan alıntılayıp kaynak linki vermesini kolaylaştıran metin mimarisini ölçer.',
    maddeler: [
      'Tekil H1 başlık ve mantıksal H2/H3 soru hiyerarşisi',
      'Doğrudan yanıt (front-loading) paragraf yapısı',
      'Ölçülebilir sayı, tarih ve somut kanıt yoğunluğu',
      'Görsel alt metinleri ve anlamsal HTML etiketleri',
      'Kurumsal künye, iletişim ve güven sinyalleri (E-E-A-T)',
      'Dil, ülke ve bölgesel hedefleme (hreflang / lang="tr")',
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical={url} schemas={graph}>
  <div class="overflow-x-clip">
    <section
      class="editorial-section bg-white"
      style="--rule-top-x:10%;--rule-top-w:48%;--rule-bot-x:35%;--rule-bot-w:28%"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <nav class="text-sm text-slate-600 mb-10" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-black underline-offset-4 hover:underline">Ana sayfa</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-800 font-medium" aria-current="page">Ücretsiz SEO ve AEO/GEO Analiz Aracı</li>
          </ol>
        </nav>

        <p class="text-xs font-medium uppercase tracking-[0.3em] text-slate-700 mb-6">
          Ücretsiz Araç · 25 Nokta Denetimi
        </p>

        <h1 class="editorial-display text-[11vw] lg:text-[6vw] xl:text-[88px] leading-[0.95] break-words mb-8 sm:mb-10">
          Siteniz yapay zekâya<br />
          <span style="color:#b42318">ne kadar hazır?</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-700 leading-relaxed max-w-3xl mb-10">
          ChatGPT, Perplexity, Claude ve Google AI motorları sitenizi ziyaret ettiğinde sizi doğru
          anlıyor ve kaynak gösteriyor mu? Adresinizi yazın, <strong>25 teknik ve içerik kontrolünü</strong>
          ücretsiz başlatın.
        </p>

        <form
          action={seoAppUrl}
          method="get"
          class="border-2 border-black p-4 sm:p-6 md:p-8 bg-slate-50 mb-8"
        >
          <label for="analiz-url" class="block text-sm font-medium uppercase tracking-wider text-slate-800 mb-3">
            Web Sitenizin Adresi
          </label>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
            <input
              id="analiz-url"
              name="url"
              type="url"
              required
              placeholder="https://ornekmarka.com.tr"
              class="flex-1 min-h-[44px] px-4 py-3 border border-slate-400 bg-white text-black text-base"
            />
            <button
              type="submit"
              class="min-h-[44px] w-full sm:w-auto px-6 sm:px-8 py-3 text-white font-medium transition cursor-pointer inline-flex items-center justify-center"
              style="background-color:#b42318"
            >
              Ücretsiz Analiz Başlat →
            </button>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 mt-4 leading-relaxed">
            Kayıt gerekmez; anlık teknik ve AEO/GEO ön skorunuzu hemen görürsünüz.
          </p>
        </form>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <a
            href={seoAppUrl}
            class="min-h-[44px] w-full sm:w-auto px-6 py-3 bg-black text-white font-medium text-center inline-flex items-center justify-center hover:bg-slate-800 transition"
          >
            Ücretsiz Analiz Başlat
          </a>
          <a
            href={panelLoginUrl}
            class="min-h-[44px] w-full sm:w-auto px-6 py-3 border-2 border-black text-black font-medium text-center inline-flex items-center justify-center hover:bg-slate-100 transition"
          >
            Müşteri Paneli
          </a>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 border-t border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-slate-700 mb-4">Kapsam</p>
        <h2 class="editorial-display text-3xl sm:text-4xl md:text-6xl mb-12 leading-[0.95] break-words">
          25 kontrol noktası,<br />4 temel katman.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {kategoriler.map((k) => (
            <article class="bg-white border border-slate-300 p-6 sm:p-8">
              <p class="editorial-display text-4xl mb-3" style="color:#b42318">{k.no}</p>
              <h3 class="text-xl sm:text-2xl font-medium mb-3 text-black">{k.baslik}</h3>
              <p class="text-slate-700 text-sm mb-5 leading-relaxed">{k.aciklama}</p>
              <ul class="space-y-2 text-sm text-slate-800">
                {k.maddeler.map((m) => (
                  <li>• {m}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white border-t border-slate-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-slate-700 mb-4">Sıkça Sorulan Sorular</p>
        <h2 class="editorial-display text-3xl sm:text-4xl md:text-5xl mb-10 leading-[0.95] break-words">
          Merak edilenler
        </h2>
        <div class="space-y-4">
          {faqItems.map((item, idx) => (
            <details class="border-b border-slate-300 pb-4" open={idx === 0}>
              <summary class="min-h-[44px] py-2 text-lg sm:text-xl font-medium cursor-pointer hover:text-black flex items-center">
                {item.question}
              </summary>
              <p class="mt-3 text-slate-700 leading-relaxed">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-black text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <h2 class="editorial-display text-3xl sm:text-4xl md:text-5xl leading-[0.95] mb-6 break-words">
          Ön analizi tamamlayın, panelde haftalık takibe geçin.
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl">
          Ücretsiz analizle teknik eksikleri hemen görün; düzenli görünürlük raporları ve rakip
          karşılaştırması için müşteri paneline giriş yapın.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href={seoAppUrl}
            class="min-h-[44px] w-full sm:w-auto px-8 py-3 text-white font-medium text-center inline-flex items-center justify-center transition"
            style="background-color:#c80000"
          >
            Ücretsiz Analiz Başlat
          </a>
          <a
            href={panelLoginUrl}
            class="min-h-[44px] w-full sm:w-auto px-8 py-3 border border-white text-white font-medium text-center inline-flex items-center justify-center hover:bg-white hover:text-black transition"
          >
            Müşteri Paneli
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
