---
import BaseLayout from '../layouts/BaseLayout.astro';
import AjanKarti from '../components/kadro/AjanKarti.astro';
import {
  DEPARTMANLAR,
  KURUCU_LIDERLIK,
  KADRO_METRIKLERI,
  UZMAN_AJANLAR,
} from '../data/kadro';
import { teamPageSchema, faqSchema } from '../lib/schema';

const title = 'Ekibimiz — Tek İnsan Liderliği ve Şeffaf AI Ajan Kadrosu | Gonet';
const description =
  "Gonet'te her karar tek insan onayından geçer; üretimde 27 uzman yapay zekâ ajanı açık kimlik, görev sınırı ve gelişim karnesiyle çalışır.";
const url = 'https://gonet.com.tr/ekibimiz';

const alternates = [
  { lang: 'tr', href: 'https://gonet.com.tr/ekibimiz' },
  { lang: 'en', href: 'https://gonet.com.tr/en/team' },
  { lang: 'x-default', href: 'https://gonet.com.tr/ekibimiz' },
];

const faqs = [
  {
    question: 'AI ajanlarınız müşteriyle doğrudan konuşur mu?',
    answer:
      'Hayır. Müşteri görüşmeleri, teklif kararları ve nihai teslimat onayı kurucu Gökhan Kazancı’nın sorumluluğundadır. Herhangi bir dijital arayüzde bir AI asistanıyla etkileşime girerseniz bu durum her etkileşimin başında açıkça bildirilir.',
  },
  {
    question: 'Ajanlara neden insan adı verdiniz? Bu yanıltıcı değil mi?',
    answer:
      'İçeride 27 farklı uzmanlığı ve rapor hattını karıştırmadan yönetebilmek için kurgusal persona adları kullanıyoruz. Dış dünyada ise her adın yanında "AI Ajanı" rozeti yer alır; hiçbir ajanımıza sahte yaş, mezuniyet, özgeçmiş veya insan fotoğrafı koymuyoruz.',
  },
  {
    question: 'Müşteri verilerimiz yapay zekâ modellerini eğitmek için kullanılıyor mu?',
    answer:
      'Hayır. Müşteri bilgileri genel amaçlı açık modellerin eğitimine aktarılmaz; her müşteri projesi kendi izole çalışma alanında tutulur ve kamuya açık kadro vitrininde hiçbir müşteri verisi paylaşılmaz.',
  },
  {
    question: 'Bir AI ajanının "Ne DEĞİLDİR" sınırı ne işe yarar?',
    answer:
      'Çoklu ajan sistemlerindeki hataların önemli kısmı rol belirsizliğinden doğar. Her ajanın neyi yapmayacağını açıkça yazmak, örneğin yazarın kendi içeriğini onaylamasını veya ajanın izinsiz yayın yapmasını baştan engeller.',
  },
  {
    question: 'Kariyer basamağı (Aday / Yetkin / Kıdemli / Usta) neyi gösterir?',
    answer:
      'Ajanın süslü bir unvanını değil, bağımsız doğrulamadan geçmiş iş sayısını, ret oranını ve ne kadar sıkı denetime tabi olduğunu gösterir. Yeni başlayan her ajan Aday olarak doğar ve her çıktısı tam denetimden geçer.',
  },
];

const departmanSayilari = DEPARTMANLAR.map((dept) => ({
  ...dept,
  sayi:
    dept.kod === 'all'
      ? UZMAN_AJANLAR.length
      : UZMAN_AJANLAR.filter((ajan) => ajan.departmanKodu === dept.kod).length,
}));

const surecAdimlari = [
  {
    no: '01',
    baslik: 'Stratejik Çerçeve',
    aciklama:
      'Kurucu insan hedefi ve kapsamı belirler; CEO-G1 (Kaan Demirsoy · AI Ajanı) işi uzman paketlere böler.',
  },
  {
    no: '02',
    baslik: 'Uzman Üretim',
    aciklama:
      'Pazarlama, Kreatif, Web veya Yazılım ajanları yalnız kendi yetki sınırları içinde kaynaklı üretim yapar.',
  },
  {
    no: '03',
    baslik: 'Bağımsız Denetim',
    aciklama:
      'QA-G1 (Gizem Sertkaya · AI Ajanı), Tester1-G1 (Tamer Uslu · AI Ajanı) ve gerektiğinde Hukuk-Danismani-G1 (Meltem Akıncılar · AI Ajanı) çıktıyı ölçer.',
  },
  {
    no: '04',
    baslik: 'İnsan Onayı ve Teslimat',
    aciklama:
      'Son sözü kurucu Gökhan Kazancı söyler; onaylanan iş müşteriye çıkar, hata çıkarsa ders olarak hafızaya işlenir.',
  },
];

const golgeAiMaddeleri = [
  'Süreç müşteriden gizlenir; işi kimin ürettiği belirsizdir.',
  'Tek genel amaçlı sohbet penceresinden denetimsiz çıktı alınır.',
  'Kaynaksız tahminler ve halüsinasyonlar kontrol kapısı olmadan teslim edilir.',
  'Hatalar sessizce geçiştirilir; kalıcı kurumsal ders birikmez.',
];

const gonetKadroMaddeleri = [
  'Her uzman ajan açıkça "Yapay Zekâ Ajanı" olarak deklare edilir.',
  'Her ajanın yetki alanı ve "Ne DEĞİLDİR" sınırı yazılıdır.',
  'Üreten ajan kendi işini onaylayamaz; bağımsız QA, Test ve YBF denetimi uygulanır.',
  'Her ret ve düzeltme kalıcı ders kaydına ve mekanik kontrole dönüştürülür.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  lang="tr"
  alternates={alternates}
  schemas={[teamPageSchema(UZMAN_AJANLAR, 'tr'), faqSchema(faqs)]}
>
  <!-- Hero -->
  <section class="bg-[var(--bg)] text-[var(--text)] border-b border-[var(--border)]">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 py-12 lg:py-20">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-10">
        <nav class="text-sm text-[var(--text-secondary)]" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-[var(--text-heading)] transition-colors">Ana sayfa</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-[var(--text-heading)] font-medium" aria-current="page">Ekibimiz</li>
          </ol>
        </nav>

        <a
          href="/en/team"
          hreflang="en"
          class="min-h-[44px] inline-flex items-center px-4 border border-[var(--border)] bg-[var(--surface)] text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text)] hover:bg-black hover:text-white transition-colors"
        >
          English
        </a>
      </div>

      <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--text-secondary)] mb-6">
        HİBRİT KADRO · İNSAN × AI
      </p>

      <h1 class="editorial-display text-[11vw] sm:text-[8vw] lg:text-[6vw] xl:text-[84px] leading-[0.94] text-[var(--text-heading)] max-w-5xl mb-8">
        Tek insan liderliği. Şeffaf uzman AI kadrosu<span class="text-[#ff0000]">.</span>
      </h1>

      <p class="text-lg lg:text-xl leading-relaxed text-[var(--text)] max-w-3xl mb-8">
        Stok fotoğraflı sahte ekip profilleri yerine tüm yapay zekâ ajanlarımızı görev sınırları ve
        gelişim karneleriyle açıkça deklare ediyoruz. Hiçbir ajanımız insan taklidi yapmaz; her
        teslimat bağımsız kalite kontrolü ve kurucu onayıyla çıkar.
      </p>

      <div class="mb-12">
        <a
          href="/ik"
          class="inline-flex items-center min-h-[44px] text-sm font-semibold text-[var(--text-heading)] border-b border-[var(--border)] hover:opacity-75 transition-opacity"
        >
          Çalışma Anayasamız ve Gelişim Ölçeğimiz <span aria-hidden="true">&nbsp;→</span>
        </a>
      </div>

      <!-- Metrik Şeridi -->
      <dl class="grid grid-cols-1 md:grid-cols-3 border border-[var(--border)] bg-[var(--surface)]">
        <div class="p-6 border-b md:border-b-0 md:border-r border-[var(--border)]">
          <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-2">
            Tek Onay ve Müşteri Sorumluluğu
          </dt>
          <dd class="text-2xl lg:text-3xl font-bold tracking-tight text-[var(--text-heading)]">
            {KADRO_METRIKLERI.insanLiderSayisi} İnsan
          </dd>
          <p class="text-xs text-[var(--text-secondary)] mt-1">{KURUCU_LIDERLIK.ad}</p>
        </div>

        <div class="p-6 border-b md:border-b-0 md:border-r border-[var(--border)]">
          <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-2">
            Görev Sınırlı Ajan Kadrosu
          </dt>
          <dd class="text-2xl lg:text-3xl font-bold tracking-tight text-[var(--text-heading)]">
            {KADRO_METRIKLERI.uzmanAjanSayisi} Uzman AI
          </dd>
          <p class="text-xs text-[var(--text-secondary)] mt-1">Açık kimlik ve rapor hattı</p>
        </div>

        <div class="p-6">
          <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-2">
            Sürekli Eğitim ve Bağımsız Doğrulama
          </dt>
          <dd class="text-2xl lg:text-3xl font-bold tracking-tight text-[var(--text-heading)]">
            0–3 Kanıt
          </dd>
          <p class="text-xs text-[var(--text-secondary)] mt-1">Ölçülebilir gelişim ölçeği</p>
        </div>
      </dl>
    </div>
  </section>

  <!-- Bölüm 1: Kurucu & Tek Onay Makamı -->
  <section class="bg-[var(--surface-2)] text-[var(--text)] border-b border-[var(--border)]">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 py-14 lg:py-20">
      <div class="border border-[var(--border)] bg-[var(--surface)] p-6 lg:p-10">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border)] pb-5 mb-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--text-secondary)]">
            İNSAN LİDERLİĞİ · TEK ONAY MAKAMI
          </p>
          <span class="inline-flex items-center gap-2 border border-[var(--border)] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--text-heading)]">
            İNSAN KURUCU · NİHAİ SORUMLU
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5">
            <h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-[var(--text-heading)]">
              {KURUCU_LIDERLIK.ad}
            </h2>
            <p class="text-sm font-medium text-[var(--text-secondary)] mt-2">
              {KURUCU_LIDERLIK.unvan.tr}
            </p>
          </div>

          <div class="lg:col-span-7 flex flex-col gap-4 text-base leading-relaxed text-[var(--text)]">
            <p>
              2000’den beri İzmir merkezli Gonet’in kurucusu; Dokuz Eylül Üniversitesi İİBF mezunu,
              Yaşar Üniversitesi eski dijital pazarlama eğitmeni, DEÜ Rektörlük ve DEUZEM eski
              uzaktan eğitim danışmanı ve <em>YBF — Yalın Bilinç Felsefesi</em> kitabının yazarı.
            </p>
            <p class="border-l-2 border-[var(--border)] pl-4 text-sm text-[var(--text-secondary)]">
              Hiçbir AI ajanı tek başına müşteriye teslimat yapmaz, bütçe kararı almaz veya hukuki
              sorumluluk üstlenmez. Tüm stratejik kararlar, dış yayınlar ve müşteri taahhütleri
              kurucu insan denetiminden geçer.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bölüm 2: Gölge AI vs. Gonet Şeffaf Hibrit Kadro -->
  <section class="bg-[var(--bg)] text-[var(--text)] border-b border-[var(--border)]">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 py-14 lg:py-20">
      <div class="mb-10 max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[var(--text-secondary)] mb-3">
          YÖNETİŞİM FARKI
        </p>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-heading)]">
          Gölge AI ve Gonet Şeffaf Hibrit Kadro Karşılaştırması
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <article class="border border-[var(--border)] bg-[var(--surface-2)] p-6 lg:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-2">
            Standart Piyasa Pratiği
          </p>
          <h3 class="text-xl font-bold text-[var(--text-heading)] pb-4 mb-5 border-b border-[var(--border)]">
            Gölge AI Kullanan Ajans
          </h3>
          <ul class="flex flex-col gap-3 text-sm leading-relaxed text-[var(--text)]">
            {golgeAiMaddeleri.map((madde) => (
              <li class="flex items-start gap-3">
                <span class="inline-block w-2 h-2 mt-1.5 shrink-0 border border-[var(--border)]" aria-hidden="true"></span>
                <span>{madde}</span>
              </li>
            ))}
          </ul>
        </article>

        <article class="border-2 border-[var(--border)] bg-[var(--surface)] p-6 lg:p-8">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--text-secondary)] mb-2">
            Anayasal Model
          </p>
          <h3 class="text-xl font-bold text-[var(--text-heading)] pb-4 mb-5 border-b border-[var(--border)]">
            Gonet Şeffaf Hibrit Kadro
          </h3>
          <ul class="flex flex-col gap-3 text-sm leading-relaxed text-[var(--text)]">
            {gonetKadroMaddeleri.map((madde) => (
              <li class="flex items-start gap-3">
                <span class="inline-block w-2 h-2 mt-1.5 shrink-0 bg-[var(--text-heading)]" aria-hidden="true"></span>
                <span>{madde}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Bölüm 3: Uzman AI Kadrosu Dizini -->
  <section id="kadro-dizini" class="bg-[var(--surface-2)] text-[var(--text)] border-b border-[var(--border)]">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 py-14 lg:py-20">
      <div class="max-w-3xl mb-8">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[var(--text-secondary)] mb-3">
          AÇIK AJAN ENVANTERİ
        </p>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-heading)] mb-4">
          {KADRO_METRIKLERI.uzmanAjanSayisi} Uzman Yapay Zekâ Ajanımız.
        </h2>
        <p class="text-sm lg:text-base leading-relaxed text-[var(--text-secondary)]">
          Her kartta gördüğünüz ad ajans içi koordinasyon ve rol sürekliliği için tanımlanmış
          <strong class="text-[var(--text-heading)] font-semibold">kurgusal bir persona</strong>dır;
          gerçek bir insanı temsil etmez. Müşteri gizliliği gereği proje çalışma evleri bu dizinde
          listelenmez.
        </p>
      </div>

      <!-- Departman Filtre Sekmeleri -->
      <div
        role="tablist"
        aria-label="Departmana göre AI ajanlarını filtrele"
        id="dept-tablist"
        class="flex flex-nowrap overflow-x-auto gap-1 border-b border-[var(--border)]"
      >
        {departmanSayilari.map((dept, idx) => (
          <button
            type="button"
            role="tab"
            id={`tab-${dept.kod}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            tabindex={idx === 0 ? '0' : '-1'}
            data-filter={dept.kod}
            data-label={dept.tr}
            class="shrink-0 min-h-[44px] px-4 py-2.5 relative text-xs font-semibold uppercase tracking-[0.12em] whitespace-nowrap cursor-pointer transition-colors text-[var(--text-secondary)] hover:text-[var(--text-heading)]"
          >
            {dept.tr} ({dept.sayi})
          </button>
        ))}
      </div>

      <p
        id="roster-status"
        aria-live="polite"
        class="mt-4 text-xs font-medium text-[var(--text-secondary)]"
      >
        Gösterilen: {UZMAN_AJANLAR.length} uzman yapay zekâ ajanı (Tümü)
      </p>

      <!-- Kart Izgarası -->
      <div
        id="roster-grid"
        class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {UZMAN_AJANLAR.map((ajan) => <AjanKarti ajan={ajan} lang="tr" />)}
      </div>
    </div>
  </section>

  <!-- Bölüm 4: Bir İş Nasıl Üretilir? -->
  <section class="bg-[var(--bg)] text-[var(--text)] border-b border-[var(--border)]">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 py-14 lg:py-20">
      <div class="mb-10 max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[var(--text-secondary)] mb-3">
          ÜRETİM VE DENETİM HATTI
        </p>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-heading)]">
          Bir İş Nasıl Üretilir?
        </h2>
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {surecAdimlari.map((adim) => (
          <li class="border border-[var(--border)] bg-[var(--surface)] p-6 flex flex-col gap-3">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-[var(--text-secondary)]">
              Adım {adim.no}
            </span>
            <h3 class="text-lg font-bold text-[var(--text-heading)]">
              {adim.baslik}
            </h3>
            <p class="text-sm leading-relaxed text-[var(--text)]">
              {adim.aciklama}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Bölüm 5: Sık Sorulan Sorular -->
  <section class="bg-[var(--surface-2)] text-[var(--text)] border-b border-[var(--border)]" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 lg:px-12 py-14 lg:py-20">
      <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-[var(--text-secondary)] mb-3">
        ŞEFFAFLIK VE YÖNETİŞİM
      </p>
      <h2 id="faq-heading" class="text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-heading)] mb-8">
        Sık Sorulan Sorular
      </h2>

      <div class="border-t border-[var(--border)]">
        {faqs.map((item) => (
          <details class="faq-item border-b border-[var(--border)] bg-[var(--surface)]">
            <summary class="faq-summary flex items-center gap-3 min-h-[44px] px-5 py-4 cursor-pointer list-none font-semibold text-base text-[var(--text-heading)] hover:bg-[var(--surface-2)] transition-colors">
              <svg
                class="faq-chevron w-4 h-4 shrink-0 text-[var(--text-heading)]"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M6 3l5 5-5 5" />
              </svg>
              <span>{item.question}</span>
            </summary>
            <div class="px-5 pb-5 pl-12 text-sm lg:text-base leading-relaxed text-[var(--text)]">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Tek Dolu Kırmızı CTA -->
  <section class="bg-[var(--bg)] text-[var(--text)] py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 flex flex-col gap-6">
      <h2 class="editorial-display text-[32px] lg:text-[52px] leading-[1.02] text-[var(--text-heading)] max-w-3xl">
        Hibrit kadromuzla tanışmaya hazır mısınız?
      </h2>
      <p class="text-base lg:text-lg text-[var(--text-secondary)] max-w-2xl">
        Projenizi doğrudan kurucu Gökhan Kazancı ile görüşmek ve uzman ajan çalışma düzenimizi
        kendi hedeflerinize uygulamak için bize ulaşın.
      </p>
      <div>
        <a
          href="/iletisim"
          class="team-primary-cta inline-flex items-center justify-center min-h-[48px] px-7 py-3 bg-accent-600 text-[#000000] hover:bg-black hover:text-white transition-colors font-semibold text-xs uppercase tracking-[0.2em]"
        >
          Hibrit kadromuzla projenizi konuşalım <span aria-hidden="true">&nbsp;→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  [role="tab"] {
    position: relative;
  }

  [role="tab"][aria-selected="true"] {
    color: var(--text-heading);
  }

  [role="tab"][aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    border-block-end: 3px solid #ff0000;
  }

  #roster-grid article[data-dept][hidden] {
    display: none;
  }

  .team-primary-cta {
    box-shadow: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] > .faq-summary .faq-chevron {
    transform: rotate(90deg);
  }

  .faq-item::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }

  .faq-item:not([open])::details-content {
    block-size: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-chevron {
      transition: transform 0.2s ease;
    }

    .faq-item::details-content {
      transition: block-size, content-visibility, display;
      transition-duration: 0.3s;
      transition-timing-function: ease-in-out;
      transition-behavior: allow-discrete;
    }
  }
</style>

<script>
  const tablist = document.getElementById('dept-tablist');
  const grid = document.getElementById('roster-grid');
  const statusEl = document.getElementById('roster-status');

  if (tablist && grid) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-dept]'));

    const selectTab = (nextTab: HTMLButtonElement, moveFocus = false) => {
      const filter = nextTab.dataset.filter || 'all';
      const label = nextTab.dataset.label || '';

      for (const tab of tabs) {
        const isSelected = tab === nextTab;
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.tabIndex = isSelected ? 0 : -1;
      }

      nextTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });

      if (moveFocus) {
        nextTab.focus();
      }

      let visibleCount = 0;
      for (const card of cards) {
        const matches = filter === 'all' || card.dataset.dept === filter;
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      if (statusEl) {
        statusEl.textContent = `Gösterilen: ${visibleCount} uzman yapay zekâ ajanı (${label})`;
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => selectTab(tab, false));
    }

    tablist.addEventListener('keydown', (event) => {
      const current = document.activeElement;
      if (!(current instanceof HTMLButtonElement)) return;
      const currentIndex = tabs.indexOf(current);
      if (currentIndex === -1) return;

      let nextIndex = -1;
      if (event.key === 'ArrowRight') {
        nextIndex = (currentIndex + 1) % tabs.length;
      } else if (event.key === 'ArrowLeft') {
        nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      } else if (event.key === 'Home') {
        nextIndex = 0;
      } else if (event.key === 'End') {
        nextIndex = tabs.length - 1;
      }

      if (nextIndex !== -1) {
        event.preventDefault();
        selectTab(tabs[nextIndex], true);
      }
    });
  }
</script>
