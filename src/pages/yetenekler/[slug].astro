---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { webpageSchema, ORG_ID } from '../../lib/schema';
import { categories, type Category } from '../../data/yetenekler';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { cat },
  }));
}

interface Props { cat: Category; }
const { cat } = Astro.props;

const url = `https://gonet.com.tr/yetenekler/${cat.slug}`;
const title = `${cat.name} — Yetkinlik Detayı | Gonet`;
const description = cat.intro;

// Önceki/sonraki kategori — sayfa altı navigation için
const idx = categories.findIndex((c) => c.slug === cat.slug);
const prev = idx > 0 ? categories[idx - 1] : null;
const next = idx < categories.length - 1 ? categories[idx + 1] : null;

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'AboutPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Yetenekler', url: 'https://gonet.com.tr/yetenekler' },
    { name: cat.name, url },
  ],
});

// DefinedTermSet — kategori bir tanım kümesi
const termSetSchema = {
  '@type': 'DefinedTermSet',
  '@id': `${url}#termset`,
  name: cat.name,
  description: cat.intro,
  url,
  inLanguage: 'tr',
  hasDefinedTerm: cat.skills.map((sk, i) => ({
    '@type': 'DefinedTerm',
    '@id': `${url}#term-${i}`,
    name: sk.name,
    description: sk.detail,
  })),
};

// Organization knowsAbout sinyali
const orgSkillSchema = {
  '@type': 'Organization',
  '@id': ORG_ID,
  knowsAbout: cat.skills.map((s) => s.name),
};
---

<BaseLayout title={title} description={description} canonical={url} schemas={[pageSchema, termSetSchema, orgSkillSchema]}>
  <article class="bg-white text-black">
    <!-- Hero — sade, profesyonel -->
    <header class="border-b border-black/15">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
        <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/yetenekler" class="hover:text-black">Yetenekler</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-700" aria-current="page">{cat.name}</li>
          </ol>
        </nav>

        <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-500 mb-3">
          Yetkinlik kategorisi {String(idx + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}
        </p>
        <h1 class="text-3xl lg:text-5xl font-bold leading-tight mb-6">
          {cat.name}
        </h1>
        <p class="text-base lg:text-lg text-slate-700 leading-relaxed max-w-3xl">
          {cat.intro}
        </p>

        <!-- Seviye dağılımı özet -->
        <div class="flex flex-wrap gap-4 mt-8 text-xs text-slate-600">
          {(['Uzman', 'İleri', 'Orta'] as const).map((lvl) => {
            const count = cat.skills.filter((s) => s.level === lvl).length;
            if (!count) return null;
            return (
              <span class="inline-flex items-center gap-1.5">
                <span class={`inline-block w-1.5 h-1.5 rounded-full ${
                  lvl === 'Uzman' ? 'bg-black' : lvl === 'İleri' ? 'bg-slate-500' : 'bg-slate-300'
                }`}></span>
                <strong class="font-semibold text-black">{count}</strong> {lvl}
              </span>
            );
          })}
          <span class="text-slate-400">·</span>
          <span><strong class="font-semibold text-black">{cat.skills.length}</strong> toplam yetkinlik</span>
        </div>
      </div>
    </header>

    <!-- Skill listesi — sade okuma, makul fontlar -->
    <section class="border-b border-black/15">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
        <h2 class="text-xl font-bold mb-8">Yetkinlikler</h2>
        <ol class="space-y-6">
          {cat.skills.map((sk, i) => (
            <li class="grid grid-cols-12 gap-4 lg:gap-8 pb-6 border-b border-black/10 last:border-0">
              <div class="col-span-12 sm:col-span-1 text-sm font-mono text-slate-400 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div class="col-span-12 sm:col-span-9">
                <h3 class="text-base lg:text-lg font-semibold leading-snug mb-1">{sk.name}</h3>
                <p class="text-sm lg:text-base text-slate-700 leading-relaxed">{sk.detail}</p>
              </div>
              <div class="col-span-12 sm:col-span-2 sm:text-right">
                <span class={`inline-block text-[10px] font-semibold uppercase tracking-[0.2em] px-2 py-1 border ${
                  sk.level === 'Uzman' ? 'border-black bg-black text-white' :
                  sk.level === 'İleri' ? 'border-slate-700 text-slate-700' :
                  'border-slate-400 text-slate-500'
                }`}>{sk.level}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Seviye tanımları — referans -->
    <section class="bg-slate-50 border-b border-black/15">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-12">
        <h2 class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-600 mb-6">Seviye ölçeği</h2>
        <div class="grid md:grid-cols-3 gap-6 text-sm">
          <div>
            <p class="font-semibold mb-1.5 inline-flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-black"></span> Uzman
            </p>
            <p class="text-slate-700 leading-relaxed">
              5+ yıl üretim ortamında, 10+ projede uyguladık. Konferansta konuşur, kurum içi eğitim verir, yeni başlayanları yönlendirebiliriz.
            </p>
          </div>
          <div>
            <p class="font-semibold mb-1.5 inline-flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-slate-500"></span> İleri
            </p>
            <p class="text-slate-700 leading-relaxed">
              2+ yıl üretim ortamında, birden fazla projede uyguladık. Karmaşık durumları çözebilir, mimari karar verebiliriz.
            </p>
          </div>
          <div>
            <p class="font-semibold mb-1.5 inline-flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-slate-300"></span> Orta
            </p>
            <p class="text-slate-700 leading-relaxed">
              Pratik kullanım var, projeye göre danışman/partner desteği ile derinleşiyoruz. Talep gelirse derinleştirebiliriz.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Önceki / sonraki kategori navigation -->
    <nav class="border-b border-black/15" aria-label="Kategori navigation">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-8 grid grid-cols-2 gap-6 text-sm">
        <div>
          {prev && (
            <a href={`/yetenekler/${prev.slug}`} class="group block">
              <p class="text-[10px] uppercase tracking-[0.3em] text-slate-500 mb-1">← Önceki</p>
              <p class="font-semibold group-hover:underline">{prev.name}</p>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a href={`/yetenekler/${next.slug}`} class="group block">
              <p class="text-[10px] uppercase tracking-[0.3em] text-slate-500 mb-1">Sonraki →</p>
              <p class="font-semibold group-hover:underline">{next.name}</p>
            </a>
          )}
        </div>
      </div>
    </nav>

    <!-- CTA -->
    <section class="bg-black text-white">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
        <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-white/60 mb-4">
          Bu kategoride iş birliği
        </p>
        <h2 class="text-2xl lg:text-3xl font-bold leading-tight mb-6 max-w-3xl">
          {cat.name} alanında bir proje konuşalım.
        </h2>
        <div class="flex flex-wrap gap-4 items-center">
          <a
            href="/iletisim"
            class="inline-block px-5 py-2.5 bg-white text-black text-sm font-semibold uppercase tracking-[0.2em] hover:bg-white/90 transition-colors"
          >
            İletişim →
          </a>
          <a
            href="/yetenekler"
            class="inline-block text-sm font-medium underline underline-offset-4 hover:no-underline"
          >
            Tüm yetenekler
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
