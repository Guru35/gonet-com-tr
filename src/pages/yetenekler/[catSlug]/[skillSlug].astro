---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { webpageSchema, ORG_ID } from '../../../lib/schema';
import { categories } from '../../../data/yetenekler';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('yetkinlikler');
  return pages
    .filter((p) => !p.data.draft)
    .map((page) => ({
      params: { catSlug: page.data.categorySlug, skillSlug: page.data.skillSlug },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const fm = page.data;

// Aynı kategorideki diğer yetkinlikler (internal link için)
// Sıra: yetenekler.ts'deki cat.skills array sırasına göre (editöryel düzen),
// alphabetical değil. Markdown dosyaları yoksa skip.
const cat = categories.find((c) => c.slug === fm.categorySlug);
const allPages = await getCollection('yetkinlikler');
const allMap = new Map<string, typeof allPages[0]>();
for (const p of allPages) {
  if (p.data.draft) continue;
  allMap.set(`${p.data.categorySlug}::${p.data.skillSlug}`, p);
}
const slugify = (name: string) => name.toLowerCase()
  .replace(/[çğıöşü]/g, (c) => ({ç:'c',ğ:'g',ı:'i',ö:'o',ş:'s',ü:'u'} as Record<string,string>)[c] || c)
  .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// CROSS-CATEGORY global flat sıra — kategori sınırlarını aşar
const flatGlobal: Array<typeof allPages[0]> = [];
for (const c of categories) {
  for (const sk of (c.skills ?? [])) {
    const slug = sk.slug ?? slugify(sk.name);
    const p = allMap.get(`${c.slug}::${slug}`);
    if (p) flatGlobal.push(p);
  }
}
const globalIdx = flatGlobal.findIndex(
  (p) => p.data.categorySlug === fm.categorySlug && p.data.skillSlug === fm.skillSlug
);
const prevSkill = globalIdx > 0 ? flatGlobal[globalIdx - 1] : null;
const nextSkill = globalIdx >= 0 && globalIdx < flatGlobal.length - 1 ? flatGlobal[globalIdx + 1] : null;

// Aynı kategorideki diğer skill'ler ("İlgili yetkinlikler" bloğu için)
const orderedSiblings = (cat?.skills ?? [])
  .map((sk) => allMap.get(`${fm.categorySlug}::${sk.slug ?? slugify(sk.name)}`))
  .filter((p): p is NonNullable<typeof p> => !!p);
const siblings = orderedSiblings
  .filter((p) => p.data.skillSlug !== fm.skillSlug)
  .map((p) => ({ slug: p.data.skillSlug, title: p.data.title }));

const url = `https://gonet.com.tr/yetenekler/${fm.categorySlug}/${fm.skillSlug}`;
const title = `${fm.title} — ${fm.categoryName} | Gonet`;
const description = fm.description;

// WebPage + Breadcrumb
const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'WebPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Yetenekler', url: 'https://gonet.com.tr/yetenekler' },
    { name: fm.categoryName, url: `https://gonet.com.tr/yetenekler/${fm.categorySlug}` },
    { name: fm.title, url },
  ],
});

// Service @type — bu sayfa bir Gonet hizmet/yetkinlik tanımı
const serviceSchema = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: fm.title,
  description: fm.description,
  serviceType: fm.categoryName,
  provider: { '@id': ORG_ID },
  areaServed: { '@type': 'Country', name: 'TR' },
  url,
  keywords: fm.keywords?.join(', ') ?? undefined,
};

// FAQPage — extraction-ready Q&A
const faqSchema = fm.faqs && fm.faqs.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  mainEntity: fm.faqs.map((f, i) => ({
    '@type': 'Question',
    '@id': `${url}#faq-${i}`,
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
} : null;

const schemas = [pageSchema, serviceSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout title={title} description={description} canonical={url} schemas={schemas} transparentHeader={!!fm.detailHero}>
  <article class="bg-white text-black">
    <!-- Hero — opsiyonel geniş arka plan görseli + toggle -->
    <header class={`relative border-b border-black/15 overflow-hidden ${fm.detailHero ? '-mt-[72px] pt-[72px]' : ''}`} data-detail-hero>
      {fm.detailHero && (
        <div class="absolute inset-0 z-0 pointer-events-none transition-opacity duration-300"
             style={`background-image: url('${fm.detailHero}'); background-size: cover; background-position: center; opacity: 0.25;`}
             data-detail-hero-bg></div>
      )}
      {fm.detailHero && (
        <div class="absolute inset-0 z-0 pointer-events-none bg-white/25 transition-opacity duration-300"
             data-detail-hero-fade></div>
      )}

      <!-- Önceki/sonraki yetkinlik okları (cross-category — kategori sınırlarını aşar) -->
      <!-- Hero içinde absolute → scroll sırasında JS ile fixed'a alınır (sticky sliders) -->
      {prevSkill && (
        <a href={`/yetenekler/${prevSkill.data.categorySlug}/${prevSkill.data.skillSlug}`}
           title={`Önceki: ${prevSkill.data.title}`}
           data-hero-nav="prev"
           class="hero-nav-arrow group hidden lg:flex absolute left-2 xl:left-6 top-1/2 -translate-y-1/2 z-30
                  w-12 h-12 xl:w-14 xl:h-14 items-center justify-center rounded-full
                  bg-white/70 hover:bg-white backdrop-blur border border-black/10 hover:border-black
                  shadow-sm hover:shadow-md"
           aria-label={`Önceki yetkinlik: ${prevSkill.data.title}`}>
          <svg class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          <span class="absolute left-full ml-3 px-3 py-1.5 bg-black text-white text-[11px] font-semibold uppercase tracking-[0.15em] whitespace-nowrap
                       opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300">
            ← {prevSkill.data.title}
          </span>
        </a>
      )}
      {nextSkill && (
        <a href={`/yetenekler/${nextSkill.data.categorySlug}/${nextSkill.data.skillSlug}`}
           title={`Sonraki: ${nextSkill.data.title}`}
           data-hero-nav="next"
           class="hero-nav-arrow group hidden lg:flex absolute right-2 xl:right-6 top-1/2 -translate-y-1/2 z-30
                  w-12 h-12 xl:w-14 xl:h-14 items-center justify-center rounded-full
                  bg-white/70 hover:bg-white backdrop-blur border border-black/10 hover:border-black
                  shadow-sm hover:shadow-md"
           aria-label={`Sonraki yetkinlik: ${nextSkill.data.title}`}>
          <svg class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
          <span class="absolute right-full mr-3 px-3 py-1.5 bg-black text-white text-[11px] font-semibold uppercase tracking-[0.15em] whitespace-nowrap
                       opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-300">
            {nextSkill.data.title} →
          </span>
        </a>
      )}

      <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10 py-12 lg:py-20">
        <nav class="text-sm text-slate-500 mb-8 flex items-center justify-between gap-4" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/yetenekler" class="hover:text-black">Yetenekler</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`/yetenekler/${fm.categorySlug}`} class="hover:text-black">{fm.categoryName}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-700" aria-current="page">{fm.title}</li>
          </ol>
          {fm.detailHero && (
            <button type="button"
                    data-detail-hero-toggle
                    class="shrink-0 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500 hover:text-black underline underline-offset-4 decoration-1"
                    aria-pressed="true">
              <span data-detail-hero-toggle-on>Görseli gizle</span>
              <span data-detail-hero-toggle-off class="hidden">Görseli göster</span>
            </button>
          )}
        </nav>

        <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-500 mb-3">
          {fm.categoryName} · {fm.skillLevel}
        </p>
        <h1 class="text-3xl lg:text-5xl font-bold leading-tight mb-6">
          {fm.h1 || fm.title}
        </h1>
        <p class="text-lg lg:text-xl text-slate-700 leading-relaxed max-w-3xl">
          {fm.description}
        </p>

        <!-- Share + back actions -->
        <div class="mt-10 flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.2em]">
          <div class="share-wrap relative">
            <button type="button"
                    data-share-trigger
                    data-share-url={url}
                    data-share-title={fm.title}
                    data-share-text={fm.description}
                    class="inline-flex items-center gap-2 px-3 py-1.5 border border-black bg-white/80 backdrop-blur hover:bg-black hover:text-white transition-colors"
                    aria-expanded="false"
                    aria-haspopup="menu">
              Paylaş
            </button>
            <!-- Custom share popover — minimal editorial, ikon yok, sadece etiket -->
            <div data-share-menu
                 class="hidden absolute top-full left-0 mt-2 z-30 min-w-[200px] bg-white shadow-[0_8px_28px_rgba(0,0,0,0.14)] border border-black/10"
                 role="menu">
              <a data-share-x href="#" target="_blank" rel="noopener" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">
                X / Twitter
              </a>
              <a data-share-linkedin href="#" target="_blank" rel="noopener" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">
                LinkedIn
              </a>
              <a data-share-whatsapp href="#" target="_blank" rel="noopener" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">
                WhatsApp
              </a>
              <a data-share-email href="#" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">
                E-posta
              </a>
              <button type="button" data-share-copy role="menuitem"
                      class="block w-full text-left px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors">
                <span data-share-copy-default>Bağlantıyı kopyala</span>
                <span data-share-copy-done class="hidden text-emerald-600">✓ Kopyalandı</span>
              </button>
            </div>
          </div>
          <a href={`/yetenekler/${fm.categorySlug}`} class="text-slate-600 hover:text-black underline underline-offset-4 decoration-1">
            ← {fm.categoryName}
          </a>
        </div>
      </div>
    </header>

    <!-- Body — Markdown render. Paragraflar üstten alta küçülerek (editöryel modülasyon) -->
    <section class="border-b border-black/15">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
        <div class="body-typography prose prose-lg prose-slate max-w-none
                    prose-headings:font-bold prose-headings:text-black
                    prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
                    prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                    prose-p:text-slate-700 prose-p:leading-relaxed
                    prose-a:text-brand-700 prose-a:no-underline hover:prose-a:underline
                    prose-strong:text-black
                    prose-table:text-sm prose-th:bg-slate-50 prose-th:text-left
                    prose-td:py-2 prose-td:px-3 prose-th:py-2 prose-th:px-3
                    prose-li:my-1">
          <Content />
        </div>

        <!-- Yazı sonu ikinci paylaş butonu -->
        <div class="mt-12 pt-8 border-t border-black/10 flex items-center justify-between gap-4 flex-wrap text-[11px] font-semibold uppercase tracking-[0.2em]">
          <p class="text-slate-500">İşine yarayan bir yazı mıydı?</p>
          <div class="share-wrap relative">
            <button type="button"
                    data-share-trigger
                    data-share-url={url}
                    data-share-title={fm.title}
                    data-share-text={fm.description}
                    class="inline-flex items-center gap-2 px-3 py-1.5 border border-black bg-white hover:bg-black hover:text-white transition-colors"
                    aria-expanded="false"
                    aria-haspopup="menu">
              Paylaş
            </button>
            <div data-share-menu
                 class="hidden absolute bottom-full right-0 mb-2 z-30 min-w-[200px] bg-white shadow-[0_8px_28px_rgba(0,0,0,0.14)] border border-black/10"
                 role="menu">
              <a data-share-x href="#" target="_blank" rel="noopener" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">X / Twitter</a>
              <a data-share-linkedin href="#" target="_blank" rel="noopener" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">LinkedIn</a>
              <a data-share-whatsapp href="#" target="_blank" rel="noopener" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">WhatsApp</a>
              <a data-share-email href="#" role="menuitem"
                 class="block px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors border-b border-black/5">E-posta</a>
              <button type="button" data-share-copy role="menuitem"
                      class="block w-full text-left px-4 py-3 text-[11px] font-semibold tracking-[0.18em] text-black hover:bg-black hover:text-white transition-colors">
                <span data-share-copy-default>Bağlantıyı kopyala</span>
                <span data-share-copy-done class="hidden text-emerald-600">✓ Kopyalandı</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Global tipografi modülasyonu — Astro scoped style markdown'a uygulanmıyor, is:global lazım -->
    <!-- Google ferah: bolt değil, lighter weight, geniş satır/paragraf aralığı, yavaş kademeli küçülme -->
    <style is:global>
      /* Tüm paragraflar — geniş hava */
      .body-typography > p {
        line-height: 1.85 !important;
        margin-bottom: 1.75rem !important;
        font-weight: 400 !important;
        color: rgb(30 41 59) !important;
      }
      /* H2 ve H3 başlıklar için de geniş aralık */
      .body-typography > h2 {
        margin-top: 3.5rem !important;
        margin-bottom: 1.25rem !important;
        line-height: 1.3 !important;
      }
      .body-typography > h3 {
        margin-top: 2.5rem !important;
        margin-bottom: 1rem !important;
        line-height: 1.4 !important;
      }

      /* Editöryel kademeli küçülme — title'dan 2 boy altından, bolt değil, daha büyükten başla */
      /* Title h1: text-3xl mobile (30px) / text-5xl desktop (48px), font-bold */
      /* İlk paragraf: title'ın 2 boy aşağısı, bolt OLMAYAN — geniş başlangıç */
      .body-typography > p:first-of-type {
        font-size: 1.625rem !important;      /* ~26px mobile */
        line-height: 1.5 !important;
        font-weight: 400 !important;          /* bolt DEĞİL */
        color: rgb(15 23 42) !important;
        margin-bottom: 2.25rem !important;
      }
      @media (min-width: 1024px) {
        .body-typography > p:first-of-type {
          font-size: 2.25rem !important;     /* ~36px desktop — title 48px'in 2 boy altı */
          line-height: 1.4 !important;
        }
      }
      .body-typography > p:nth-of-type(2) {
        font-size: 1.375rem !important;      /* ~22px mobile */
        line-height: 1.6 !important;
        font-weight: 400 !important;
      }
      @media (min-width: 1024px) {
        .body-typography > p:nth-of-type(2) {
          font-size: 1.75rem !important;     /* ~28px desktop */
          line-height: 1.5 !important;
        }
      }
      .body-typography > p:nth-of-type(3) {
        font-size: 1.25rem !important;       /* ~20px mobile */
        line-height: 1.7 !important;
        font-weight: 400 !important;
      }
      @media (min-width: 1024px) {
        .body-typography > p:nth-of-type(3) {
          font-size: 1.5rem !important;      /* ~24px desktop */
          line-height: 1.6 !important;
        }
      }
      /* 4. paragraftan sonra standart minimum okunabilir — küçük degil, ferah */
      .body-typography > p:nth-of-type(n+4) {
        font-size: 1.1875rem !important;     /* ~19px — küçük değil, akıcı */
        line-height: 1.75 !important;
      }
      /* H2 sonrası ilk paragraf — her bölümün hafif vurgulu girişi */
      .body-typography h2 + p {
        font-size: 1.3125rem !important;     /* ~21px */
        font-weight: 400 !important;
        color: rgb(15 23 42) !important;
        line-height: 1.7 !important;
      }
      @media (min-width: 1024px) {
        .body-typography h2 + p {
          font-size: 1.4375rem !important;   /* ~23px desktop */
        }
      }
      /* Liste içi her madde geniş */
      .body-typography ul, .body-typography ol {
        margin-top: 1.25rem !important;
        margin-bottom: 1.75rem !important;
      }
      .body-typography li {
        margin-top: 0.625rem !important;
        margin-bottom: 0.625rem !important;
        line-height: 1.75 !important;
      }
      /* ───── Hero nav okları — scroll'da sticky, scrolling sırasında daire kaybolur ───── */
      @media (min-width: 1024px) {
        .hero-nav-arrow {
          /* Sticky — sayfa scroll'da viewport ortasında kalır */
          position: fixed !important;
          top: 50% !important;
          transform: translateY(-50%) !important;
          transition: background 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                      border-color 0.3s ease,
                      box-shadow 0.3s ease,
                      backdrop-filter 0.3s ease,
                      opacity 0.2s ease;
        }
        .hero-nav-arrow[data-hero-nav="prev"] { left: 1rem !important; right: auto !important; }
        .hero-nav-arrow[data-hero-nav="next"] { right: 1rem !important; left: auto !important; }
      }
      @media (min-width: 1280px) {
        .hero-nav-arrow[data-hero-nav="prev"] { left: 1.5rem !important; }
        .hero-nav-arrow[data-hero-nav="next"] { right: 1.5rem !important; }
      }
      /* Scrolling esnasında: daire (background, border, shadow, backdrop) kaybol → sadece ok kalır */
      .hero-nav-arrow.is-scrolling {
        background: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
      }
      .hero-nav-arrow.is-scrolling .group-hover\:opacity-100 {
        opacity: 0 !important;
      }
      /* Footer/CTA'ya yakınken oklar gizlenmesin diye — body sonu sınırı yok, hep görünür */

      /* Tablo aralıkları */
      .body-typography table {
        margin-top: 2.5rem !important;
        margin-bottom: 2.5rem !important;
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
      }
      .body-typography th, .body-typography td {
        padding: 1rem 1.25rem !important;
        vertical-align: top !important;
        line-height: 1.7 !important;
      }
      .body-typography th {
        font-weight: 600 !important;
        color: rgb(15 23 42) !important;
        background: rgb(248 250 252) !important;
        border-bottom: 1.5px solid rgb(0 0 0 / 0.15) !important;
      }
      .body-typography td {
        border-bottom: 1px solid rgb(0 0 0 / 0.06) !important;
      }
      .body-typography tr:last-child td {
        border-bottom: 0 !important;
      }
      .body-typography td:first-child {
        font-weight: 500 !important;
        color: rgb(15 23 42) !important;
        width: 38% !important;
      }
      .body-typography td:nth-child(2) {
        width: 62% !important;
      }
      .body-typography table {
        table-layout: fixed !important;
      }

      /* MOBİL: tabloyu satır-bazlı kart yapısına çevir */
      @media (max-width: 768px) {
        .body-typography table thead { display: none !important; }
        .body-typography table, .body-typography tbody, .body-typography tr, .body-typography td {
          display: block !important;
          width: 100% !important;
        }
        .body-typography tr {
          margin-bottom: 1.5rem !important;
          border: 1px solid rgb(0 0 0 / 0.1) !important;
          padding: 1rem 1.25rem !important;
          background: white !important;
        }
        .body-typography td {
          padding: 0.5rem 0 !important;
          border: 0 !important;
          white-space: normal !important;
        }
        .body-typography td:first-child {
          font-weight: 600 !important;
          color: rgb(15 23 42) !important;
          font-size: 0.95rem !important;
          padding-bottom: 0.5rem !important;
          border-bottom: 1px solid rgb(0 0 0 / 0.08) !important;
          margin-bottom: 0.5rem !important;
        }
      }

      /* İçerik blokları arası ekstra hava — sıkışıklığı azalt */
      .body-typography > * + * {
        margin-top: 1.5rem !important;
      }

      /* ───── İnfografik bileşenleri ───── */

      /* Statistic bars — yatay çubuk grafik (3-5 metric için) */
      .gonet-stat-bars {
        margin: 3rem 0 !important;
        padding: 2rem 0;
        border-top: 1px solid rgb(0 0 0 / 0.08);
        border-bottom: 1px solid rgb(0 0 0 / 0.08);
      }
      .gonet-stat-bars .stat-title {
        font-size: 0.8125rem !important;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: rgb(100 116 139);
        margin-bottom: 2rem;
      }
      .gonet-stat-bar {
        display: grid;
        grid-template-columns: minmax(140px, 30%) 1fr auto;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
