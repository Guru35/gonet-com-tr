  <!-- Detail hero toggle + share button -->
  <script is:inline>
    (function () {
      // Detail hero görsel toggle
      const dBtn = document.querySelector('[data-detail-hero-toggle]');
      const dBg = document.querySelector('[data-detail-hero-bg]');
      const dFade = document.querySelector('[data-detail-hero-fade]');
      const dOn = document.querySelector('[data-detail-hero-toggle-on]');
      const dOff = document.querySelector('[data-detail-hero-toggle-off]');
      const KEY = 'gonet:yetkinlik:hero-visible';

      function applyDetailHero(visible) {
        if (!dBg || !dFade) return;
        if (visible) {
          dBg.style.opacity = '0.25';
          dFade.style.opacity = '1';
          dOn?.classList.remove('hidden');
          dOff?.classList.add('hidden');
          dBtn?.setAttribute('aria-pressed', 'true');
        } else {
          dBg.style.opacity = '0';
          dFade.style.opacity = '0';
          dOn?.classList.add('hidden');
          dOff?.classList.remove('hidden');
          dBtn?.setAttribute('aria-pressed', 'false');
        }
      }
      if (dBtn) {
        const saved = localStorage.getItem(KEY);
        if (saved === 'false') applyDetailHero(false);
        dBtn.addEventListener('click', () => {
          const cur = dBtn.getAttribute('aria-pressed') === 'true';
          const next = !cur;
          applyDetailHero(next);
          localStorage.setItem(KEY, String(next));
        });
      }

      // Custom share popover — her .share-wrap için ayrı (hero + body altı 2 adet)
      document.querySelectorAll('.share-wrap').forEach((wrap) => {
        const trigger = wrap.querySelector('[data-share-trigger]');
        const menu = wrap.querySelector('[data-share-menu]');
        if (!trigger || !menu) return;
        const url = trigger.getAttribute('data-share-url') || window.location.href;
        const title = trigger.getAttribute('data-share-title') || document.title;
        const text = trigger.getAttribute('data-share-text') || '';
        const enc = encodeURIComponent;

        // Link href'lerini doldur
        const links = {
          'data-share-x': `https://x.com/intent/post?text=${enc(title)}&url=${enc(url)}`,
          'data-share-linkedin': `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
          'data-share-whatsapp': `https://wa.me/?text=${enc(title + ' — ' + url)}`,
          'data-share-email': `mailto:?subject=${enc(title)}&body=${enc(text + '\n\n' + url)}`,
        };
        Object.entries(links).forEach(([attr, href]) => {
          const el = wrap.querySelector(`[${attr}]`);
          if (el) el.setAttribute('href', href);
        });

        // Trigger toggle
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = !menu.classList.contains('hidden');
          // Tüm popover'ları kapat
          document.querySelectorAll('[data-share-menu]').forEach((m) => m.classList.add('hidden'));
          document.querySelectorAll('[data-share-trigger]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
          if (!isOpen) {
            menu.classList.remove('hidden');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });

        // Copy link button
        const copyBtn = wrap.querySelector('[data-share-copy]');
        const copyDef = wrap.querySelector('[data-share-copy-default]');
        const copyDone = wrap.querySelector('[data-share-copy-done]');
        if (copyBtn) {
          copyBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
              await navigator.clipboard.writeText(url);
              copyDef?.classList.add('hidden');
              copyDone?.classList.remove('hidden');
              setTimeout(() => {
                copyDef?.classList.remove('hidden');
                copyDone?.classList.add('hidden');
                menu.classList.add('hidden');
                trigger.setAttribute('aria-expanded', 'false');
              }, 1500);
            } catch (_) {
              window.prompt('Bu linki kopyalayın:', url);
            }
          });
        }
      });

      // Dış tıklama ile popover kapat
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.share-wrap')) {
          document.querySelectorAll('[data-share-menu]').forEach((m) => m.classList.add('hidden'));
          document.querySelectorAll('[data-share-trigger]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
        }
      });

      // FAQ accordion — Safari/eski Chrome <details name="..."> mutex polyfill
      const faqAcc = document.querySelector('[data-faq-accordion]');
      if (faqAcc) {
        const detailsList = Array.from(faqAcc.querySelectorAll('details'));
        // Native browser zaten name="faq" ile çözüyorsa skip; eski sürümler için manuel
        const supportsExclusive = 'name' in document.createElement('details');
        if (!supportsExclusive) {
          detailsList.forEach((d) => {
            d.addEventListener('toggle', () => {
              if (d.open) {
                detailsList.forEach((other) => { if (other !== d) other.open = false; });
              }
            });
          });
        }
      }
    })();
  </script>
</BaseLayout>
