---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { webpageSchema, ORG_ID } from '../../../lib/schema';
import { categories } from '../../../data/yetenekler';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('yetkinlikler');
  return pages
    .filter((p) => !p.data.draft)
    .map((page) => ({
      params: { catSlug: page.data.categorySlug, skillSlug: page.data.skillSlug },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const fm = page.data;

// Aynı kategorideki diğer yetkinlikler (internal link için)
const cat = categories.find((c) => c.slug === fm.categorySlug);
const siblings = (await getCollection('yetkinlikler'))
  .filter((p) => p.data.categorySlug === fm.categorySlug && p.data.skillSlug !== fm.skillSlug && !p.data.draft)
  .map((p) => ({ slug: p.data.skillSlug, title: p.data.title }));

const url = `https://gonet.com.tr/yetenekler/${fm.categorySlug}/${fm.skillSlug}`;
const title = `${fm.title} — ${fm.categoryName} | Gonet`;
const description = fm.description;

// WebPage + Breadcrumb
const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'WebPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Yetenekler', url: 'https://gonet.com.tr/yetenekler' },
    { name: fm.categoryName, url: `https://gonet.com.tr/yetenekler/${fm.categorySlug}` },
    { name: fm.title, url },
  ],
});

// Service @type — bu sayfa bir Gonet hizmet/yetkinlik tanımı
const serviceSchema = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: fm.title,
  description: fm.description,
  serviceType: fm.categoryName,
  provider: { '@id': ORG_ID },
  areaServed: { '@type': 'Country', name: 'TR' },
  url,
  keywords: fm.keywords?.join(', ') ?? undefined,
};

// FAQPage — extraction-ready Q&A
const faqSchema = fm.faqs && fm.faqs.length > 0 ? {
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  mainEntity: fm.faqs.map((f, i) => ({
    '@type': 'Question',
    '@id': `${url}#faq-${i}`,
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
} : null;

const schemas = [pageSchema, serviceSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout title={title} description={description} canonical={url} schemas={schemas} transparentHeader={!!fm.detailHero}>
  <article class="bg-white text-black">
    <!-- Hero — opsiyonel geniş arka plan görseli + toggle -->
    <header class={`relative border-b border-black/15 overflow-hidden ${fm.detailHero ? '-mt-[72px] pt-[72px]' : ''}`} data-detail-hero>
      {fm.detailHero && (
        <div class="absolute inset-0 z-0 pointer-events-none transition-opacity duration-300"
             style={`background-image: url('${fm.detailHero}'); background-size: cover; background-position: center; opacity: 0.85;`}
             data-detail-hero-bg></div>
      )}
      {fm.detailHero && (
        <div class="absolute inset-0 z-0 pointer-events-none bg-gradient-to-b from-white/30 via-white/55 to-white/85 transition-opacity duration-300"
             data-detail-hero-fade></div>
      )}

      <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10 py-12 lg:py-20">
        <nav class="text-sm text-slate-500 mb-8 flex items-center justify-between gap-4" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/yetenekler" class="hover:text-black">Yetenekler</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`/yetenekler/${fm.categorySlug}`} class="hover:text-black">{fm.categoryName}</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-700" aria-current="page">{fm.title}</li>
          </ol>
          {fm.detailHero && (
            <button type="button"
                    data-detail-hero-toggle
                    class="shrink-0 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500 hover:text-black underline underline-offset-4 decoration-1"
                    aria-pressed="true">
              <span data-detail-hero-toggle-on>Görseli gizle</span>
              <span data-detail-hero-toggle-off class="hidden">Görseli göster</span>
            </button>
          )}
        </nav>

        <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-500 mb-3">
          {fm.categoryName} · {fm.skillLevel}
        </p>
        <h1 class="text-3xl lg:text-5xl font-bold leading-tight mb-6">
          {fm.h1 || fm.title}
        </h1>
        <p class="text-lg lg:text-xl text-slate-700 leading-relaxed max-w-3xl">
          {fm.description}
        </p>

        <!-- Share + back actions -->
        <div class="mt-10 flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.2em]">
          <button type="button"
                  data-share-btn
                  data-share-url={url}
                  data-share-title={fm.title}
                  data-share-text={fm.description}
                  class="inline-flex items-center gap-2 px-3 py-1.5 border border-black bg-white/80 backdrop-blur hover:bg-black hover:text-white transition-colors">
            <span data-share-default>Paylaş</span>
            <span data-share-copied class="hidden">✓ Link kopyalandı</span>
          </button>
          <a href={`/yetenekler/${fm.categorySlug}`} class="text-slate-600 hover:text-black underline underline-offset-4 decoration-1">
            ← {fm.categoryName}
          </a>
        </div>
      </div>
    </header>

    <!-- Body — Markdown render. Paragraflar üstten alta küçülerek (editöryel modülasyon) -->
    <section class="border-b border-black/15">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
        <div class="body-typography prose prose-lg prose-slate max-w-none
                    prose-headings:font-bold prose-headings:text-black
                    prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
                    prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                    prose-p:text-slate-700 prose-p:leading-relaxed
                    prose-a:text-brand-700 prose-a:no-underline hover:prose-a:underline
                    prose-strong:text-black
                    prose-table:text-sm prose-th:bg-slate-50 prose-th:text-left
                    prose-td:py-2 prose-td:px-3 prose-th:py-2 prose-th:px-3
                    prose-li:my-1">
          <Content />
        </div>
      </div>
    </section>

    <style>
      /* Editöryel typography modülasyonu — ilk paragraflar büyük/koyu, alta doğru standart */
      .body-typography > p:first-of-type {
        font-size: 1.5rem;        /* ~24px */
        line-height: 1.4;
        font-weight: 600;
        color: rgb(15 23 42);     /* slate-900 */
        margin-bottom: 1.5rem;
      }
      .body-typography > p:nth-of-type(2) {
        font-size: 1.15rem;       /* ~18.5px */
        line-height: 1.55;
        font-weight: 500;
        color: rgb(30 41 59);     /* slate-800 */
      }
      .body-typography > p:nth-of-type(3) {
        font-size: 1.05rem;       /* ~17px */
        font-weight: 450;
      }
      /* H2 sonrası ilk paragraf da hafif vurgu (her bölümün başı) */
      .body-typography h2 + p {
        font-size: 1.1rem;
        font-weight: 500;
        color: rgb(30 41 59);
      }
    </style>

    <!-- SSS — FAQPage schema ayrıca yukarıda eklendi -->
    {fm.faqs && fm.faqs.length > 0 && (
      <section class="border-b border-black/15 bg-slate-50">
        <div class="max-w-3xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
          <h2 class="text-2xl lg:text-3xl font-bold mb-8">Sık sorulan sorular</h2>
          <dl class="space-y-6">
            {fm.faqs.map((faq) => (
              <div class="border-l-2 border-brand-600 pl-5">
                <dt class="text-base lg:text-lg font-semibold text-black mb-2">{faq.q}</dt>
                <dd class="text-slate-700 leading-relaxed">{faq.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <!-- İlgili yetkinlikler — aynı kategorideki kardeşler -->
    {siblings.length > 0 && (
      <section class="border-b border-black/15">
        <div class="max-w-4xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
          <h2 class="text-2xl font-bold mb-2">{fm.categoryName} altındaki diğer yetkinlikler</h2>
          <p class="text-sm text-slate-500 mb-8">Bu kategoride toplam {siblings.length + 1} yetkinlik.</p>
          <ul class="grid sm:grid-cols-2 gap-4">
            {siblings.map((s) => (
              <li>
                <a href={`/yetenekler/${fm.categorySlug}/${s.slug}`}
                   class="block p-5 border border-black/10 hover:border-black hover:bg-slate-50 transition-colors group">
                  <span class="block text-base font-semibold text-black group-hover:underline">{s.title}</span>
                  <span class="block text-xs uppercase tracking-wider text-slate-500 mt-2">İncele →</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <a href={`/yetenekler/${fm.categorySlug}`} class="text-sm font-semibold underline underline-offset-4 hover:no-underline">
              ← {fm.categoryName} ana sayfasına dön
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="bg-black text-white">
      <div class="max-w-4xl mx-auto px-6 lg:px-10 py-16 lg:py-20 text-center">
        <h2 class="text-2xl lg:text-4xl font-bold mb-4">Markanız için bu yetkinliği konuşalım</h2>
        <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto">
          25 yıllık ajans deneyimi ve 220+ marka portföyü ile {fm.title.toLowerCase()} disiplinini markanıza nasıl uygulayacağımızı bir görüşmede netleştirelim.
        </p>
        <a href="/iletisim" class="inline-block px-8 py-4 bg-white text-black font-bold uppercase tracking-wider hover:bg-slate-200 transition-colors">
          İletişime geç →
        </a>
      </div>
    </section>
  </article>

  <!-- Detail hero toggle + share button -->
  <script is:inline>
    (function () {
      // Detail hero görsel toggle
      const dBtn = document.querySelector('[data-detail-hero-toggle]');
      const dBg = document.querySelector('[data-detail-hero-bg]');
      const dFade = document.querySelector('[data-detail-hero-fade]');
      const dOn = document.querySelector('[data-detail-hero-toggle-on]');
      const dOff = document.querySelector('[data-detail-hero-toggle-off]');
      const KEY = 'gonet:yetkinlik:hero-visible';

      function applyDetailHero(visible) {
        if (!dBg || !dFade) return;
        if (visible) {
          dBg.style.opacity = '0.85';
          dFade.style.opacity = '1';
          dOn?.classList.remove('hidden');
          dOff?.classList.add('hidden');
          dBtn?.setAttribute('aria-pressed', 'true');
        } else {
          dBg.style.opacity = '0';
          dFade.style.opacity = '0';
          dOn?.classList.add('hidden');
          dOff?.classList.remove('hidden');
          dBtn?.setAttribute('aria-pressed', 'false');
        }
      }
      if (dBtn) {
        const saved = localStorage.getItem(KEY);
        if (saved === 'false') applyDetailHero(false);
        dBtn.addEventListener('click', () => {
          const cur = dBtn.getAttribute('aria-pressed') === 'true';
          const next = !cur;
          applyDetailHero(next);
          localStorage.setItem(KEY, String(next));
        });
      }

      // Share button — Web Share API + clipboard fallback
      const sBtn = document.querySelector('[data-share-btn]');
      const sDefault = document.querySelector('[data-share-default]');
      const sCopied = document.querySelector('[data-share-copied]');
      if (sBtn) {
        sBtn.addEventListener('click', async () => {
          const url = sBtn.getAttribute('data-share-url') || window.location.href;
          const title = sBtn.getAttribute('data-share-title') || document.title;
          const text = sBtn.getAttribute('data-share-text') || '';
          if (navigator.share) {
            try { await navigator.share({ title, text, url }); return; } catch (_) {}
          }
          try {
            await navigator.clipboard.writeText(url);
            sDefault?.classList.add('hidden');
            sCopied?.classList.remove('hidden');
            setTimeout(() => {
              sDefault?.classList.remove('hidden');
              sCopied?.classList.add('hidden');
            }, 2500);
          } catch (_) {
            window.prompt('Bu linki kopyalayın:', url);
          }
        });
      }
    })();
  </script>
</BaseLayout>
