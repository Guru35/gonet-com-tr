---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema, faqSchema } from '../lib/schema';

const title = 'İletişim — Gonet İzmir';
const description =
  "Gonet ile iletişime geçin — İzmir Buca, DEÜ Tınaztepe Teknopark. " +
  'gonet@gonet.com.tr · +90 232 465 00 15. Projeniz için stratejik destek.';
const url = 'https://gonet.com.tr/iletisim';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'ContactPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'İletişim', url },
  ],
});

const faq = faqSchema([
  {
    question: 'Gonet ile nasıl iletişime geçilir?',
    answer:
      'E-posta: gonet@gonet.com.tr. Telefon: +90 232 465 00 15. İzmir Buca\'da DEÜ Tınaztepe ' +
      'Kampüsü Teknopark ofisimizden tek bir görüşmede projenizi dinleyip yol haritası sunabiliriz.',
  },
  {
    question: 'Görüşme öncesi hangi bilgileri hazırlamalıyım?',
    answer:
      'Markanız/projeniz hakkında kısa bir özet, mevcut dijital varlığınız (varsa), hedeflediğiniz ' +
      'sonuçlar ve yaklaşık bütçe aralığınız. Bu dört bilgi ilk görüşmenin verimli geçmesini sağlar.',
  },
  {
    question: 'Hangi şehirlerden müşteriniz var?',
    answer:
      'İzmir merkezliyiz, ama portföyümüz tüm Türkiye\'ye yayılıyor. İstanbul (Oztan Tekstil), ' +
      'Ankara (siyasi parti merkezleri), Amasya (Merzifon Belediyesi) gibi şehirlerden müşterilerimiz var. ' +
      'Almanya ve Hollanda Türk pazarına yönelik uluslararası projelerimiz (Simtronik) de mevcuttur.',
  },
  {
    question: 'Ücretsiz strateji görüşmesi yapıyor musunuz?',
    answer:
      'Evet. İlk tanışma görüşmesi 30-45 dakikadır, ücretsizdir. Projenizi dinleyip, başlangıç ' +
      'önerileri sunarız. Sonrasında kapsamlı bir teklif ve yol haritası için ayrı bir toplantı yapılır.',
  },
  {
    question: 'Online forma alternatif var mı?',
    answer:
      'E-posta (gonet@gonet.com.tr) ve telefon yoluyla doğrudan ulaşabilirsiniz. Form ' +
      'gönderimi sonrası e-posta programınız açılır; mesajınızı doğrudan iletmiş olursunuz.',
  },
]);

// ContactPoint schemas
const contactPoints = {
  '@type': 'Organization',
  '@id': 'https://gonet.com.tr/#organization',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: 'gonet@gonet.com.tr',
      telephone: '+90-232-465-00-15',
      availableLanguage: ['Turkish', 'English'],
      areaServed: ['TR', 'NL', 'DE'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'gonet@gonet.com.tr',
      telephone: '+90-232-463-46-49',
      availableLanguage: ['Turkish'],
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Adatepe Mah. DEÜ Tınaztepe Kampüsü',
    addressLocality: 'Buca',
    addressRegion: 'İzmir',
    addressCountry: 'TR',
  },
};
---

<BaseLayout title={title} description={description} canonical={url} schemas={[pageSchema, faq, contactPoints]}>
  <!-- Hero -->
  <section class="bg-white border-b border-black">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700" aria-current="page">İletişim</li>
        </ol>
      </nav>
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-8">
        İletişim
      </p>
      <h1 class="editorial-display text-[14vw] lg:text-[9vw] xl:text-[140px] leading-[0.9] mb-10">
        Projenizi konuşalım.
      </h1>
      <p class="text-xl text-slate-700 leading-relaxed">
        25 yıllık ajansla ilk tanışma görüşmesi 30-45 dakika, ücretsizdir. Gökhan Kazancı ile
        doğrudan görüşeceksiniz.
      </p>
    </div>
  </section>

  <!-- Tek alan formu + iletişim bilgileri -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-3 gap-16">
      <!-- Form (2 col) -->
      <div class="lg:col-span-2">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-6">
          Bir şeyler yazın, gönderin
        </p>
        <form
          id="mega-form"
          method="POST"
          action="https://engine.gonet.com.tr/api/contact"
          class="space-y-6"
        >
          <div class="msg-wrap relative">
            <textarea
              id="message"
              name="message"
              rows="1"
              placeholder=" "
              class="editorial-display w-full text-[10vw] lg:text-[6vw] xl:text-[96px] leading-[1.05] bg-transparent border-0 focus:outline-none resize-none p-0 block relative z-10"
              style="font-family: var(--font-display); letter-spacing: -0.01em; overflow: hidden; caret-color: #ff0000;"
            ></textarea>
            <div class="msg-overlay" aria-hidden="true">
              <span class="msg-caret"></span><span class="msg-hint">bir şeyler yazın, gönderin<br />biz size döneriz.</span>
            </div>
          </div>

          <!-- Submit + state messages -->
          <div class="flex flex-col gap-6">
            <button
              type="submit"
              id="send-btn"
              class="self-start text-2xl lg:text-3xl font-bold uppercase tracking-[0.2em] underline decoration-2 underline-offset-8 hover:decoration-4 transition-all"
            >
              Gönder →
            </button>

            <!-- Validation error (mail/telefon yok) -->
            <div
              id="form-error"
              class="hidden editorial-display text-[8vw] lg:text-[5vw] xl:text-[72px] leading-[0.95]"
              style="color: #ff0000;"
            >
              telefon ya da mail<br />adresi yazmazsanız<br />zor döneriz <span class="font-display">:)</span>
            </div>

            <!-- Server error (network / 5xx) -->
            <div
              id="form-server-error"
              class="hidden editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[0.95]"
              style="color: #ff0000;"
            >
              bir aksaklık oldu.<br />direkt <a href="mailto:gonet@gonet.com.tr" class="underline">gonet@gonet.com.tr</a> &rsquo;ye yazın.
            </div>

            <!-- Success state — birkaç saniye gösterilir, sonra solar; form çalışmaya devam eder -->
            <div
              id="form-success"
              class="hidden editorial-display text-[8vw] lg:text-[5vw] xl:text-[72px] leading-[0.95] transition-opacity duration-500"
              style="color: #16a34a;"
            >
              mesajınız gönderildi.<br />en kısa sürede döneceğiz.
            </div>

            <p class="text-[10px] uppercase tracking-[0.3em] opacity-60">
              Mesajınız doğrudan ekibe ulaşır — üyelik / kayıt yok.
            </p>
          </div>
        </form>

        <script is:inline>
          (function () {
            const form = document.getElementById('mega-form');
            const msg = document.getElementById('message');
            const err = document.getElementById('form-error');
            const serverErr = document.getElementById('form-server-error');
            const success = document.getElementById('form-success');
            const btn = document.getElementById('send-btn');
            const ENDPOINT = 'https://engine.gonet.com.tr/api/contact';
            if (!form || !msg || !err || !btn) return;

            function hasEmail(t) { return /[\w.+-]+@[\w.-]+\.\w{2,}/.test(t); }
            function hasPhone(t) {
              const digits = (t.match(/\d/g) || []).length;
              return digits >= 7;
            }
            function hideAllStates() {
              err.classList.add('hidden');
              if (serverErr) serverErr.classList.add('hidden');
              if (success) success.classList.add('hidden');
            }

            form.addEventListener('submit', async function (e) {
              e.preventDefault();
              hideAllStates();

              const text = (msg.value || '').trim();
              if (!text) {
                err.classList.remove('hidden');
                msg.focus();
                return;
              }
              if (!hasEmail(text) && !hasPhone(text)) {
                err.classList.remove('hidden');
                msg.focus();
                return;
              }

              // Send to engine.gonet.com.tr/api/contact
              btn.disabled = true;
              const originalBtnText = btn.textContent;
              btn.textContent = 'Gönderiliyor…';

              try {
                const res = await fetch(ENDPOINT, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                  body: JSON.stringify({ message: text, source: 'gonet.com.tr' }),
                });
                const data = await res.json().catch(() => ({}));

                if (res.ok && data.ok) {
                  // Başarı — textarea temizle, success göster, form çalışmaya DEVAM eder
                  msg.value = '';
                  if (success) {
                    success.style.opacity = '1';
                    success.classList.remove('hidden');
                    // 6 saniye sonra fade-out + gizle (kullanıcı yeni mesaj atabilsin)
                    setTimeout(() => {
                      success.style.opacity = '0';
                      setTimeout(() => success.classList.add('hidden'), 500);
                    }, 6000);
                  }
                  btn.disabled = false;
                  btn.textContent = originalBtnText;
                  // textarea boyutunu sıfırla (auto-grow için input event tetikle)
                  msg.dispatchEvent(new Event('input'));
                  msg.focus();
                } else if (res.status === 422 && data.error === 'no_contact_info') {
                  err.classList.remove('hidden');
                  btn.disabled = false;
                  btn.textContent = originalBtnText;
                } else {
                  // 429 (rate limit), 5xx, network — server error
                  if (serverErr) serverErr.classList.remove('hidden');
                  btn.disabled = false;
                  btn.textContent = originalBtnText;
                }
              } catch (_) {
                if (serverErr) serverErr.classList.remove('hidden');
                btn.disabled = false;
                btn.textContent = originalBtnText;
              }
            });

            // Kullanıcı yazmaya başladığında error gizlensin + auto-grow
            const overlay = document.querySelector('.msg-overlay');
            function syncMinHeight() {
              if (!overlay) return;
              const h = overlay.offsetHeight;
              if (h > 0) msg.style.minHeight = h + 'px';
            }
            function autoGrow() {
              msg.style.height = 'auto';
              const target = Math.max(msg.scrollHeight + 8, overlay ? overlay.offsetHeight : 0);
              msg.style.height = target + 'px';
            }
            msg.addEventListener('input', function () {
              err.classList.add('hidden');
              autoGrow();
            });
            // İlk yüklemede overlay yüksekliği = textarea min-height → GÖNDER overlay altına oturur
            window.addEventListener('load', function () {
              syncMinHeight();
              autoGrow();
            });
            window.addEventListener('resize', function () {
              syncMinHeight();
              autoGrow();
            });
          })();
        </script>
      </div>

      <!-- İletişim bilgileri -->
      <div>
        <h2 class="editorial-display text-[8vw] lg:text-[5vw] xl:text-[64px] leading-[0.9] mb-6">Doğrudan Ulaşım</h2>

        <div class="space-y-6">
          <div class="border-l-4 border-brand-600 pl-4">
            <div class="text-xs font-semibold text-black uppercase tracking-wider mb-1">E-posta</div>
            <a href="mailto:gonet@gonet.com.tr" class="text-xl font-semibold text-black hover:text-brand-700">
              gonet@gonet.com.tr
            </a>
            <p class="text-sm text-slate-600 mt-1">Doğrudan ekibe</p>
          </div>

          <div class="border-l-4 border-black pl-4">
            <div class="text-xs font-semibold text-black uppercase tracking-wider mb-1">Telefon</div>
            <a href="tel:+902324650015" class="block text-xl font-semibold text-black hover:text-brand-700">
              +90 232 465 00 15
            </a>
            <a href="tel:+902324634649" class="block text-xl font-semibold text-black hover:text-brand-700 mt-1">
              +90 232 463 46 49
            </a>
            <p class="text-sm text-slate-600 mt-1">Hafta içi 09:00–18:00</p>
          </div>

          <div class="border-l-4 border-black pl-4">
            <div class="text-xs font-semibold text-black uppercase tracking-wider mb-1">Adres — DEÜ Teknopark</div>
            <address class="not-italic text-slate-700">
              Adatepe Mah.<br>
              <strong>DEÜ Tınaztepe Kampüsü</strong><br>
              Buca / İzmir
            </address>
            <a
              href="https://maps.google.com/?q=DEÜ+Tınaztepe+Kampüsü+Buca+İzmir"
              target="_blank"
              rel="noopener"
              class="text-sm text-black hover:underline mt-1 inline-block"
            >
              Google Maps'te aç →
            </a>
          </div>

          <div class="border-l-4 border-black pl-4">
            <div class="text-xs font-semibold text-black uppercase tracking-wider mb-1">Tüzel Kişilik</div>
            <p class="text-slate-700 text-sm">
              Pigme Proje ve İş Geliştirme Merkezi Yazılım A.Ş.
            </p>
          </div>

          <div class="bg-white rounded-none p-6 mt-8">
            <h3 class="text-lg font-semibold text-black mb-2">Görüşme öncesi hazırlık</h3>
            <ul class="space-y-2 text-sm text-slate-700">
              <li class="flex gap-2"><span class="text-black">●</span><span>Marka/proje özeti</span></li>
              <li class="flex gap-2"><span class="text-black">●</span><span>Mevcut dijital varlık (varsa)</span></li>
              <li class="flex gap-2"><span class="text-black">●</span><span>Hedef sonuçlar</span></li>
              <li class="flex gap-2"><span class="text-black">●</span><span>Yaklaşık bütçe aralığı</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sosyal medya — editöryel çılgınlık -->
  <section class="editorial-section bg-white text-black py-24 lg:py-32 overflow-hidden" style="--rule-top-x:22%;--rule-top-w:46%;--rule-bot-x:8%;--rule-bot-w:54%">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-10">Sosyal medya</p>
      <h2 class="editorial-display text-[14vw] lg:text-[8vw] xl:text-[120px] leading-[0.85] mb-16">
        Sosyal medyada<br />
        <span style="color:#ff0000">Gonet.</span>
      </h2>

      <div class="space-y-6 lg:space-y-8">
        <a
          href="https://tr.linkedin.com/company/gonet-interactive-advertising-agency"
          target="_blank"
          rel="noopener"
          class="editorial-display block text-[10vw] lg:text-[6vw] xl:text-[88px] leading-[0.9] hover:text-[#ff0000] transition-colors"
          style="transform: rotate(-1deg); transform-origin: left;"
        >
          LinkedIn <span class="text-xs lg:text-sm font-sans uppercase tracking-[0.3em] align-super">16K+ takipçi</span>
        </a>
        <a
          href="https://www.behance.net/GonetCompany"
          target="_blank"
          rel="noopener"
          class="editorial-display block text-[10vw] lg:text-[6vw] xl:text-[88px] leading-[0.9] hover:text-[#ff0000] transition-colors lg:ml-[12%]"
          style="transform: rotate(0.8deg); transform-origin: center;"
        >
          Behance <span class="text-xs lg:text-sm font-sans uppercase tracking-[0.3em] align-super">24 proje</span>
        </a>
        <a
          href="https://www.instagram.com/gonetinteractive/"
          target="_blank"
          rel="noopener"
          class="editorial-display block text-[10vw] lg:text-[6vw] xl:text-[88px] leading-[0.9] hover:text-[#ff0000] transition-colors lg:ml-[4%]"
          style="transform: rotate(-0.6deg); transform-origin: left;"
        >
          Instagram
        </a>
        <a
          href="https://www.facebook.com/GonetCompany/"
          target="_blank"
          rel="noopener"
          class="editorial-display block text-[10vw] lg:text-[6vw] xl:text-[88px] leading-[0.9] hover:text-[#ff0000] transition-colors lg:ml-[20%]"
          style="transform: rotate(1.2deg); transform-origin: right;"
        >
          Facebook
        </a>
        <a
          href="https://www.slideshare.net/gonetpigme"
          target="_blank"
          rel="noopener"
          class="editorial-display block text-[10vw] lg:text-[6vw] xl:text-[88px] leading-[0.9] hover:text-[#ff0000] transition-colors lg:ml-[8%]"
          style="transform: rotate(-0.9deg); transform-origin: left;"
        >
          SlideShare
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Textarea — halo yok, normal cümle düzeni (uppercase yok), native placeholder gizli */
    #message {
      color: #000;
      text-shadow: none !important;
      text-transform: none !important;
    }
    #message::placeholder {
      color: transparent !important;
      text-shadow: none !important;
    }

    /* Form error — halo yok, normal cümle düzeni (editorial-display global kuralları override) */
    #form-error {
      text-shadow: none !important;
      text-transform: none !important;
    }

    /* Custom placeholder overlay — soluk gri, normal düzen, halo yok */
    .msg-wrap { position: relative; }
    .msg-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      pointer-events: none;
      font-family: var(--font-display);
      font-size: 10vw;
      line-height: 0.92;
      letter-spacing: -0.01em;
      text-transform: none;                  /* normal cümle düzeni */
      color: rgba(0, 0, 0, 0.06);            /* iyice transparan, BG'de fısıltı */
      text-shadow: none !important;
      display: flex;
      align-items: flex-start;
      z-index: 5;
    }
    @media (min-width: 1024px) {
      .msg-overlay { font-size: min(6vw, 96px); }
    }
    .msg-caret {
      display: inline-block;
      width: 0.55ch;
      height: 0.78em;
      background: #ff0000;
      margin-top: 0.04em;
      margin-right: 0.06em;
      flex-shrink: 0;
      animation: msg-blink 1.05s steps(2, start) infinite;
    }
    .msg-hint { display: inline; }
    /* Textarea fokuslanınca veya kullanıcı yazınca: SADECE caret gizlensin, hint arka planda kalsın */
    .msg-wrap:has(#message:focus) .msg-caret,
    .msg-wrap:has(#message:not(:placeholder-shown)) .msg-caret {
      display: none;
    }
    @keyframes msg-blink { to { visibility: hidden; } }
  </style>
</BaseLayout>
