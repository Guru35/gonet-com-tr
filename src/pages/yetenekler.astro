---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema, ORG_ID } from '../lib/schema';

const title = 'Yetenekler — Teknoloji, Disiplin ve Araç Envanteri | Gonet';
const description =
  'Gonet ekibinin uzmanlık alanları: AEO/GEO (Answer Engine Optimization), SEO, Google Ads, sosyal medya, mobil API, ' +
  'web altyapı (Astro, Next.js, Laravel, WordPress), analitik (GA4, GTM, BigQuery), Schema.org JSON-LD, ' +
  'içerik üretimi ve marka stratejisi. 50+ tool, 26 yıl, 100+ markada doğrulanmış yetkinlik.';
const url = 'https://gonet.com.tr/yetenekler';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'AboutPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Yetenekler', url },
  ],
});

// Yetkinlik kategorileri — paylaşılan veri (/yetenekler + /yetenekler/[slug])
import { categories } from '../data/yetenekler';

// Yetenek verisi data/yetenekler.ts dosyasından import ediliyor (yukarıda)

// ItemList schema — yetenek envanteri
const totalSkills = categories.reduce((s, c) => s + c.skills.length, 0);
const skillListSchema = {
  '@type': 'ItemList',
  name: 'Gonet ajans yetkinlik envanteri',
  numberOfItems: totalSkills,
  itemListElement: categories.flatMap((cat, cIdx) =>
    cat.skills.map((sk, sIdx) => ({
      '@type': 'ListItem',
      position: cIdx * 100 + sIdx + 1,
      item: {
        '@type': 'DefinedTerm',
        name: sk.name,
        description: sk.detail,
        inDefinedTermSet: cat.name,
      },
    })),
  ),
};

// AboutPage'i ekstra sinyalle besle
const orgSkillSchema = {
  '@type': 'Organization',
  '@id': ORG_ID,
  knowsAbout: categories.flatMap((c) => c.skills.map((s) => s.name)),
};
---

<BaseLayout title={title} description={description} canonical={url} schemas={[pageSchema, skillListSchema, orgSkillSchema]}>
  <!-- Hero -->
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700" aria-current="page">Yetenekler</li>
        </ol>
      </nav>
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-8">
        Yetkinlik Envanteri
      </p>
      <h1 class="editorial-display text-[14vw] lg:text-[9vw] xl:text-[140px] leading-[0.9] mb-10">
        9 disiplin, {totalSkills}+ yetkinlik, 26 yıl uygulama.
      </h1>
      <p class="text-xl text-slate-700 leading-relaxed">
        Hizmetlerimiz <a href="/uzmanlik" class="text-black underline">/uzmanlık</a> sayfasında.
        Burada ise <strong>nasıl çalıştığımız</strong> — kullandığımız araçlar, takip ettiğimiz
        protokoller ve uzmanlaştığımız teknolojiler. Bir konuda "Uzman" yazıyorsa, o konuda Türkiye'de ilk
        100 ajans arasındayız demektir.
      </p>
    </div>
  </section>

  <!-- Kategoriler — editöryel çılgın -->
  <section class="border-t border-black">
    <div class="max-w-7xl mx-auto">
      {categories.map((cat, idx) => (
        <article id={`kategori-${idx}`} class="scroll-mt-24 border-b border-black">
          <div class="px-6 lg:px-10 py-12 lg:py-16 grid grid-cols-12 gap-6 lg:gap-10">
            <!-- Numara + intro — tamamı tıklanır (kategori ana sayfasına) -->
            <div class="col-span-12 lg:col-span-4">
              <a href={`/yetenekler/${cat.slug}`}
                 class="group block cursor-pointer"
                 aria-label={`${cat.name} kategorisini incele`}>
                <p class="editorial-display text-5xl lg:text-7xl mb-4">{String(idx + 1).padStart(2, '0')}</p>
                <h2 class="editorial-display text-[12vw] lg:text-[5vw] xl:text-[64px] leading-[0.9] mb-6 group-hover:underline decoration-2 underline-offset-8 decoration-black">{cat.name}</h2>
                <p class="text-sm lg:text-base leading-snug max-w-md mb-6">{cat.intro}</p>
                <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.25em] border-b border-black pb-1 group-hover:gap-3 transition-all">
                  Tamamını gör <span aria-hidden="true">→</span>
                </span>
              </a>
            </div>

            <!-- Skills satırları — her biri alt-sayfaya link, glow yok -->
            <div class="col-span-12 lg:col-span-8 border-l-0 lg:border-l border-black lg:pl-10">
              {cat.skills.map((sk) => {
                const skillSlug = sk.slug ?? sk.name
                  .toLowerCase()
                  .replace(/[çğıöşü]/g, (c) => ({ç:'c',ğ:'g',ı:'i',ö:'o',ş:'s',ü:'u'}[c] || c))
                  .replace(/[^a-z0-9]+/g, '-')
                  .replace(/^-|-$/g, '');
                return (
                  <a href={`/yetenekler/${cat.slug}/${skillSlug}`}
                     class="grid grid-cols-12 gap-4 border-b border-black/30 py-4 group hover:bg-slate-50 transition-colors -mx-6 lg:-mx-0 px-6 lg:px-0 lg:-mr-10 lg:pr-10">
                    <div class="col-span-12 lg:col-span-8">
                      <h3 class="text-base lg:text-lg font-semibold leading-snug group-hover:underline decoration-1 underline-offset-4">{sk.name}</h3>
                      <p class="text-sm leading-snug mt-1 text-slate-600">{sk.detail}</p>
                    </div>
                    <div class="col-span-12 lg:col-span-4 lg:text-right">
                      <span class={`text-[10px] font-bold uppercase tracking-[0.3em] ${
                        sk.level === 'Uzman' ? 'text-black' :
                        sk.level === 'İleri' ? 'text-slate-700' :
                        'text-slate-500'
                      }`}>{sk.level}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Yetkinlik seviyesi açıklaması -->
  <section class="py-16 bg-white border-t border-black">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="editorial-display text-3xl lg:text-4xl mb-6">Seviyeleri ne anlama geliyor?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-none p-6 border border-black/20">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-accent-pure text-black mb-3">Uzman</span>
          <p class="text-sm text-slate-700">
            Üretim ortamında 5+ yıl, 10+ projede uyguladık. Konferansta konuşur, kurum içi eğitim verir,
            yeni başlayanları yönlendirebiliriz.
          </p>
        </div>
        <div class="bg-white rounded-none p-6 border border-black/20">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-brand-200 text-black mb-3">İleri</span>
          <p class="text-sm text-slate-700">
            Üretim ortamında 2+ yıl, birden fazla projede uyguladık. Karmaşık durumları çözebilir,
            mimari karar verebiliriz.
          </p>
        </div>
        <div class="bg-white rounded-none p-6 border border-black/20">
          <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 mb-3">Orta</span>
          <p class="text-sm text-slate-700">
            Pratik kullanım var, projeye göre danışman/partner desteği ile derinleşiyoruz.
            Talep gelirse derinleştirebiliriz.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="editorial-section bg-white text-black py-32" style="--rule-top-x:16%;--rule-top-w:44%;--rule-bot-x:30%;--rule-bot-w:36%">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="editorial-display text-[8vw] lg:text-[5vw] xl:text-[64px] leading-[0.9] mb-4">İhtiyacınız bu listede mi?</h2>
      <p class="text-lg text-black/70 mb-8">
        Listede görmediğiniz bir teknoloji ya da süreç varsa, büyük olasılıkla onu da yapıyoruz —
        sadece dokümante etmemişiz. Sorun, anlatalım.
      </p>
      <a
        href="/iletisim"
        class="inline-block text-xl lg:text-2xl font-bold uppercase tracking-[0.2em] underline decoration-2 underline-offset-8 hover:decoration-4 transition-all"
      >
        Yetkinliğinizi konuşalım →
      </a>
    </div>
  </section>

</BaseLayout>
