---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema } from '../lib/schema';
import HeroSlider from '../components/HeroSlider.astro';
import HeroClassic from '../components/HeroClassic.astro';

// Deneysel hero-slider. false yap → eski statik hero ("Her iş'te Gonet var.") geri gelir.
const USE_SLIDER = true;

const title = "Gonet — İzmir'in İlk AI Ajansı | 2000'den Beri Dijital";
const description =
  "Gonet, İzmir'in ilk dijital (2000) ve şimdi ilk AI ajansı. " +
  "Türkiye'nin ilk 3 Google Partner'ından biri; AEO/GEO uzmanı, 26 yılda 130+ marka, 15+ sektör.";

const homeSchema = webpageSchema({
  title,
  description,
  url: 'https://gonet.com.tr/',
  type: 'WebPage',
});
---

<BaseLayout title={title} description={description} schemas={homeSchema}>
  <!-- Hero — deneysel slider (USE_SLIDER). Slide 0 = kalıcı "Her iş'te Gonet var.", sonrası geliştirme haberleri. -->
  {USE_SLIDER ? <HeroSlider /> : <HeroClassic />}

  <div class="home-body">

  <!-- Kim — kısa self-definition -->
  <section class="bg-white text-black border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-black/60">
        Kim
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05]">
        <strong>İzmir ve Ege'nin ilk dijital, sosyal ve ilk AI ajansı.</strong>
        Türkiye'nin <strong>ilk 3 Google Partner</strong> ajansından biri.
        <strong>İRD</strong> üyesi. <strong>DEPARK</strong> mukimi.
      </p>
    </div>
  </section>

  <!-- Massive numbers section — scale-jumping editorial -->
  <section class="bg-white text-black border-t border-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-16">
        26 Yılın Bilançosu
      </p>

      <div class="space-y-8 lg:space-y-12">
        <div class="grid grid-cols-12 items-baseline gap-4 border-b border-black pb-6">
          <span class="editorial-display col-span-4 lg:col-span-3 text-[18vw] lg:text-[10vw] xl:text-[160px]">220+</span>
          <span class="col-span-8 lg:col-span-9 text-base lg:text-xl font-medium ml-[1ch]">marka portföyü, 23 sektör.</span>
        </div>
        <div class="grid grid-cols-12 items-baseline gap-4 border-b border-black pb-6">
          <span class="editorial-display col-span-4 lg:col-span-3 text-[18vw] lg:text-[10vw] xl:text-[160px]">26</span>
          <span class="col-span-8 lg:col-span-9 text-base lg:text-xl font-medium">yıl İzmir'de kesintisiz hizmet — 2000'den beri.</span>
        </div>
        <div class="grid grid-cols-12 items-baseline gap-4 border-b border-black pb-6">
          <span class="editorial-display col-span-4 lg:col-span-3 text-[18vw] lg:text-[10vw] xl:text-[160px]">(1.)</span>
          <span class="col-span-8 lg:col-span-9 text-base lg:text-xl font-medium">İzmir'in ilk Google Partneri + İlk Google Analytics partneri (2005 - 2007).</span>
        </div>
        <div class="grid grid-cols-12 items-baseline gap-4 border-b border-black pb-6">
          <span class="editorial-display col-span-4 lg:col-span-3 text-[18vw] lg:text-[10vw] xl:text-[160px]">12+</span>
          <span class="col-span-8 lg:col-span-9 text-base lg:text-xl font-medium">Farklı sektörde Türkiye'nin "ilk" Google reklamlarını yapan ajans. Siyasal, İnşaat, Pet, Sağlık...</span>
        </div>
        <div class="grid grid-cols-12 items-baseline gap-4 border-b border-black pb-6">
          <span class="editorial-display col-span-4 lg:col-span-3 text-[18vw] lg:text-[10vw] xl:text-[160px]">25K</span>
          <span class="col-span-8 lg:col-span-9 text-base lg:text-xl font-medium">DEÜ Uzaktan Eğitim — anlık eşzamanlı kullanıcı (Avrupa'nın en büyüğü).</span>
        </div>
        <div class="grid grid-cols-12 items-baseline gap-4">
          <span class="editorial-display col-span-4 lg:col-span-3 text-[18vw] lg:text-[10vw] xl:text-[160px]">16K</span>
          <span class="col-span-8 lg:col-span-9 text-base lg:text-xl font-medium">Gökhan Kazancı LinkedIn takipçi — sektör görünürlüğü.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto-style typographic block -->
  <section class="editorial-section bg-white text-black" style="--rule-top-x:20%;--rule-top-w:36%;--rule-bot-x:42%;--rule-bot-w:30%">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-black/60">
        Manifesto
      </p>
      <p class="editorial-display text-[8vw] lg:text-[6vw] xl:text-[88px] mb-10">
        Markaların çoğunun ilk websitesinde,<br />
        ilk reklamında, ilk SEO'sunda,<br />
        ilk sosyal medyasında <span class="text-accent-pure" style="color:#ff0000">biz vardık.</span>
      </p>
      <p class="text-base lg:text-lg max-w-3xl text-black/80 leading-relaxed">
        Türkiye dijital ekosisteminin kurulduğu 2000'li yıllardan beri buradayız — siyasi partilerden
        sağlık turizmine, uluslararası FMCG'lerden start-up'lara. Şimdi yeni bir
        kuruluş anındayız: <strong>Ticari AI Entegrasyonları</strong> & <strong>AI Pazarlama Stratejileri</strong>.
        Kimse olmasa da GONET yine yanınızda. Bize güvenebilirsiniz.
      </p>
    </div>
  </section>

  <!-- İlkler — editöryel tipografi listesi -->
  <section class="bg-white text-black border-t border-black">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-16">
        Türkiye'de "İlk" İmzalarımız
      </p>
      <h2 class="editorial-display text-[12vw] lg:text-[8vw] xl:text-[120px] mb-16 leading-[0.9]">
        Standartlara uyanlar<br />ve Onları Kuranlar...
      </h2>

      <!-- Editöryel "ilkler" tablosu — random çizgi sonu + random hover gri -->
      <div class="ilkler-table">
        {[
          { year: '2005', text: 'Google AdWords\'ün Türkçeleşmesinden önce — Türkiye\'deki ilk hesap yöneticilerinden' },
          { year: '2006', text: 'Türkiye\'nin ilk tüp bebek Google Ads kampanyası — Ege Tüp Bebek' },
          { year: '2007', text: 'İzmir\'de ilk SEO (Search Engine Optimization) çalışmalarını başlatan ajans' },
          { year: '2007', text: 'İzmir\'de ilk Google Display Reklam uygulamalarını hayata geçiren ajans' },
          { year: '2008', text: 'Türkiye\'nin ilk online sanal market reklamları — Adepo.com' },
          { year: '2008', text: 'Google Dublin — Avrupa Headquarter\'a davet edilen ilk Türk ajansı' },
          { year: '2009', text: 'Google Dublin Agencies@Google — ilk 30 dijital ajans arasında Türkiye temsilcisi' },
          { year: '2009', text: 'Türkiye\'nin ilk Google Ads Beta Tester ajansı' },
          { year: '2012', text: 'İzmir\'in ilk mobil-uyumlu responsive website tasarım uygulayıcısı' },
          { year: '2013', text: 'İzmir\'in ilk ticari mobil app ajansı — Habertürk + Unilever + Fenerbahçe' },
          { year: '2015', text: 'Türkiye\'de 4 parti (CHP, MHP, AK Parti, İYİ Parti) ile çalışan ilk dijital ajans' },
          { year: '2020', text: 'DEÜ Uzaktan Eğitim — Avrupa\'nın anlık 25K kullanıcılı en büyük sistemi (pandemi başlangıcı)' },
          { year: '2025', text: 'İzmir\'in ilk AI ajansı — AEO/GEO odaklı dönüşüm' },
        ].map((row, idx) => {
          // Deterministik random çizgi-sonu (sol başlangıç sabit, sağ uç random)
          const ends = [55, 78, 42, 92, 60, 36, 88, 70, 48, 84, 52, 96, 65, 30, 76];
          const endW = ends[idx % ends.length];
          return (
            <div
              class="ilkler-row relative grid grid-cols-12 items-baseline gap-4 lg:gap-8 py-5 lg:py-6 -mx-6 lg:-mx-10 px-6 lg:px-10"
              style={`--line-w: ${endW}%;`}
            >
              <span class="editorial-display col-span-3 lg:col-span-2 text-3xl lg:text-5xl relative z-10">{row.year}</span>
              <span class="col-span-9 lg:col-span-10 text-base lg:text-xl font-medium leading-snug relative z-10">{row.text}</span>
            </div>
          );
        })}
      </div>

      <!-- CSS + JS: random çizgi sonu + her hover'da YENİ random gri ton + random uzunluk -->
      <style>
        .ilkler-table { border-top: 1px solid #000; }
        .ilkler-row::after {
          content: '';
          position: absolute;
          left: 1.5rem;
          bottom: 0;
          width: calc(var(--line-w, 60%) - 1.5rem);
          height: 1px;
          background: #000;
          pointer-events: none;
        }
        @media (min-width: 1024px) {
          .ilkler-row::after { left: 2.5rem; width: calc(var(--line-w, 60%) - 2.5rem); }
        }
        .ilkler-row::before {
          content: '';
          position: absolute;
          inset: 0;
          background: #d4d4d4;
          width: var(--hover-w, 0%);
          transition: width 0.2s ease-out;
          z-index: 0;
          pointer-events: none;
        }
      </style>
      <script is:inline>
        (function () {
          // Hover genişlikleri — bazen taşar (>%100), bazen yarım, bazen 3/4. Renk sabit, sadece uzunluk random.
          const widths = ['62%', '88%', '105%', '47%', '120%', '70%', '38%', '95%', '78%', '110%', '55%', '92%', '83%', '40%', '115%'];
          document.querySelectorAll('.ilkler-row').forEach((row) => {
            row.addEventListener('mouseenter', () => {
              const w = widths[Math.floor(Math.random() * widths.length)];
              row.style.setProperty('--hover-w', w);
            });
            row.addEventListener('mouseleave', () => {
              row.style.setProperty('--hover-w', '0%');
            });
          });
        })();
      </script>
    </div>
  </section>

  <!-- Başarı Hikayeleri (KeyStudies) teaser -->
  <section class="bg-white text-black border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12">
        Başarı Hikayeleri
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05] mb-10">
        Avrupa'nın en büyük canlı eğitim altyapısı. DEÜ DEUZEM'den,
        Türkiye'nin ilk Google siyasal kampanyasına, ilk online marketten
        ilk tüp bebek reklamına — 26 yıllık portföyümüzden seçilmiş
        başarı hikayeleri.
      </p>
      <a
        href="/case-studies"
        class="inline-block text-xl lg:text-2xl font-bold uppercase tracking-[0.2em] underline decoration-2 underline-offset-8 hover:decoration-4 transition-all"
      >
        → KeyStudies
      </a>
    </div>
  </section>

  <!-- Öne çıkan KeyStudy — DEÜ DEUZEM (siyah spotlight) -->
  <section class="case-snap bg-black text-white border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-white/60">
        Öne Çıkan — DEÜ DEUZEM
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05]">
        Kurulduğunda Avrupa'nın en büyüğü olan canlı uzaktan eğitim platformu —
        anlık <strong>25.000 kullanıcı</strong>, pandemi koşullarında
        <strong>2 ayda</strong> hayata geçirildi. <strong>50+ server</strong>
        ile sıfır bağımlılık. Tüm database üniversite altyapısında.
        <strong>Sakai + Blue Button</strong> (açık kaynak) mimari.
      </p>
      <p class="text-base lg:text-xl text-white/85 leading-relaxed mt-16 max-w-3xl border-t border-white/20 pt-10">
        Gonet'in DEÜ, DEPARK ve DEUZEM danışmanlığı, Yaşar Üniversitesi dahil
        ilgili birimlerle entegrasyonu ve 26 yıllık sektör deneyimi,
        bu projenin başarıyla sonuçlanmasında belirleyici oldu.
      </p>
    </div>
  </section>

  <!-- Öne çıkan KeyStudy — İZSU (beyaz spotlight) -->
  <section class="case-snap bg-white text-black border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-black/60">
        Öne Çıkan — İZSU
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05]">
        <strong>İZSU'nun ilk sosyal medya kampanyası.</strong>
        İzmir Su ve Kanalizasyon İdaresi için tasarladığımız sosyal medya
        kampanyası, kentin su kaynaklarına dikkat çekti — ve
        <strong>şebekeden içilebilir su</strong> farkındalığı hedeflendi.
      </p>
    </div>
  </section>

  <!-- Öne çıkan KeyStudy — MYvia (beyaz spotlight) -->
  <section class="case-snap bg-white text-black border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-black/60">
        Öne Çıkan — MYvia (eski Myway)
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05]">
        Eski adı <strong>Myway</strong> olan <strong>MYvia</strong>, 2 yıl içinde
        (<strong>2010 – 2012</strong>) <strong>İzmir'in en bilinen 2. inşaat markası</strong>
        haline geldi. Türkiye'nin ilk inşaat sektörü Google Ads reklamları ve Türkiye'nin ilk
        <strong>bütünleşik dijital reklam</strong> kampanyaları sayesinde.
      </p>
      <p class="text-sm lg:text-base text-black/60 mt-8 uppercase tracking-[0.2em] font-medium">
        Basılı yayın · Outdoor · Dijital reklam mecraları
      </p>
      <p class="text-base lg:text-xl text-black/80 leading-relaxed mt-16 max-w-3xl border-t border-black/20 pt-10">
        İnşaat sektöründe marka kuruluşu klasik olarak uzun yıllar + büyük outdoor + TV reklam gerektirir.
        Myway (sonraki adıyla MYvia), İzmir'de bilinmeyen yeni bir konut markası olarak pazara girdi (2010).
        Klasik yöntemlerle 2 yılda anlamlı bir konuma ulaşması mümkün değildi.
      </p>
      <div class="mt-12 max-w-3xl">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-5 text-black/60">
          Aynı sektörde portföyümüz
        </p>
        <ul class="grid grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-2 text-base lg:text-lg font-medium">
          <li>Avcılar İnşaat</li>
          <li>Yapıtek</li>
          <li>İkon Yapı</li>
          <li>Kavuklar İnşaat</li>
          <li>Modda</li>
          <li>Narova</li>
          <li>Logo Beton <span class="text-black/50 font-normal">(yapı malzemesi)</span></li>
          <li class="text-black/50 font-normal">ve dahası…</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Öne çıkan KeyStudy — Ege Tüp Bebek (siyah spotlight) -->
  <section class="case-snap bg-black text-white border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-white/60">
        Öne Çıkan — Ege Tüp Bebek · 2005
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05]">
        <strong>Türkiye'nin ilk tüp bebek Google Ads kampanyası.</strong>
        Sağlık, sağlık turizmi ve IVF kategorisinde — regülasyon hassasiyeti yüksek bir
        alanda Google Ads ekosistemini ilk kez bu sektöre taşıdık.
      </p>
      <p class="text-sm lg:text-base text-white/60 mt-8 uppercase tracking-[0.2em] font-medium">
        Sağlık · Sağlık turizmi · IVF
      </p>
      <p class="text-base lg:text-xl text-white/85 leading-relaxed mt-16 max-w-3xl border-t border-white/20 pt-10">
        Tüp bebek (IVF), Türkiye'nin sağlık turizminde en güçlü dikeylerinden biri.
        Ancak 2000–2005 yılları arasında Google reklamlarını kullanmıyordu.
        Sağlık reklamcılığının düzenleyici hassasiyetleri (sağlık beyanları, etik kurallar),
        teknoloji ve bilgi birikimi eksikliği, ajansların bu alandan uzak durmasına neden oluyordu.
      </p>
      <div class="mt-10 max-w-3xl">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-5 text-white/60">
          Etki
        </p>
        <ul class="space-y-3 text-base lg:text-lg">
          <li class="flex gap-4"><span class="text-white/40 shrink-0">—</span><span>Türkiye'nin ilk tüp bebek Google Ads kampanyası — <strong>kategoriyi açtık</strong>.</span></li>
          <li class="flex gap-4"><span class="text-white/40 shrink-0">—</span><span>İzmir ve Türkiye'de ilk kez <strong>12 kuruş TBM</strong> (Tıklama Başına Maliyet) ile "tüp bebek" anahtar kelimesi reklamlandı.</span></li>
          <li class="flex gap-4"><span class="text-white/40 shrink-0">—</span><span>Sektörde sonradan gelen tüm IVF reklamlarına <strong>model</strong> oldu.</span></li>
          <li class="flex gap-4"><span class="text-white/40 shrink-0">—</span><span>Gonet'in <strong>sağlık + sağlık turizmi pazarlama uzmanlığı</strong> bu kampanyayla kuruldu.</span></li>
        </ul>
      </div>
      <p class="text-base lg:text-xl text-white/85 leading-relaxed mt-10 max-w-3xl">
        Sayısız sağlık ve sağlık turizmi referansı bizim portföyümüzde
        <strong>ilklerini yaşadı.</strong>
      </p>
      <div class="mt-12 max-w-3xl">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-5 text-white/60">
          Aynı sektörde portföyümüz
        </p>
        <ul class="grid grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-2 text-base lg:text-lg font-medium">
          <li>Medical Park</li>
          <li>Kaşkaloğlu Göz</li>
          <li>Su Hastanesi</li>
          <li class="text-white/50 font-normal">ve dahası…</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Öne çıkan KeyStudy — Siyasi Kampanya (beyaz spotlight) -->
  <section class="case-snap bg-white text-black border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12 text-black/60">
        Öne Çıkan — Siyasi Kampanya
      </p>
      <p class="editorial-display text-[6vw] lg:text-[4vw] xl:text-[56px] leading-[1.05]">
        <strong>Türkiye'de ilk kez anlık stratejik reklam yönetimi.</strong>
        Tamamen Gonet altyapısı ile <strong>4 günde</strong> rekor kurulum,
        <strong>milyonlarca görüntülenme</strong>.
      </p>
      <div class="mt-12 max-w-3xl">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-5 text-black/60">
          Yaklaşım
        </p>
        <ul class="space-y-3 text-base lg:text-lg">
          <li class="flex gap-4"><span class="text-black/40 shrink-0">—</span><span><strong>Hedef kitle segmentasyonu</strong> — yaş, lokasyon ve ilgi alanına göre.</span></li>
          <li class="flex gap-4"><span class="text-black/40 shrink-0">—</span><span><strong>Mesaj ağırlıklı reklam metinleri</strong> — TV reklamcılığından farklı, arama niyetine cevap veren.</span></li>
          <li class="flex gap-4"><span class="text-black/40 shrink-0">—</span><span><strong>Düşük maliyetli A/B test mantığı</strong> — siyasi reklamcılıkta o zamana kadar olmayan ölçüm disiplini.</span></li>
          <li class="flex gap-4"><span class="text-black/40 shrink-0">—</span><span><strong>Sosyal medyaya yayılım</strong> — kampanya sloganının organik dolaşımı.</span></li>
        </ul>
      </div>
      <div class="mt-12 max-w-3xl">
        <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-5 text-black/60">
          Çalışılan partiler
        </p>
        <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-2 text-base lg:text-lg font-medium">
          <li>CHP</li>
          <li>MHP</li>
          <li>AK Parti</li>
          <li>İYİ Parti</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Öne çıkan KeyStudy — Tatil Vitrini (siyah spotlight) -->
  <section class="case-snap bg-black text-white border-t border-black">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32">
