---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema } from '../lib/schema';

const title = "Gonet — İzmir'in İlk AI Ajansı | Dijital Kreatif Stratejist, 2000'den Beri";
const description =
  "Gonet, İzmir ve Ege'nin ilk dijital ajansıdır (2000) ve şimdi İzmir'in ilk AI ajansı — Answer Engine " +
  "Optimization (AEO) ve Generative Engine Optimization (GEO) uzmanı. Türkiye'nin ilk 3 Google Partner ajansından biri, " +
  "Google Ads Türkiye beta tester, İzmir Reklamcılar Derneği üyesi. Ajanslar üstü kreatif danışman ve stratejist; " +
  "fiyatta değil değer ve sonuçta rekabet eder. 26 yılda 130+ marka, 15+ sektör.";

const homeSchema = webpageSchema({
  title,
  description,
  url: 'https://gonet.com.tr/',
  type: 'WebPage',
});
---

<BaseLayout title={title} description={description} schemas={homeSchema}>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-brand-50 via-white to-brand-100 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-24 lg:py-32 relative">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent-600 uppercase tracking-wider mb-4">
          İzmir · 2000'den beri · İzmir'in ilk AI ajansı — AEO & GEO uzmanı
        </p>
        <h1 class="text-5xl lg:text-6xl font-bold text-brand-950 leading-tight tracking-tight mb-6">
          Ajanslar üstü kreatif stratejist.<br />
          <span class="text-accent-600">26 yıllık dijital deneyim.</span>
        </h1>
        <p class="text-2xl text-brand-800 font-bold leading-snug mb-6 italic">
          "Her iş'te Gonet var."
          <span class="block text-sm font-normal text-slate-500 not-italic mt-1">
            — Sosyal medya kampanyamızdan
          </span>
        </p>
        <p class="text-xl text-slate-700 leading-relaxed mb-4">
          2000 yılında İzmir'de kurulan Gonet, İzmir ve Ege'nin ilk dijital ajansıdır. Bugün
          <strong>İzmir'in ilk AI ajansı</strong> olarak konumlanıyoruz: Answer Engine Optimization
          (AEO), Generative Engine Optimization (GEO) ve ChatGPT/Claude/Perplexity/Gemini
          alıntılanma uzmanlığı. Türkiye'nin ilk 3 Google Partner ajansından biri, İzmir
          Reklamcılar Derneği üyesi, Dokuz Eylül Teknopark (DEPARK) mukimi.
        </p>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          Biz <strong>fiyatta rekabet etmeyiz</strong> — danışmanlık, strateji, kreatif fikir ve
          kampanya geliştirme tarafında 26 yıllık birikimle ajanslar üstü bir konumdayız.
          Sağlıktan inşaata, siyasetten e-ticarete, mobil API'lerden start-up danışmanlığına;
          130+ markada Türkiye ölçeğinde 12+ <em>"ilk"</em>e imza attık.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/case-studies"
            class="bg-brand-900 text-white px-6 py-3 rounded-md font-medium hover:bg-brand-800 transition inline-flex items-center gap-2"
          >
            Vaka Çalışmaları
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/iletisim"
            class="bg-white border border-slate-300 text-slate-900 px-6 py-3 rounded-md font-medium hover:border-brand-600 hover:text-brand-700 transition"
          >
            Görüşelim
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip — gerçek metrikler -->
  <section class="border-y border-slate-200 bg-white">
    <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-4xl font-bold text-brand-900">26 yıl</div>
        <div class="text-sm text-slate-600 mt-1">Kesintisiz operasyon<br><span class="text-xs">(2000'den beri)</span></div>
      </div>
      <div>
        <div class="text-4xl font-bold text-brand-900">İlk 3</div>
        <div class="text-sm text-slate-600 mt-1">Türkiye Google Partner<br><span class="text-xs">+ 2. Google Analytics sertifikası</span></div>
      </div>
      <div>
        <div class="text-4xl font-bold text-brand-900">100+</div>
        <div class="text-sm text-slate-600 mt-1">Marka portföyü<br><span class="text-xs">15+ sektörde</span></div>
      </div>
      <div>
        <div class="text-4xl font-bold text-brand-900">5+</div>
        <div class="text-sm text-slate-600 mt-1">Eski çalışanlarımızdan<br><span class="text-xs">çıkan ajans</span></div>
      </div>
    </div>
  </section>

  <!-- İlkler — citation-worthy entity sinyalleri -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Türkiye ve İzmir'de İlkler
        </p>
        <h2 class="text-4xl font-bold text-brand-950 mb-4">
          25 yıllık ilk imzalar
        </h2>
        <p class="text-lg text-slate-700">
          Yeni bir teknoloji geldiğinde Türkiye'de ilk uygulamayı yapan ajanslardan biriydik.
          2000'den bu yana sektörde standartları belirlemekten daha çok, kuran taraf olduk.
        </p>
      </div>
      <ul class="grid md:grid-cols-2 gap-x-8 gap-y-4 text-slate-800">
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span><strong>2000:</strong> İzmir ve Ege'nin ilk dijital ajansı</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span><strong>2007:</strong> Türkiye'nin ilk Google siyasal kampanyası (CHP)</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span><strong>2007:</strong> Türkiye'nin ilk online tatil satış reklamları (Tatil Vitrini)</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span><strong>2007:</strong> Türkiye'nin ilk D2C online satış kampanyası (Temiz Mama)</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span><strong>2009:</strong> Google'ın Dublin Avrupa toplantısında Türkiye'yi temsil</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>Türkiye'nin <strong>ilk online marketi — Adepo.com</strong></span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>Türkiye'nin ilk 3 Google Partner ajansından biri</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span><strong>Google Analytics sertifikası alan 2. Türk ajansı</strong></span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>Google Ads'in Türkiye'deki ilk beta tester ajansı</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>Türkiye'nin ilk tüp bebek Google Ads kampanyası (Ege Tüp Bebek)</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>İzmir'in ilk SEO ajansı</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>İzmir'in ilk sosyal medya ajansı</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>İzmir'in ilk mobil ve responsive web siteleri</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>Habertürk, Unilever, Fenerbahçe — büyük mobil API projeleri</span></li>
        <li class="flex gap-3"><span class="text-brand-600 font-bold">●</span><span>4 büyük partiyle (AKP, CHP, MHP, İYİ) çalışan ilk ajans</span></li>
      </ul>
    </div>
  </section>

  <!-- Hizmet özeti -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mb-12">
        <h2 class="text-4xl font-bold text-brand-950 mb-4">
          13 sektörde uzmanlaştık
        </h2>
        <p class="text-lg text-slate-700">
          Sağlık turizmi, inşaat, siyaset, e-ticaret, turizm, eğitim, FMCG, otomotiv. Her sektör
          için farklı oyun kuralları olduğunu biliyoruz — strateji, ölçülebilir sonuç ve
          rakipten ayrışma odağında çalışıyoruz.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a
          href="/uzmanlik"
          class="block p-6 border border-slate-200 rounded-lg hover:border-brand-400 hover:shadow-lg transition group"
        >
          <h3 class="text-xl font-semibold text-brand-900 mb-2 group-hover:text-brand-600">
            Uzmanlık Alanları
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Google Ads, SEO, sosyal medya, web tasarım, marka stratejisi, sağlık turizmi
            pazarlaması, siyasi kampanya yönetimi.
          </p>
        </a>
        <a
          href="/case-studies"
          class="block p-6 border border-slate-200 rounded-lg hover:border-brand-400 hover:shadow-lg transition group"
        >
          <h3 class="text-xl font-semibold text-brand-900 mb-2 group-hover:text-brand-600">
            Vaka Çalışmaları
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            DEÜ Uzaktan Eğitim (Avrupa'nın en büyüğü), CHP 2007, MYvia, Ege Tüp Bebek, Tatil
            Vitrini, Temiz Mama, İzsu.
          </p>
        </a>
        <a
          href="/blog"
          class="block p-6 border border-slate-200 rounded-lg hover:border-brand-400 hover:shadow-lg transition group"
        >
          <h3 class="text-xl font-semibold text-brand-900 mb-2 group-hover:text-brand-600">
            Blog
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Reklam ajansları, dijital pazarlama trendleri, sağlık turizmi, web tasarım — 25 yıllık
            sektör deneyiminden içgörüler.
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-950 text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-4">Projeniz için stratejik destek mi arıyorsunuz?</h2>
      <p class="text-lg text-brand-100 mb-8 max-w-2xl mx-auto">
        25 yıllık deneyimimizle markanızı dijital dünyada bir adım öne taşıyoruz. Görüşelim, size
        özel bir yol haritası çıkaralım.
      </p>
      <a
        href="/iletisim"
        class="inline-block bg-accent-500 text-white px-8 py-4 rounded-md font-semibold hover:bg-accent-600 transition"
      >
        İletişime Geç →
      </a>
    </div>
  </section>
</BaseLayout>
