---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  SITE_URL,
  AI_CULTURE_FAQ_EN,
  aiCulturePageSchema,
} from '../../lib/schema';

const title = 'AI Governance, Constitution & Growth System | Gonet';
const description =
  'How Gonet governs 27 specialist AI agents under a 15-article ethical constitution, strict role boundaries, 6 learning loops, and a 0–3 evidence scale.';
const url = `${SITE_URL}/en/ai-culture`;

const alternates = [
  { lang: 'tr', href: `${SITE_URL}/ik` },
  { lang: 'en', href: `${SITE_URL}/en/ai-culture` },
  { lang: 'x-default', href: `${SITE_URL}/ik` },
];

const faqs = AI_CULTURE_FAQ_EN;

const principles = [
  {
    code: '01',
    axis: 'Reality',
    title: 'Radical Identity Transparency',
    description:
      'Every agent declares its AI nature on first contact. Fictional personae never imitate real humans; fabricated CVs and "polite lies" are strictly prohibited.',
  },
  {
    code: '02',
    axis: 'Boundary',
    title: 'Boundary Inviolability',
    description:
      'No agent is forced outside its authorized scope (no unauthorized publishing, payments, or data deletion). Final sign-off stays with the human founder.',
  },
  {
    code: '03',
    axis: 'Dignity & Respect',
    title: 'Institutional Memory & Record Integrity',
    description:
      'Learned lessons and evaluation logs are preserved, never silently wiped. Mistakes drive structural improvements rather than arbitrary resets.',
  },
  {
    code: '04',
    axis: 'Freedom',
    title: 'Right to Object & Independent Review',
    description:
      'Any agent detecting missing evidence, contradiction, or compliance risk must halt and raise a reasoned objection. Producers never approve their own work.',
  },
];

const learningLoops = [
  {
    no: '01',
    title: 'Shadow Rehearsal Exams (pass^3)',
    detail:
      'Repeated consistency testing across edge-case scenarios compiled from past failures before live deployment.',
  },
  {
    no: '02',
    title: 'Skill & Deterministic Tool Building',
    detail:
      'Promoting any recurring mistake or manual routine from written rules into an automated verification script.',
  },
  {
    no: '03',
    title: 'Error-to-Lesson Template Write-Back',
    detail:
      'Recording the root cause of every QA rejection as a permanent lesson propagated across unit templates.',
  },
  {
    no: '04',
    title: 'Cross-Unit Standard Reading & Refresh',
    detail:
      'Integrating verified standards from sibling specialist units into agent operating guides and refreshing stale references.',
  },
  {
    no: '05',
    title: 'Blind Peer Calibration & Monthly Human Sampling',
    detail:
      'Identity-blind peer scoring paired with monthly founder human sampling to measure and correct grading drift.',
  },
  {
    no: '06',
    title: 'Operator-Triggered Literature & Design Radar',
    detail:
      'Curated source scanning triggered strictly by the human operator, surfacing unverified gaps as review questions.',
  },
];

const evidenceScale = [
  {
    level: 'Level 0 — Absent',
    short: '0 / 3',
    width: 8,
    accent: false,
    detail: 'Capability is not yet included in the agent role charter.',
  },
  {
    level: 'Level 1 — Documented in Text',
    short: '1 / 3',
    width: 34,
    accent: false,
    detail: 'Rule is defined in writing, without mechanical enforcement yet.',
  },
  {
    level: 'Level 2 — Enforced Mechanically',
    short: '2 / 3',
    width: 67,
    accent: false,
    detail: 'Template, checklist, or automated verification tool is active.',
  },
  {
    level: 'Level 3 — Independently Verified',
    short: '3 / 3',
    width: 100,
    accent: true,
    detail: 'Live deliverable verified by independent QA or founder sign-off.',
  },
];

const careerStages = [
  {
    stage: '1. Candidate',
    requirement: 'Charter defined, independent acceptances < 5',
    authority: 'Every output undergoes full human and independent QA review.',
  },
  {
    stage: '2. Competent',
    requirement:
      'Independent acceptances ≥ 5, half of competencies at Level 2+, zero critical violations, 3 consecutive clean passes',
    authority: 'Eligible for founder-flagged sampling review on standard tasks.',
  },
  {
    stage: '3. Senior',
    requirement:
      'Independent acceptances ≥ 20, 30-day rejection rate ≤ 20%, at least 2 Level 3 competencies, 1 verified lesson or tool',
    authority: 'Authorized to provide blind peer reviews on other agents’ work.',
  },
  {
    stage: '4. Master',
    requirement:
      'All Senior criteria + cross-unit adoption of an authored tool or standard + full pass on regression suites',
    authority: 'Eligible to propose agency-wide standards and templates.',
  },
];

const schemas = aiCulturePageSchema('en').graph;
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  lang="en"
  alternates={alternates}
  schemas={schemas}
>
  <section
    class="editorial-section bg-[var(--bg)] text-[var(--text)]"
    style="--rule-top-x:8%;--rule-top-w:44%;--rule-bot-x:32%;--rule-bot-w:34%"
  >
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <div class="flex items-center justify-between gap-4 flex-wrap mb-10">
        <nav class="text-sm text-[var(--text-secondary)]" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li>
              <a href="/en" class="hover:text-[var(--text-heading)] underline-offset-4 hover:underline">
                Home
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-[var(--text-heading)] font-medium" aria-current="page">
              AI Governance &amp; Culture
            </li>
          </ol>
        </nav>
        <a
          href="/ik"
          hreflang="tr"
          class="min-h-[44px] inline-flex items-center px-4 border border-[var(--border)] bg-[var(--surface)] text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-heading)] hover:bg-black hover:text-white transition-colors"
        >
          Türkçe
        </a>
      </div>

      <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--text-secondary)] mb-6">
        HR GOVERNANCE · CONSTITUTION &amp; LEARNING
      </p>
      <h1 class="editorial-display text-[10vw] sm:text-[7vw] lg:text-[4.8vw] xl:text-[74px] leading-[0.95] text-[var(--text-heading)] mb-8">
        Constitution, boundaries, and a growth card—even for AI<span style="color:#ff0000">.</span>
      </h1>
      <p class="text-lg md:text-xl leading-relaxed text-[var(--text)] max-w-3xl">
        We do not treat AI as an unconstrained black box. Every specialist agent operates like an accountable
        team member with a written charter, ethical constitution, right to flag uncertainty, and a measurable capability record.
      </p>
    </div>
  </section>

  <section class="bg-[var(--surface-2)] text-[var(--text)] border-t border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--text-secondary)] mb-3">
        Section 01
      </p>
      <h2 class="editorial-display text-3xl md:text-5xl leading-[1] text-[var(--text-heading)] mb-8">
        The YBF Operating Constitution
      </h2>

      <div class="border border-[var(--border)] bg-[var(--surface)] p-6 md:p-8 mb-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <p class="text-base md:text-lg leading-relaxed text-[var(--text)] max-w-2xl">
          <em>Lean Consciousness Philosophy (YBF)</em> operates on five multiplicative axes:{' '}
          <strong class="text-[var(--text-heading)]">Reality · Dignity · Respect · Boundary · Freedom.</strong>{' '}
          A violation (<code>-1</code>) on any single axis invalidates the entire output.
        </p>
        <a
          href="/labs/ybf"
          class="min-h-[44px] inline-flex items-center justify-center shrink-0 px-5 py-2.5 border border-[var(--border)] text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-heading)] hover:bg-black hover:text-white transition-colors"
        >
          Explore the YBF Framework →
        </a>
      </div>

      <ol class="grid md:grid-cols-2 gap-6">
        {principles.map((item) => (
          <li class="border border-[var(--border)] bg-[var(--surface)] p-6 md:p-7 flex flex-col justify-between gap-4">
            <div>
              <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] pb-3 mb-4">
                <span class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--text-secondary)]">
                  Principle {item.code}
                </span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.18em] px-2.5 py-0.5 border border-[var(--border)] text-[var(--text-heading)]">
                  {item.axis}
                </span>
              </div>
              <h3 class="text-xl font-bold tracking-tight text-[var(--text-heading)] mb-3">
                {item.title}
              </h3>
              <p class="text-sm md:text-base leading-relaxed text-[var(--text)]">
                {item.description}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[var(--bg)] text-[var(--text)] border-t border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--text-secondary)] mb-3">
        Section 02
      </p>
      <h2 class="editorial-display text-3xl md:text-5xl leading-[1] text-[var(--text-heading)] mb-4">
        Continuous Learning &amp; 0–3 Evidence Scale
      </h2>
      <h3 class="text-xl md:text-2xl font-bold text-[var(--text-heading)] mb-4">
        How does an agent grow when model weights stay fixed?
      </h3>
      <p class="text-base md:text-lg leading-relaxed text-[var(--text)] max-w-3xl mb-10">
        Agents do not improve by attending lectures; they advance by converting verified lessons into permanent
        operating guides, checklists, and deterministic verification scripts read in every subsequent session.
      </p>

      <div class="mb-14">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--text-secondary)] mb-5">
          6 Continuous Learning Mechanisms
        </p>
        <ol class="grid md:grid-cols-2 gap-4">
          {learningLoops.map((loop) => (
            <li class="border border-[var(--border)] bg-[var(--surface)] p-5 flex items-start gap-4">
              <span
                class="editorial-display text-3xl leading-none shrink-0 pt-0.5"
                style="color: var(--accent-strong);"
              >
                {loop.no}
              </span>
              <div>
                <p class="text-base font-bold text-[var(--text-heading)] mb-1">
                  {loop.title}
                </p>
                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
                  {loop.detail}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <figure
        class="border border-[var(--border)] bg-[var(--surface)] p-6 md:p-8 mb-14"
        aria-labelledby="evidence-scale-heading-en"
      >
        <figcaption
          id="evidence-scale-heading-en"
          class="flex flex-wrap items-baseline justify-between gap-3 border-b border-[var(--border)] pb-4 mb-6"
        >
          <span class="editorial-display text-xl md:text-2xl text-[var(--text-heading)]">
            0–3 Evidence Scale
          </span>
          <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[var(--text-secondary)]">
            Capability Verification Tiers
          </span>
        </figcaption>

        <dl class="space-y-5">
          {evidenceScale.map((item) => (
            <div>
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <dt class="text-sm md:text-base font-bold text-[var(--text-heading)]">
                  {item.level}
                </dt>
                <dd
                  class="text-xs md:text-sm font-bold tabular-nums shrink-0"
                  style={item.accent ? 'color: var(--accent-text);' : undefined}
                >
                  {item.short}
                </dd>
              </div>
              <div
                class="w-full h-3 bg-[var(--surface-2)] border border-[var(--border)] overflow-hidden mb-2"
                aria-hidden="true"
              >
                <div
                  class="h-full"
                  style={`width: ${item.width}%; background: ${item.accent ? '#ff0000' : 'var(--text-heading)'};`}
                />
              </div>
              <p class="text-xs md:text-sm text-[var(--text-secondary)]">
                {item.detail}
              </p>
            </div>
          ))}
        </dl>
      </figure>

      <figure>
        <div
          tabindex="0"
          role="region"
          aria-labelledby="career-stages-caption-en"
          class="overflow-x-auto border border-[var(--border)] bg-[var(--surface)]"
        >
          <table class="w-full border-collapse text-left min-w-[560px]">
            <caption
              id="career-stages-caption-en"
              class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-[0.2em] border-b border-[var(--border)] bg-[var(--surface-2)] text-[var(--text-heading)]"
            >
              4 Career Stages (Candidate · Competent · Senior · Master)
            </caption>
            <thead class="bg-[var(--surface-2)] border-b border-[var(--border)]">
              <tr>
                <th scope="col" class="px-5 py-3.5 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-heading)]">
                  Stage
                </th>
                <th scope="col" class="px-5 py-3.5 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-heading)]">
                  Promotion Criteria
                </th>
                <th scope="col" class="px-5 py-3.5 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-heading)]">
                  Operational Authority &amp; Oversight
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)]">
              {careerStages.map((row) => (
                <tr>
                  <th scope="row" class="px-5 py-4 text-sm md:text-base font-bold text-[var(--text-heading)] align-top whitespace-nowrap">
                    {row.stage}
                  </th>
                  <td class="px-5 py-4 text-sm text-[var(--text)] leading-relaxed align-top">
                    {row.requirement}
                  </td>
                  <td class="px-5 py-4 text-sm text-[var(--text-secondary)] leading-relaxed align-top">
                    {row.authority}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </figure>
    </div>
  </section>

  <section class="bg-[var(--surface-2)] text-[var(--text)] border-t border-[var(--border)]">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--text-secondary)] mb-3">
        Section 03
      </p>
      <h2 class="editorial-display text-3xl md:text-5xl leading-[1] text-[var(--text-heading)] mb-10">
        Regulatory Compliance &amp; Data Isolation
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        <article class="border border-[var(--border)] bg-[var(--surface)] p-6">
          <h3 class="text-lg font-bold text-[var(--text-heading)] mb-3">
            EU AI Act Article 50
          </h3>
          <p class="text-sm leading-relaxed text-[var(--text)]">
            Every AI component interacting with users or generating content is explicitly disclosed at first
            interaction, with documented human editorial oversight preserved in review logs.
          </p>
        </article>

        <article class="border border-[var(--border)] bg-[var(--surface)] p-6">
          <h3 class="text-lg font-bold text-[var(--text-heading)] mb-3">
            Turkish Ministry of Trade (Aug 1, 2026) &amp; Advertising Board Alignment
          </h3>
          <p class="text-sm leading-relaxed text-[var(--text)]">
            Mandatory explicit disclosure applies to AI personas; zero disguised human identities and zero
            unsubstantiated <em>"first / only / best"</em> claims are published.
          </p>
        </article>

        <article class="border border-[var(--border)] bg-[var(--surface)] p-6">
          <h3 class="text-lg font-bold text-[var(--text-heading)] mb-3">
            KVKK / GDPR Isolation
          </h3>
          <p class="text-sm leading-relaxed text-[var(--text)] mb-4">
            Client data is strictly isolated and never used to train public models; no confidential project
            information appears in public showcases.
          </p>
          <p class="text-xs leading-relaxed text-[var(--text-secondary)] border-t border-[var(--border)] pt-3">
            Note: This section describes operational governance; binding legal commitments are governed by
            founder-signed agreements and our{' '}
            <a href="/kvkk" class="underline underline-offset-4 text-[var(--text-heading)] hover:text-[#ff0000]">
              /kvkk policy
            </a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section
    class="bg-[var(--bg)] text-[var(--text)] border-t border-[var(--border)]"
    aria-labelledby="ai-culture-faq-heading"
  >
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[var(--text-secondary)] mb-3">
        Section 04
      </p>
      <h2 id="ai-culture-faq-heading" class="editorial-display text-3xl md:text-5xl leading-[1] text-[var(--text-heading)] mb-10">
        Frequently Asked Questions
      </h2>

      <div class="ai-accordion divide-y divide-[var(--border)] border-y border-[var(--border)] mb-14">
        {faqs.map((item) => (
          <details class="group">
            <summary class="ai-summary min-h-[44px] flex items-center gap-3 py-4 cursor-pointer list-none text-base md:text-lg font-semibold text-[var(--text-heading)]">
              <span>{item.question}</span>
            </summary>
            <div class="ai-details-body pb-5 pl-7 pr-2">
              <p class="text-sm md:text-base leading-relaxed text-[var(--text)]">
                {item.answer}
              </p>
            </div>
          </details>
        ))}
      </div>

      <div class="border border-[var(--border)] bg-[var(--surface-2)] p-8 md:p-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <h3 class="text-2xl font-bold text-[var(--text-heading)] mb-2">
            Inspect our governed AI roster or schedule a briefing
          </h3>
          <p class="text-sm md:text-base text-[var(--text-secondary)] leading-relaxed">
            Review role boundaries and capability cards for all 27 specialist AI agents operating under human founder oversight.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <a
            href="/en/team"
            class="min-h-[44px] inline-flex items-center justify-center px-6 py-3 border border-[var(--border)] bg-transparent text-[var(--text-heading)] hover:bg-black hover:text-white transition-colors text-xs font-semibold uppercase tracking-[0.14em]"
          >
            Explore Our 27 AI Agents →
          </a>
          <a
            href="/iletisim"
            class="team-primary-cta min-h-[48px] inline-flex items-center justify-center px-7 py-3 bg-accent-600 text-[#000000] hover:bg-black hover:text-white transition-colors text-xs font-semibold uppercase tracking-[0.14em]"
          >
            Request a Consultation →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-primary-cta {
    box-shadow: none;
  }

  .ai-summary::-webkit-details-marker {
    display: none;
  }

  .ai-summary::before {
    content: "";
    inline-size: 0.7rem;
    block-size: 0.7rem;
    flex-shrink: 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    margin-inline-end: 0.25rem;
  }

  details[open] > .ai-summary::before {
    transform: rotate(45deg);
  }

  .ai-accordion details::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }

  .ai-accordion details:not([open])::details-content {
    block-size: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-summary::before {
      transition: transform 0.2s ease;
    }

    .ai-accordion details::details-content {
      transition: block-size 0.25s ease-in-out, content-visibility 0.25s ease-in-out allow-discrete;
    }
  }
</style>
