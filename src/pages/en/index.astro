---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { webpageSchema, SITE_URL } from '../../lib/schema';

const title = "Gonet — İzmir's First Digital & AI Agency in Turkey (Since 2000)";
const description =
  "Founded in 2000 in İzmir (DEPARK Technopark), Gonet is Turkey's pioneer digital & AI agency: AEO/GEO audits, Google Ads performance marketing, medical tourism growth, and 190+ brands across 24 industries.";
const url = `${SITE_URL}/en`;
const trUrl = `${SITE_URL}/`;

const alternates = [
  { lang: 'tr', href: trUrl },
  { lang: 'en', href: url },
  { lang: 'x-default', href: trUrl },
];

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'WebPage',
  breadcrumb: [
    { name: 'Home', url: trUrl },
    { name: 'English', url },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  lang="en"
  alternates={alternates}
  schemas={pageSchema}
>
  <!-- Hero -->
  <section
    class="editorial-section bg-white"
    style="--rule-top-x:8%;--rule-top-w:52%;--rule-bot-x:30%;--rule-bot-w:34%"
  >
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="flex items-center justify-between gap-4 flex-wrap mb-10">
        <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-black">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-700" aria-current="page">English</li>
          </ol>
        </nav>
        <a href="/" class="text-xs font-medium uppercase tracking-wider border border-slate-300 px-3 py-1.5 hover:border-black transition">
          Türkçe
        </a>
      </div>

      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-10">
        Since 2000 · İzmir, Turkey (DEPARK Technopark)
      </p>
      <h1 class="editorial-display text-[11vw] lg:text-[6.5vw] xl:text-[96px] leading-[0.95] mb-12">
        26 years of digital.<br />
        Now <span style="color:#ff0000">built for AI</span>.
      </h1>
      <p class="text-xl text-slate-700 leading-relaxed max-w-3xl">
        Founded in <strong>2000</strong> in İzmir, <strong>Gonet</strong> is the first digital agency in İzmir and the
        Aegean region, and now an <strong>AI-integrated performance &amp; AEO/GEO agency</strong>. Certified in Google's
        agency programs (2005–2017), Turkey's representative at <strong>Agencies@Google Dublin (2009)</strong>, and a
        member of <strong>IRD</strong> (İzmir Advertisers Association) — serving <strong>190+ brands across 24 industries</strong>.
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <a href="/en/aeo-geo-audit"
           class="inline-flex items-center gap-2 px-8 py-4 bg-black text-white font-medium hover:bg-slate-800 transition">
          Explore AEO/GEO Audit →
        </a>
        <a href="https://seo.gonet.com.tr" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-8 py-4 border-2 border-black text-black font-medium hover:bg-black hover:text-white transition">
          Free AI Visibility Check (seo.gonet.com.tr) →
        </a>
      </div>
    </div>
  </section>

  <!-- Key Numbers -->
  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-12">Track record</p>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="border-l-4 pl-6" style="border-color:#ff0000">
          <p class="editorial-display text-5xl md:text-6xl mb-2">190+</p>
          <p class="text-slate-700 text-sm">Brands served across 24 industries since 2000.</p>
        </div>
        <div class="border-l-4 pl-6 border-slate-400">
          <p class="editorial-display text-5xl md:text-6xl mb-2">25K</p>
          <p class="text-slate-700 text-sm">Concurrent live users on Dokuz Eylül University Distance Education (largest in Europe at launch).</p>
        </div>
        <div class="border-l-4 pl-6 border-slate-400">
          <p class="editorial-display text-5xl md:text-6xl mb-2">#1</p>
          <p class="text-slate-700 text-sm">First Google Ads beta tester agency in Turkey &amp; Google Analytics #2 partner in Turkey (2025).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core English Services -->
  <section class="bg-white border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-6">Core services</p>
      <h2 class="editorial-display text-5xl md:text-7xl mb-14 leading-[0.95]">
        Where we deliver measurable growth
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <a href="/en/aeo-geo-audit" class="block border-2 border-slate-300 p-8 hover:border-black transition group">
          <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3" style="color:#ff0000">01 · AEO / GEO</p>
          <h3 class="text-2xl font-medium mb-3 group-hover:underline">AI Visibility &amp; AEO/GEO Audit</h3>
          <p class="text-slate-700 text-sm leading-relaxed">
            5-layer evidence-based audit covering AI crawler access, Common Crawl archive presence, Schema.org entity graphs,
            llms.txt, and multi-LLM probes across ChatGPT, Claude, Gemini, Perplexity, and Copilot.
          </p>
        </a>

        <a href="/en/medical-tourism-marketing" class="block border-2 border-slate-300 p-8 hover:border-black transition group">
          <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3" style="color:#ff0000">02 · Healthcare</p>
          <h3 class="text-2xl font-medium mb-3 group-hover:underline">Medical Tourism Performance Marketing</h3>
          <p class="text-slate-700 text-sm leading-relaxed">
            International patient acquisition for clinics and hospitals in Turkey. Bilingual web architecture, UK GDPR &amp; KVKK
            compliance, branch-isolated CRM, and healthcare AEO/GEO authority.
          </p>
        </a>

        <a href="/en/ai-digital-agency" class="block border-2 border-slate-300 p-8 hover:border-black transition group">
          <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3" style="color:#ff0000">03 · Creative AI</p>
          <h3 class="text-2xl font-medium mb-3 group-hover:underline">AI-Integrated Digital Performance Agency</h3>
          <p class="text-slate-700 text-sm leading-relaxed">
            Creative AI (Human × AI) combining 26 years of Google Ads, SEO, and strategy with AI-assisted analytics,
            structured content pipelines, and live reporting via panel.gonet.com.tr.
          </p>
        </a>

        <a href="/en/case-studies" class="block border-2 border-slate-300 p-8 hover:border-black transition group">
          <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3" style="color:#ff0000">04 · Proof</p>
          <h3 class="text-2xl font-medium mb-3 group-hover:underline">Selected Case Studies</h3>
          <p class="text-slate-700 text-sm leading-relaxed">
            Dokuz Eylül University (25,000 concurrent users), Nano Dental (TR/UK bilingual AEO pilot), Medical Park Hospitals Group,
            and Sixt Rent A Car (6-year online &amp; SEO partnership).
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Live Platforms -->
  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-6">Live infrastructure</p>
      <h2 class="editorial-display text-4xl md:text-6xl mb-12 leading-[0.95]">
        Tools built &amp; operated in-house
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="border-l-4 pl-6" style="border-color:#ff0000">
          <h3 class="text-xl font-medium mb-2">seo.gonet.com.tr — Free AI Readiness Check</h3>
          <p class="text-slate-700 text-sm mb-3">
            Test how AI crawlers (GPTBot, ClaudeBot, PerplexityBot), Schema.org JSON-LD, and llms.txt are configured on your domain.
          </p>
          <a href="https://seo.gonet.com.tr" target="_blank" rel="noopener noreferrer" class="text-sm underline font-medium">
            Open seo.gonet.com.tr →
          </a>
        </div>
        <div class="border-l-4 pl-6 border-slate-400">
          <h3 class="text-xl font-medium mb-2">panel.gonet.com.tr — Client Visibility Portal</h3>
          <p class="text-slate-700 text-sm mb-3">
            Dedicated client portal for GA4/GSC metrics, multi-LLM Share-of-Model tracking, task approvals, and monthly PDF reports.
          </p>
          <a href="https://panel.gonet.com.tr" target="_blank" rel="noopener noreferrer" class="text-sm underline font-medium">
            Open panel.gonet.com.tr →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hybrid Roster & AI Culture -->
  <section class="bg-white border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-6">People &amp; AI Governance</p>
      <h2 class="editorial-display text-4xl md:text-6xl mb-10 leading-[0.95]">
        Single human leadership.<br />
        27 constitutional AI agents.
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <a
          href="/en/team"
          class="flex flex-col justify-between min-h-[44px] border-2 border-slate-300 p-8 hover:border-black transition group"
        >
          <div>
            <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3 text-accent-600">01 · Roster</p>
            <h3 class="text-2xl font-medium mb-3 group-hover:underline">Our Team · Transparent Hybrid Roster</h3>
            <p class="text-slate-700 text-sm leading-relaxed mb-6">
              Meet founder Gökhan Kazancı alongside 27 specialized AI agents operating with explicit AI disclosure,
              written scope boundaries, and human sign-off.
            </p>
          </div>
          <span class="inline-flex items-center min-h-[44px] text-xs font-semibold uppercase tracking-[0.2em] text-black">
            Explore /en/team →
          </span>
        </a>
        <a
          href="/en/ai-culture"
          class="flex flex-col justify-between min-h-[44px] border-2 border-slate-300 p-8 hover:border-black transition group"
        >
          <div>
            <p class="text-[10px] font-medium uppercase tracking-[0.3em] mb-3 text-accent-600">02 · Constitution</p>
            <h3 class="text-2xl font-medium mb-3 group-hover:underline">HR &amp; AI Culture · YBF Governance</h3>
            <p class="text-slate-700 text-sm leading-relaxed mb-6">
              Discover our Lean Consciousness Philosophy (YBF) charter, 6 continuous learning loops, agent objection
              rights, and 0–3 evidence-based capability scale.
            </p>
          </div>
          <span class="inline-flex items-center min-h-[44px] text-xs font-semibold uppercase tracking-[0.2em] text-black">
            Explore /en/ai-culture →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Footer -->
  <section class="border-t border-slate-200" style="background-color:#000;color:#fff">
    <div class="max-w-3xl mx-auto px-6 py-20 text-center">
      <p class="editorial-display text-3xl md:text-5xl leading-[1.1] mb-10">
        Ready to work with Turkey's<br />
        <span style="color:#ff0000">pioneer digital &amp; AI agency</span>?
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/iletisim" class="inline-flex items-center gap-2 px-10 py-4 bg-white text-black font-medium hover:bg-slate-200 transition">
          Contact Gonet →
        </a>
        <a href="/en/aeo-geo-audit" class="inline-flex items-center gap-2 px-10 py-4 border-2 border-white text-white font-medium hover:bg-white hover:text-black transition">
          View AEO/GEO Audit →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
