---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema, serviceSchema, faqSchema } from '../lib/schema';

const title = 'Uzmanlık Alanları — Gonet\'in 14 Dijital ve AI Hizmeti';
const description =
  'Gonet\'in 14 dijital ve AI hizmeti: Google Ads (2005–2017 arasında Google Partner), ' +
  'SEO, AEO/GEO görünürlük denetimi, sosyal medya, web tasarım, sağlık turizmi, e-ticaret.';
const url = 'https://gonet.com.tr/uzmanlik';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'CollectionPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Uzmanlık', url },
  ],
});

// 14 hizmet — her birinin slug, kategori, highlight (varsa); link varsa derin sayfaya yönlendirir
const services = [
  {
    slug: 'google-ads',
    name: 'Google Ads (SEM)',
    category: 'Performans Pazarlama',
    highlight: '2005–2017 Google ajans programı döneminde erken dönem beta tester ajanslarındandık',
    description:
      '2005–2017 arasında Google\'ın ajans programlarında sertifikalı iş ortağıydık (bugünkü adıyla Google Partner). Google Ads\'in Türkiye\'deki erken dönem beta tester ajanslarındandık. Search, Display, YouTube, Performance Max — tüm Google Ads ürünlerinde 26 yıllık operasyonel deneyim.',
    deliverables: [
      'Keyword + competitor research',
      'Kampanya yapısı + ad group hiyerarşisi',
      'Reklam metni A/B testleri',
      'Landing page optimizasyonu',
      'Dönüşüm takibi + ROAS hesabı',
    ],
    link: '/yetenekler/google-ads-sem',
  },
  {
    slug: 'seo',
    name: 'Arama Motoru Optimizasyonu (SEO)',
    category: 'Organik görünürlük',
    highlight: '2007\'den beri İzmir merkezli teknik SEO & AEO pratiği',
    description:
      'İzmir merkezli teknik SEO ekibi olarak 20+ yıllık deneyim. Teknik SEO, on-page, off-page, içerik stratejisi, schema markup ve Answer Engine Optimization (AEO) dahil modern arama mühendisliği.',
    deliverables: [
      'Site teknik SEO denetimi',
      'Anahtar kelime + intent araştırması',
      'İçerik stratejisi + editorial calendar',
      'Schema.org yapılandırılmış veri',
      'Link building + dijital PR',
    ],
    link: '/yetenekler/seo-klasik-arama',
  },
  {
    slug: 'aeo-geo-denetimi',
    name: 'AEO/GEO Denetim Hizmeti',
    category: 'Yeni nesil arama',
    highlight: 'Markanız ChatGPT, Claude, Gemini ve Perplexity yanıtlarında nasıl temsil ediliyor? 4 resmi motor API\'si + 25+ teknik kontrol.',
    description:
      'Klasik SEO denetiminin yapay zekâ çağına evrilmiş hâli. 25+ teknik kontrol (Schema.org @graph, llms.txt, robots.txt), 21 yapay zekâ botu erişim denetimi ve Cloudflare Worker bot trafiği analizi tek hatta toplanır. ChatGPT, Claude, Gemini ve Perplexity (4 resmi motor API\'si, 3 tekrarlı ölçüm ve Wilson %95 güven aralığı) ölçümleri seo.gonet.com.tr ücretsiz ön teknik denetimi ve panel.gonet.com.tr canlı müşteri paneliyle sunulur.',
    deliverables: [
      '25+ teknik kontrol (Schema.org @graph, llms.txt, canonical)',
      '21 yapay zekâ botu erişim denetimi & Cloudflare Worker bot trafiği analizi',
      '4 resmi motor API\'si (ChatGPT, Claude, Gemini, Perplexity) ile 3 tekrarlı ölçüm',
      'Wilson %95 güven aralığı ile anılma & atıf oranı raporu',
      'seo.gonet.com.tr ücretsiz ön denetim + panel.gonet.com.tr canlı müşteri paneli',
    ],
    link: '/aeo-geo-denetimi',
  },
  {
    slug: 'sosyal-medya',
    name: 'Sosyal Medya Yönetimi',
    category: 'Marka iletişimi',
    highlight: '2000\'lerden beri İzmir merkezli sosyal medya & topluluk yönetimi',
    description:
      'İzmir merkezli hibrit sosyal medya ekibi. Instagram, X (Twitter), LinkedIn, Facebook, TikTok için strateji, içerik ve topluluk yönetimi. Sağlık, siyaset, FMCG, eğitim için kategori-spesifik yaklaşımlar.',
    deliverables: [
      'Sosyal medya stratejisi',
      'İçerik takvimi + üretim',
      'Topluluk yönetimi',
      'Influencer / KOL koordinasyonu',
      'Performans raporlama',
    ],
    link: '/yetenekler/sosyal-medya-topluluk',
  },
  {
    slug: 'web-tasarim',
    name: 'Web Tasarım & Geliştirme',
    category: 'Dijital ürün',
    highlight: '2000\'den beri İzmir merkezli mobil + responsive web tasarımı',
    description:
      '2000 yılında kurulan İzmir merkezli web tasarım ekibi. Responsive ve mobil öncelikli mimariden Astro, WordPress ve özel yazılım geliştirmeye kadar proje gereksinimine göre yığın seçimi.',
    deliverables: [
      'UX araştırma + bilgi mimarisi',
      'UI tasarım + design system',
      'Frontend geliştirme (modern stack)',
      'Backend / CMS / e-ticaret entegrasyonu',
      'Performance + SEO + erişilebilirlik',
    ],
    link: '/yetenekler/web-gelistirme-altyapi',
  },
  {
    slug: 'saglik-turizmi-pazarlamasi',
    name: 'Sağlık Turizmi Pazarlaması',
    category: 'Dikey uzmanlık',
    highlight: '2005\'ten beri sağlık alanında arama reklamı pratiğimiz',
    description:
      'Tüp bebek, estetik cerrahi, diş sağlığı, saç ekimi, göz sağlığı — Türk sağlık turizminin tüm kritik dikeylerinde portföy. Düzenleyici uyumlu, çoklu dil (TR + EN + DE), yurt dışı hasta hedefli.',
    deliverables: [
      'Çoklu dil web altyapısı (TR/EN/DE/AR)',
      'Düzenleyici uyumlu reklam metinleri',
      'Hasta yolculuğu funnel\'ı',
      'CRM + lead nurturing entegrasyonu',
      'Review + reputation yönetimi',
    ],
    link: '/saglik-turizmi-performans-pazarlama',
  },
  {
    slug: 'siyasi-kampanya',
    name: 'Siyasi Kampanya Yönetimi',
    category: 'Dikey uzmanlık',
    highlight: '4 büyük partiyle de çalışan dijital kampanya deneyimi',
    description:
      'AK Parti, CHP, MHP, İYİ Parti — Türkiye\'nin 4 büyük partisiyle de çalışmış dijital kampanya ekibi. 2007\'de Google siyasal kampanyası (CHP) başta olmak üzere farklı dönemlerde aktif saha ve dijital yönetim.',
    deliverables: [
      'Hedef seçmen segmentasyonu',
      'Mesaj test + optimize',
      'Mikro-hedefli reklamcılık',
      'Sosyal medya kriz yönetimi',
      'Kampanya web sitesi + landing pages',
    ],
    link: '/case-studies/chp-2007-google-siyasal-kampanya',
  },
  {
    slug: 'e-ticaret-pazarlama',
    name: 'E-ticaret Reklam Yönetimi',
    category: 'Performans pazarlama',
    highlight: '2008 Adepo.com döneminden bu yana e-ticaret performansı',
    description:
      '2008 Adepo.com döneminden D2C markası Temiz Mama\'ya kadar 20+ yıllık e-ticaret deneyimi. Performance Max, dynamic remarketing, feed yönetimi.',
    deliverables: [
      'Product feed optimizasyonu',
      'Google Shopping + Meta katalog',
      'Dynamic remarketing kampanyaları',
      'Abandoned cart funnel\'ı',
      'CRO (dönüşüm oranı optimizasyonu)',
    ],
    link: '/yetenekler/analitik-veri',
  },
  {
    slug: 'marka-tasarimi',
    name: 'Marka Tasarımı & Kreatif Kampanya',
    category: 'Marka',
    description:
      'Yeni marka kuruluşundan rebrand sürecine kadar marka tasarımı. MYvia (eski Myway) örneğinde olduğu gibi 2 yıl içinde sıfırdan ana akım rekabete taşıdığımız markalar var.',
    deliverables: [
      'Marka stratejisi + positioning',
      'Logo + görsel kimlik sistemi',
      'Marka iletişim kuralları (guidelines)',
      'Kampanya kreatif tasarımı',
      'Cross-channel görsel tutarlılık',
    ],
    link: '/yetenekler/tasarim-ux',
  },
  {
    slug: 'online-itibar-yonetimi',
    name: 'Online İtibar Yönetimi',
    category: 'Marka koruma',
    highlight: 'İzmir merkezli kurumsal online itibar yönetimi hizmeti',
    description:
      'Marka adının Google, sosyal medya, forum ve review platformlarındaki algısını izleme + yönetme. Kriz durumunda hızlı müdahale, pozitif içerik üretimi, SEO ile negatif içerik supresyonu.',
    deliverables: [
      '24/7 marka monitoring',
      'Review yanıtlama protokolü',
      'Kriz iletişim planı',
      'Pozitif içerik SEO\'su',
      'Wikipedia + Knowledge Graph yönetimi',
    ],
    link: '/yetenekler/icerik-yaratici',
  },
  {
    slug: 'dijital-strateji',
    name: 'Dijital Strateji & Danışmanlık',
    category: 'Strateji',
    description:
      'C-level düzeyde dijital dönüşüm danışmanlığı. Pazarlama + satış + servis süreçlerinin dijitalleşmesi. Yaşar Üniversitesi\'nde ders veren ve DEPARK\'ta danışmanlık yapan ekip.',
    deliverables: [
      'Dijital olgunluk değerlendirmesi',
      'Çoklu kanal strateji yol haritası',
      'Pazarlama teknoloji stack seçimi',
      'KPI çerçevesi + ölçüm altyapısı',
      'Aylık strateji review oturumları',
    ],
    link: '/yetenekler/strateji-danismanlik',
  },
  {
    slug: 'start-up-danismanligi',
    name: 'Start-up Danışmanlığı',
    category: 'Girişimcilik',
    description:
      'Dojonote ve DEPARK\'ta start-up\'lara verilen mentörlük deneyimimiz var. Erken aşama girişimler için GTM stratejisi, marka kuruluşu, ilk kullanıcı edinme.',
    deliverables: [
      'Go-to-market stratejisi',
      'MVP\'den ilk 1000 kullanıcıya',
      'Yatırımcı sunumu desteği',
      'Marka kuruluşu',
      'Performans pazarlama setup',
    ],
    link: '/yetenekler/strateji-danismanlik',
  },
  {
    slug: 'yazilim-danismanligi',
    name: 'Yazılım Danışmanlığı',
    category: 'Teknoloji',
    description:
      'DEÜ Uzaktan Eğitim Sistemi (Avrupa\'nın en büyük canlı eğitim altyapısı) gibi büyük ölçekli projelerde yazılım mimarisi danışmanlığı. Mobil API (Habertürk, Unilever, Fenerbahçe).',
    deliverables: [
      'Mimari değerlendirme + öneri',
      'Teknoloji seçim danışmanlığı',
      'API tasarım',
      'Performans + ölçeklenme danışmanlığı',
      'Migration / modernizasyon stratejisi',
    ],
    link: '/yetenekler/web-gelistirme-altyapi',
  },
  {
    slug: 'proje-yoneticiligi',
    name: 'Proje Yöneticiliği',
    category: 'Operasyon',
    description:
      'DEÜ Uzaktan Eğitim Sistemi gibi karmaşık projeleri 2 ayda hayata geçiren proje yönetimi disiplinimiz. Çok-paydaşlı projelerde koordinasyon.',
    deliverables: [
      'Proje planlama + zaman çizelgesi',
      'Paydaş + iletişim yönetimi',
      'Risk + değişiklik yönetimi',
      'Kalite kontrol',
      'Teslim + devir + dökümantasyon',
    ],
    link: '/yetenekler/strateji-danismanlik',
  },
];

// Her hizmet için Service schema
const serviceSchemas = services.map((s) =>
  serviceSchema({
    name: s.name,
    description: s.description,
    slug: s.slug,
  }),
);

// FAQPage — global hizmet soruları
const faq = faqSchema([
  {
    question: 'Gonet hangi hizmetleri sunuyor?',
    answer:
      '14 ana hizmet alanında çalışıyoruz: Google Ads, SEO, AEO/GEO görünürlük denetimi, sosyal medya, web tasarım & geliştirme, ' +
      'sağlık turizmi pazarlaması, siyasi kampanya yönetimi, e-ticaret reklam yönetimi, marka tasarımı, ' +
      'online itibar yönetimi, dijital strateji, start-up danışmanlığı, yazılım danışmanlığı, proje yöneticiliği.',
  },
  {
    question: 'AEO/GEO görünürlük denetimi nasıl çalışır?',
    answer:
      'ChatGPT, Claude, Gemini ve Perplexity olmak üzere 4 resmi motor API\'sinde 3 tekrarlı ölçüm ve Wilson %95 güven aralığı ile ' +
      'markanızın anılma ve atıf oranını ölçüyoruz. Teknik katmanda ise Schema.org @graph, llms.txt, robots.txt dahil 25+ kontrol ve 21 yapay zekâ botu erişim denetimi yapılıyor.',
  },
  {
    question: 'seo.gonet.com.tr ve panel.gonet.com.tr ne sunar?',
    answer:
      'seo.gonet.com.tr üzerinden alan adınız için ücretsiz ön teknik AEO/SEO denetimi alabilirsiniz; panel.gonet.com.tr ise ' +
      'Cloudflare Worker bot trafiği ve dönemsel motor görünürlük raporlarını takip ettiğiniz canlı müşteri panelidir.',
  },
  {
    question: 'Hangi sektörlerde çalışıyorsunuz?',
    answer:
      'Sağlık (Medical Park), inşaat (MYvia, Marport), siyaset (4 büyük parti), ' +
      'e-ticaret (Adepo, Temiz Mama), eğitim (Dokuz Eylül Üni), FMCG (Coca Cola, Özdilek), otomotiv ' +
      '(Lada Türkiye, Toyota İzmir, Hyundai, Ford), turizm, tekstil, mobilya, kamu (Merzifon Belediyesi, İzsu) ' +
      've daha fazlasında 26 yıllık deneyim.',
  },
  {
    question: 'Google Partner sertifikanız var mı?',
    answer:
      'Gonet, 2005–2017 arasında Google\'ın ajans programlarında sertifikalı iş ortağıydı (bugünkü adıyla Google Partner). Google Ads\'in ' +
      'Türkiye\'deki erken dönem beta tester ajanslarındandı ve Google Analytics sertifikası alan 2. Türk ajansıdır.',
  },
  {
    question: 'Sağlık turizmi pazarlamasında deneyiminiz nedir?',
    answer:
      'Sağlık alanında arama reklamı çalışmalarına başladık. ' +
      'Medical Park, Kaşkaloğlu Göz Hastanesi, Su Hastanesi, Nano Dental, Metin İlaç gibi ' +
      'sağlık portföyümüz var. Sağlık turizmi için TR/EN/DE/AR çoklu dil reklam altyapısı kurabiliriz.',
  },
  {
    question: 'Yurt dışı pazarlama deneyiminiz var mı?',
    answer:
      'Evet. Simtronik Çelik Tencere markası için Almanya ve Hollanda\'daki Türk pazarına ' +
      'yönelik kampanyalar yönettik. Amatis.nl ile Hollanda projesi gerçekleştirdik. ' +
      'Yurt dışı hasta odaklı sağlık turizmi pazarlaması yapıyoruz.',
  },
]);
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  schemas={[pageSchema, ...serviceSchemas, faq]}
>
  <section class="bg-white">
    <div class="max-w-4xl mx-auto px-4 md:px-6 pt-6 md:pt-16 pb-16">
      <nav class="text-sm text-slate-500 mb-5 md:mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-black">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700" aria-current="page">Uzmanlık</li>
        </ol>
      </nav>
      <p class="etiket-kirmizi text-[11px] font-semibold uppercase tracking-[0.35em] mb-5 md:mb-7">
        Uzmanlık Alanları
      </p>
      <h1 class="editorial-display text-[38px] lg:text-[80px] leading-[1.06] mb-5 md:mb-7">
        14 dijital hizmet, 26 yıllık disiplin<span class="text-accent-600">.</span>
      </h1>
      <p class="text-[17px] md:text-xl text-slate-600 leading-normal">
        2005–2017 arasında Google'ın ajans programlarında sertifikalı iş ortağıydık (bugünkü adıyla Google Partner). Sağlık
        turizminden siyasi kampanyaya, e-ticaretten yazılım danışmanlığına — her hizmette
        sektörünüze özel disiplinli yaklaşım.
      </p>
      <!-- İlk ekran çağrısı — çerçeveli (dolu kırmızı sayfa sonunda) · taslak IlkEkran-Uzmanlik -->
      <div data-ilk-cagri class="mt-5 md:mt-7 flex flex-col md:flex-row gap-3">
        <a href="/iletisim" class="flex md:inline-flex items-center justify-center min-h-[52px] px-6 border border-current text-black text-[13px] font-semibold uppercase tracking-[0.25em] hover:bg-black hover:text-white transition-colors">
          Görüşme isteyin <span aria-hidden="true">&nbsp;→</span>
        </a>
        <a href="tel:+902324650015" class="flex md:inline-flex items-center justify-center min-h-[48px] md:min-h-[52px] px-5 border border-current text-black text-[13px] font-semibold uppercase tracking-[0.15em] hover:bg-black hover:text-white transition-colors">
          Telefon
        </a>
      </div>
    </div>
  </section>
  <style>
    .etiket-kirmizi { color: #d40000; }
    :global([data-theme="dark"]) .etiket-kirmizi { color: var(--accent-strong); }
  </style>

  <!-- Dikey ok separatör — yatay border yerine -->
  <div class="bg-white flex justify-center py-10 lg:py-14">
    <svg width="22" height="100" viewBox="0 0 22 100" aria-hidden="true" class="text-black">
      <line x1="11" y1="0" x2="11" y2="86" stroke="currentColor" stroke-width="1.5" />
      <polyline points="3,80 11,90 19,80" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>

  <!-- Tilt cards — her birinde kendi perspektif derinliği, eğim yönüne kaçar -->
  <section class="bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-24 lg:py-32 space-y-32 lg:space-y-40">
      {services.map((s, idx) => {
        // Deterministik 2D rotasyon — yön belirleyici
        const rotations = [-3, 2, -1.5, 3, -2.5, 1, -2, 2.5, -1, 3, -2, 1.5, -3];
        const aligns = ['', 'lg:ml-[10%]', 'lg:ml-[20%]', 'lg:ml-[5%]', 'lg:ml-[15%]', '', 'lg:ml-[8%]', 'lg:ml-[18%]', 'lg:ml-[3%]', '', 'lg:ml-[12%]', 'lg:ml-[22%]', 'lg:ml-[6%]'];
        const rot = rotations[idx % rotations.length];
        const align = aligns[idx % aligns.length];
        // rotateY = eğim yönü ile aynı tarafa kaçan derinlik; sert eğimlerde küçük yazı okunaklı kalsın diye 8° ile cap
        // rotateX = küçük statik yukarı eğim → masada yatık kart hissi
        const ySign = rot < 0 ? -1 : 1;
        const yTilt = ySign * Math.min(Math.abs(rot) * 3, 8);
        const xTilt = 2;
        // Origin: eğim yönüne göre — sol eğimlide sağ kenar pivot, sağ eğimlide sol kenar pivot (uzaklaşan kenar serbest hareket)
        const originX = rot < 0 ? 'right' : 'left';
        return (
          <article
            id={s.slug}
            class={`${align} max-w-5xl`}
            style={`transform: perspective(900px) rotateX(${xTilt}deg) rotateY(${yTilt}deg) rotate(${rot}deg); transform-origin: ${originX} center;`}
          >
            <!-- Numara + kategori — küçük üst meta -->
            <div class="flex items-baseline gap-4 mb-4">
              <span class="editorial-display text-3xl lg:text-5xl">{String(idx + 1).padStart(2, '0')}</span>
              <span class="text-[10px] font-medium uppercase tracking-[0.3em]">{s.category}</span>
            </div>

            <!-- Devasa servis adı -->
            <h2 class="editorial-display text-[14vw] lg:text-[8vw] xl:text-[140px] leading-[0.82] mb-8">
              {s.name}
            </h2>

            {s.highlight && (
              <p class="editorial-display text-2xl lg:text-3xl mb-6">
                ★ {s.highlight}
              </p>
            )}

            <p class="text-base lg:text-lg leading-snug mb-8 max-w-2xl">{s.description}</p>

            {s.deliverables && s.deliverables.length > 0 && (
              <div>
                <p class="text-[10px] font-medium uppercase tracking-[0.4em] mb-4">Çıktılar</p>
                <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-base font-medium">
                  {s.deliverables.map((d) => (
                    <li class="flex gap-3 items-baseline">
                      <span class="text-[10px]">→</span><span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {s.link && (
              <div class="mt-8">
                <a
                  href={s.link}
                  class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] border-b border-current pb-1 hover:bg-black hover:text-white hover:px-2 transition-all"
                >
                  Detaylı incele <span aria-hidden="true">→</span>
                </a>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="bg-white text-black border-t border-black py-[72px] lg:py-24">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 flex flex-col gap-6 lg:gap-7">
      <h2 class="editorial-display font-normal uppercase text-[34px] lg:text-[56px] leading-[1.03] tracking-[-0.02em] max-w-[960px] m-0">Hangi hizmet sizin için doğru<span class="text-accent-600">?</span></h2>
      <p class="text-[17px] lg:text-xl leading-normal text-slate-600 max-w-[680px] m-0">
        Tek bir görüşmede sizin durumunuzu dinleyip, doğru hizmet kombinasyonunu önereceğiz.
      </p>
      <div>
        <a
          href="/iletisim"
