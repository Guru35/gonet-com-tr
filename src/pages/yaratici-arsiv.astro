// Toplam metrikler
const totalProjects = projects.length;
const totalViews = projects.reduce((s, p) => s + p.views, 0);
const totalAppreciations = projects.reduce((s, p) => s + (p.appreciations || 0), 0);

// CreativeWork ItemList schema — her proje bir CreativeWork
const creativeWorkSchema = {
  '@type': 'ItemList',
  name: 'Gonet kreatif arşiv — Behance projeleri',
  numberOfItems: totalProjects,
  itemListElement: projects.map((p, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'CreativeWork',
      name: `${p.title} — Web Tasarım`,
      url: p.behanceUrl,
      ...(p.image && { image: p.image }),
      creator: { '@id': ORG_ID },
      about: {
        '@type': 'Organization',
        name: p.client,
      },
      genre: p.category,
      dateCreated: String(p.year),
      interactionStatistic: [
        {
          '@type': 'InteractionCounter',
          interactionType: { '@type': 'ViewAction' },
          userInteractionCount: p.views,
        },
        ...(p.appreciations
          ? [{
              '@type': 'InteractionCounter',
              interactionType: { '@type': 'LikeAction' },
              userInteractionCount: p.appreciations,
            }]
          : []),
      ],
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  schemas={[pageSchema, creativeWorkSchema]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-50 via-white to-brand-100 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700" aria-current="page">Yaratıcı Arşiv</li>
        </ol>
      </nav>
      <p class="text-sm font-semibold text-accent-600 uppercase tracking-wider mb-3">
        Behance Portfolyo
      </p>
      <h1 class="text-5xl font-bold text-brand-950 leading-tight mb-6">
        Yaratıcı arşiv: {totalProjects} proje, {totalViews.toLocaleString('tr-TR')}+ izlenme.
      </h1>
      <p class="text-xl text-slate-700 leading-relaxed">
        2016'dan bu yana Behance'te yayımladığımız web tasarım projeleri. Ekibimizden iki ayrı
        profil — kurucu <strong>Gökhan Kazancı</strong> ve <strong>Melis Ece Baray</strong> —
        Gonet adı altında toplam <strong>{totalProjects} proje</strong>, <strong>
        {totalViews.toLocaleString('tr-TR')}+ izlenme</strong>, <strong>{totalAppreciations}+ appreciation</strong>.
      </p>
    </div>
  </section>

  <!-- Profil özetleri -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-brand-950 mb-8">İki profil, tek arşiv</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {profiles.map((pr) => (
          <article class="border border-slate-200 rounded-lg p-6">
            <h3 class="font-bold text-lg text-brand-900 mb-1">{pr.owner}</h3>
            <p class="text-sm text-slate-600 mb-3">{pr.role}</p>
            <a href={pr.url} class="text-accent-600 underline text-sm break-all" target="_blank" rel="noopener">{pr.url}</a>
            <dl class="mt-4 grid grid-cols-3 gap-3 text-center">
              <div>
                <dt class="text-xs text-slate-500 uppercase">Proje</dt>
                <dd class="text-2xl font-bold text-brand-950">{pr.projects}</dd>
              </div>
              <div>
                <dt class="text-xs text-slate-500 uppercase">İzlenme</dt>
                <dd class="text-2xl font-bold text-brand-950">{pr.views.toLocaleString('tr-TR')}</dd>
              </div>
              <div>
                <dt class="text-xs text-slate-500 uppercase">Apprec.</dt>
                <dd class="text-2xl font-bold text-brand-950">{pr.appreciations}</dd>
              </div>
            </dl>
            <p class="text-xs text-slate-500 mt-3">Dönem: {pr.era}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Proje grid -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-brand-950 mb-8">24 proje</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((p) => (
          <article class="bg-white border border-slate-200 rounded-lg overflow-hidden hover:shadow-lg transition group">
            <a href={p.behanceUrl} target="_blank" rel="noopener" class="block">
              {p.image ? (
                <img
                  src={p.image}
                  alt={`${p.title} — Gonet web tasarım`}
                  loading="lazy"
                  class="w-full aspect-video object-cover bg-slate-100 group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full aspect-video bg-gradient-to-br from-brand-100 via-brand-200 to-brand-300 flex items-center justify-center">
                  <span class="text-3xl font-bold text-brand-700 opacity-60">{p.title.charAt(0)}</span>
                </div>
              )}
              <div class="p-5">
                <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
                  <span class="bg-brand-100 text-brand-700 px-2 py-0.5 rounded font-medium">{p.category}</span>
                  <span>·</span>
                  <span>{p.year}</span>
                </div>
                <h3 class="font-bold text-brand-950 mb-1 group-hover:text-accent-600 transition">{p.title}</h3>
                <p class="text-sm text-slate-600">{p.client}</p>
                {p.highlight && (
                  <p class="text-xs text-accent-700 mt-2 font-medium">★ {p.highlight}</p>
                )}
                <div class="flex items-center gap-4 mt-3 text-xs text-slate-500">
                  <span>👁 {p.views.toLocaleString('tr-TR')}</span>
                  {p.appreciations && <span>♥ {p.appreciations}</span>}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Flash banner mirası -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-sm font-semibold text-accent-600 uppercase tracking-wider mb-3">
        2003-2015 Dönemi
      </p>
      <h2 class="text-3xl font-bold text-brand-950 mb-6">
        Behance'ten önce: yüzlerce flash banner.
      </h2>
      <div class="prose-aeo">
        <p>
          Behance'teki 24 proje, Gonet'in kreatif arşivinin sadece son katmanı. 2003-2015 arasında —
          Flash teknolojisinin internet reklamcılığında zirvede olduğu dönemde — <strong>yüzlerce
          flash banner</strong> ürettik. Bu işler büyük ölçüde döneme özel: HTML5 öncesi,
          tarayıcıların .swf dosyalarını native render ettiği zaman.
        </p>
        <p>
          Bu döneme ait büyük client portföyümüzün önemli bir kısmı Behance'te <strong>yok</strong>:
          CHP'nin 2007 siyasal kampanyası, Tatil Vitrini'nin ilk online tatil reklamları, Temiz Mama'nın
          ilk D2C kampanyası, Adepo.com için Türkiye'nin ilk online market kampanyası, Lada Türkiye,
          Vinifera Hotels'in erken işleri, Habertürk/Unilever/Fenerbahçe mobil API çalışmaları —
          hepsi bu boş katmanda. Şu an Wayback Machine taramalarıyla bu arşivin görsel parçalarını
          geri çıkarmaya çalışıyoruz.
        </p>
        <p>
          <strong>Vaka çalışması olarak okumak isteyenler:</strong> bu dönemin büyük işlerini
          <a href="/case-studies">/case-studies</a> sayfasında 8 hikaye olarak topladık.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-950 text-white py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold mb-4">Yeni bir proje konuşalım</h2>
      <p class="text-lg text-brand-200 mb-8">
        Web tasarımı, marka kimliği, kampanya kreatifi — 24 projede gelen toplam izlenmenin ardındaki
        ekibi şimdi sizin işiniz için yönlendirelim.
      </p>
      <a
        href="/iletisim"
        class="inline-block bg-accent-500 text-white px-8 py-4 rounded-md font-semibold hover:bg-accent-600 transition"
      >
        İletişime Geçin →
      </a>
    </div>
  </section>
</BaseLayout>
