---
import BaseLayout from '../layouts/BaseLayout.astro';
import { webpageSchema, ORG_ID, SITE_URL } from '../lib/schema';

const title = 'Yaratıcı Arşiv — 24 Behance Projesi + Flash Banner Mirası | Gonet';
const description =
  '2016-2023 arasında Behance\'te yayımladığımız 24 web tasarım projesi: Doğapark Villaları, Bilge Çiftliği, ' +
  'Luna Cookware, Molly, B Hvac, Jain Farm Fresh, Sade Derma, Çizgi Film Anaokulları, Myvia Bahçe, Smyrna Park ve diğerleri. ' +
  '23K+ toplam izlenme, 486+ appreciation. Ayrıca 2003-2015 flash banner dönemimizden notlar.';
const url = 'https://gonet.com.tr/yaratici-arsiv';

const pageSchema = webpageSchema({
  title,
  description,
  url,
  type: 'CollectionPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Yaratıcı Arşiv', url },
  ],
});

// Behance profil bilgisi
const profiles = [
