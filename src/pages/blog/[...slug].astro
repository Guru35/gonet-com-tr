---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema, webpageSchema } from '../../lib/schema';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const url = `https://gonet.com.tr/blog/${post.id}`;
const article = articleSchema({
  title: post.data.title,
  description: post.data.description,
  slug: post.id,
  published: post.data.published,
  updated: post.data.updated,
  author: post.data.author,
  category: post.data.category,
  tags: post.data.tags,
  image: post.data.ogImage,
});

const breadcrumb = webpageSchema({
  title: post.data.title,
  description: post.data.description,
  url,
  type: 'WebPage',
  breadcrumb: [
    { name: 'Ana sayfa', url: 'https://gonet.com.tr/' },
    { name: 'Blog', url: 'https://gonet.com.tr/blog' },
    { name: post.data.title, url },
  ],
});
---

<BaseLayout
  title={`${post.data.title} — GONET Blog`}
  description={post.data.description}
  canonical={url}
  ogImage={post.data.ogImage}
  schemas={[article, breadcrumb]}
>
  <article class="py-16">
    <div class="max-w-3xl mx-auto px-6">
      <!-- Breadcrumb -->
      <nav class="text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600">Ana sayfa</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog" class="hover:text-brand-600">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-700 truncate" aria-current="page">{post.data.title}</li>
        </ol>
      </nav>

      <!-- Meta -->
      <div class="flex items-center gap-3 text-sm text-slate-500 mb-4">
        <time datetime={post.data.published.toISOString()}>
          {post.data.published.toLocaleDateString('tr-TR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.category && (
          <>
            <span aria-hidden="true">·</span>
            <span class="font-medium">{post.data.category}</span>
          </>
        )}
      </div>

      <!-- Title -->
      <h1 class="text-4xl lg:text-5xl font-bold text-brand-950 leading-tight mb-6">
        {post.data.h1 || post.data.title}
      </h1>

      <!-- Description as lead -->
      <p class="text-xl text-slate-700 leading-relaxed mb-12 pb-12 border-b border-slate-200">
        {post.data.description}
      </p>

      <!-- Body -->
      <div class="prose-aeo">
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-slate-200">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="text-xs font-medium text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Author -->
      <aside class="mt-12 pt-8 border-t border-slate-200 flex items-start gap-4">
        <div class="w-12 h-12 rounded-full bg-brand-100 flex items-center justify-center text-brand-700 font-bold text-lg">
          {post.data.author.name.slice(0, 1)}
        </div>
        <div>
          <p class="font-semibold text-brand-950">{post.data.author.name}</p>
          {post.data.author.role && <p class="text-sm text-slate-600">{post.data.author.role}</p>}
        </div>
      </aside>

      <!-- CTA -->
      <div class="mt-16 bg-brand-50 rounded-lg p-8 text-center">
        <p class="text-lg text-slate-700 mb-4">
          Projeniz için stratejik destek mi arıyorsunuz?
        </p>
        <a
          href="/iletisim"
          class="inline-block bg-brand-900 text-white px-6 py-3 rounded-md font-medium hover:bg-brand-800"
        >
          İletişime geç →
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
